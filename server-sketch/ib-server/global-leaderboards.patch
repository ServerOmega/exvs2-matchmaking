+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Leaderboards;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Leaderboard;
+
+namespace ServerInfinite.Controllers.UI;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card-server WebUI side of the global leaderboards. The boards come from the matchmaker
+/// (/tag/leaderboard with the shared secret, or the in-process store on an all-in-one server) and are cached briefly.
+/// Name visibility calls carry the card's access code + chip id in a POST body (never in URLs or the request log).
+/// </summary>
+[ApiController]
+[Route("ui/leaderboard")]
+public class LeaderboardUiController : BaseController<LeaderboardUiController>
+{
+    private static readonly object CacheGate = new();
+    private static readonly Dictionary<string, (DateTime At, GlobalLeaderboardDto Dto)> Cache = new();
+
+    private readonly ILeaderboardClient _client;
+    private readonly LeaderboardIdentity _identity;
+    private readonly LeaderboardSubmitter? _submitter;
+    private readonly LeaderboardConfigurations _cfg;
+    private readonly ServerDbContext _db;
+
+    public LeaderboardUiController(ILeaderboardClient client, LeaderboardIdentity identity, IOptions<CardServerConfig> options,
+        ServerDbContext db, LeaderboardSubmitter? submitter = null)
+    {
+        _client = client;
+        _identity = identity;
+        _cfg = options.Value.Leaderboard;
+        _db = db;
+        _submitter = submitter;
+    }
+
+    [HttpGet("board/{board}")]
+    public async Task<ActionResult<GlobalLeaderboardDto>> Board(string board, CancellationToken ct)
+    {
+        if (!_cfg.Enabled) return new GlobalLeaderboardDto { Available = false, Message = "Leaderboards are turned off on this server." };
+        var b = LeaderboardBoards.Normalize(board);
+        if (b == null) return BadRequest();
+        lock (CacheGate)
+        {
+            if (Cache.TryGetValue(b, out var hit) && DateTime.UtcNow - hit.At < TimeSpan.FromSeconds(Math.Max(0, _cfg.ViewCacheSeconds)))
+                return hit.Dto;
+        }
+        GlobalLeaderboardDto dto;
+        try
+        {
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(TimeSpan.FromSeconds(8));
+            dto = ToDto(await _client.BoardAsync(b, null, cts.Token));
+        }
+        catch (Exception ex) when (!ct.IsCancellationRequested)
+        {
+            Logger.LogWarning("LEADERBOARD board {Board} not loaded ({Error})", b, ex.Message);
+            return new GlobalLeaderboardDto { Board = b, Available = false, Message = "The matchmaker's leaderboard could not be reached right now." };
+        }
+        lock (CacheGate) Cache[b] = (DateTime.UtcNow, dto);
+        return dto;
+    }
+
+    [HttpPost("visibility")]
+    public async Task<ActionResult<LeaderboardVisibilityResponse>> Visibility([FromBody] LeaderboardVisibilityRequest r, CancellationToken ct)
+    {
+        var id = await CardId(r, ct);
+        if (id == null) return new LeaderboardVisibilityResponse { Success = false, Message = "Card Profile is invalid" };
+        return new LeaderboardVisibilityResponse { Success = true, Enabled = _cfg.Enabled, Hidden = _identity.IsHidden(id.Value) };
+    }
+
+    [HttpPost("setVisibility")]
+    public async Task<ActionResult<LeaderboardVisibilityResponse>> SetVisibility([FromBody] LeaderboardVisibilityRequest r, CancellationToken ct)
+    {
+        var id = await CardId(r, ct);
+        if (id == null) return new LeaderboardVisibilityResponse { Success = false, Message = "Card Profile is invalid" };
+        _identity.SetHidden(id.Value, r.Hidden);
+        lock (CacheGate) Cache.Clear();
+        _submitter?.RequestIn(TimeSpan.FromSeconds(3));
+        Logger.LogInformation("LEADERBOARD card {CardId} name {State} on the global boards", id.Value, r.Hidden ? "hidden" : "shown");
+        return new LeaderboardVisibilityResponse { Success = true, Enabled = _cfg.Enabled, Hidden = _identity.IsHidden(id.Value) };
+    }
+
+    private async Task<int?> CardId(LeaderboardVisibilityRequest r, CancellationToken ct)
+    {
+        if (string.IsNullOrEmpty(r?.AccessCode) || string.IsNullOrEmpty(r.ChipId)) return null;
+        return await _db.CardProfiles.AsNoTracking()
+            .Where(x => x.AccessCode == r.AccessCode && x.ChipId == r.ChipId)
+            .Select(x => (int?)x.Id)
+            .FirstOrDefaultAsync(ct);
+    }
+
+    internal static void ClearCacheForTests()
+    {
+        lock (CacheGate) Cache.Clear();
+    }
+
+    public static GlobalLeaderboardDto ToDto(LeaderboardPage p) => new()
+    {
+        Available = true,
+        Board = p.Board,
+        Region = p.Region,
+        MinMatches = p.MinMatches,
+        Ranked = p.Ranked,
+        UpdatedUtc = p.UpdatedUtc,
+        Rows = p.Rows.Select(r => new GlobalLeaderboardRowDto
+        {
+            Rank = r.Rank, Name = r.Name, Hidden = r.Hidden, ClassId = r.ClassId, Grade = r.Grade, Rate = r.Rate,
+            Wins = r.Wins, Losses = r.Losses, Matches = r.Matches, WinRate = r.WinRate, TopSuitId = r.TopSuitId,
+        }).ToList(),
+    };
+}
