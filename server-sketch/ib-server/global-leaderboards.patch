+using System.Net.Http.Json;
+using System.Text.Json;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.Leaderboard;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card server -> matchmaker /tag/leaderboard. Same base URL and X-Tag-Secret header as the
+/// online tag and friends clients, so no new port, allowlist entry or secret. Sends only opaque card keys, names
+/// and numbers.
+/// </summary>
+public sealed class HttpLeaderboardClient : ILeaderboardClient
+{
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+    };
+
+    private readonly HttpClient _http;
+    private readonly string _base;
+
+    /// <param name="tagBaseUrl">The /tag URL (for example http://host:28090/tag); /leaderboard is appended.</param>
+    public HttpLeaderboardClient(HttpClient http, string tagBaseUrl, string? sharedSecret = null)
+    {
+        _http = http;
+        _base = tagBaseUrl.TrimEnd('/') + "/leaderboard";
+        _http.Timeout = TimeSpan.FromSeconds(10);
+        if (!string.IsNullOrEmpty(sharedSecret))
+            _http.DefaultRequestHeaders.TryAddWithoutValidation(ServerInfinite.Lobbies.NetworkAccess.TagSecretHeader, sharedSecret);
+    }
+
+    public async Task<LeaderboardSubmitResult> SubmitAsync(LeaderboardSubmission submission, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/submit", submission, Json, ct);
+        LeaderboardSubmitResult? body = null;
+        try { body = await r.Content.ReadFromJsonAsync<LeaderboardSubmitResult>(Json, ct); } catch { }
+        body ??= new LeaderboardSubmitResult();
+        body.Status = (int)r.StatusCode;
+        if (!r.IsSuccessStatusCode)
+        {
+            body.Ok = false;
+            body.Error ??= Describe((int)r.StatusCode);
+        }
+        return body;
+    }
+
+    public async Task<LeaderboardPage> BoardAsync(string board, int? limit = null, CancellationToken ct = default)
+    {
+        var url = $"{_base}/{Uri.EscapeDataString(board)}" + (limit is { } l ? $"?limit={l}" : "");
+        var r = await _http.GetAsync(url, ct);
+        if (!r.IsSuccessStatusCode) throw new InvalidOperationException(Describe((int)r.StatusCode));
+        return await r.Content.ReadFromJsonAsync<LeaderboardPage>(Json, ct) ?? new LeaderboardPage { Board = board };
+    }
+
+    public static string Describe(int status) => status switch
+    {
+        401 => "The matchmaker refused this card server: OnlineTag.TagSecret in server.json is missing or does not match the matchmaker's.",
+        403 => "The matchmaker refused this card server's network address (Security.AccessMode).",
+        404 or 405 => "The matchmaker has no leaderboards (older build, or Leaderboard.Enabled / AcceptSubmissions is false there).",
+        413 => "The leaderboard snapshot is larger than the matchmaker accepts (Leaderboard.MaxSubmitBytes).",
+        429 => "The matchmaker is rate limiting this card server; the snapshot is retried later.",
+        _ => $"Leaderboard request failed ({status}).",
+    };
+}
