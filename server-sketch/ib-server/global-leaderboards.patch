@@ -0,0 +1,136 @@
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card server: sends a full leaderboard snapshot to the matchmaker every
+/// Leaderboard.SubmitIntervalMinutes and Leaderboard.SubmitAfterResultSeconds after a saved online Class / Mix result.
+/// Background only: never delays a game reply. One snapshot in flight at a time; failures are logged and retried
+/// at the next tick.
+/// </summary>
+public sealed class LeaderboardSubmitter : BackgroundService
+{
+    private readonly IServiceScopeFactory _scopes;
+    private readonly ILeaderboardClient _client;
+    private readonly LeaderboardIdentity _identity;
+    private readonly LeaderboardConfigurations _cfg;
+    private readonly ILogger<LeaderboardSubmitter> _log;
+    private readonly SemaphoreSlim _wake = new(0, 1);
+    private readonly object _gate = new();
+    private DateTime? _dueUtc;
+    private long _lastGeneratedMs;
+
+    public LeaderboardSubmitter(IServiceScopeFactory scopes, ILeaderboardClient client, LeaderboardIdentity identity,
+        IOptions<CardServerConfig> options, ILogger<LeaderboardSubmitter> log)
+    {
+        _scopes = scopes;
+        _client = client;
+        _identity = identity;
+        _cfg = options.Value.Leaderboard;
+        _log = log;
+    }
+
+    public bool Active => _cfg.Enabled && _cfg.SubmitEnabled;
+    public DateTime? LastSubmitUtc { get; private set; }
+    public string? LastError { get; private set; }
+    public int LastCount { get; private set; }
+
+    /// <summary>A Class / Mix result was saved: send a snapshot soon (batched with the rest of the room's results).</summary>
+    public void ResultSaved()
+    {
+        if (!Active || _cfg.SubmitAfterResultSeconds <= 0) return;
+        RequestIn(TimeSpan.FromSeconds(_cfg.SubmitAfterResultSeconds));
+    }
+
+    /// <summary>Send a snapshot after <paramref name="delay"/> (an earlier pending request wins).</summary>
+    public void RequestIn(TimeSpan delay)
+    {
+        if (!Active) return;
+        lock (_gate)
+        {
+            var due = DateTime.UtcNow + delay;
+            if (_dueUtc == null || due < _dueUtc) _dueUtc = due;
+        }
+        try { if (_wake.CurrentCount == 0) _wake.Release(); } catch (SemaphoreFullException) { }
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        if (!Active) return;
+        var interval = TimeSpan.FromMinutes(Math.Max(1, _cfg.SubmitIntervalMinutes));
+        RequestIn(TimeSpan.FromSeconds(20)); // first snapshot shortly after start
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            TimeSpan wait;
+            lock (_gate)
+            {
+                var due = _dueUtc ?? DateTime.UtcNow + interval;
+                _dueUtc ??= due;
+                wait = due - DateTime.UtcNow;
+            }
+            if (wait > TimeSpan.Zero)
+            {
+                try { await _wake.WaitAsync(wait, stoppingToken); }
+                catch (OperationCanceledException) { break; }
+                continue; // re-evaluate the due time (a result may have moved it earlier)
+            }
+            lock (_gate) _dueUtc = null;
+            await SubmitOnceAsync(stoppingToken);
+        }
+    }
+
+    /// <summary>Build and send one full snapshot now. Returns the matchmaker's answer.</summary>
+    public async Task<LeaderboardSubmitResult> SubmitOnceAsync(CancellationToken ct = default)
+    {
+        try
+        {
+            List<LeaderboardEntryIn> entries;
+            using (var scope = _scopes.CreateScope())
+            {
+                var db = scope.ServiceProvider.GetRequiredService<ServerDbContext>();
+                entries = await LeaderboardSnapshotBuilder.BuildAsync(db, _identity, _cfg.SubmitMinMatches, ct);
+            }
+            if (entries.Count == 0 && LastCount == 0 && LastSubmitUtc == null)
+            {
+                // nothing to show and nothing sent before from this process (e.g. the matchmaker itself): stay quiet
+                return new LeaderboardSubmitResult { Ok = true };
+            }
+            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+            _lastGeneratedMs = Math.Max(now, _lastGeneratedMs + 1);
+            var submission = new LeaderboardSubmission
+            {
+                ServerId = (uint)Math.Max(1, PilotId.ServerId),
+                GeneratedUnixMs = _lastGeneratedMs,
+                Full = true,
+                Entries = entries,
+            };
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(TimeSpan.FromSeconds(15));
+            var r = await _client.SubmitAsync(submission, cts.Token);
+            if (r.Ok)
+            {
+                LastSubmitUtc = DateTime.UtcNow;
+                LastError = null;
+                LastCount = entries.Count;
+                _log.LogInformation("LEADERBOARD snapshot sent: cards={Cards} accepted={Accepted} rejected={Rejected} removed={Removed}{Stale}",
+                    entries.Count, r.Accepted, r.Rejected, r.Removed, r.Stale ? " (stale, ignored)" : "");
+            }
+            else
+            {
+                LastError = r.Error ?? $"status {r.Status}";
+                _log.LogWarning("LEADERBOARD snapshot not accepted ({Status}): {Error}", r.Status, LastError);
+                if (r.Status == 429) RequestIn(TimeSpan.FromSeconds(Math.Max(5, _cfg.SubmitAfterResultSeconds) + 20));
+            }
+            return r;
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException || !ct.IsCancellationRequested)
+        {
+            LastError = ex.Message;
+            _log.LogWarning("LEADERBOARD snapshot not sent ({Error})", ex.GetType().Name + ": " + ex.Message);
+            return new LeaderboardSubmitResult { Ok = false, Status = 0, Error = ex.Message };
+        }
+    }
+}
