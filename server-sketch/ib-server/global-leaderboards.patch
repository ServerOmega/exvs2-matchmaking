+++ b/Tests/Matchmaking.Tests/LeaderboardStoreTests.cs
@@ -0,0 +1,249 @@
+using System.Net;
+using ServerInfinite.Lobbies;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>exvs2-lobbies 2026-11-16: global leaderboard store on the matchmaker (/tag/leaderboard) and its access rule.</summary>
+public class LeaderboardStoreTests
+{
+    private DateTime _now = new(2026, 11, 16, 20, 0, 0, DateTimeKind.Utc);
+    private long NowMs => new DateTimeOffset(_now).ToUnixTimeMilliseconds();
+
+    private LeaderboardStore Store(string? path = null) => new(path)
+    {
+        UtcNow = () => _now,
+        MinMatches = 5,
+        MinSubmitInterval = TimeSpan.FromSeconds(20),
+    };
+
+    private static string Key(int i) => i.ToString("x").PadLeft(32, '0');
+
+    private static LeaderboardEntryIn Mix(int i, string name, uint w, uint l, uint suit = 0) =>
+        new() { Key = Key(i), Name = name, Mix = new LeaderboardStats { Wins = w, Losses = l, TopSuitId = suit } };
+
+    private static LeaderboardEntryIn Cls(int i, string name, uint cls, float rate, uint w, uint l, bool team = false)
+    {
+        var s = new LeaderboardStats { Wins = w, Losses = l, ClassId = cls, Rate = rate, Grade = 5 };
+        return team ? new() { Key = Key(i), Name = name, ClassTeam = s } : new() { Key = Key(i), Name = name, ClassSolo = s };
+    }
+
+    private LeaderboardSubmission Sub(uint server, params LeaderboardEntryIn[] e) =>
+        new() { ServerId = server, GeneratedUnixMs = NowMs, Entries = e.ToList() };
+
+    [Fact]
+    public void ClassBoardRanksByClassThenRate()
+    {
+        var s = Store();
+        Assert.True(s.Submit(Sub(1, Cls(1, "LOW", 1, 1700, 9, 1), Cls(2, "ACE", 3, 1400, 5, 5), Cls(3, "ACE2", 3, 1600, 3, 7))).Ok);
+        var b = s.Board("class-solo");
+        Assert.Equal(new[] { "ACE2", "ACE", "LOW" }, b.Rows.Select(r => r.Name));
+        Assert.Equal(new[] { 1, 2, 3 }, b.Rows.Select(r => r.Rank));
+        Assert.Equal(3u, b.Rows[0].ClassId);
+        Assert.Equal(1600f, b.Rows[0].Rate);
+        Assert.Equal(30.0, b.Rows[0].WinRate);
+        Assert.Empty(s.Board("class-team").Rows);
+    }
+
+    [Fact]
+    public void MixBoardUsesWilsonSoSmallSamplesDoNotTopTheBoard()
+    {
+        var s = Store();
+        s.Submit(Sub(1, Mix(1, "NINE-ONE", 9, 1), Mix(2, "BIG", 45, 5), Mix(3, "FIVE-ZERO", 5, 0), Mix(4, "LOSER", 1, 9)));
+        var names = s.Board("mix").Rows.Select(r => r.Name).ToList();
+        Assert.Equal(new[] { "BIG", "NINE-ONE", "FIVE-ZERO", "LOSER" }, names);
+        Assert.True(LeaderboardStore.Wilson(45, 50) > LeaderboardStore.Wilson(9, 10));
+        Assert.Equal(0, LeaderboardStore.Wilson(0, 0));
+    }
+
+    [Fact]
+    public void MinimumMatchesAndRowLimit()
+    {
+        var s = Store();
+        s.Submit(Sub(1, Mix(1, "FOUR", 4, 0), Mix(2, "FIVE", 3, 2), Mix(3, "SIX", 3, 3)));
+        var b = s.Board("mix");
+        Assert.Equal(2, b.Ranked);
+        Assert.DoesNotContain(b.Rows, r => r.Name == "FOUR");
+        Assert.Single(s.Board("mix", limit: 1).Rows);
+        Assert.Equal(5, b.MinMatches);
+    }
+
+    [Fact]
+    public void StaleSnapshotsAreIgnored()
+    {
+        var s = Store();
+        var first = Sub(1, Mix(1, "A", 5, 0));
+        Assert.True(s.Submit(first).Ok);
+        _now = _now.AddMinutes(1);
+        var older = Sub(1, Mix(1, "A", 0, 9));
+        older.GeneratedUnixMs = first.GeneratedUnixMs; // same time = not newer
+        var r = s.Submit(older);
+        Assert.True(r.Ok);
+        Assert.True(r.Stale);
+        Assert.Equal(5u, s.Board("mix").Rows.Single().Wins);
+
+        var ancient = Sub(2, Mix(2, "OLD", 5, 0));
+        ancient.GeneratedUnixMs = NowMs - (long)TimeSpan.FromHours(25).TotalMilliseconds;
+        Assert.True(s.Submit(ancient).Stale);
+        Assert.Single(s.Board("mix").Rows);
+    }
+
+    [Fact]
+    public void FutureSnapshotsAndBadInputAreRefused()
+    {
+        var s = Store();
+        var future = Sub(1, Mix(1, "A", 5, 0));
+        future.GeneratedUnixMs = NowMs + (long)TimeSpan.FromMinutes(30).TotalMilliseconds;
+        Assert.Equal(400, s.Submit(future).Status);
+        Assert.Equal(400, s.Submit(null).Status);
+        Assert.Equal(400, s.Submit(new LeaderboardSubmission { ServerId = 0, GeneratedUnixMs = NowMs }).Status);
+        Assert.Equal(400, s.Submit(new LeaderboardSubmission { ServerId = 1, GeneratedUnixMs = 0 }).Status);
+        s.MaxEntriesPerSubmit = 2;
+        Assert.Equal(400, s.Submit(Sub(1, Mix(1, "A", 5, 0), Mix(2, "B", 5, 0), Mix(3, "C", 5, 0))).Status);
+        Assert.Equal(0, s.Count);
+    }
+
+    [Fact]
+    public void BadKeysAndDuplicatesAreRejectedPerRow()
+    {
+        var s = Store();
+        var r = s.Submit(Sub(1,
+            new LeaderboardEntryIn { Key = "NOT-HEX!", Name = "X", Mix = new() { Wins = 5 } },
+            new LeaderboardEntryIn { Key = "abc", Name = "SHORT", Mix = new() { Wins = 5 } },
+            Mix(1, "OK", 5, 0),
+            Mix(1, "DUP", 9, 0)));
+        Assert.Equal(1, r.Accepted);
+        Assert.Equal(3, r.Rejected);
+        Assert.Equal("OK", s.Board("mix").Rows.Single().Name);
+    }
+
+    [Fact]
+    public void FullSnapshotReplacesTheServersRowsOnly()
+    {
+        var s = Store();
+        s.Submit(Sub(1, Mix(1, "A", 5, 0), Mix(2, "B", 5, 0)));
+        s.Submit(Sub(2, Mix(1, "OTHER-SERVER-SAME-KEY", 5, 0)));
+        _now = _now.AddMinutes(1);
+        var r = s.Submit(Sub(1, Mix(2, "B", 6, 0)));
+        Assert.Equal(1, r.Removed);
+        var names = s.Board("mix").Rows.Select(x => x.Name).ToHashSet();
+        Assert.Equal(new HashSet<string?> { "B", "OTHER-SERVER-SAME-KEY" }, names);
+
+        _now = _now.AddMinutes(1);
+        var partial = Sub(1, Mix(3, "C", 5, 0));
+        partial.Full = false;
+        Assert.Equal(0, s.Submit(partial).Removed);
+        Assert.Equal(3, s.Board("mix").Ranked);
+    }
+
+    [Fact]
+    public void OneSnapshotPerServerPerInterval()
+    {
+        var s = Store();
+        Assert.True(s.Submit(Sub(1, Mix(1, "A", 5, 0))).Ok);
+        _now = _now.AddSeconds(5);
+        var r = s.Submit(Sub(1, Mix(1, "A", 6, 0)));
+        Assert.Equal(429, r.Status);
+        Assert.True(s.Submit(Sub(2, Mix(1, "B", 5, 0))).Ok); // other servers are not affected
+        _now = _now.AddSeconds(20);
+        Assert.True(s.Submit(Sub(1, Mix(1, "A", 6, 0))).Ok);
+        Assert.Equal(6u, s.Board("mix").Rows.Single(x => x.Name == "A").Wins);
+    }
+
+    [Fact]
+    public void CapsOnRowsAndServers()
+    {
+        var s = Store();
+        s.MaxEntriesPerServer = 2;
+        s.MaxServers = 2;
+        var r = s.Submit(Sub(1, Mix(1, "A", 5, 0), Mix(2, "B", 5, 0), Mix(3, "C", 5, 0)));
+        Assert.Equal(2, r.Accepted);
+        Assert.Equal(1, r.Rejected);
+        Assert.True(s.Submit(Sub(2, Mix(1, "D", 5, 0))).Ok);
+        Assert.Equal(507, s.Submit(Sub(3, Mix(1, "E", 5, 0))).Status);
+        s.MaxTotalEntries = 3;
+        _now = _now.AddMinutes(1);
+        Assert.Equal(0, s.Submit(new LeaderboardSubmission { ServerId = 2, GeneratedUnixMs = NowMs, Full = false,
+            Entries = { Mix(9, "F", 5, 0) } }).Accepted);
+    }
+
+    [Fact]
+    public void HiddenNamesAndCleaning()
+    {
+        var s = Store();
+        s.Submit(Sub(1,
+            new LeaderboardEntryIn { Key = Key(1), Name = "SECRET NAME", Hidden = true, Mix = new() { Wins = 5 } },
+            new LeaderboardEntryIn { Key = Key(2), Name = "  " + new string('Z', 80) + "\u0007", Mix = new() { Wins = 5 } },
+            new LeaderboardEntryIn { Key = Key(3), Name = "WEIRD", ClassSolo = new() { Wins = 5, ClassId = 99, Grade = 50, Rate = float.NaN } }));
+        var mix = s.Board("mix").Rows;
+        var hidden = mix.Single(r => r.Hidden);
+        Assert.Null(hidden.Name);
+        Assert.Equal(LeaderboardStore.MaxNameLength, mix.Single(r => !r.Hidden).Name!.Length);
+        var weird = s.Board("class-solo").Rows.Single();
+        Assert.Equal(0u, weird.ClassId);
+        Assert.Equal(0u, weird.Grade);
+        Assert.Equal(0f, weird.Rate);
+    }
+
+    [Fact]
+    public void PersistsWithoutKeysInPublicRowsAndExpires()
+    {
+        var path = Path.Combine(Path.GetTempPath(), "lb-" + Guid.NewGuid().ToString("n") + ".json");
+        try
+        {
+            var s = Store(path);
+            s.EntryTtl = TimeSpan.FromDays(2);
+            s.Submit(Sub(1, Mix(1, "A", 5, 0)));
+            var reloaded = Store(path);
+            reloaded.EntryTtl = TimeSpan.FromDays(2);
+            var row = reloaded.Board("mix").Rows.Single();
+            Assert.Equal("A", row.Name);
+            var json = System.Text.Json.JsonSerializer.Serialize(reloaded.Board("mix"));
+            Assert.DoesNotContain(Key(1), json);
+            Assert.DoesNotContain("serverId", json, StringComparison.OrdinalIgnoreCase);
+
+            // stale protection survives a restart
+            Assert.True(reloaded.Submit(Sub(1, Mix(1, "A", 9, 0))).Stale);
+
+            _now = _now.AddDays(3);
+            Assert.Empty(reloaded.Board("mix").Rows);
+        }
+        finally
+        {
+            File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void SubmissionsOffAnswers404()
+    {
+        var s = Store();
+        s.AcceptSubmissions = false;
+        Assert.Equal(404, s.Submit(Sub(1, Mix(1, "A", 5, 0))).Status);
+    }
+
+    [Theory]
+    [InlineData("class-solo", "class-solo")]
+    [InlineData("CLASS_TEAM", "class-team")]
+    [InlineData("mix", "mix")]
+    [InlineData("free", "mix")]
+    [InlineData("fes", null)]
+    [InlineData(null, null)]
+    public void BoardNames(string? input, string? expected) => Assert.Equal(expected, LeaderboardBoards.Normalize(input));
+
+    [Fact]
+    public void PublicLeaderboardPathOnlyWhenEnabled()
+    {
+        var internet = IPAddress.Parse("203.0.113.9");
+        Assert.False(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, "/leaderboard", internet));
+        Assert.True(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, "/leaderboard", internet, null, publicLeaderboard: true));
+        Assert.True(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, "/leaderboard/data", internet, null, publicLeaderboard: true));
+        Assert.False(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, "/leaderboards", internet, null, publicLeaderboard: true));
+        Assert.False(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, "/ui/leaderboard/board/mix", internet, null, publicLeaderboard: true));
+        Assert.False(NetworkAccess.IsAllowed(AccessMode.LanOnly, "/leaderboard", internet, null, publicLeaderboard: true));
+        Assert.True(NetworkAccess.IsLeaderboardPath("/leaderboard"));
+        Assert.False(NetworkAccess.IsTagPath("/leaderboard"));
+        Assert.True(NetworkAccess.IsTagPath("/tag/leaderboard/submit"));
+    }
+}
diff --git a/Tests/Server.Tests/LeaderboardTests.cs b/Tests/Server.Tests/LeaderboardTests.cs
new file mode 100644
index 0000000..e4883b9
--- /dev/null
+++ b/Tests/Server.Tests/LeaderboardTests.cs
@@ -0,0 +1,304 @@
+using System.Text.Json;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Handlers.Game;
+using ServerInfinite.Handlers.Game.Online;
+using ServerInfinite.Leaderboards;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using Xunit;
+
+namespace Server.Tests;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: global leaderboards, card-server side (snapshot from the DB, opaque keys, hidden names,
+/// result -> snapshot -> store -> board) and the Class rate fix (IB LoadClassMatch tables, optional server fallback).
+/// </summary>
+public sealed class LeaderboardTests : IDisposable
+{
+    private static readonly byte[] Salt = Enumerable.Range(1, 32).Select(i => (byte)i).ToArray();
+    private readonly SqliteConnection _connection;
+    private readonly ServerDbContext _db;
+    private readonly string _tmp = Path.Combine(Path.GetTempPath(), "lb-tests-" + Guid.NewGuid().ToString("n"));
+
+    public LeaderboardTests()
+    {
+        OnlineBattleResults.ResetForTests();
+        _connection = new SqliteConnection("DataSource=:memory:");
+        _connection.Open();
+        _db = NewContext();
+        _db.Database.Migrate();
+        Directory.CreateDirectory(_tmp);
+    }
+
+    public void Dispose()
+    {
+        _db.Dispose();
+        _connection.Dispose();
+        try { Directory.Delete(_tmp, true); } catch { }
+    }
+
+    private ServerDbContext NewContext() =>
+        new(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_connection).Options);
+
+    private CardProfile NewCard(string session, string name)
+    {
+        var card = new CardProfile
+        {
+            AccessCode = "SECRETACCESS" + session,
+            ChipId = "SECRETCHIP" + session,
+            SessionId = session,
+            UserName = name,
+            IsNewCard = false,
+            DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+        };
+        _db.CardProfiles.Add(card);
+        _db.SaveChangesAsync().GetAwaiter().GetResult();
+        return card;
+    }
+
+    private static CardServerConfig Config(bool fallback = false)
+    {
+        var c = new CardServerConfig { LogNetworkReport = false };
+        c.OnlineMatching.ClassRateServerFallback = fallback;
+        return c;
+    }
+
+    private static Request Save(CardProfile card, OnlineMatchingMode mode, bool shuffle, bool win, ulong playedAt,
+        uint suit = 313, float? before = null, float? after = null, float obtained = 0f)
+    {
+        var result = new Request.SaveVsmOnResult.PlayResultGroup
+        {
+            PlayedAt = playedAt, WinFlag = win, VsElapsedTime = 100, StageId = 5, MstMobileSuitId = suit,
+            SkillPointMobileSuitId = suit, ResultScore = 2500, ResultOrder = 1, LevelId = 3, PlayerLevelId = 3,
+            GivenDamage = 800, TakenDamage = 700, BurstType = 1, RoomId = 9, OnlineMatchingMode = mode, BadgeId = 1,
+        };
+        result.Foes.Add(new AdversaryManGroup { PilotId = 3_000_456, CpuFlag = 0, MstMobileSuitId = 332 });
+        if (mode == OnlineMatchingMode.OmmClass)
+        {
+            result.class_match_result = new Request.SaveVsmOnResult.PlayResultGroup.ClassMatchResult
+            {
+                ClassIdSolo = 1, ClassIdTeam = 2, BeforeRate = before ?? 1500f, AfterRate = after ?? 1500f,
+                ObtainedRate = obtained, GradeId = 0,
+            };
+        }
+        return new Request
+        {
+            Type = MethodType.MthdSaveVsmOnResult, RequestId = "t",
+            save_vsm_on_result = new Request.SaveVsmOnResult
+            {
+                PilotId = (uint)card.Id, SessionId = card.SessionId, ShuffleFlag = shuffle, Result = result,
+            },
+        };
+    }
+
+    private void Send(Request r, CardServerConfig? config = null)
+    {
+        using var db = NewContext();
+        var h = new SaveVsmOnResultCommandHandler(NullLogger<SaveVsmOnResultCommandHandler>.Instance, db,
+            Options.Create(config ?? Config()));
+        Assert.Equal(Error.Success, h.Handle(new SaveVsmOnResultCommand(r), CancellationToken.None).GetAwaiter().GetResult().Error);
+    }
+
+    private List<LeaderboardEntryIn> Snapshot(LeaderboardIdentity id, int min = 1)
+    {
+        using var db = NewContext();
+        return LeaderboardSnapshotBuilder.BuildAsync(db, id, min).GetAwaiter().GetResult();
+    }
+
+    [Fact]
+    public void SnapshotCarriesClassAndMixRecordsTopSuitAndAnOpaqueKey()
+    {
+        var a = NewCard("a", "ALPHA");
+        var b = NewCard("b", "BRAVO");
+        NewCard("c", "CHARLIE"); // never played online: not in the snapshot
+        ulong t = 1794730000;
+        Send(Save(a, OnlineMatchingMode.OmmFree, true, true, t++, suit: 313));
+        Send(Save(a, OnlineMatchingMode.OmmFree, true, false, t++, suit: 313));
+        Send(Save(a, OnlineMatchingMode.OmmFree, true, true, t++, suit: 401));
+        Send(Save(a, OnlineMatchingMode.OmmClass, true, true, t++, suit: 77, after: 1512f, obtained: 12f));
+        Send(Save(b, OnlineMatchingMode.OmmClass, false, false, t++, suit: 88, after: 1490f, obtained: -10f));
+
+        var id = new LeaderboardIdentity(Salt);
+        var snap = Snapshot(id);
+        Assert.Equal(2, snap.Count);
+        var ea = snap.Single(e => e.Name == "ALPHA");
+        Assert.Equal(id.KeyFor(a.Id), ea.Key);
+        Assert.Matches("^[0-9a-f]{32}$", ea.Key);
+        Assert.NotNull(ea.Mix);
+        Assert.Equal(2u, ea.Mix!.Wins);
+        Assert.Equal(1u, ea.Mix.Losses);
+        Assert.Equal(313u, ea.Mix.TopSuitId);
+        Assert.NotNull(ea.ClassSolo);
+        Assert.Equal(1u, ea.ClassSolo!.Wins);
+        Assert.Equal(1512f, ea.ClassSolo.Rate);
+        Assert.Equal(1u, ea.ClassSolo.ClassId);
+        Assert.Equal(77u, ea.ClassSolo.TopSuitId);
+        Assert.Null(ea.ClassTeam);
+
+        var eb = snap.Single(e => e.Name == "BRAVO");
+        Assert.NotNull(eb.ClassTeam);
+        Assert.Equal(1u, eb.ClassTeam!.Losses);
+        Assert.Equal(1490f, eb.ClassTeam.Rate);
+        Assert.Equal(2u, eb.ClassTeam.ClassId);
+        Assert.Null(eb.Mix);
+
+        // nothing that identifies the card itself leaves the server
+        var json = JsonSerializer.Serialize(new LeaderboardSubmission { ServerId = 3, GeneratedUnixMs = 1, Entries = snap });
+        Assert.DoesNotContain("SECRETACCESS", json);
+        Assert.DoesNotContain("SECRETCHIP", json);
+        Assert.DoesNotContain("\"a\"", json); // session id
+        Assert.DoesNotContain("pilot", json, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public void MinimumMatchesAndHiddenNames()
+    {
+        var a = NewCard("a", "ALPHA");
+        var b = NewCard("b", "BRAVO");
+        ulong t = 1794730000;
+        for (var i = 0; i < 3; i++) Send(Save(a, OnlineMatchingMode.OmmFree, true, i % 2 == 0, t++));
+        Send(Save(b, OnlineMatchingMode.OmmFree, true, true, t++));
+
+        var id = new LeaderboardIdentity(Salt);
+        Assert.Equal(2, Snapshot(id).Count);
+        Assert.Single(Snapshot(id, min: 2));
+
+        id.SetHidden(a.Id, true);
+        var hidden = Snapshot(id).Single(e => e.Key == id.KeyFor(a.Id));
+        Assert.True(hidden.Hidden);
+        Assert.Equal("", hidden.Name);
+        id.SetHidden(a.Id, false);
+        Assert.Equal("ALPHA", Snapshot(id).Single(e => e.Key == id.KeyFor(a.Id)).Name);
+
+        var optIn = new LeaderboardIdentity(Salt, hideByDefault: true);
+        Assert.All(Snapshot(optIn), e => Assert.True(e.Hidden));
+        optIn.SetHidden(b.Id, false);
+        Assert.False(Snapshot(optIn).Single(e => e.Key == optIn.KeyFor(b.Id)).Hidden);
+    }
+
+    [Fact]
+    public void IdentityKeysAreStablePerSaltAndPersisted()
+    {
+        var saltFile = Path.Combine(_tmp, "salt.txt");
+        var hiddenFile = Path.Combine(_tmp, "hidden.json");
+        var one = new LeaderboardIdentity(saltFile, hiddenFile);
+        var key = one.KeyFor(1);
+        Assert.Equal(key, one.KeyFor(1));
+        Assert.NotEqual(key, one.KeyFor(2));
+        Assert.True(File.Exists(saltFile));
+        one.SetHidden(5, true);
+
+        var again = new LeaderboardIdentity(saltFile, hiddenFile);
+        Assert.Equal(key, again.KeyFor(1));
+        Assert.True(again.IsHidden(5));
+        Assert.False(again.IsHidden(1));
+
+        var other = new LeaderboardIdentity(Path.Combine(_tmp, "salt2.txt"), null);
+        Assert.NotEqual(key, other.KeyFor(1)); // another server's salt: unlinkable keys
+    }
+
+    [Fact]
+    public void ResultToSnapshotToStoreToBoard()
+    {
+        var cards = Enumerable.Range(0, 3).Select(i => NewCard("s" + i, "P" + i)).ToList();
+        ulong t = 1794730000;
+        // P0: 6-0, P1: 3-3, P2: 2-0 (below MinMatches 5)
+        for (var i = 0; i < 6; i++) Send(Save(cards[0], OnlineMatchingMode.OmmFree, true, true, t++));
+        for (var i = 0; i < 6; i++) Send(Save(cards[1], OnlineMatchingMode.OmmFree, true, i < 3, t++));
+        for (var i = 0; i < 2; i++) Send(Save(cards[2], OnlineMatchingMode.OmmFree, true, true, t++));
+
+        var id = new LeaderboardIdentity(Salt);
+        var store = new LeaderboardStore { MinMatches = 5 };
+        var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+        var r = new InProcessLeaderboardClient(store)
+            .SubmitAsync(new LeaderboardSubmission { ServerId = 7, GeneratedUnixMs = now, Entries = Snapshot(id) })
+            .GetAwaiter().GetResult();
+        Assert.True(r.Ok);
+        Assert.Equal(3, r.Accepted);
+
+        var board = store.Board(LeaderboardBoards.Mix);
+        Assert.Equal(2, board.Ranked);
+        Assert.Equal(new[] { "P0", "P1" }, board.Rows.Select(x => x.Name));
+        Assert.Equal(100.0, board.Rows[0].WinRate);
+        Assert.Equal(6u, board.Rows[0].Matches);
+        Assert.Empty(store.Board(LeaderboardBoards.ClassSolo).Rows);
+    }
+
+    // ---------------- Class rate (+0) ----------------
+
+    [Fact]
+    public void LoadClassMatchSendsIbRateTables()
+    {
+        var resp = LoadClassMatch(Config());
+        Assert.Equal(1500u, resp.InitialRate);
+        Assert.Equal(70, resp.grade_thresholds.Count);              // (4 solo + 3 team classes) x 10 grades
+        Assert.Equal(7, resp.class_change_initial_rate.Count);
+        Assert.DoesNotContain(resp.grade_thresholds, g => g.TeamType == 1 && g.ClassId == 1); // Pilot is solo-only
+        var solo1 = resp.grade_thresholds.Where(g => g.TeamType == 0 && g.ClassId == 1).OrderByDescending(g => g.GradeId).ToList();
+        Assert.Equal(Enumerable.Range(1, 10).Reverse().Select(x => (uint)x), solo1.Select(g => g.GradeId));
+        Assert.Equal(0u, solo1[0].MinRate);       // grade 10 starts at 0
+        Assert.Equal(99999u, solo1[^1].MaxRate);  // grade 1 is open-ended
+        for (var i = 1; i < solo1.Count; i++) Assert.Equal(solo1[i - 1].MaxRate + 1, solo1[i].MinRate); // contiguous
+        var g5 = solo1.Single(g => g.GradeId == 5);
+        Assert.InRange(1500u, g5.MinRate, g5.MaxRate);
+
+        // the fields reach the wire (they were ProtoIgnore'd OverBoost fields before)
+        var wire = new Response { Type = MethodType.MthdLoadClassMatch, RequestId = "x", Error = Error.Success, load_class_match = resp };
+        using var ms = new MemoryStream();
+        ProtoBuf.Serializer.Serialize(ms, wire);
+        ms.Position = 0;
+        var back = ProtoBuf.Serializer.Deserialize<Response>(ms).load_class_match;
+        Assert.Equal(1500u, back.InitialRate);
+        Assert.Equal(70, back.grade_thresholds.Count);
+    }
+
+    [Fact]
+    public void ClassRateTablesCanBeTurnedOff()
+    {
+        var c = Config();
+        c.OnlineMatching.ClassRateTables = false;
+        var resp = LoadClassMatch(c);
+        Assert.Equal(0u, resp.InitialRate);
+        Assert.Empty(resp.grade_thresholds);
+        Assert.Empty(resp.class_change_initial_rate);
+    }
+
+    private Response.LoadClassMatch LoadClassMatch(CardServerConfig config)
+    {
+        using var db = NewContext();
+        var h = new LoadClassMatchCommandHandler(NullLogger<LoadClassMatchCommandHandler>.Instance, db, Options.Create(config));
+        var req = new Request { Type = MethodType.MthdLoadClassMatch, RequestId = "x", load_class_match = new Request.LoadClassMatch { DiskVer = "1" } };
+        return h.Handle(new LoadClassMatchCommand(req), CancellationToken.None).GetAwaiter().GetResult().load_class_match;
+    }
+
+    [Fact]
+    public void ZeroRateChangeStaysByDefaultAndFallbackAppliesTheFormula()
+    {
+        var a = NewCard("a", "ALPHA");
+        var b = NewCard("b", "BRAVO");
+        Send(Save(a, OnlineMatchingMode.OmmClass, true, true, 1794730001)); // +0 from the cabinet, fallback off
+        using (var db = NewContext())
+            Assert.Equal(1500f, db.SoloClassMatchRecordDbSet.Single(x => x.CardId == a.Id).Rate);
+
+        Send(Save(b, OnlineMatchingMode.OmmClass, true, true, 1794730002), Config(fallback: true));
+        Send(Save(b, OnlineMatchingMode.OmmClass, true, false, 1794730003), Config(fallback: true));
+        using (var db = NewContext())
+        {
+            // win: 10 * (1 + 2500 / 25000) = 11, loss: -10
+            Assert.Equal(1501f, db.SoloClassMatchRecordDbSet.Single(x => x.CardId == b.Id).Rate, 2);
+        }
+
+        // a real change from the cabinet is never overridden
+        Send(Save(b, OnlineMatchingMode.OmmClass, true, true, 1794730004, before: 1501f, after: 1530f, obtained: 29f), Config(fallback: true));
+        using (var db = NewContext())
+            Assert.Equal(1530f, db.SoloClassMatchRecordDbSet.Single(x => x.CardId == b.Id).Rate);
+        Assert.Equal(11f, SaveVsmOnResultCommandHandler.ClassRateFallbackDelta(true, 2500));
+        Assert.Equal(-10f, SaveVsmOnResultCommandHandler.ClassRateFallbackDelta(false, 9000));
+    }
+}
diff --git a/WebUIInfinite/Client/Pages/Components/Leaderboard/GlobalLeaderboardsComponent.razor b/WebUIInfinite/Client/Pages/Components/Leaderboard/GlobalLeaderboardsComponent.razor
new file mode 100644
index 0000000..1bbce18
--- /dev/null
+++ b/WebUIInfinite/Client/Pages/Components/Leaderboard/GlobalLeaderboardsComponent.razor
@@ -0,0 +1,122 @@
+@* exvs2-lobbies 2026-11-16: global online leaderboards (Class solo / Class team / Mix) from the matchmaker. *@
+@using System.Net.Http.Json
+@using WebUIInfinite.Client.Services.MS
+@using WebUIInfinite.Shared.Dto.Leaderboard
+@inject HttpClient Http
+@inject IMobileSuitDataService MobileSuitDataService
+
+<MudStack Spacing="2">
+    <MudTabs Outlined="true" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
+             ActivePanelIndexChanged="OnTabChanged">
+        <MudTabPanel Text="@localizer["leaderboard_class_solo"]" />
+        <MudTabPanel Text="@localizer["leaderboard_class_team"]" />
+        <MudTabPanel Text="@localizer["leaderboard_mix"]" />
+    </MudTabs>
+
+    @if (_loading)
+    {
+        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
+    }
+    else if (_page is null || !_page.Available)
+    {
+        <MudAlert Severity="Severity.Info">@(_page?.Message ?? localizer["leaderboard_unavailable"])</MudAlert>
+    }
+    else
+    {
+        <MudText Typo="Typo.caption">
+            @string.Format(localizer["leaderboard_meta"], _page.Ranked, _page.MinMatches)@(string.IsNullOrEmpty(_page.Region) ? "" : " · " + _page.Region)@(_page.UpdatedUtc is { } u ? " · " + u.ToLocalTime().ToString("g") : "")
+        </MudText>
+        <MudTable Items="@_page.Rows" T="GlobalLeaderboardRowDto" Dense="true" Hover="true" Elevation="3" Breakpoint="Breakpoint.Sm">
+            <HeaderContent>
+                <MudTh Style="text-align:center">#</MudTh>
+                <MudTh>@localizer["leaderboard_player"]</MudTh>
+                @if (IsClass)
+                {
+                    <MudTh Style="text-align:center">@localizer["leaderboard_class"]</MudTh>
+                    <MudTh Style="text-align:center">@localizer["leaderboard_rate"]</MudTh>
+                }
+                <MudTh Style="text-align:center">@localizer["card_stats_wins"]</MudTh>
+                <MudTh Style="text-align:center">@localizer["card_stats_losses"]</MudTh>
+                <MudTh Style="text-align:center">@localizer["card_stats_win_rate"]</MudTh>
+                <MudTh Style="text-align:center">@localizer["leaderboard_matches"]</MudTh>
+                <MudTh>@localizer["leaderboard_top_suit"]</MudTh>
+            </HeaderContent>
+            <RowTemplate>
+                <MudTd DataLabel="#" Style="text-align:center">@context.Rank</MudTd>
+                <MudTd DataLabel="@localizer["leaderboard_player"]">@(context.Hidden || string.IsNullOrEmpty(context.Name) ? localizer["leaderboard_hidden_name"] : context.Name)</MudTd>
+                @if (IsClass)
+                {
+                    <MudTd DataLabel="@localizer["leaderboard_class"]" Style="text-align:center">@GlobalLeaderboardDto.ClassName(context.ClassId)@(context.Grade > 0 ? $" {context.Grade}" : "")</MudTd>
+                    <MudTd DataLabel="@localizer["leaderboard_rate"]" Style="text-align:center">@Math.Round(context.Rate)</MudTd>
+                }
+                <MudTd DataLabel="@localizer["card_stats_wins"]" Style="text-align:center">@context.Wins</MudTd>
+                <MudTd DataLabel="@localizer["card_stats_losses"]" Style="text-align:center">@context.Losses</MudTd>
+                <MudTd DataLabel="@localizer["card_stats_win_rate"]" Style="text-align:center">@context.WinRate.ToString("0.0")%</MudTd>
+                <MudTd DataLabel="@localizer["leaderboard_matches"]" Style="text-align:center">@context.Matches</MudTd>
+                <MudTd DataLabel="@localizer["leaderboard_top_suit"]">
+                    @if (context.TopSuitId != 0)
+                    {
+                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
+                            <img src="@($"images/mobile_suits/{context.TopSuitId}.webp")" alt="" style="width:48px" onerror="this.style.display='none'"/>
+                            <span>@SuitName(context.TopSuitId)</span>
+                        </MudStack>
+                    }
+                    else
+                    {
+                        <span>-</span>
+                    }
+                </MudTd>
+            </RowTemplate>
+            <NoRecordsContent>
+                <MudText>@localizer["leaderboard_empty"]</MudText>
+            </NoRecordsContent>
+        </MudTable>
+    }
+</MudStack>
+
+@code {
+    private static readonly string[] Boards = { GlobalLeaderboardDto.ClassSolo, GlobalLeaderboardDto.ClassTeam, GlobalLeaderboardDto.Mix };
+    private string _board = GlobalLeaderboardDto.ClassSolo;
+    private GlobalLeaderboardDto? _page;
+    private bool _loading = true;
+
+    private bool IsClass => _board != GlobalLeaderboardDto.Mix;
+
+    protected override Task OnInitializedAsync() => Load();
+
+    private async Task OnTabChanged(int index)
+    {
+        _board = Boards[Math.Clamp(index, 0, Boards.Length - 1)];
+        await Load();
+    }
+
+    private async Task Load()
+    {
+        _loading = true;
+        StateHasChanged();
+        try
+        {
+            _page = await Http.GetFromJsonAsync<GlobalLeaderboardDto>($"/ui/leaderboard/board/{_board}");
+        }
+        catch (Exception)
+        {
+            _page = null;
+        }
+        _loading = false;
+    }
+
+    private string SuitName(uint id)
+    {
+        var ms = MobileSuitDataService.GetMobileSuitById(id);
+        if (ms is null) return $"#{id}";
+        var name = Thread.CurrentThread.CurrentCulture.Name switch
+        {
+            "ja" => ms.ValueJP,
+            "zh-Hans" => ms.ValueCN,
+            "zh-Hant" => ms.ValueTC,
+            "zh-Hant-TW" => ms.ValueTC2,
+            _ => ms.Value,
+        };
+        return string.IsNullOrWhiteSpace(name) ? ms.Value : name;
+    }
+}
diff --git a/WebUIInfinite/Client/Pages/Components/Leaderboard/LeaderboardVisibilityComponent.razor b/WebUIInfinite/Client/Pages/Components/Leaderboard/LeaderboardVisibilityComponent.razor
