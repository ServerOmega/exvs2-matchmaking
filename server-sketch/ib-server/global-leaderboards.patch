+
+    /// <summary>
+    /// exvs2-lobbies 2026-11-16 (Class rate stuck at +0): send the Infinite Boost class-rate tables in LoadClassMatch
+    /// (initial_rate, grade_thresholds per class / grade, class_change_initial_rate). Upstream fills only the
+    /// OverBoost-era fields, which IB's protocol does not carry (they are ProtoIgnore'd), so the cabinet gets
+    /// initial_rate 0 and no grade table and reports grade 0, rate 1500 -> 1500 (+0) after every Class match.
+    /// EXPERIMENTAL: the table shape is from the exe's protocol descriptor; the cabinet's use of it is not traced.
+    /// false = upstream behaviour.
+    /// </summary>
+    public bool ClassRateTables { get; set; } = true;
+
+    /// <summary>Starting class rate (LoadClassMatch.initial_rate and class_change_initial_rate up / down).</summary>
+    public uint ClassInitialRate { get; set; } = 1500;
+
+    /// <summary>Rate span of one grade in the grade table: grade 10 (lowest) ends at
+    /// <see cref="ClassInitialRate"/> - 4.5 steps, grade 1 (highest) is open-ended. Default 100 puts 1500 in grade 5.</summary>
+    public uint ClassGradeRateStep { get; set; } = 100;
+
+    /// <summary>
+    /// exvs2-lobbies 2026-11-16: if the cabinet still reports a Class result with no rate change (before = after,
+    /// obtained 0), the card server applies its own change: win +ConstantRate * (1 + score / WinScoreCoefficient),
+    /// loss -ConstantRate (the formula in upstream's LoadClassMatch comment; 10 and 25000), clamped at 0.
+    /// Off by default: turn on only if <see cref="ClassRateTables"/> does not make the cabinet move the rate.
+    /// </summary>
+    public bool ClassRateServerFallback { get; set; } = false;
 }
