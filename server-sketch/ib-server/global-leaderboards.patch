+    /// <summary>
+    /// exvs2-lobbies 2026-11-16: the IB-only LoadClassMatch fields (proto fields 3, 4, 9). Upstream never set them, so
+    /// the cabinet saw initial_rate 0 and an empty grade table, and every Class result came back grade 0, +0.
+    /// Grade bands per (team type, class): grade 10 = lowest rates ... grade 1 = highest, <paramref name="step"/> wide,
+    /// centred so <paramref name="initialRate"/> falls in grade 5; grade 10 starts at 0 and grade 1 is open-ended.
+    /// Pilot (class 1) is solo-only, as in the matching pattern table.
+    /// </summary>
+    public static void FillClassRateTables(Response.LoadClassMatch response, uint initialRate, uint step)
+    {
+        step = Math.Max(1, step);
+        initialRate = Math.Max(step * 5, initialRate);
+        response.InitialRate = initialRate;
+        foreach (var teamType in new[] { ClassTeamType.SoloOnlineClass, ClassTeamType.TeamOnlineClass })
+        {
+            for (uint classId = 1; classId <= 4; classId++)
+            {
+                if (teamType == ClassTeamType.TeamOnlineClass && classId == 1) continue;
+                response.class_change_initial_rate.Add(new Response.LoadClassMatch.ClassChangeInitialRate
+                {
+                    TeamType = teamType, ClassId = classId, UpDefaultRate = initialRate, DownDefaultRate = initialRate
+                });
+                foreach (var (grade, min, max) in GradeBands(initialRate, step))
+                {
+                    response.grade_thresholds.Add(new Response.LoadClassMatch.ClassGradeThreshold
+                    {
+                        TeamType = teamType, ClassId = classId, GradeId = grade, MinRate = min, MaxRate = max
+                    });
+                }
+            }
+        }
+    }
+
+    /// <summary>(grade, min, max) for grades 10 -> 1. Grade 5 = [initial - step/2 rounded down to the band, ...].</summary>
+    public static IEnumerable<(uint Grade, uint Min, uint Max)> GradeBands(uint initialRate, uint step)
+    {
+        // band g (10..1) starts at base + (10 - g) * step; base puts initialRate in grade 5
+        var bandStart5 = initialRate - initialRate % step;          // 1500 -> 1500 (step 100)
+        var baseRate = bandStart5 - 5 * step;                        // grade 10 starts here (1000)
+        for (uint g = 10; g >= 1; g--)
+        {
+            var min = g == 10 ? 0u : baseRate + (10 - g) * step;
+            var max = g == 1 ? 99999u : baseRate + (11 - g) * step - 1;
+            yield return (g, min, max);
+        }
+    }
