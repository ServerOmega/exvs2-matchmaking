@@ -0,0 +1,109 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card-server side identity for the global boards: the opaque card key (HMAC-SHA256 of the
+/// local card id with a random per-server salt that never leaves this machine) and the players' "hide my name"
+/// choices. The access code, chip id and session never go into the key or the snapshot.
+/// </summary>
+public sealed class LeaderboardIdentity
+{
+    private readonly object _gate = new();
+    private readonly string? _hiddenPath;
+    private readonly byte[] _salt;
+    private readonly HashSet<int> _hidden = new();
+    private readonly HashSet<int> _shown = new();
+
+    public LeaderboardIdentity(string? saltPath, string? hiddenPath, bool hideByDefault = false)
+    {
+        HideByDefault = hideByDefault;
+        _salt = LoadOrCreateSalt(saltPath);
+        _hiddenPath = string.IsNullOrWhiteSpace(hiddenPath) ? null : hiddenPath;
+        LoadHidden();
+    }
+
+    /// <summary>For tests: a fixed salt, nothing persisted.</summary>
+    public LeaderboardIdentity(byte[] salt, bool hideByDefault = false)
+    {
+        HideByDefault = hideByDefault;
+        _salt = salt.Length >= 16 ? salt : throw new ArgumentException("salt must be at least 16 bytes");
+    }
+
+    public bool HideByDefault { get; }
+
+    /// <summary>32 lowercase hex characters, stable for this server's salt and card id. One-way.</summary>
+    public string KeyFor(int cardId)
+    {
+        using var h = new HMACSHA256(_salt);
+        var mac = h.ComputeHash(Encoding.UTF8.GetBytes("exvs2-leaderboard-card:" + cardId));
+        return Convert.ToHexString(mac, 0, 16).ToLowerInvariant();
+    }
+
+    public bool IsHidden(int cardId)
+    {
+        lock (_gate) return HideByDefault ? !_shown.Contains(cardId) : _hidden.Contains(cardId);
+    }
+
+    public void SetHidden(int cardId, bool hidden)
+    {
+        lock (_gate)
+        {
+            if (hidden) { _hidden.Add(cardId); _shown.Remove(cardId); }
+            else { _hidden.Remove(cardId); _shown.Add(cardId); }
+            SaveHidden();
+        }
+    }
+
+    private static byte[] LoadOrCreateSalt(string? path)
+    {
+        if (!string.IsNullOrWhiteSpace(path) && File.Exists(path))
+        {
+            try
+            {
+                var b = Convert.FromBase64String(File.ReadAllText(path).Trim());
+                if (b.Length >= 16) return b;
+            }
+            catch (FormatException) { }
+        }
+        var salt = RandomNumberGenerator.GetBytes(32);
+        if (!string.IsNullOrWhiteSpace(path))
+        {
+            var dir = Path.GetDirectoryName(path);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+            File.WriteAllText(path, Convert.ToBase64String(salt));
+        }
+        return salt;
+    }
+
+    private sealed class HiddenFile
+    {
+        public List<int> Hidden { get; set; } = new();
+        public List<int> Shown { get; set; } = new();
+    }
+
+    private void LoadHidden()
+    {
+        if (_hiddenPath == null || !File.Exists(_hiddenPath)) return;
+        try
+        {
+            var f = JsonSerializer.Deserialize<HiddenFile>(File.ReadAllText(_hiddenPath));
+            if (f == null) return;
+            foreach (var id in f.Hidden) _hidden.Add(id);
+            foreach (var id in f.Shown) _shown.Add(id);
+        }
+        catch (Exception) { /* unreadable file: start with everyone at the default */ }
+    }
+
+    private void SaveHidden()
+    {
+        if (_hiddenPath == null) return;
+        var dir = Path.GetDirectoryName(_hiddenPath);
+        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+        var tmp = _hiddenPath + ".tmp";
+        File.WriteAllText(tmp, JsonSerializer.Serialize(new HiddenFile { Hidden = _hidden.OrderBy(x => x).ToList(), Shown = _shown.OrderBy(x => x).ToList() }));
+        File.Move(tmp, _hiddenPath, overwrite: true);
+    }
+}
