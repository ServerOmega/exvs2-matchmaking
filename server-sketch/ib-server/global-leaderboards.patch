--- /dev/null
+++ b/Server-Infinite/Matchmaking/LeaderboardStore.cs
@@ -0,0 +1,414 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Text.RegularExpressions;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>[exvs2-lobbies 2026-11-16] Board ids (URL form) and their display names.</summary>
+public static class LeaderboardBoards
+{
+    public const string ClassSolo = "class-solo";
+    public const string ClassTeam = "class-team";
+    public const string Mix = "mix";
+    public static readonly string[] All = { ClassSolo, ClassTeam, Mix };
+
+    public static string? Normalize(string? board)
+    {
+        var b = (board ?? "").Trim().ToLowerInvariant().Replace('_', '-');
+        return b switch
+        {
+            "class-solo" or "classsolo" or "solo" => ClassSolo,
+            "class-team" or "classteam" or "team" => ClassTeam,
+            "mix" or "free" or "freesolo" or "mix-match" => Mix,
+            _ => null,
+        };
+    }
+
+    public static bool IsClass(string board) => board is ClassSolo or ClassTeam;
+}
+
+/// <summary>One card's record on one board, as a card server reports it.</summary>
+public sealed class LeaderboardStats
+{
+    public uint Wins { get; set; }
+    public uint Losses { get; set; }
+    /// <summary>Class boards: 1 Pilot, 2 Valiant, 3 Ace, 4 Extreme (0 = unknown).</summary>
+    public uint ClassId { get; set; }
+    /// <summary>Class boards: grade inside the class (10 -> 1, 0 = not reported).</summary>
+    public uint Grade { get; set; }
+    /// <summary>Class boards: class rate.</summary>
+    public float Rate { get; set; }
+    /// <summary>Most played suit on this board (master suit id, 0 = unknown).</summary>
+    public uint TopSuitId { get; set; }
+
+    [JsonIgnore] public uint Matches => Wins + Losses;
+}
+
+/// <summary>One card in a snapshot. <see cref="Key"/> is an opaque salted hash made by the card server.</summary>
+public sealed class LeaderboardEntryIn
+{
+    public string Key { get; set; } = "";
+    public string Name { get; set; } = "";
+    public bool Hidden { get; set; }
+    public LeaderboardStats? ClassSolo { get; set; }
+    public LeaderboardStats? ClassTeam { get; set; }
+    public LeaderboardStats? Mix { get; set; }
+}
+
+/// <summary>POST /tag/leaderboard/submit body.</summary>
+public sealed class LeaderboardSubmission
+{
+    public int Version { get; set; } = 1;
+    public uint ServerId { get; set; }
+    /// <summary>When the card server built the snapshot (unix ms, its clock). Older or equal = stale, ignored.</summary>
+    public long GeneratedUnixMs { get; set; }
+    /// <summary>Full snapshot: this server's cards not in it are removed.</summary>
+    public bool Full { get; set; } = true;
+    public List<LeaderboardEntryIn> Entries { get; set; } = new();
+}
+
+public sealed class LeaderboardSubmitResult
+{
+    public bool Ok { get; set; }
+    public bool Stale { get; set; }
+    public int Accepted { get; set; }
+    public int Rejected { get; set; }
+    public int Removed { get; set; }
+    public string? Error { get; set; }
+    /// <summary>HTTP status the controller should answer (200 / 400 / 404 / 429 / 507).</summary>
+    [JsonIgnore] public int Status { get; set; } = 200;
+}
+
+/// <summary>A public row: only the name and numbers (never the key or the card server).</summary>
+public sealed class LeaderboardRow
+{
+    public int Rank { get; set; }
+    /// <summary>Player name; null when the player hid it.</summary>
+    public string? Name { get; set; }
+    public bool Hidden { get; set; }
+    public uint ClassId { get; set; }
+    public uint Grade { get; set; }
+    public float Rate { get; set; }
+    public uint Wins { get; set; }
+    public uint Losses { get; set; }
+    public uint Matches { get; set; }
+    /// <summary>Win rate in percent, one decimal.</summary>
+    public double WinRate { get; set; }
+    public uint TopSuitId { get; set; }
+}
+
+public sealed class LeaderboardPage
+{
+    public string Board { get; set; } = "";
+    public string Region { get; set; } = "";
+    public int MinMatches { get; set; }
+    /// <summary>Players that meet <see cref="MinMatches"/> (may exceed the rows returned).</summary>
+    public int Ranked { get; set; }
+    public DateTime? UpdatedUtc { get; set; }
+    public List<LeaderboardRow> Rows { get; set; } = new();
+}
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Global leaderboard store on the matchmaker (the process that owns /tag). Rows are keyed
+/// by (card server id, opaque card key); a card server's newest full snapshot replaces its rows. Stale snapshots are
+/// ignored, sizes and rates are bounded, rows expire when not refreshed. Thread-safe; persisted to a JSON file.
+/// Holds no card secrets (the card server only ever sends a salted hash, a display name and numbers).
+/// </summary>
+public sealed class LeaderboardStore
+{
+    public const int MaxNameLength = TagInviteStore.MaxNameLength;
+    private static readonly Regex KeyFormat = new("^[0-9a-f]{16,64}$", RegexOptions.Compiled);
+    private static readonly JsonSerializerOptions JsonOpts = new() { WriteIndented = false };
+
+    private readonly object _gate = new();
+    private readonly string? _path;
+    private readonly Dictionary<(uint Server, string Key), StoredRow> _rows = new();
+    private readonly Dictionary<uint, ServerState> _servers = new();
+
+    public LeaderboardStore(string? path = null)
+    {
+        _path = string.IsNullOrWhiteSpace(path) ? null : path;
+        Load();
+    }
+
+    public Func<DateTime> UtcNow { get; set; } = () => DateTime.UtcNow;
+    public bool AcceptSubmissions { get; set; } = true;
+    public string Region { get; set; } = "";
+    public int MinMatches { get; set; } = 5;
+    public int MaxRows { get; set; } = 100;
+    public TimeSpan MinSubmitInterval { get; set; } = TimeSpan.FromSeconds(20);
+    public int MaxEntriesPerSubmit { get; set; } = 2000;
+    public int MaxEntriesPerServer { get; set; } = 5000;
+    public int MaxTotalEntries { get; set; } = 100_000;
+    public int MaxServers { get; set; } = 1000;
+    public TimeSpan? EntryTtl { get; set; } = TimeSpan.FromDays(60);
+    public TimeSpan MaxClockSkew { get; set; } = TimeSpan.FromMinutes(10);
+    public TimeSpan MaxSnapshotAge { get; set; } = TimeSpan.FromHours(24);
+    public Action<string>? Log { get; set; }
+
+    public int Count { get { lock (_gate) return _rows.Count; } }
+
+    public LeaderboardSubmitResult Submit(LeaderboardSubmission? s)
+    {
+        if (!AcceptSubmissions) return Fail(404, "leaderboard submissions are off on this matchmaker.");
+        if (s == null) return Fail(400, "empty snapshot.");
+        if (s.ServerId == 0) return Fail(400, "serverId is required.");
+        var entries = s.Entries ?? new List<LeaderboardEntryIn>();
+        if (entries.Count > MaxEntriesPerSubmit) return Fail(400, $"at most {MaxEntriesPerSubmit} cards per snapshot.");
+
+        var now = UtcNow();
+        var nowMs = new DateTimeOffset(DateTime.SpecifyKind(now, DateTimeKind.Utc)).ToUnixTimeMilliseconds();
+        if (s.GeneratedUnixMs <= 0) return Fail(400, "generatedUnixMs is required.");
+        if (s.GeneratedUnixMs > nowMs + (long)MaxClockSkew.TotalMilliseconds)
+            return Fail(400, "snapshot time is in the future (check the card server's clock).");
+
+        lock (_gate)
+        {
+            _servers.TryGetValue(s.ServerId, out var st);
+            if (st == null && _servers.Count >= MaxServers) return Fail(507, "too many card servers on this board.");
+            if (st != null && s.GeneratedUnixMs <= st.LastGeneratedUnixMs)
+                return new LeaderboardSubmitResult { Ok = true, Stale = true };
+            if (s.GeneratedUnixMs < nowMs - (long)MaxSnapshotAge.TotalMilliseconds)
+                return new LeaderboardSubmitResult { Ok = true, Stale = true };
+            if (st != null && st.LastAcceptedUtc.HasValue && now - st.LastAcceptedUtc.Value < MinSubmitInterval)
+                return Fail(429, $"one snapshot per {MinSubmitInterval.TotalSeconds:0} s per card server.");
+
+            st ??= new ServerState { ServerId = s.ServerId };
+            var result = new LeaderboardSubmitResult { Ok = true };
+            var seen = new HashSet<string>(StringComparer.Ordinal);
+            var existingForServer = _rows.Keys.Count(k => k.Server == s.ServerId);
+            foreach (var e in entries)
+            {
+                var key = (e?.Key ?? "").Trim().ToLowerInvariant();
+                if (e == null || !KeyFormat.IsMatch(key) || !seen.Add(key))
+                {
+                    result.Rejected++;
+                    continue;
+                }
+                var rk = (s.ServerId, key);
+                var isNew = !_rows.ContainsKey(rk);
+                if (isNew && (existingForServer >= MaxEntriesPerServer || _rows.Count >= MaxTotalEntries))
+                {
+                    result.Rejected++;
+                    continue;
+                }
+                var row = new StoredRow
+                {
+                    ServerId = s.ServerId,
+                    Key = key,
+                    Name = e.Hidden ? "" : TagInviteStore.CleanName(e.Name),
+                    Hidden = e.Hidden,
+                    ClassSolo = Clean(e.ClassSolo, true),
+                    ClassTeam = Clean(e.ClassTeam, true),
+                    Mix = Clean(e.Mix, false),
+                    UpdatedUtc = now,
+                };
+                _rows[rk] = row;
+                if (isNew) existingForServer++;
+                result.Accepted++;
+            }
+
+            if (s.Full)
+            {
+                foreach (var k in _rows.Keys.Where(k => k.Server == s.ServerId && !seen.Contains(k.Key)).ToList())
+                {
+                    _rows.Remove(k);
+                    result.Removed++;
+                }
+            }
+
+            st.LastGeneratedUnixMs = s.GeneratedUnixMs;
+            st.LastAcceptedUtc = now;
+            _servers[s.ServerId] = st;
+            PruneExpired(now);
+            Persist();
+            Log?.Invoke($"LEADERBOARD submit server={s.ServerId} cards={entries.Count} accepted={result.Accepted} " +
+                        $"rejected={result.Rejected} removed={result.Removed} total={_rows.Count}");
+            return result;
+        }
+    }
+
+    public LeaderboardPage Board(string board, int? limit = null, int? minMatches = null)
+    {
+        var b = LeaderboardBoards.Normalize(board) ?? LeaderboardBoards.Mix;
+        var min = Math.Max(1, minMatches ?? MinMatches);
+        var take = Math.Clamp(limit ?? MaxRows, 1, Math.Max(1, MaxRows));
+        lock (_gate)
+        {
+            PruneExpired(UtcNow());
+            var candidates = _rows.Values
+                .Select(r => (Row: r, Stats: Pick(r, b)))
+                .Where(x => x.Stats != null && x.Stats.Matches >= min)
+                .Select(x => (x.Row, Stats: x.Stats!))
+                .ToList();
+            var ordered = LeaderboardBoards.IsClass(b)
+                ? candidates.OrderByDescending(x => x.Stats.ClassId)
+                    .ThenByDescending(x => x.Stats.Rate)
+                    .ThenByDescending(x => Wilson(x.Stats.Wins, x.Stats.Matches))
+                    .ThenByDescending(x => x.Stats.Matches)
+                : candidates.OrderByDescending(x => Wilson(x.Stats.Wins, x.Stats.Matches))
+                    .ThenByDescending(x => x.Stats.Wins)
+                    .ThenByDescending(x => x.Stats.Matches);
+            var list = ordered.ThenBy(x => x.Row.Name, StringComparer.OrdinalIgnoreCase)
+                .ThenBy(x => x.Row.Key, StringComparer.Ordinal)
+                .ToList();
+            var page = new LeaderboardPage
+            {
+                Board = b,
+                Region = Region ?? "",
+                MinMatches = min,
+                Ranked = list.Count,
+                UpdatedUtc = _rows.Count == 0 ? null : _rows.Values.Max(r => r.UpdatedUtc),
+            };
+            var rank = 0;
+            foreach (var (row, st) in list.Take(take))
+            {
+                rank++;
+                page.Rows.Add(new LeaderboardRow
+                {
+                    Rank = rank,
+                    Name = row.Hidden || string.IsNullOrEmpty(row.Name) ? null : row.Name,
+                    Hidden = row.Hidden,
+                    ClassId = st.ClassId,
+                    Grade = st.Grade,
+                    Rate = MathF.Round(st.Rate, 1),
+                    Wins = st.Wins,
+                    Losses = st.Losses,
+                    Matches = st.Matches,
+                    WinRate = st.Matches == 0 ? 0 : Math.Round(100.0 * st.Wins / st.Matches, 1),
+                    TopSuitId = st.TopSuitId,
+                });
+            }
+            return page;
+        }
+    }
+
+    /// <summary>Lower bound of the 95% Wilson score interval: ranks 9-1 below 45-5 and above 1-0.</summary>
+    public static double Wilson(uint wins, uint matches)
+    {
+        if (matches == 0) return 0;
+        const double z = 1.96;
+        double n = matches, p = wins / n;
+        return (p + z * z / (2 * n) - z * Math.Sqrt((p * (1 - p) + z * z / (4 * n)) / n)) / (1 + z * z / n);
+    }
+
+    private static LeaderboardStats? Pick(StoredRow r, string board) => board switch
+    {
+        LeaderboardBoards.ClassSolo => r.ClassSolo,
+        LeaderboardBoards.ClassTeam => r.ClassTeam,
+        _ => r.Mix,
+    };
+
+    private const uint MaxCount = 10_000_000;
+
+    private static LeaderboardStats? Clean(LeaderboardStats? s, bool classBoard)
+    {
+        if (s == null) return null;
+        var wins = Math.Min(s.Wins, MaxCount);
+        var losses = Math.Min(s.Losses, MaxCount);
+        if (wins + losses == 0) return null;
+        var rate = float.IsFinite(s.Rate) ? Math.Clamp(s.Rate, 0f, 100_000f) : 0f;
+        return new LeaderboardStats
+        {
+            Wins = wins,
+            Losses = losses,
+            ClassId = classBoard && s.ClassId <= 4 ? s.ClassId : 0,
+            Grade = classBoard && s.Grade <= 10 ? s.Grade : 0,
+            Rate = classBoard ? rate : 0,
+            TopSuitId = s.TopSuitId <= 100_000_000 ? s.TopSuitId : 0,
+        };
+    }
+
+    private void PruneExpired(DateTime now)
+    {
+        if (EntryTtl is not { } ttl || ttl <= TimeSpan.Zero) return;
+        foreach (var k in _rows.Where(kv => now - kv.Value.UpdatedUtc > ttl).Select(kv => kv.Key).ToList())
+            _rows.Remove(k);
+    }
+
+    private static LeaderboardSubmitResult Fail(int status, string error) =>
+        new() { Ok = false, Status = status, Error = error };
+
+    // ---------------- persistence ----------------
+
+    private sealed class StoredRow
+    {
+        public uint ServerId { get; set; }
+        public string Key { get; set; } = "";
+        public string Name { get; set; } = "";
+        public bool Hidden { get; set; }
+        public LeaderboardStats? ClassSolo { get; set; }
+        public LeaderboardStats? ClassTeam { get; set; }
+        public LeaderboardStats? Mix { get; set; }
+        public DateTime UpdatedUtc { get; set; }
+    }
+
+    private sealed class ServerState
+    {
+        public uint ServerId { get; set; }
+        public long LastGeneratedUnixMs { get; set; }
+        public DateTime? LastAcceptedUtc { get; set; }
+    }
+
+    private sealed class Snapshot
+    {
+        public int Version { get; set; } = 1;
+        public List<StoredRow> Rows { get; set; } = new();
+        public List<ServerState> Servers { get; set; } = new();
+    }
+
+    private void Load()
+    {
+        if (_path == null || !File.Exists(_path)) return;
+        try
+        {
+            var snap = JsonSerializer.Deserialize<Snapshot>(File.ReadAllText(_path), JsonOpts);
+            if (snap == null) return;
+            foreach (var r in snap.Rows.Where(r => r.ServerId != 0 && KeyFormat.IsMatch(r.Key ?? "")))
+                _rows[(r.ServerId, r.Key)] = r;
+            foreach (var s in snap.Servers.Where(s => s.ServerId != 0))
+                _servers[s.ServerId] = s;
+        }
+        catch (Exception ex)
+        {
+            Log?.Invoke($"LEADERBOARD state file unreadable ({ex.GetType().Name}); starting empty");
+        }
+    }
+
+    private void Persist()
+    {
+        if (_path == null) return;
+        try
+        {
+            var snap = new Snapshot { Rows = _rows.Values.ToList(), Servers = _servers.Values.ToList() };
+            var dir = Path.GetDirectoryName(_path);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+            var tmp = _path + ".tmp";
+            File.WriteAllText(tmp, JsonSerializer.Serialize(snap, JsonOpts));
+            File.Move(tmp, _path, overwrite: true);
+        }
+        catch (Exception ex)
+        {
+            Log?.Invoke($"LEADERBOARD state not saved ({ex.GetType().Name}: {ex.Message})");
+        }
+    }
+}
+
+/// <summary>Card server -> leaderboard store: in-process on an all-in-one server, HTTP (/tag/leaderboard) otherwise.</summary>
+public interface ILeaderboardClient
+{
+    Task<LeaderboardSubmitResult> SubmitAsync(LeaderboardSubmission submission, CancellationToken ct = default);
+    Task<LeaderboardPage> BoardAsync(string board, int? limit = null, CancellationToken ct = default);
+}
+
+public sealed class InProcessLeaderboardClient : ILeaderboardClient
+{
+    private readonly LeaderboardStore _store;
+    public InProcessLeaderboardClient(LeaderboardStore store) => _store = store;
+
+    public Task<LeaderboardSubmitResult> SubmitAsync(LeaderboardSubmission submission, CancellationToken ct = default) =>
+        Task.FromResult(_store.Submit(submission));
+
+    public Task<LeaderboardPage> BoardAsync(string board, int? limit = null, CancellationToken ct = default) =>
+        Task.FromResult(_store.Board(board, limit));
+}
diff --git a/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs b/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs
index 2b94027..81331f5 100644
--- a/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs
+++ b/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs
@@ -26,6 +26,8 @@ public sealed class SecurityGuardMiddleware
     private readonly bool _exemptLoopback;
     private readonly IpRateLimiter _matchLimiter;
     private readonly IpRateLimiter _tagLimiter;
+    private readonly IpRateLimiter _leaderboardLimiter;
+    private readonly bool _publicLeaderboard;
