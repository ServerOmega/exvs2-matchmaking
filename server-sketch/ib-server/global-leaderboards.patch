+using System.Text.Json;
+using Microsoft.AspNetCore.Http.Features;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Controllers;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Global leaderboard API on the matchmaker. Under /tag, so it inherits the /tag shared
+/// secret (X-Tag-Secret), the /tag rate limit and the PublicMatchmaker allowlist. Card servers only.
+/// POST /tag/leaderboard/submit (snapshot), GET /tag/leaderboard/{board}?limit= (rows for the card-server WebUI).
+/// </summary>
+[ApiController]
+[Route("tag/leaderboard")]
+public class LeaderboardTagController : ControllerBase
+{
+    internal static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        MaxDepth = 16,
+    };
+
+    private readonly LeaderboardStore _store;
+    private readonly LeaderboardConfigurations _cfg;
+
+    public LeaderboardTagController(LeaderboardStore store, IOptions<CardServerConfig> options)
+    {
+        _store = store;
+        _cfg = options.Value.Leaderboard;
+    }
+
+    [HttpPost("submit")]
+    public async Task<IActionResult> Submit(CancellationToken ct)
+    {
+        if (!_cfg.Enabled || !_cfg.AcceptSubmissions) return NotFound();
+        var max = Math.Max(1024, _cfg.MaxSubmitBytes);
+        if (Request.ContentLength is { } len && len > max) return TooLarge(max);
+        var feature = HttpContext.Features.Get<IHttpMaxRequestBodySizeFeature>();
+        if (feature is { IsReadOnly: false }) feature.MaxRequestBodySize = max;
+
+        byte[] body;
+        try
+        {
+            body = await ReadLimited(Request.Body, max, ct);
+        }
+        catch (InvalidDataException)
+        {
+            return TooLarge(max);
+        }
+        catch (BadHttpRequestException)
+        {
+            return TooLarge(max);
+        }
+
+        LeaderboardSubmission? submission;
+        try
+        {
+            submission = JsonSerializer.Deserialize<LeaderboardSubmission>(body, Json);
+        }
+        catch (JsonException)
+        {
+            return BadRequest(new { ok = false, error = "snapshot is not valid JSON." });
+        }
+        var r = _store.Submit(submission);
+        return StatusCode(r.Status, r);
+    }
+
+    [HttpGet("{board}")]
+    public IActionResult Board(string board, [FromQuery] int? limit)
+    {
+        if (!_cfg.Enabled) return NotFound();
+        var b = LeaderboardBoards.Normalize(board);
+        if (b == null) return BadRequest(new { error = "board must be class-solo, class-team or mix." });
+        return Ok(_store.Board(b, limit));
+    }
+
+    private ObjectResult TooLarge(int max) =>
+        StatusCode(StatusCodes.Status413PayloadTooLarge, new { ok = false, error = $"snapshot larger than {max} bytes." });
+
+    internal static async Task<byte[]> ReadLimited(Stream s, int max, CancellationToken ct)
+    {
+        using var ms = new MemoryStream();
+        var buf = new byte[16 * 1024];
+        int n;
+        while ((n = await s.ReadAsync(buf, ct)) > 0)
+        {
+            if (ms.Length + n > max) throw new InvalidDataException("too large");
+            ms.Write(buf, 0, n);
+        }
+        return ms.ToArray();
+    }
+}
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Read-only public boards on the matchmaker (Leaderboard.PublicPage): GET /leaderboard
+/// (HTML page with Class solo / Class team / Mix tabs) and GET /leaderboard/data?board=&amp;limit= (JSON rows: rank,
+/// name, class, grade, rate, wins, losses, matches, win rate). Rows never carry card keys or card-server ids.
+/// </summary>
+[ApiController]
+[Route("leaderboard")]
+public class PublicLeaderboardController : ControllerBase
+{
+    private readonly LeaderboardStore _store;
+    private readonly LeaderboardConfigurations _cfg;
+
+    public PublicLeaderboardController(LeaderboardStore store, IOptions<CardServerConfig> options)
+    {
+        _store = store;
+        _cfg = options.Value.Leaderboard;
+    }
+
+    [HttpGet("data")]
+    public IActionResult Data([FromQuery] string? board, [FromQuery] int? limit)
+    {
+        if (!_cfg.Enabled || !_cfg.PublicPage) return NotFound();
+        var b = LeaderboardBoards.Normalize(board ?? LeaderboardBoards.ClassSolo);
+        if (b == null) return BadRequest(new { error = "board must be class-solo, class-team or mix." });
+        Response.Headers.CacheControl = "public, max-age=15";
+        return Ok(_store.Board(b, limit));
+    }
+
+    [HttpGet("")]
+    public IActionResult Page()
+    {
+        if (!_cfg.Enabled || !_cfg.PublicPage) return NotFound();
+        Response.Headers["X-Content-Type-Options"] = "nosniff";
+        Response.Headers["Content-Security-Policy"] = "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'";
+        var region = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(_cfg.RegionName) ? "" : " — " + _cfg.RegionName.Trim());
+        return Content(LeaderboardPageHtml.Render(region), "text/html; charset=utf-8");
+    }
+}
+
+internal static class LeaderboardPageHtml
+{
+    public static string Render(string regionHtml) => """
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>EXVS2 IB leaderboards</title>
+<style>
+body{font-family:system-ui,Segoe UI,Arial,sans-serif;margin:0;background:#14161c;color:#e8e8ea}
+header{padding:16px 20px;background:#1f2330}h1{margin:0;font-size:22px}
+.tabs{display:flex;gap:8px;padding:12px 20px}.tabs button{background:#2a3042;color:#e8e8ea;border:0;padding:8px 14px;border-radius:6px;cursor:pointer}
+.tabs button.on{background:#4a6cf7}main{padding:0 20px 24px}
+table{border-collapse:collapse;width:100%;max-width:980px}th,td{padding:6px 10px;border-bottom:1px solid #2a3042;text-align:center}
+th{color:#aab;font-weight:600}td.n{text-align:left}.muted{color:#889;font-size:13px;margin:8px 0}
+</style></head><body>
+<header><h1>EXVS2 Infinite Boost — online leaderboards__REGION__</h1></header>
+<div class="tabs"><button data-b="class-solo" class="on">Class (solo)</button><button data-b="class-team">Class (team)</button><button data-b="mix">Mix</button></div>
+<main><div class="muted" id="meta"></div><table><thead id="h"></thead><tbody id="rows"></tbody></table></main>
+<script>
+const CLASSES={1:"Pilot",2:"Valiant",3:"Ace",4:"Extreme"};
+let board="class-solo";
+function td(t,cls){const e=document.createElement("td");e.textContent=t;if(cls)e.className=cls;return e;}
+function head(cols){const tr=document.createElement("tr");for(const c of cols){const th=document.createElement("th");th.textContent=c;tr.appendChild(th);}const h=document.getElementById("h");h.replaceChildren(tr);}
+async function load(){
+  const cls=board!=="mix";
+  head(cls?["#","Player","Class","Grade","Rate","Wins","Losses","Win rate","Matches"]:["#","Player","Wins","Losses","Win rate","Matches"]);
+  const body=document.getElementById("rows");body.replaceChildren();
+  let p;try{const r=await fetch("/leaderboard/data?board="+board);p=await r.json();}catch(e){document.getElementById("meta").textContent="Could not load the board.";return;}
+  document.getElementById("meta").textContent=(p.ranked||0)+" ranked players (at least "+p.minMatches+" matches)"+(p.updatedUtc?" · updated "+new Date(p.updatedUtc).toLocaleString():"");
+  for(const r of p.rows||[]){
+    const tr=document.createElement("tr");
+    tr.appendChild(td(r.rank));tr.appendChild(td(r.hidden||!r.name?"(hidden)":r.name,"n"));
+    if(cls){tr.appendChild(td(CLASSES[r.classId]||"-"));tr.appendChild(td(r.grade?r.grade:"-"));tr.appendChild(td(Math.round(r.rate)));}
+    tr.appendChild(td(r.wins));tr.appendChild(td(r.losses));tr.appendChild(td(r.winRate.toFixed(1)+"%"));tr.appendChild(td(r.matches));
+    body.appendChild(tr);
+  }
+  if(!(p.rows||[]).length){const tr=document.createElement("tr");const c=td("Nobody has enough matches on this board yet.");c.colSpan=9;tr.appendChild(c);body.appendChild(tr);}
+}
+for(const b of document.querySelectorAll(".tabs button")){b.onclick=()=>{board=b.dataset.b;for(const o of document.querySelectorAll(".tabs button"))o.classList.toggle("on",o===b);load();};}
+load();
+</script></body></html>
+""".Replace("__REGION__", regionHtml);
+}
