@@ -0,0 +1,62 @@
+@* exvs2-lobbies 2026-11-16: per-card "show my name on the global leaderboards" switch (View Card -> Stats). *@
+@using System.Net.Http.Json
+@using WebUIInfinite.Shared.Dto.Leaderboard
+@inject HttpClient Http
+@inject ISnackbar Snackbar
+
+@if (_state is { Success: true, Enabled: true })
+{
+    <MudPaper Elevation="1" Class="pa-2 mb-4">
+        <MudSwitch T="bool" Value="@(!_state.Hidden)" ValueChanged="OnChanged" Color="Color.Primary" Disabled="@_busy">
+            @localizer["leaderboard_show_name"]
+        </MudSwitch>
+        <MudText Typo="Typo.caption">@localizer["leaderboard_show_name_note"]</MudText>
+    </MudPaper>
+}
+
+@code {
+    [Parameter] public string AccessCode { get; set; } = "";
+    [Parameter] public string ChipId { get; set; } = "";
+
+    private LeaderboardVisibilityResponse? _state;
+    private bool _busy;
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (string.IsNullOrEmpty(AccessCode) || string.IsNullOrEmpty(ChipId) || _state is not null) return;
+        try
+        {
+            var r = await Http.PostAsJsonAsync("/ui/leaderboard/visibility", new LeaderboardVisibilityRequest { AccessCode = AccessCode, ChipId = ChipId });
+            _state = r.IsSuccessStatusCode ? await r.Content.ReadFromJsonAsync<LeaderboardVisibilityResponse>() : null;
+        }
+        catch (Exception)
+        {
+            _state = null;
+        }
+    }
+
+    private async Task OnChanged(bool show)
+    {
+        _busy = true;
+        try
+        {
+            var r = await Http.PostAsJsonAsync("/ui/leaderboard/setVisibility",
+                new LeaderboardVisibilityRequest { AccessCode = AccessCode, ChipId = ChipId, Hidden = !show });
+            var s = r.IsSuccessStatusCode ? await r.Content.ReadFromJsonAsync<LeaderboardVisibilityResponse>() : null;
+            if (s is { Success: true })
+            {
+                _state = s;
+                Snackbar.Add(localizer[show ? "leaderboard_name_shown" : "leaderboard_name_hidden"], Severity.Success);
+            }
+            else
+            {
+                Snackbar.Add(s?.Message ?? "Could not save the setting.", Severity.Error);
+            }
+        }
+        catch (Exception)
+        {
+            Snackbar.Add("Could not save the setting.", Severity.Error);
+        }
+        _busy = false;
+    }
+}
