@@ -0,0 +1,99 @@
+using Microsoft.EntityFrameworkCore;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Builds this card server's leaderboard snapshot from existing tables (no migration):
+/// win/loss record (Class solo / Class team / Mix counters), class records (class, grade, rate) and battle history
+/// (most played suit per board). One entry per card with at least <c>minMatches</c> on any board.
+/// </summary>
+public static class LeaderboardSnapshotBuilder
+{
+    private static readonly string[] ClassSoloModes = { "ClassMatchSolo" };
+    private static readonly string[] ClassTeamModes = { "ClassMatchTeam" };
+    private static readonly string[] MixModes = { "FreeSolo", "FreeTeam" };
+
+    public static async Task<List<LeaderboardEntryIn>> BuildAsync(ServerDbContext db, LeaderboardIdentity identity,
+        int minMatches = 1, CancellationToken ct = default)
+    {
+        minMatches = Math.Max(1, minMatches);
+        var records = await db.WinLossRecordDbSet.AsNoTracking()
+            .Where(w => w.ClassSoloWin + w.ClassSoloLose + w.ClassTeamWin + w.ClassTeamLose + w.FreeWin + w.FreeLose > 0)
+            .Select(w => new
+            {
+                w.CardId, w.ClassSoloWin, w.ClassSoloLose, w.ClassTeamWin, w.ClassTeamLose, w.FreeWin, w.FreeLose,
+            })
+            .ToListAsync(ct);
+        records = records.Where(w => w.ClassSoloWin + w.ClassSoloLose >= minMatches
+                                     || w.ClassTeamWin + w.ClassTeamLose >= minMatches
+                                     || w.FreeWin + w.FreeLose >= minMatches).ToList();
+        if (records.Count == 0) return new List<LeaderboardEntryIn>();
+
+        var ids = records.Select(r => r.CardId).ToHashSet();
+        var names = (await db.CardProfiles.AsNoTracking().Select(c => new { c.Id, c.UserName }).ToListAsync(ct))
+            .Where(c => ids.Contains(c.Id)).ToDictionary(c => c.Id, c => c.UserName);
+        var solo = (await db.SoloClassMatchRecordDbSet.AsNoTracking()
+                .Select(r => new { r.CardId, r.ClassId, r.Grade, r.Rate }).ToListAsync(ct))
+            .Where(r => ids.Contains(r.CardId)).GroupBy(r => r.CardId).ToDictionary(g => g.Key, g => g.First());
+        var team = (await db.TeamClassMatchRecordDbSet.AsNoTracking()
+                .Select(r => new { r.CardId, r.ClassId, r.Grade, r.Rate }).ToListAsync(ct))
+            .Where(r => ids.Contains(r.CardId)).GroupBy(r => r.CardId).ToDictionary(g => g.Key, g => g.First());
+
+        var modes = ClassSoloModes.Concat(ClassTeamModes).Concat(MixModes).ToList();
+        var played = (await db.BattleHistoryDbSet.AsNoTracking()
+                .Where(h => modes.Contains(h.BattleMode))
+                .Select(h => new { h.CardId, h.BattleMode, Suit = h.BattleSelf.MobileSuitId })
+                .ToListAsync(ct))
+            .Where(h => h.Suit != 0 && ids.Contains(h.CardId))
+            .ToList();
+        uint TopSuit(int cardId, string[] boardModes) => played
+            .Where(h => h.CardId == cardId && boardModes.Contains(h.BattleMode))
+            .GroupBy(h => h.Suit)
+            .OrderByDescending(g => g.Count()).ThenBy(g => g.Key)
+            .Select(g => g.Key).FirstOrDefault();
+
+        var list = new List<LeaderboardEntryIn>(records.Count);
+        foreach (var r in records.OrderBy(r => r.CardId))
+        {
+            var hidden = identity.IsHidden(r.CardId);
+            var e = new LeaderboardEntryIn
+            {
+                Key = identity.KeyFor(r.CardId),
+                Name = hidden ? "" : TagInviteStore.CleanName(names.GetValueOrDefault(r.CardId)),
+                Hidden = hidden,
+            };
+            if (r.ClassSoloWin + r.ClassSoloLose > 0)
+            {
+                var c = solo.GetValueOrDefault(r.CardId);
+                e.ClassSolo = new LeaderboardStats
+                {
+                    Wins = r.ClassSoloWin, Losses = r.ClassSoloLose,
+                    ClassId = c?.ClassId ?? 0, Grade = c?.Grade ?? 0, Rate = c?.Rate ?? 0,
+                    TopSuitId = TopSuit(r.CardId, ClassSoloModes),
+                };
+            }
+            if (r.ClassTeamWin + r.ClassTeamLose > 0)
+            {
+                var c = team.GetValueOrDefault(r.CardId);
+                e.ClassTeam = new LeaderboardStats
+                {
+                    Wins = r.ClassTeamWin, Losses = r.ClassTeamLose,
+                    ClassId = c?.ClassId ?? 0, Grade = c?.Grade ?? 0, Rate = c?.Rate ?? 0,
+                    TopSuitId = TopSuit(r.CardId, ClassTeamModes),
+                };
+            }
+            if (r.FreeWin + r.FreeLose > 0)
+            {
+                e.Mix = new LeaderboardStats
+                {
+                    Wins = r.FreeWin, Losses = r.FreeLose,
+                    TopSuitId = TopSuit(r.CardId, MixModes),
+                };
+            }
+            list.Add(e);
+        }
+        return list;
+    }
+}
diff --git a/Server-Infinite/Leaderboards/LeaderboardSubmitter.cs b/Server-Infinite/Leaderboards/LeaderboardSubmitter.cs
