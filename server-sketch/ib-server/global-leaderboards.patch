@@ -0,0 +1,90 @@
+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Global leaderboards (Class solo, Class team, Mix). Card servers send a snapshot of
+/// their cards' online records to the shared matchmaker's /tag API (same X-Tag-Secret, rate limit and allowlist as
+/// online tag / friends); the matchmaker keeps one board per region (one matchmaker = one region) and serves it to
+/// card servers (/tag/leaderboard) and, if <see cref="PublicPage"/>, to anyone (/leaderboard).
+/// No card secret ever leaves the card server: each card is sent as an opaque salted hash, a name and numbers.
+/// See ONLINE_MATCHMAKING.md "Global leaderboards".
+/// </summary>
+public class LeaderboardConfigurations
+{
+    /// <summary>Master switch on both sides. false: no snapshots are sent, /tag/leaderboard and /leaderboard answer 404,
+    /// and the WebUI hides the Leaderboards section.</summary>
+    public bool Enabled { get; set; } = true;
+
+    // ---------------- card-server side ----------------
+
+    /// <summary>Card server: send snapshots to the matchmaker (periodically and soon after each saved online result).</summary>
+    public bool SubmitEnabled { get; set; } = true;
+
+    /// <summary>Card server: full snapshot every this many minutes (min 1).</summary>
+    public double SubmitIntervalMinutes { get; set; } = 10;
+
+    /// <summary>Card server: after a saved online Class / Mix result, send a snapshot this many seconds later
+    /// (results of one match are batched). 0 = only the periodic snapshot.</summary>
+    public double SubmitAfterResultSeconds { get; set; } = 15;
+
+    /// <summary>Card server: a card is sent once it has at least this many matches on any board.</summary>
+    public int SubmitMinMatches { get; set; } = 1;
+
+    /// <summary>Card server: random per-server salt for the card hash (created on first use, keep it with the DB).</summary>
+    public string SaltFile { get; set; } = "leaderboard_salt.txt";
+
+    /// <summary>Card server: cards whose players chose to hide their name on the boards.</summary>
+    public string HiddenFile { get; set; } = "leaderboard_hidden.json";
+
+    /// <summary>Card server: hide every name unless the player opts in (Stats tab). false = names shown unless hidden.</summary>
+    public bool HideNamesByDefault { get; set; } = false;
+
+    /// <summary>Card server: the WebUI's board reply is cached this many seconds.</summary>
+    public int ViewCacheSeconds { get; set; } = 30;
+
+    // ---------------- matchmaker side (the process that owns /tag) ----------------
+
+    /// <summary>Matchmaker: accept snapshots from card servers.</summary>
+    public bool AcceptSubmissions { get; set; } = true;
+
+    /// <summary>Matchmaker: JSON file with the stored rows.</summary>
+    public string StateFile { get; set; } = "leaderboard.json";
+
+    /// <summary>Region label shown on the boards (for example "Los Angeles" or "Europe"). Empty = none.</summary>
+    public string RegionName { get; set; } = "";
+
+    /// <summary>Matchmaker: a player is listed on a board after this many matches on it.</summary>
+    public int MinMatches { get; set; } = 5;
+
+    /// <summary>Matchmaker: most rows a board reply returns (also caps ?limit=).</summary>
+    public int MaxRows { get; set; } = 100;
+
+    /// <summary>Matchmaker: one snapshot per card server every this many seconds; faster ones get 429.</summary>
+    public int MinSubmitIntervalSeconds { get; set; } = 20;
+
+    /// <summary>Matchmaker: largest snapshot body in bytes (413 above it).</summary>
+    public int MaxSubmitBytes { get; set; } = 512 * 1024;
+
+    /// <summary>Matchmaker: most cards in one snapshot.</summary>
+    public int MaxEntriesPerSubmit { get; set; } = 2000;
+
+    /// <summary>Matchmaker: most stored cards per card server and in total, and most card servers.</summary>
+    public int MaxEntriesPerServer { get; set; } = 5000;
+    public int MaxTotalEntries { get; set; } = 100_000;
+    public int MaxServers { get; set; } = 1000;
+
+    /// <summary>Matchmaker: rows not refreshed for this many days are dropped (0 = never).</summary>
+    public double EntryExpiryDays { get; set; } = 60;
+
+    /// <summary>Matchmaker: snapshots stamped more than this many minutes in the future are refused, and snapshots
+    /// older than <see cref="MaxSnapshotAgeHours"/> are ignored as stale.</summary>
+    public double MaxClockSkewMinutes { get; set; } = 10;
+    public double MaxSnapshotAgeHours { get; set; } = 24;
+
+    /// <summary>Matchmaker: serve the read-only page /leaderboard and its JSON /leaderboard/data to anyone (also from
+    /// the internet when Security.AccessMode is PublicMatchmaker). false = boards only via /tag (card servers).</summary>
+    public bool PublicPage { get; set; } = true;
+
+    /// <summary>Matchmaker: per source IP token bucket for /leaderboard (0 = off).</summary>
+    public int PublicRequestsPerMinute { get; set; } = 60;
+    public int PublicBurst { get; set; } = 20;
+}
