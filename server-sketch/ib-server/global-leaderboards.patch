@@ -0,0 +1,59 @@
+namespace WebUIInfinite.Shared.Dto.Leaderboard;
+
+/// <summary>exvs2-lobbies 2026-11-16: global Class / Mix boards as the card-server WebUI shows them.</summary>
+public class GlobalLeaderboardDto
+{
+    public const string ClassSolo = "class-solo";
+    public const string ClassTeam = "class-team";
+    public const string Mix = "mix";
+
+    /// <summary>false: boards are off on this card server, or the matchmaker could not be reached (see Message).</summary>
+    public bool Available { get; set; }
+    public string? Message { get; set; }
+    public string Board { get; set; } = ClassSolo;
+    public string Region { get; set; } = "";
+    public int MinMatches { get; set; }
+    public int Ranked { get; set; }
+    public DateTime? UpdatedUtc { get; set; }
+    public List<GlobalLeaderboardRowDto> Rows { get; set; } = new();
+
+    public static string ClassName(uint classId) => classId switch
+    {
+        1 => "Pilot",
+        2 => "Valiant",
+        3 => "Ace",
+        4 => "Extreme",
+        _ => "-",
+    };
+}
+
+public class GlobalLeaderboardRowDto
+{
+    public int Rank { get; set; }
+    public string? Name { get; set; }
+    public bool Hidden { get; set; }
+    public uint ClassId { get; set; }
+    public uint Grade { get; set; }
+    public float Rate { get; set; }
+    public uint Wins { get; set; }
+    public uint Losses { get; set; }
+    public uint Matches { get; set; }
+    public double WinRate { get; set; }
+    public uint TopSuitId { get; set; }
+}
+
+public class LeaderboardVisibilityRequest
+{
+    public string AccessCode { get; set; } = "";
+    public string ChipId { get; set; } = "";
+    /// <summary>Only for setVisibility.</summary>
+    public bool Hidden { get; set; }
+}
+
+public class LeaderboardVisibilityResponse
+{
+    public bool Success { get; set; }
+    public bool Enabled { get; set; }
+    public bool Hidden { get; set; }
+    public string? Message { get; set; }
+}
