+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// no-CPU 1v1 (2026-11-14): every results hang was 2 humans + 2 game-made CPU seats in a 2v2-rule room; the
+// one 4-human 2v2 cleared results. Fes 1on1 (code 0x13 -> world 20) is the game's own 1v1 rule with no CPUs.
+public class OneOnOneTests
+{
+    private uint _node = 7000;
+
+    private Request.EntryMatching Entry(uint world, bool team = false, long attr2 = 0)
+    {
+        var me = ++_node;
+        Client Cl(uint n) { var c = new Client { NodeId = n, PcbSerial = $"P{n}", LocId = $"L{me}", PrefCode = 13,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent };
+            c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" }); return c; }
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(me), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = attr2 });
+        if (team) e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(++_node), Player = new Player { BanapassportAmId = 9000 + me } });
+        return e;
+    }
+
+    private static Matchmaker New() => new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1) { StaleAfter = 1e6 };
+
+    [Fact]
+    public void TwoSolosMatchImmediatelyAsTwoClientRoom()
+    {
+        var mm = New();
+        var a = Entry(20); var b = Entry(20);
+        mm.Entry(a, 0); mm.Entry(b, 5);
+        var room = mm.Check(a.Myclient.NodeId, 5).Room!;
+        Assert.Equal(2, room.Clients.Count);
+        Assert.Equal(2, room.Humans);
+        Assert.Equal(a.Myclient.NodeId, room.Clients[0].Client.NodeId);
+        Assert.Equal(0u, room.Clients[0].GroupId);
+        Assert.Equal(b.Myclient.NodeId, room.Clients[1].Client.NodeId);
+        Assert.Equal(1u, room.Clients[1].GroupId);
+        Assert.All(room.Clients, c => Assert.True(Matchmaker.Unit.IsHuman(c.Client)));
+        Assert.Same(room, mm.Check(b.Myclient.NodeId, 5).Room);
+    }
+
+    [Fact]
+    public void FourSolosBecomeTwo1v1sNeverA2v2()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 4).Select(_ => Entry(20)).ToList();
+        foreach (var e in es) mm.Entry(e, 0);
+        var rooms = es.Select(e => mm.Check(e.Myclient.NodeId, 0).Room).Distinct().ToList();
+        Assert.Equal(2, rooms.Count);
+        Assert.All(rooms, r => Assert.Equal(2, r!.Clients.Count));
+    }
+
+    [Fact]
+    public void LoneSoloNeverGetsAPartialOrCpuRoom()
+    {
+        var mm = New();
+        mm.CpuStandIns = true;   // even with stand-ins on, a 1on1 world gets none
+        var a = Entry(20);
+        mm.Entry(a, 0);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 120).Room);
+        var b = Entry(20);
+        mm.Entry(b, 121);
+        var room = mm.Check(a.Myclient.NodeId, 121).Room!;
+        Assert.Equal(2, room.Clients.Count);
+        Assert.DoesNotContain(room.Clients, c => c.Client.PcbSerial == Matchmaker.NpcSerial);
+    }
+
+    [Fact]
+    public void TeamEntryIsRefusedIn1on1World()
+    {
+        var mm = New();
+        Assert.Equal(ErrorCode.ErrMatchCondition, mm.Entry(Entry(20, team: true), 0));
+    }
+
+    [Fact]
+    public void OtherWorldsUnchanged_TwoSolosWaitForFill()
+    {
+        var mm = New();
+        var a = Entry(23); var b = Entry(23);
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 10).Room);
+        Assert.NotNull(mm.Check(a.Myclient.NodeId, 31).Room);
+    }
+
+    [Fact]
+    public void EmptyOneOnOneWorlds_World20BehavesLikeA2v2World()
+    {
+        var mm = New(); mm.OneOnOneWorlds = Matchmaker.ParseWorlds("");
+        var a = Entry(20); var b = Entry(20);
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 10).Room);
+    }
+
+    [Theory]
+    [InlineData("20", new uint[] { 20 })]
+    [InlineData("20, 30;x", new uint[] { 20, 30 })]
+    [InlineData("", new uint[0])]
+    [InlineData(null, new uint[0])]
+    public void ParseWorlds(string? s, uint[] expected) =>
+        Assert.Equal(expected.OrderBy(x => x), Matchmaker.ParseWorlds(s).OrderBy(x => x));
+}
