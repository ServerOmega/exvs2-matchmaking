+    /// <summary>1on1 worlds: two clients, the earlier searcher in group 0, the other in group 1 (same order for both).</summary>
+    private void MakeOneOnOneRoom(Unit a, Unit b, double now)
+    {
+        var ordered = new[] { a, b }.OrderBy(u => u.Created).ThenBy(u => u.LeaderNode).ToList();
+        var room = new Room
+        {
+            RoomId = _nextRoom++, At = now, World = a.World, Humans = 2,
+            Clients = new List<RoomClient> { new(0, ordered[0].Clients[0]), new(1, ordered[1].Clients[0]) },
+        };
+        foreach (var u in ordered)
+        {
+            _queue.Remove(u);
+            u.Room = room;
+            RememberRoom(u, room);
+        }
+        Log?.Invoke($"MATCH room={room.RoomId} {a.WorldName} 1on1 S[{ordered[0].LeaderNode}] vs S[{ordered[1].LeaderNode}] " +
+                    "(humans=2/2, no CPU seats)");
+        var src = new Dictionary<uint, string>();
+        foreach (var u in ordered) foreach (var kv in u.SourceByNode) src[kv.Key] = kv.Value;
+        Log?.Invoke(NetDiag.MatchLine(room.RoomId, room.Clients.Select(c => (c.GroupId, c.Client)), src, Realms));
+    }
