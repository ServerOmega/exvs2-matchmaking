--- /dev/null
+++ b/Tests/Matchmaking.Tests/ResultGapTraceTests.cs
@@ -0,0 +1,77 @@
+using nue.protocol.exvs;
+using ServerInfinite.Lobbies;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// results-hang timing (2026-11-14): logging only.
+public class ResultGapTraceTests
+{
+    private const string Cab = "28951428XXXG", Lm = "289511281397";
+
+    [Fact]
+    public void ReplayOfTheHungMatchOn20261114()
+    {
+        // 10:00:47 SaveVsmOnResult, then only the LM's LoadRanking polls every 10 s
+        var t = new ResultGapTrace();
+        var start = t.Observe(MethodType.MthdSaveVsmOnResult, Cab, 0);
+        Assert.Equal(new[] { "RESULT-SAVE pcb=…XXXG MthdSaveVsmOnResult (results screen clock started)" }, start);
+        var lines = new List<string>();
+        for (var s = 10; s <= 130; s += 10) lines.AddRange(t.Observe(MethodType.MthdLoadRanking, Lm, s));
+        Assert.Equal(new[]
+        {
+            "RESULT-WAIT pcb=…XXXG MthdSaveVsmOnResult answered, no request from this cabinet for 30s",
+            "RESULT-WAIT pcb=…XXXG MthdSaveVsmOnResult answered, no request from this cabinet for 60s",
+            "RESULT-WAIT pcb=…XXXG MthdSaveVsmOnResult answered, no request from this cabinet for 120s"
+        }, lines);
+        var end = t.Observe(MethodType.MthdSaveUserPlayResearchData, Cab, 185.2);
+        Assert.Equal(new[] { "RESULT-GAP pcb=…XXXG MthdSaveVsmOnResult -> next MthdSaveUserPlayResearchData after 185.2s" }, end);
+        Assert.Empty(t.Observe(MethodType.MthdLoadRanking, Lm, 1000));   // closed
+    }
+
+    [Fact]
+    public void RetryIsCountedAndShownInTheGap()
+    {
+        var t = new ResultGapTrace();
+        t.Observe(MethodType.MthdSaveVsmOnResult, Cab, 0);
+        Assert.Equal(new[] { "RESULT-SAVE pcb=…XXXG MthdSaveVsmOnResult retry #2 +10.0s" },
+            t.Observe(MethodType.MthdSaveVsmOnResult, Cab, 10));
+        Assert.Equal(new[] { "RESULT-GAP pcb=…XXXG MthdSaveVsmOnResult -> next MthdLoadCard after 12.0s (save sent 2x)" },
+            t.Observe(MethodType.MthdLoadCard, Cab, 12));
+    }
+
+    [Fact]
+    public void NoClockWithoutAResultSaveAndOffWhenDisabled()
+    {
+        var t = new ResultGapTrace();
+        Assert.Empty(t.Observe(MethodType.MthdLoadCard, Cab, 0));
+        Assert.Empty(t.Observe(MethodType.MthdLoadRanking, Lm, 500));
+        var off = new ResultGapTrace { Enabled = false };
+        Assert.Empty(off.Observe(MethodType.MthdSaveVsmOnResult, Cab, 0));
+        Assert.Empty(off.Observe(MethodType.MthdLoadRanking, Lm, 100));
+    }
+
+    [Fact]
+    public void TwoCabinetsAreTimedSeparately()
+    {
+        var t = new ResultGapTrace();
+        t.Observe(MethodType.MthdSaveVsmOnResult, "AAAAAAAA0001", 0);
+        t.Observe(MethodType.MthdSaveVsmOnResult, "AAAAAAAA0002", 0.5);
+        var l = t.Observe(MethodType.MthdLoadRanking, Lm, 31);
+        Assert.Equal(2, l.Count);
+        Assert.Contains("pcb=…0001", l[0] + l[1]);
+        Assert.Contains("pcb=…0002", l[0] + l[1]);
+        Assert.Equal(new[] { "RESULT-GAP pcb=…0002 MthdSaveVsmOnResult -> next MthdPing after 39.5s" },
+            t.Observe(MethodType.MthdPing, "AAAAAAAA0002", 40));
+        Assert.Single(t.Observe(MethodType.MthdLoadRanking, Lm, 61));       // only 0001 still open
+    }
+
+    [Fact]
+    public void ShortSerialAndEmptySerial()
+    {
+        Assert.Equal("-", ResultGapTrace.Short(null));
+        Assert.Equal("ab", ResultGapTrace.Short("ab"));
+        Assert.Equal("…7890", ResultGapTrace.Short("1234567890"));
+        Assert.Empty(new ResultGapTrace().Observe(MethodType.MthdSaveVsmOnResult, "", 0));
+    }
+}
