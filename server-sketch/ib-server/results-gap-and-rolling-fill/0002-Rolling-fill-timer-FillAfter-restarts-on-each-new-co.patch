+    /// <summary>Parse OnlineMatching.FillTimerMode. Unrecognized or empty values become Rolling.</summary>
+    public static FillTimerMode ParseFillTimerMode(string? s)
+    {
+        if (string.IsNullOrWhiteSpace(s)) return FillTimerMode.Rolling;
+        if (s.Equals("FromFirst", StringComparison.OrdinalIgnoreCase)) return FillTimerMode.FromFirst;
+        return FillTimerMode.Rolling;
+    }
+
+    /// <summary>
+    /// Whether a short-handed room may form for this compatible set ({<paramref name="a"/>} + <paramref name="pool"/>).
+    /// Rolling: FillAfter since the most recent join, or MaxFillWait since the first join (if MaxFillWait &gt; 0).
+    /// FromFirst: FillAfter since the anchor <paramref name="a"/>, or the same MaxFillWait cap.
+    /// </summary>
+    private bool ReadyForPartial(Unit a, List<Unit> pool, double now)
+    {
+        if (!AllowPartial) return false;
+        var first = a.Created;
+        var last = a.Created;
+        foreach (var u in pool)
+        {
+            if (u.Created < first) first = u.Created;
+            if (u.Created > last) last = u.Created;
+        }
+        if (MaxFillWait > 0 && now - first >= MaxFillWait) return true;
+        if (FillTimerMode == FillTimerMode.FromFirst)
+            return now - a.Created >= FillAfter;
+        return now - last >= FillAfter;
+    }
+
