+namespace ServerInfinite.Matchmaking;
+
+/// <summary>How the short-handed-room fill timer is measured. See <see cref="Matchmaker.FillTimerMode"/>.</summary>
+public enum FillTimerMode
+{
+    /// <summary>FillAfterSeconds restarts each time a new compatible searcher joins the queue.</summary>
+    Rolling = 0,
+    /// <summary>FillAfterSeconds is measured from the oldest waiter (pre-v8 behaviour).</summary>
+    FromFirst = 1,
+}
