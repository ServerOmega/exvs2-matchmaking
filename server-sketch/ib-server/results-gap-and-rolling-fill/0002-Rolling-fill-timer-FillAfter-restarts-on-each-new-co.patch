diff --git a/Tests/Matchmaking.Tests/FillTimerTests.cs b/Tests/Matchmaking.Tests/FillTimerTests.cs
new file mode 100644
index 0000000..146efda
--- /dev/null
+++ b/Tests/Matchmaking.Tests/FillTimerTests.cs
@@ -0,0 +1,195 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// Rolling fill timer (v8): FillAfter restarts on each new compatible joiner, with a MaxFillWait cap
+// from the first searcher. Tonight's 4-cab Class Solo (2026-11-14) joined at t=0, 24, 30.5, 42 and
+// split into two 1v1s under FromFirst; Rolling should have made one shuffled 2v2.
+public class FillTimerTests
+{
+    private uint _node = 2000;
+
+    private static Client Cl(uint node, bool human = true, string loc = "LOC1")
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = human ? $"P{node}" : Matchmaker.NpcSerial, LocId = loc, PrefCode = 13,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = human ? "Y" : "N" });
+        return c;
+    }
+
+    private Request.EntryMatching Entry(uint world, string sortie = "S", long attr2 = 0, long level = 0)
+    {
+        var me = ++_node;
+        var loc = $"L{me}";
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(me, true, loc), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = attr2 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = level });
+        if (sortie == "T")
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(++_node, true, loc), Player = new Player { BanapassportAmId = 9000 + me } });
+        return e;
+    }
+
+    // Class Solo, same class/level as tonight's cabins (world 13, attr2=1, level=3).
+    private Request.EntryMatching ClassSolo() => Entry(13, "S", attr2: 1, level: 3);
+
+    private static Matchmaker Rolling(double fillAfter = 30, double maxFillWait = 90) =>
+        new(fillAfter: fillAfter, allowPartial: true, softWait: 15, seed: 1,
+            fillTimerMode: FillTimerMode.Rolling, maxFillWait: maxFillWait) { StaleAfter = 1e6 };
+
+    private static Matchmaker FromFirst(double fillAfter = 30, double maxFillWait = 90) =>
+        new(fillAfter: fillAfter, allowPartial: true, softWait: 15, seed: 1,
+            fillTimerMode: FillTimerMode.FromFirst, maxFillWait: maxFillWait) { StaleAfter = 1e6 };
+
+    [Fact]
+    public void TonightTimeline_RollingMakesOneFourPlayerRoom()
+    {
+        // Joins at t=0, 24, 30.5, 42 (FillAfter=30). FromFirst formed a 1v1 at t=30;
+        // Rolling keeps waiting and shuffles all four into one 2v2 when the fourth arrives.
+        var mm = Rolling();
+        var a = ClassSolo(); var b = ClassSolo(); var c = ClassSolo(); var d = ClassSolo();
+        mm.Entry(a, 0);
+        mm.Entry(b, 24);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 30).Room);
+        mm.Entry(c, 30.5);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 31).Room);
+        mm.Entry(d, 42);
+        var room = mm.Check(a.Myclient.NodeId, 42).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        Assert.Equal(4, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+        Assert.Equal(2, room.Clients.Count(x => x.GroupId == 0));
+        Assert.Equal(2, room.Clients.Count(x => x.GroupId == 1));
+        foreach (var e in new[] { a, b, c, d })
+            Assert.Same(room, mm.Check(e.Myclient.NodeId, 42).Room);
+    }
+
+    [Fact]
+    public void Rolling_TwoSearchers_NoRoomAtFillAfterFromFirst()
+    {
+        var mm = Rolling();
+        var a = ClassSolo(); var b = ClassSolo();
+        mm.Entry(a, 0);
+        mm.Entry(b, 24);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 30).Room);
+    }
+
+    [Fact]
+    public void FromFirst_TwoSearchers_FormsPartialAtFillAfterFromOldest()
+    {
+        var mm = FromFirst();
+        var a = ClassSolo(); var b = ClassSolo();
+        mm.Entry(a, 0);
+        mm.Entry(b, 24);
+        var room = mm.Check(a.Myclient.NodeId, 30).Room!;
+        Assert.Equal(2, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void Rolling_SecondJoinsAt20_NoRoomAt30_RoomAt50()
+    {
+        var mm = Rolling();
+        var a = Entry(23); var b = Entry(23);
+        mm.Entry(a, 0);
+        mm.Entry(b, 20);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 30).Room);
+        var room = mm.Check(a.Myclient.NodeId, 50).Room!;
+        Assert.Equal(2, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void Rolling_ThreeJoinsEvery25s_PartialAt80NotBefore()
+    {
+        // Three solos join every 25s (t=0, 25, 50). A fourth never arrives, so no full 2v2.
+        // Rolling is due 30s after the last join (t=80). A 4th cabinet at t=75 would have
+        // filled a 2v2 immediately instead.
+        var mm = Rolling(fillAfter: 30, maxFillWait: 90);
+        var a = Entry(23); var b = Entry(23); var c = Entry(23);
+        mm.Entry(a, 0);
+        mm.Entry(b, 25);
+        mm.Entry(c, 50);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 79).Room);
+        var room = mm.Check(a.Myclient.NodeId, 80).Room!;
+        Assert.Equal(3, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void MaxFillWait_PartialAllowedAt90FromFirstWhenRollingWouldWaitLonger()
+    {
+        // Joins at 0, 25, 70 (every-25s-style late third). Rolling due at 100; cap at 90.
+        var mm = Rolling(fillAfter: 30, maxFillWait: 90);
+        var a = Entry(23); var b = Entry(23); var c = Entry(23);
+        mm.Entry(a, 0);
+        mm.Entry(b, 25);
+        mm.Entry(c, 70);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 89).Room);
+        var room = mm.Check(a.Myclient.NodeId, 90).Room!;
+        Assert.Equal(3, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void MaxFillWait_ZeroMeansNoCap()
+    {
+        var mm = Rolling(fillAfter: 30, maxFillWait: 0);
+        var a = Entry(23); var b = Entry(23); var c = Entry(23);
+        mm.Entry(a, 0);
+        mm.Entry(b, 25);
+        mm.Entry(c, 70);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 90).Room);
+        var room = mm.Check(a.Myclient.NodeId, 100).Room!;
+        Assert.Equal(3, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void FourCompatibleSolosStillShuffleImmediatelyIntoOne2v2()
+    {
+        var mm = Rolling();
+        var es = Enumerable.Range(0, 4).Select(_ => ClassSolo()).ToList();
+        foreach (var e in es) mm.Entry(e, 0);
+        var room = mm.Check(es[0].Myclient.NodeId, 1).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        Assert.Equal(2, room.Clients.Count(x => x.GroupId == 0));
+        foreach (var e in es) Assert.Same(room, mm.Check(e.Myclient.NodeId, 1).Room);
+    }
+
+    [Fact]
+    public void PreFormedPairsStayTogetherEvenWhenTheyArriveStaggered()
+    {
+        var mm = Rolling();
+        var teamA = Entry(14, "T", attr2: 1, level: 3);
+        var teamB = Entry(14, "T", attr2: 1, level: 3);
+        mm.Entry(teamA, 0);
+        mm.Entry(teamB, 40);
+        var room = mm.Check(teamA.Myclient.NodeId, 40).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        var gA = room.Clients.First(c => c.Client.NodeId == teamA.Myclient.NodeId).GroupId;
+        var gAPartner = room.Clients.First(c => c.Client.NodeId == teamA.Groups[0].Client.NodeId).GroupId;
+        var gB = room.Clients.First(c => c.Client.NodeId == teamB.Myclient.NodeId).GroupId;
+        var gBPartner = room.Clients.First(c => c.Client.NodeId == teamB.Groups[0].Client.NodeId).GroupId;
+        Assert.Equal(gA, gAPartner);
+        Assert.Equal(gB, gBPartner);
+        Assert.NotEqual(gA, gB);
+    }
+
+    [Theory]
+    [InlineData(null, FillTimerMode.Rolling)]
+    [InlineData("", FillTimerMode.Rolling)]
+    [InlineData("Rolling", FillTimerMode.Rolling)]
+    [InlineData("rolling", FillTimerMode.Rolling)]
+    [InlineData("FromFirst", FillTimerMode.FromFirst)]
+    [InlineData("fromfirst", FillTimerMode.FromFirst)]
+    [InlineData("nope", FillTimerMode.Rolling)]
+    public void ParseFillTimerMode(string? value, FillTimerMode expected)
+    {
+        Assert.Equal(expected, Matchmaker.ParseFillTimerMode(value));
+    }
+}
