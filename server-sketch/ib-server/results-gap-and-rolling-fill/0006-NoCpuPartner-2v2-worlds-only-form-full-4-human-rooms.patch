+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// NoCpuPartner (2026-11-15, 3-cab test 02:18): a cabinet whose partner is a CPU hangs on the results screen. In
+// 2v2-rule worlds only full 4-human rooms may form; 1on1 (Fes) worlds keep their 2-client rooms. Fake entries only.
+public class NoCpuPartnerTests
+{
+    private uint _node = 8000;
+
+    private static Client Cl(uint node, bool human = true)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = human ? $"P{node}" : Matchmaker.NpcSerial, LocId = $"L{node}", PrefCode = 13,
+            GlobalIpaddress = "203.0.113.1", NatMappingType = NatMappingType.NmEndpointIndependent,
+            NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = human ? "Y" : "N" });
+        return c;
+    }
+
+    private Request.EntryMatching Entry(uint world = 23, bool team = false, bool cpuPartner = false)
+    {
+        var me = _node += 2;
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(me), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        if (team || cpuPartner)
+            e.Groups.Add(new Request.EntryMatching.Group
+            {
+                Client = Cl(me + 1, !cpuPartner), Player = new Player { BanapassportAmId = cpuPartner ? 0 : me + 1 }
+            });
+        return e;
+    }
+
+    private static Matchmaker New(bool on = true, List<string>? log = null) =>
+        new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, MaxFillWait = 90, InStoreFillAfter = 60, InStoreMaxFillWait = 120,
+            NoCpuPartner = on, Log = log == null ? null : log.Add,
+        };
+
+    private static Matchmaker.Room? RoomAt(Matchmaker mm, Request.EntryMatching e, double t) => mm.Check(e.Myclient.NodeId, t).Room;
+
+    /// <summary>Every client human, each side exactly 2 humans.</summary>
+    private static void AssertFourHumans(Matchmaker.Room r)
+    {
+        Assert.Equal(4, r.Clients.Count);
+        Assert.Equal(4, r.Humans);
+        Assert.All(r.Clients, c => Assert.True(Matchmaker.Unit.IsHuman(c.Client)));
+        Assert.Equal(2, r.Clients.Count(c => c.GroupId == 0));
+        Assert.Equal(2, r.Clients.Count(c => c.GroupId == 1));
+    }
+
+    [Theory]
+    [InlineData(23u)]   // mix
+    [InlineData(18u)]   // free solo
+    [InlineData(13u)]   // class solo
+    [InlineData(15u)]   // in-store solo
+    public void TwoSolosNeverGetAShortRoomAndTimeOut(uint world)
+    {
+        var mm = New();
+        var a = Entry(world); var b = Entry(world);
+        mm.Entry(a, 0); mm.Entry(b, 1);
+        foreach (var t in new[] { 31.0, 60, 91, 121, 149 })
+        {
+            Assert.Null(RoomAt(mm, a, t));
+            Assert.Null(RoomAt(mm, b, t));
+        }
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(a.Myclient.NodeId, 151).Code);   // the cabinet's own timeout
+    }
+
+    [Fact]
+    public void ThreeSolosWaitThenAFourthMakesA2v2()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 3).Select(_ => Entry()).ToList();
+        for (var i = 0; i < 3; i++) mm.Entry(es[i], i);
+        foreach (var t in new[] { 40.0, 95, 120 })
+            Assert.All(es, e => Assert.Null(RoomAt(mm, e, t)));
+        var d = Entry();
+        mm.Entry(d, 125);
+        var r = RoomAt(mm, d, 125)!;
+        AssertFourHumans(r);
+        Assert.All(es, e => Assert.Same(r, RoomAt(mm, e, 125)));
+    }
+
+    [Fact]
+    public void FourSolosMatchAtOnce()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 4).Select(_ => Entry()).ToList();
+        foreach (var e in es) mm.Entry(e, 0);
+        AssertFourHumans(RoomAt(mm, es[0], 0)!);
+    }
+
+    [Fact]
+    public void DuoAndOneSoloNeverMatch()
+    {
+        var mm = New();
+        var duo = Entry(team: true); var solo = Entry();
+        mm.Entry(duo, 0); mm.Entry(solo, 0);
+        foreach (var t in new[] { 31.0, 91, 149 })
+        {
+            Assert.Null(RoomAt(mm, duo, t));
+            Assert.Null(RoomAt(mm, solo, t));
+        }
+    }
+
+    [Fact]
+    public void DuoPlusTwoSolosPutsTheSolosTogether()
+    {
+        var mm = New();
+        var duo = Entry(team: true); var s1 = Entry(); var s2 = Entry();
+        mm.Entry(duo, 0); mm.Entry(s1, 0); mm.Entry(s2, 0);
+        var r = RoomAt(mm, duo, 0)!;
+        AssertFourHumans(r);
+        var duoGroup = r.Clients.Single(c => c.Client.NodeId == duo.Myclient.NodeId).GroupId;
+        Assert.All(r.Clients.Where(c => c.Client.NodeId == s1.Myclient.NodeId || c.Client.NodeId == s2.Myclient.NodeId),
+            c => Assert.NotEqual(duoGroup, c.GroupId));
+    }
+
+    [Fact]
+    public void DuoVsDuoMatches()
+    {
+        var mm = New();
+        var a = Entry(team: true); var b = Entry(team: true);
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        AssertFourHumans(RoomAt(mm, a, 0)!);
+    }
+
+    [Fact]
+    public void LoneDuoKeepsWaitingEvenWithLoneTeamVsCpu()
+    {
+        var mm = New();
+        mm.LoneTeamVsCpu = true;
+        var duo = Entry(team: true);
+        mm.Entry(duo, 0);
+        foreach (var t in new[] { 31.0, 91, 149 }) Assert.Null(RoomAt(mm, duo, t));
+    }
+
+    [Fact]
+    public void HumansVsCpuAndStandInsAreOverridden()
+    {
+        var mm = New();
+        mm.HumansVsCpu = true; mm.CpuStandIns = true;
+        var a = Entry(); var b = Entry();
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        foreach (var t in new[] { 31.0, 91, 149 }) Assert.Null(RoomAt(mm, a, t));
+    }
+
+    [Fact]
+    public void EntryWithCpuPartnerIsNeverPlaced()
+    {
+        var log = new List<string>();
+        var mm = New(log: log);
+        mm.Warn = log.Add;
+        var cpu = Entry(cpuPartner: true); var s1 = Entry(); var s2 = Entry();
+        mm.Entry(cpu, 0); mm.Entry(s1, 0); mm.Entry(s2, 0);
+        Assert.Null(RoomAt(mm, cpu, 0));
+        Assert.Null(RoomAt(mm, s1, 100));
+        Assert.Contains(log, l => l.StartsWith("NOCPU-WARN"));
+        // the two humans still match once two more humans come
+        var s3 = Entry(); var s4 = Entry();
+        mm.Entry(s3, 101); mm.Entry(s4, 101);
+        var r = RoomAt(mm, s1, 101)!;
+        AssertFourHumans(r);
+        Assert.Null(RoomAt(mm, cpu, 101));
+    }
+
+    [Fact]
+    public void FesOneOnOneStillMatchesTwoSolosAtOnce()
+    {
+        var mm = New();
+        var a = Entry(20); var b = Entry(20);
+        mm.Entry(a, 0); mm.Entry(b, 1);
+        var r = RoomAt(mm, a, 1)!;
+        Assert.Equal(2, r.Clients.Count);
+        Assert.Equal(new uint[] { 0, 1 }, r.Clients.Select(c => c.GroupId).ToArray());
+    }
+
+    [Fact]
+    public void HoldIsLoggedOnceWhenTheFillTimerWouldHaveFired()
+    {
+        var log = new List<string>();
+        var mm = New(log: log);
+        var a = Entry(); var b = Entry();
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        RoomAt(mm, a, 10);
+        Assert.DoesNotContain(log, l => l.StartsWith("NOCPU hold"));
+        RoomAt(mm, a, 31); RoomAt(mm, a, 60); RoomAt(mm, b, 60);
+        Assert.Equal(2, log.Count(l => l.StartsWith("NOCPU hold")));   // once per waiting unit
+    }
+
+    [Fact]
+    public void FlagOffKeepsTheOldShortRoom()
+    {
+        var mm = New(on: false);
+        var a = Entry(); var b = Entry();
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        Assert.Null(RoomAt(mm, a, 10));
+        var r = RoomAt(mm, a, 31)!;
+        Assert.Equal(2, r.Humans);
+    }
+}
