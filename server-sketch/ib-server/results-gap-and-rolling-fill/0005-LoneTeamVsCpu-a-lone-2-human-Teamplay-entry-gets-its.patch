+    [Fact]
+    public void LoneTeamVsCpuGivesTheTeamItsOwnRoom()
+    {
+        Assert.False(new Matchmaker().LoneTeamVsCpu);
+        var log = new List<string>();
+        var mm = New(on: false, log: log);
+        mm.LoneTeamVsCpu = true;
+        mm.Entry(Solo(1500, partner: 1502), 0);
+        Assert.Null(mm.Check(1500, 10).Room);                     // still waits FillAfter for opponents
+        var room = mm.Check(1500, 31).Room!;
+        Assert.Equal(new uint[] { 1500, 1502 }, room.Clients.Select(c => c.Client.NodeId));
+        Assert.All(room.Clients, c => Assert.Equal(0u, c.GroupId));
+        Assert.All(room.Clients, c => Assert.True(Matchmaker.Unit.IsHuman(c.Client)));
+        Assert.Equal(2, room.Humans);
+        Assert.Same(room, mm.Check(1502, 31).Room);
+        Assert.Contains(log, l => l.Contains("lone-team-vs-cpu"));
+
+        // a team with a CPU partner entry, or a team that has a compatible opponent, is unchanged
+        var m2 = New(on: false); m2.LoneTeamVsCpu = true;
+        m2.Entry(Solo(1600, partner: 1601, cpuPartner: true), 0);
+        Assert.Null(m2.Check(1600, 60).Room);
+        var m3 = New(on: false); m3.LoneTeamVsCpu = true;
+        m3.Entry(Solo(1700, partner: 1702), 0); m3.Entry(Solo(1704), 0);
+        var r3 = m3.Check(1700, 31).Room!;
+        Assert.NotEqual(r3.Clients.Single(c => c.Client.NodeId == 1700).GroupId, r3.Clients.Single(c => c.Client.NodeId == 1704).GroupId);
+    }
+
