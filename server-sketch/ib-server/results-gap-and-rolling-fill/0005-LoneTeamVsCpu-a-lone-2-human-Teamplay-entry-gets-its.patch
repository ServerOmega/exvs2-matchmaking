+    /// <summary>LoneTeamVsCpu: the team's two human clients, both group 0, no other clients (game adds CPU opponents).</summary>
+    private void MakeLoneTeamRoom(Unit team, double now)
+    {
+        var room = new Room
+        {
+            RoomId = _nextRoom++, At = now, World = team.World, Humans = team.Clients.Count,
+            Clients = team.Clients.Select(c => new RoomClient(0, c)).ToList(),
+        };
+        _queue.Remove(team);
+        team.Room = room;
+        RememberRoom(team, room);
+        Log?.Invoke($"MATCH room={room.RoomId} {team.WorldName} lone-team-vs-cpu T[{string.Join(",", team.NodeIds)}] " +
+                    $"vs CPU (humans={room.Humans}/4, LoneTeamVsCpu)");
+        Log?.Invoke(NetDiag.MatchLine(room.RoomId, room.Clients.Select(c => (c.GroupId, c.Client)), team.SourceByNode, Realms));
+    }
+
     private void MakeRoom((List<Unit> S0, List<Unit> S1) sides, double now)
