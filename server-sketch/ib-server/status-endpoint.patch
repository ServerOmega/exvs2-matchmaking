@@ -0,0 +1,35 @@
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Controllers;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Public read-only matchmaker status for launchers: GET /status returns
+/// <c>{"service","version","online","searching","inMatch","matches","updatedAt","cacheSeconds"}</c>, totals only.
+/// Reachable from the internet under Security.AccessMode = PublicMatchmaker when Status.PublicStatus is on (exact
+/// path only), rate-limited per source IP (Status.RequestsPerMinute / Burst) and cached (Status.CacheSeconds).
+/// </summary>
+[ApiController]
+[Route("status")]
+public class StatusController : ControllerBase
+{
+    private readonly MatchmakerStatus _status;
+    private readonly StatusConfigurations _cfg;
+
+    public StatusController(MatchmakerStatus status, IOptions<CardServerConfig> options)
+    {
+        _status = status;
+        _cfg = options.Value.Status;
+    }
+
+    [HttpGet]
+    public IActionResult Get()
+    {
+        if (!_cfg.PublicStatus) return NotFound();
+        var reply = _status.Get();
+        Response.Headers.CacheControl = $"public, max-age={Math.Max(0, reply.CacheSeconds)}";
+        return Ok(reply);
+    }
+}
