@@ -0,0 +1,68 @@
+using System.Text.Json.Serialization;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] The public GET /status reply. Totals only: never card ids, access codes, chip ids,
+/// names, pcb serials, node ids or IP addresses.
+/// </summary>
+public sealed record MatchmakerStatusReply(
+    [property: JsonPropertyName("service")] string Service,
+    [property: JsonPropertyName("version")] string Version,
+    [property: JsonPropertyName("online")] int Online,
+    [property: JsonPropertyName("searching")] int Searching,
+    [property: JsonPropertyName("inMatch")] int InMatch,
+    [property: JsonPropertyName("matches")] int Matches,
+    [property: JsonPropertyName("updatedAt")] DateTime UpdatedAt,
+    [property: JsonPropertyName("cacheSeconds")] int CacheSeconds);
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Builds <see cref="MatchmakerStatusReply"/> from the matchmaker at most once per
+/// <c>cacheSeconds</c> (callers in between get the cached reply), so /status costs one lock per few seconds.
+/// </summary>
+public sealed class MatchmakerStatus
+{
+    /// <summary>Matchmaker add-on version reported when Status.Version is empty.</summary>
+    public const string BuiltInVersion = "0.6.0-dev";
+    public const string ServiceName = "exvs2-matchmaking";
+
+    private readonly object _gate = new();
+    private readonly Func<double, Matchmaker.StatusCounts> _counts;
+    private readonly Func<double> _clock;
+    private readonly Func<DateTime> _utcNow;
+    private readonly string _version;
+    private readonly int _cacheSeconds;
+    private MatchmakerStatusReply? _cached;
+    private double _cachedAt;
+
+    public MatchmakerStatus(Func<double, Matchmaker.StatusCounts> counts, Func<double> clock, Func<DateTime>? utcNow = null,
+        string? version = null, int cacheSeconds = 5)
+    {
+        _counts = counts;
+        _clock = clock;
+        _utcNow = utcNow ?? (() => DateTime.UtcNow);
+        _version = string.IsNullOrWhiteSpace(version) ? BuiltInVersion : version.Trim();
+        _cacheSeconds = Math.Max(0, cacheSeconds);
+    }
+
+    public MatchmakerStatus(Matchmaker mm, Func<double> clock, double onlineWindow, double inMatchWindow,
+        string? version = null, int cacheSeconds = 5)
+        : this(now => mm.GetStatusCounts(now, onlineWindow, inMatchWindow), clock, null, version, cacheSeconds) { }
+
+    public int CacheSeconds => _cacheSeconds;
+
+    public MatchmakerStatusReply Get()
+    {
+        lock (_gate)
+        {
+            var now = _clock();
+            if (_cached != null && now - _cachedAt < _cacheSeconds) return _cached;
+            var c = _counts(now);
+            var at = _utcNow();
+            _cached = new MatchmakerStatusReply(ServiceName, _version, c.Online, c.Searching, c.InMatch, c.Matches,
+                new DateTime(at.Ticks - at.Ticks % TimeSpan.TicksPerSecond, DateTimeKind.Utc), _cacheSeconds);
+            _cachedAt = now;
+            return _cached;
+        }
+    }
+}
