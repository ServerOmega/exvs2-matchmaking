+    /// <summary>[exvs2-lobbies 2026-11-16] Totals for the public GET /status (no ids of any kind).</summary>
+    public readonly record struct StatusCounts(int Online, int Searching, int InMatch, int Matches);
+
+    private static string StatusKey(Client c) =>
+        (string.IsNullOrEmpty(c.PcbSerial) ? "node:" + c.NodeId : c.PcbSerial) + "|" + NetDiag.Norm(c.GlobalIpaddress);
+
+    /// <summary>Call under _gate. A search (EntryMatching) ends the cabinet's previous match.</summary>
+    private void StatusContact(Client c, double now, bool searching)
+    {
+        var key = StatusKey(c);
+        _statusSeen[key] = now;
+        if (searching) _statusInMatch.Remove(key);
+        if (_statusSeen.Count > StatusTrackMax)
+            foreach (var k in _statusSeen.OrderBy(kv => kv.Value).Take(_statusSeen.Count - StatusTrackMax / 2)
+                         .Select(kv => kv.Key).ToList())
+                _statusSeen.Remove(k);
+        if (_statusInMatch.Count > StatusTrackMax)
+            foreach (var k in _statusInMatch.OrderBy(kv => kv.Value.At).Take(_statusInMatch.Count - StatusTrackMax / 2)
+                         .Select(kv => kv.Key).ToList())
+                _statusInMatch.Remove(k);
+    }
+
+    /// <summary>
+    /// [exvs2-lobbies 2026-11-16] Cabinet totals for GET /status. Searching = human cabinets in the queue right now;
+    /// in match = cabinets placed in a room within <paramref name="inMatchWindow"/> seconds that have not searched
+    /// again; online = cabinets that searched, polled or were matched within <paramref name="onlineWindow"/> seconds
+    /// (plus the two above). Matches = rooms with at least one cabinet still counted in match. Estimates: a cabinet
+    /// in menus or practice does not talk to the matchmaker.
+    /// </summary>
+    public StatusCounts GetStatusCounts(double now, double onlineWindow = 600, double inMatchWindow = 480)
+    {
+        lock (_gate)
+        {
+            Sweep(now);
+            var searching = new HashSet<string>();
+            foreach (var u in _queue)
+                if (u.Room == null)
+                    foreach (var c in u.Humans) searching.Add(StatusKey(c));
+            foreach (var k in _statusInMatch.Where(kv => now - kv.Value.At > inMatchWindow).Select(kv => kv.Key).ToList())
+                _statusInMatch.Remove(k);
+            foreach (var k in _statusSeen.Where(kv => now - kv.Value > Math.Max(onlineWindow, inMatchWindow)).Select(kv => kv.Key).ToList())
+                _statusSeen.Remove(k);
+            var inMatch = _statusInMatch.Where(kv => !searching.Contains(kv.Key)).ToList();
+            var online = new HashSet<string>(searching);
+            foreach (var kv in _statusSeen)
+                if (now - kv.Value <= onlineWindow) online.Add(kv.Key);
+            foreach (var kv in inMatch) online.Add(kv.Key);
+            return new StatusCounts(online.Count, searching.Count, inMatch.Count, inMatch.Select(kv => kv.Value.Room).Distinct().Count());
+        }
+    }
