+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Public read-only matchmaker status (GET /status) for launchers and status pages.
+/// The reply holds totals only (cabinets online / searching / in a match, matches, version): no card ids, access
+/// codes, chip ids, names, serials, node ids or IP addresses. With Security.AccessMode = PublicMatchmaker the
+/// internet may reach exactly <c>/status</c> (not sub-paths) when <see cref="PublicStatus"/> is on.
+/// </summary>
+public class StatusConfigurations
+{
+    /// <summary>Serve GET /status. false = 404 (and the path stays LAN-only like the WebUI).</summary>
+    public bool PublicStatus { get; set; } = true;
+
+    /// <summary>The totals are computed at most once per this many seconds; repeated requests get the cached reply.</summary>
+    public int CacheSeconds { get; set; } = 5;
+
+    /// <summary>Per source IP token bucket for /status (0 = off). A launcher refreshes about every 15 s.</summary>
+    public int RequestsPerMinute { get; set; } = 60;
+    public int Burst { get; set; } = 20;
+
+    /// <summary>A cabinet counts as online for this many seconds after its last search / poll / match.</summary>
+    public double OnlineWindowSeconds { get; set; } = 600;
+
+    /// <summary>A matched cabinet counts as "in a match" for at most this many seconds, or until it searches again.</summary>
+    public double InMatchWindowSeconds { get; set; } = 480;
+
+    /// <summary>Version text in the reply. Empty = the built-in matchmaker version.</summary>
+    public string Version { get; set; } = "";
+}
