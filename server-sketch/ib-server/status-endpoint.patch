+using System.Net;
+using System.Text.Json;
+using nue.protocol.mms;
+using ServerInfinite.Lobbies;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// exvs2-lobbies 2026-11-16: public GET /status (totals only). All data is fake (documentation IP ranges).
+public class StatusEndpointTests
+{
+    private uint _node = 500;
+
+    private static Client Cl(uint node, string ip, string? serial = null)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial ?? $"P{node}", LocId = $"L{node}", PrefCode = 13, GlobalIpaddress = ip,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private Request.EntryMatching Entry(uint world, string ip = "203.0.113.5", string? serial = null, uint? node = null)
+    {
+        var me = node ?? ++_node;
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(me, ip, serial), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = 0 });
+        return e;
+    }
+
+    private static Matchmaker New() => new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1) { StaleAfter = 1e6 };
+
+    [Fact]
+    public void EmptyMatchmakerReportsZeros()
+    {
+        var c = New().GetStatusCounts(0);
+        Assert.Equal(new Matchmaker.StatusCounts(0, 0, 0, 0), c);
+    }
+
+    [Fact]
+    public void SearchingCabinetsAreCountedAndOnline()
+    {
+        var mm = New();
+        mm.Entry(Entry(23), 0);
+        mm.Entry(Entry(23), 0);
+        var c = mm.GetStatusCounts(1);
+        Assert.Equal(2, c.Searching);
+        Assert.Equal(0, c.InMatch);
+        Assert.Equal(2, c.Online);
+    }
+
+    [Fact]
+    public void MatchedCabinetsMoveToInMatchUntilTheySearchAgainOrTheWindowPasses()
+    {
+        var mm = New();
+        var es = Enumerable.Range(0, 4).Select(_ => Entry(23)).ToList();
+        es.ForEach(e => mm.Entry(e, 0));
+        Assert.NotNull(mm.Check(es[0].Myclient.NodeId, 1).Room);
+        var c = mm.GetStatusCounts(2);
+        Assert.Equal(0, c.Searching);
+        Assert.Equal(4, c.InMatch);
+        Assert.Equal(1, c.Matches);
+        Assert.Equal(4, c.Online);
+
+        // one cabinet searches again after its match (new apply id): it is searching, the others stay in the match
+        var again = Entry(23, serial: es[0].Myclient.PcbSerial, node: es[0].Myclient.NodeId);
+        again.ApplyId = 2;
+        mm.Entry(again, 200);
+        c = mm.GetStatusCounts(201, onlineWindow: 600, inMatchWindow: 480);
+        Assert.Equal(1, c.Searching);
+        Assert.Equal(3, c.InMatch);
+        Assert.Equal(4, c.Online);
+
+        // after the in-match window the three are just "online" (seen recently), then gone after the online window
+        c = mm.GetStatusCounts(500, onlineWindow: 600, inMatchWindow: 480);
+        Assert.Equal(0, c.InMatch);
+        Assert.Equal(0, c.Matches);
+        Assert.True(c.Online >= 3);
+        c = mm.GetStatusCounts(5000, onlineWindow: 600, inMatchWindow: 480);
+        Assert.Equal(0, c.InMatch);
+        Assert.Equal(0, c.Online - c.Searching);
+    }
+
+    [Fact]
+    public void ACabinetOnANewNodeIdIsCountedOnce()
+    {
+        var mm = New();
+        mm.Entry(Entry(23, serial: "PCB_X", node: 900), 0);
+        mm.Cancel(900, 1);
+        mm.Entry(Entry(23, serial: "PCB_X", node: 901), 2);
+        var c = mm.GetStatusCounts(3);
+        Assert.Equal(1, c.Online);
+        Assert.Equal(1, c.Searching);
+    }
+
+    [Fact]
+    public void TheSameSerialAtTwoSitesIsTwoCabinets()
+    {
+        var mm = New();
+        mm.Entry(Entry(23, ip: "203.0.113.5", serial: "PCB_03"), 0);
+        mm.Entry(Entry(23, ip: "198.51.100.7", serial: "PCB_03"), 0);
+        Assert.Equal(2, mm.GetStatusCounts(1).Searching);
+    }
+
+    [Fact]
+    public void ReplyIsCachedForCacheSeconds()
+    {
+        var calls = 0;
+        double clock = 100;
+        var st = new MatchmakerStatus(_ => { calls++; return new Matchmaker.StatusCounts(calls, 0, 0, 0); },
+            () => clock, () => new DateTime(2026, 11, 16, 12, 0, 0, DateTimeKind.Utc), version: null, cacheSeconds: 5);
+        Assert.Equal(1, st.Get().Online);
+        clock = 104;
+        Assert.Equal(1, st.Get().Online);
+        Assert.Equal(1, calls);
+        clock = 105.5;
+        Assert.Equal(2, st.Get().Online);
+        Assert.Equal(MatchmakerStatus.BuiltInVersion, st.Get().Version);
+    }
+
+    [Fact]
+    public void ReplyJsonHasTotalsOnly()
+    {
+        var mm = New();
+        mm.Entry(Entry(23, ip: "203.0.113.77", serial: "PCB_SECRET1"), 0);
+        var st = new MatchmakerStatus(mm, () => 1, 600, 480, version: "test-1", cacheSeconds: 5);
+        var json = JsonSerializer.Serialize(st.Get());
+        using var doc = JsonDocument.Parse(json);
+        var names = doc.RootElement.EnumerateObject().Select(p => p.Name).OrderBy(n => n).ToArray();
+        Assert.Equal(new[] { "cacheSeconds", "inMatch", "matches", "online", "searching", "service", "updatedAt", "version" }, names);
+        Assert.DoesNotContain("203.0.113", json);
+        Assert.DoesNotContain("PCB_SECRET1", json);
+        Assert.Equal("test-1", doc.RootElement.GetProperty("version").GetString());
+        Assert.Equal(1, doc.RootElement.GetProperty("searching").GetInt32());
+    }
+
+    // ---- access: exactly /status is public on a PublicMatchmaker, nothing else new ----
+
+    [Theory]
+    [InlineData("/status", true)]
+    [InlineData("/STATUS", true)]
+    [InlineData("/status/", true)]
+    [InlineData("/status/x", false)]
+    [InlineData("/statusx", false)]
+    [InlineData("/", false)]
+    [InlineData("/ui", false)]
+    [InlineData("/index.html", false)]
+    public void OnlyTheExactStatusPathIsPublic(string path, bool allowed)
+    {
+        var internet = IPAddress.Parse("203.0.113.9");
+        Assert.Equal(allowed, NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, path, internet, null,
+            publicLeaderboard: true, publicStatus: true));
+        // switched off: LAN-only like the WebUI
+        if (NetworkAccess.IsStatusPath(path))
+            Assert.False(NetworkAccess.IsAllowed(AccessMode.PublicMatchmaker, path, internet, null, true, publicStatus: false));
+        // a LanOnly card server never serves it to the internet
+        Assert.False(NetworkAccess.IsAllowed(AccessMode.LanOnly, path, internet, null, true, publicStatus: true));
+        Assert.True(NetworkAccess.IsAllowed(AccessMode.LanOnly, path, IPAddress.Parse("192.168.1.72"), null, true, true));
+    }
+}
