@@ -0,0 +1,363 @@
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>2026-11-15 friend requests: pending → mutual, block rules, auto online tag team, paging / search / sort, persistence.</summary>
+public class FriendStoreTests
+{
+    private const uint A = 1_000_002, B = 2_000_002, C = 3_000_001, D = 1_000_009;
+
+    private static (FriendStore F, TagInviteStore T) New(string? path = null, string? tagPath = null)
+    {
+        var t = new TagInviteStore(tagPath);
+        return (new FriendStore(path) { Tags = t }, t);
+    }
+
+    private static string Tmp(string tag) => Path.Combine(Path.GetTempPath(), $"friends-{tag}-{Guid.NewGuid():n}.json");
+
+    [Fact]
+    public void GameRequestIsPendingUntilThePartnerAlsoRequests()
+    {
+        var (f, t) = New();
+        var r1 = f.Request(A, "server(2)", B, "game");
+        Assert.Equal(FriendResult.Sent, r1.Result);
+        Assert.Equal(FriendLinkState.Pending, f.StateOf(A, B));
+        Assert.Empty(t.PairCodes(A, B));
+        Assert.Equal(FriendResult.AlreadyPending, f.Request(A, "server(2)", B, "game").Result);
+
+        var r2 = f.Request(B, "friend", A, "game");
+        Assert.Equal(FriendResult.BecameFriends, r2.Result);
+        Assert.True(r2.TagTeamCreated);
+        Assert.Equal(FriendLinkState.Friends, f.StateOf(B, A));
+        var code = Assert.Single(t.PairCodes(A, B));
+        Assert.Equal(code, r2.TagCode);
+        var inv = t.Get(code)!;
+        Assert.True(inv.Joined);
+        Assert.Equal(A, inv.CreatorPilotId);           // the first requester creates the team
+        Assert.Equal(B, inv.PartnerPilotId);
+        Assert.Equal("server(2)", inv.CreatorName);
+        Assert.Equal("friend", inv.PartnerName);
+        Assert.Contains(code, t.ForPilot(B).Select(i => i.Code));
+        Assert.Equal(FriendResult.AlreadyFriends, f.Request(A, "", B).Result);
+        Assert.Single(t.PairCodes(A, B));              // no second team
+    }
+
+    [Fact]
+    public void AcceptOnTheWebMakesFriendsAndOnlyTheReceiverCanAccept()
+    {
+        var (f, t) = New();
+        f.Request(A, "a", B, "game");
+        Assert.Equal(FriendResult.NotFound, f.Accept(A, "a", B).Result);   // you cannot accept your own request
+        var r = f.Accept(B, "b", A);
+        Assert.Equal(FriendResult.Accepted, r.Result);
+        Assert.True(r.TagTeamCreated);
+        Assert.Single(t.PairCodes(A, B));
+        Assert.Equal(FriendResult.AlreadyFriends, f.Accept(B, "b", A).Result);
+        Assert.Equal(FriendResult.NotFound, f.Accept(C, "c", A).Result);
+    }
+
+    [Fact]
+    public void AnExistingTeamIsReusedNotDuplicated()
+    {
+        var (f, t) = New();
+        var code = t.Create(B, "b");
+        t.Join(code, A, "a");
+        f.Request(A, "a", B);
+        var r = f.Accept(B, "b", A);
+        Assert.False(r.TagTeamCreated);
+        Assert.Equal(code, r.TagCode);
+        Assert.Single(t.PairCodes(A, B));
+    }
+
+    [Fact]
+    public void AutoTagTeamCanBeTurnedOff()
+    {
+        var (f, t) = New();
+        f.AutoTagTeam = false;
+        f.Request(A, "a", B);
+        Assert.Equal(FriendResult.BecameFriends, f.Request(B, "b", A).Result);
+        Assert.Empty(t.PairCodes(A, B));
+    }
+
+    [Fact]
+    public void DeclineAndCancelRemoveOnlyPendingRequests()
+    {
+        var (f, _) = New();
+        f.Request(A, "a", B);
+        Assert.Equal(FriendResult.Removed, f.Decline(B, A).Result);   // receiver declines
+        Assert.Null(f.StateOf(A, B));
+        f.Request(A, "a", B);
+        Assert.Equal(FriendResult.Removed, f.Decline(A, B).Result);   // sender cancels
+        Assert.Equal(FriendResult.NotFound, f.Decline(A, B).Result);
+        f.Request(A, "a", B); f.Accept(B, "b", A);
+        Assert.Equal(FriendResult.NotFound, f.Decline(A, B).Result);  // not a pending request any more
+        Assert.Equal(FriendLinkState.Friends, f.StateOf(A, B));
+    }
+
+    [Fact]
+    public void RemoveKeepsTheTagTeamUnlessAsked()
+    {
+        var (f, t) = New();
+        f.Request(A, "a", B); f.Accept(B, "b", A);
+        var r = f.Remove(A, B);
+        Assert.Equal(FriendResult.Removed, r.Result);
+        Assert.Empty(r.DeletedTagCodes);
+        Assert.Single(t.PairCodes(A, B));
+
+        f.Request(A, "a", B); f.Accept(B, "b", A);
+        var r2 = f.Remove(B, A, deleteTagTeams: true);
+        Assert.Single(r2.DeletedTagCodes);
+        Assert.Empty(t.PairCodes(A, B));
+        Assert.Null(f.StateOf(A, B));
+    }
+
+    [Fact]
+    public void BlockDropsFriendshipAndRefusesRequestsBothWays()
+    {
+        var (f, t) = New();
+        f.Request(A, "a", B); f.Accept(B, "b", A);
+        var r = f.Block(A, B, "web");
+        Assert.Equal(FriendResult.Blocked, r.Result);
+        Assert.Null(f.StateOf(A, B));
+        Assert.Single(t.PairCodes(A, B));                               // team kept: no explicit choice
+        Assert.Equal(FriendResult.RefusedBlocked, f.Request(B, "b", A).Result);
+        Assert.Equal(FriendResult.RefusedYouBlocked, f.Request(A, "a", B).Result);
+        Assert.Equal(FriendResult.AlreadyBlocked, f.Block(A, B).Result);
+        Assert.True(f.EitherBlocked(B, A));
+        Assert.Equal(new[] { B }, f.BlockedIds(A));
+        Assert.Empty(f.BlockedIds(B));
+
+        Assert.Equal(FriendResult.Unblocked, f.Unblock(A, B).Result);
+        Assert.Equal(FriendResult.NotFound, f.Unblock(A, B).Result);
+        Assert.Equal(FriendResult.Sent, f.Request(B, "b", A).Result);
+    }
+
+    [Fact]
+    public void BlockCanDeleteSharedTeamsAndClearsPendingRequests()
+    {
+        var (f, t) = New();
+        f.Request(C, "c", A);
+        var r = f.Block(A, C, "game");
+        Assert.Equal(FriendResult.Blocked, r.Result);
+        Assert.Null(f.StateOf(A, C));
+        Assert.Equal(0, f.Counts(A).Incoming);
+
+        f.Request(A, "a", B); f.Accept(B, "b", A);
+        var r2 = f.Block(B, A, "web", deleteTagTeams: true);
+        Assert.Single(r2.DeletedTagCodes);
+        Assert.Empty(t.PairCodes(A, B));
+    }
+
+    [Fact]
+    public void InvalidSelfAndZeroIdsAreRefused()
+    {
+        var (f, _) = New();
+        Assert.Equal(FriendResult.RefusedSelf, f.Request(A, "a", A).Result);
+        Assert.Equal(FriendResult.RefusedInvalid, f.Request(0, "a", A).Result);
+        Assert.Equal(FriendResult.RefusedInvalid, f.Request(A, "a", 0).Result);
+        Assert.Equal(FriendResult.RefusedSelf, f.Block(A, A).Result);
+        Assert.Equal(FriendResult.RefusedInvalid, f.Accept(A, "", A).Result);
+    }
+
+    [Fact]
+    public void LimitsAreEnforced()
+    {
+        var (f, _) = New();
+        f.MaxOutgoing = 2; f.MaxIncoming = 2; f.MaxBlocked = 1; f.MaxFriends = 1;
+        Assert.Equal(FriendResult.Sent, f.Request(A, "a", 10).Result);
+        Assert.Equal(FriendResult.Sent, f.Request(A, "a", 11).Result);
+        Assert.Equal(FriendResult.RefusedLimit, f.Request(A, "a", 12).Result);
+        Assert.Equal(FriendResult.Sent, f.Request(20, "x", B).Result);
+        Assert.Equal(FriendResult.Sent, f.Request(21, "y", B).Result);
+        Assert.Equal(FriendResult.RefusedLimit, f.Request(22, "z", B).Result);
+        Assert.Equal(FriendResult.Accepted, f.Accept(B, "b", 20).Result);
+        Assert.Equal(FriendResult.RefusedLimit, f.Accept(B, "b", 21).Result);   // B already has MaxFriends
+        Assert.Equal(FriendResult.Blocked, f.Block(C, 30).Result);
+        Assert.Equal(FriendResult.RefusedLimit, f.Block(C, 31).Result);
+    }
+
+    [Fact]
+    public void PendingRequestsExpire()
+    {
+        var now = new DateTime(2026, 11, 15, 18, 0, 0, DateTimeKind.Utc);
+        var (f, _) = New();
+        f.UtcNow = () => now;
+        f.PendingTtl = TimeSpan.FromDays(30);
+        f.Request(A, "a", B);
+        now = now.AddDays(31);
+        Assert.Equal(0, f.Counts(A).Outgoing);
+        Assert.Null(f.StateOf(A, B));
+        Assert.Equal(FriendResult.Sent, f.Request(A, "a", B).Result);   // can ask again
+    }
+
+    [Fact]
+    public void GameRequestsStampLastPlayedWebRequestsDoNot()
+    {
+        var now = new DateTime(2026, 11, 15, 18, 0, 0, DateTimeKind.Utc);
+        var (f, _) = New();
+        f.UtcNow = () => now;
+        f.Request(A, "a", B, "web");
+        Assert.Null(f.List(A, new FriendQuery { Tab = "outgoing" }).Items.Single().LastPlayedUtc);
+        now = now.AddMinutes(5);
+        f.Request(A, "a", B, "game");
+        Assert.Equal(now, f.List(A, new FriendQuery { Tab = "outgoing" }).Items.Single().LastPlayedUtc);
+    }
+
+    private static FriendStore Big(int n, out uint self)
+    {
+        self = 1_000_001;
+        var f = new FriendStore();
+        var t0 = new DateTime(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        var tick = 0;
+        f.UtcNow = () => t0.AddMinutes(tick);
+        f.MaxFriends = f.MaxIncoming = f.MaxOutgoing = 10_000;
+        for (var i = 1; i <= n; i++)
+        {
+            tick = i;
+            var other = (uint)(2_000_000 + i);
+            f.Request(other, $"Pilot{i:D4}", self, i % 3 == 0 ? "game" : "web");
+            if (i % 5 != 0) f.Accept(self, "me", other);   // 4 of 5 become friends, every 5th stays incoming
+        }
+        return f;
+    }
+
+    [Fact]
+    public void ListPagesAndCountsLargeLists()
+    {
+        var f = Big(1000, out var me);
+        var p1 = f.List(me, new FriendQuery { Tab = "friends", PageSize = 25 });
+        Assert.Equal(800, p1.Total);
+        Assert.Equal(32, p1.TotalPages);
+        Assert.Equal(25, p1.Items.Count);
+        Assert.Equal(800, p1.Counts.Friends);
+        Assert.Equal(200, p1.Counts.Incoming);
+        Assert.Equal(0, p1.Counts.Outgoing);
+        // default sort: date added, newest first
+        Assert.True(p1.Items[0].AddedUtc >= p1.Items[1].AddedUtc);
+        var last = f.List(me, new FriendQuery { Tab = "friends", PageSize = 25, Page = 999 });
+        Assert.Equal(32, last.Page);                       // clamped to the last page
+        Assert.Equal(25, last.Items.Count);
+        var all = Enumerable.Range(1, 32).SelectMany(p => f.List(me, new FriendQuery { Tab = "friends", Page = p }).Items).ToList();
+        Assert.Equal(800, all.Select(e => e.PilotId).Distinct().Count());   // pages do not overlap
+        Assert.Equal(100, f.List(me, new FriendQuery { PageSize = 5000 }).PageSize);   // page size capped
+        Assert.Equal(200, f.List(me, new FriendQuery { Tab = "requests" }).Total);
+        Assert.All(f.List(me, new FriendQuery { Tab = "incoming" }).Items, e => Assert.Equal("incoming", e.Kind));
+    }
+
+    [Fact]
+    public void SearchByNameIsCaseAndWidthInsensitiveAndByPilotIdDigits()
+    {
+        var f = Big(60, out var me);
+        var byName = f.List(me, new FriendQuery { Tab = "friends", Q = "pilot004" });
+        Assert.Equal(new[] { "Pilot0041", "Pilot0042", "Pilot0043", "Pilot0044", "Pilot0046", "Pilot0047", "Pilot0048", "Pilot0049" },
+            byName.Items.Select(e => e.Name).OrderBy(x => x));
+        Assert.Single(f.List(me, new FriendQuery { Tab = "friends", Q = "ＰＩＬＯＴ0041" }).Items);   // fullwidth query
+        var byId = f.List(me, new FriendQuery { Tab = "friends", Q = "2000041" });
+        Assert.Equal((uint)2_000_041, Assert.Single(byId.Items).PilotId);
+        Assert.Empty(f.List(me, new FriendQuery { Tab = "friends", Q = "nobody" }).Items);
+        Assert.Equal(0, f.List(me, new FriendQuery { Tab = "friends", Q = "nobody" }).Total);
+        Assert.Equal(48, f.List(me, new FriendQuery { Tab = "friends", Q = "  " }).Total);   // blank = no filter
+    }
+
+    [Fact]
+    public void SortByNameAddedAndLastPlayed()
+    {
+        var f = Big(30, out var me);
+        var byName = f.List(me, new FriendQuery { Tab = "friends", Sort = "name", PageSize = 100 }).Items.Select(e => e.Name).ToList();
+        Assert.Equal(byName.OrderBy(x => x, StringComparer.CurrentCultureIgnoreCase).ToList(), byName);
+        var byNameDesc = f.List(me, new FriendQuery { Tab = "friends", Sort = "name", Dir = "desc", PageSize = 100 }).Items.Select(e => e.Name).ToList();
+        Assert.Equal(byName.AsEnumerable().Reverse().ToList(), byNameDesc);
+        var oldest = f.List(me, new FriendQuery { Tab = "friends", Sort = "added", Dir = "asc" }).Items[0];
+        Assert.Equal("Pilot0001", oldest.Name);
+        var played = f.List(me, new FriendQuery { Tab = "friends", Sort = "lastPlayed", PageSize = 100 }).Items;
+        // game requests (every 3rd) have a last-played time and come first, newest first; the rest follow
+        var withTime = played.TakeWhile(e => e.LastPlayedUtc.HasValue).ToList();
+        Assert.True(withTime.Count > 0);
+        Assert.All(played.Skip(withTime.Count), e => Assert.Null(e.LastPlayedUtc));
+        Assert.Equal(withTime.OrderByDescending(e => e.LastPlayedUtc).Select(e => e.PilotId), withTime.Select(e => e.PilotId));
+    }
+
+    [Fact]
+    public void BlockedTabPagesAndSearches()
+    {
+        var t0 = new DateTime(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        var tick = 0;
+        var f = new FriendStore { UtcNow = () => t0.AddSeconds(tick) };
+        for (uint i = 1; i <= 40; i++) { tick++; f.UpdateName(5_000_000 + i, $"Rude{i:D2}"); f.Block(A, 5_000_000 + i, "web"); }
+        var p = f.List(A, new FriendQuery { Tab = "blocked", PageSize = 10, Page = 2 });
+        Assert.Equal(40, p.Total);
+        Assert.Equal(4, p.TotalPages);
+        Assert.Equal(10, p.Items.Count);
+        Assert.All(p.Items, e => Assert.Equal("blocked", e.Kind));
+        Assert.Equal("Rude07", Assert.Single(f.List(A, new FriendQuery { Tab = "blocked", Q = "rude07" }).Items).Name);
+        Assert.Equal(10, f.BlockedIds(A, 10).Count);
+        Assert.Equal((uint)5_000_040, f.BlockedIds(A, 1)[0]);   // newest first
+    }
+
+    [Fact]
+    public void NamesFollowRenames()
+    {
+        var (f, _) = New();
+        f.Request(A, "old", B);
+        Assert.Equal("old", f.List(B, new FriendQuery { Tab = "incoming" }).Items.Single().Name);
+        Assert.True(f.UpdateName(A, "new name"));
+        Assert.False(f.UpdateName(A, "new name"));
+        Assert.Equal("new name", f.List(B, new FriendQuery { Tab = "incoming" }).Items.Single().Name);
+    }
+
+    [Fact]
+    public void StatePersistsAcrossRestartAtomically()
+    {
+        var path = Tmp("persist");
+        var tagPath = Tmp("tags");
+        try
+        {
+            var (f, _) = New(path, tagPath);
+            f.Request(A, "a", B); f.Accept(B, "b", A);
+            f.Request(C, "c", A);
+            f.Block(A, D, "game");
+            Assert.False(File.Exists(path + ".tmp"));
+            var (g, t2) = New(path, tagPath);
+            Assert.Equal(FriendLinkState.Friends, g.StateOf(A, B));
+            Assert.Equal(FriendLinkState.Pending, g.StateOf(A, C));
+            Assert.Equal(new[] { D }, g.BlockedIds(A));
+            Assert.Equal("c", g.NameOf(C));
+            Assert.Single(t2.PairCodes(A, B));
+            Assert.True(g.List(A, new FriendQuery()).Items.Single().HasTagTeam);
+        }
+        finally { File.Delete(path); File.Delete(tagPath); }
+    }
+
+    [Fact]
+    public void CorruptStateStartsEmptyAndKeepsTheBadFile()
+    {
+        var path = Tmp("corrupt");
+        try
+        {
+            File.WriteAllText(path, "{ not json");
+            var f = new FriendStore(path);
+            Assert.Equal(0, f.Counts(A).Friends);
+            Assert.NotEmpty(Directory.GetFiles(Path.GetDirectoryName(path)!, Path.GetFileName(path) + ".corrupt-*"));
+        }
+        finally
+        {
+            File.Delete(path);
+            foreach (var x in Directory.GetFiles(Path.GetDirectoryName(path)!, Path.GetFileName(path) + ".corrupt-*")) File.Delete(x);
+        }
+    }
+
+    [Fact]
+    public void QueryClampNormalisesInput()
+    {
+        var q = new FriendQuery { Tab = "BLOCKED", Sort = "LastPlayed", Dir = "sideways", Page = -3, PageSize = 0, Q = "  x  " }.Clamp();
+        Assert.Equal("blocked", q.Tab);
+        Assert.Equal("lastPlayed", q.Sort);
+        Assert.Equal("desc", q.Dir);
+        Assert.Equal(1, q.Page);
+        Assert.Equal(25, q.PageSize);
+        Assert.Equal("x", q.Q);
+        Assert.Equal("friends", new FriendQuery { Tab = "weird" }.Clamp().Tab);
+        Assert.Equal("asc", new FriendQuery { Sort = "name" }.Clamp().Dir);
+    }
+}
