     }
+
+    // ---- fix2 2026-11-15: card secrets inside WebUI / API request paths and query strings ----
+
+    // /ui/<controller>/<action>/{accessCode}/{chipId} (getTeams, getBasicDisplayProfile, get-recent-battle-histories, …)
+    private static readonly Regex UiPair = new(
+        @"(?i)(/ui/[A-Za-z\-/]+?/(?:get|get\-recent\-battle\-histories|getAllFavouriteMs|getBasicDisplayProfile|getCpuTriadPartner|getCustomMessageGroupSetting|getDefaultSticker|getGamepadConfig|getMobileSuitStickers|getNaviProfile|getPlayerLevelProfile|getTeams|getTriadCourseOverallResult|getUsedMobileSuitData)/)([^/?#\s]+)/([^/?#\s]+)(?=$|[/?#\s""'])", RegexOptions.Compiled);
+    // /ui/card/getBy/{accessCode}
+    private static readonly Regex UiGetBy = new(@"(?i)(/ui/card/getBy/)([^/?#\s]+)", RegexOptions.Compiled);
+    // /ui/team/checkPlayerExistence/{partnerId}/{partnerToken} and /upload/uploadImage/{cardId}/{accessToken}
+    private static readonly Regex IdThenToken = new(
+        @"(?i)(/(?:checkPlayerExistence|uploadImage)/[^/?#\s]+/)([^/?#\s]+)", RegexOptions.Compiled);
+    // ?accessCode=…&chipId=…&token=…
+    private static readonly Regex QuerySecret = new(
+        @"(?i)([?&;](?:access_?code|chip_?id|session_?id|boot_?token|access_?token|partner_?token|upload_?token|token)=)([^&#\s""']+)",
+        RegexOptions.Compiled);
+    // fallback: any URL path segment that looks like a chip id (16+ hex) or an access code (16+ digits)
+    private static readonly Regex LongHexSegment = new(@"(?<=/)([0-9A-Fa-f]{16,})(?=$|[/?#\s""'])", RegexOptions.Compiled);
+
+    private static string M(string v) => v.StartsWith("<masked:") ? v : $"<masked:{v.Length}>";
+
+    /// <summary>Mask access codes, chip ids and tokens in URL paths / query strings (request logs, HttpClient logs).</summary>
+    public static string MaskUrlSecrets(string? text)
+    {
+        if (string.IsNullOrEmpty(text) || text.IndexOf('/') < 0 && text.IndexOf('=') < 0) return text ?? "";
+        var s = UiGetBy.Replace(text, m => m.Groups[1].Value + M(m.Groups[2].Value));
+        s = UiPair.Replace(s, m => m.Groups[1].Value + M(m.Groups[2].Value) + "/" + M(m.Groups[3].Value));
+        s = IdThenToken.Replace(s, m => m.Groups[1].Value + M(m.Groups[2].Value));
+        s = QuerySecret.Replace(s, m => m.Groups[1].Value + M(m.Groups[2].Value));
+        return LongHexSegment.Replace(s, m => M(m.Groups[1].Value));
+    }
 }
