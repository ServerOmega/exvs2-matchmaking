@@ -0,0 +1,26 @@
+using Serilog.Core;
+using Serilog.Events;
+
+namespace ServerInfinite.Lobbies.Serilog;
+
+/// <summary>
+/// exvs2-lobbies security hardening (2026-11-15): with CardServerConfig.Security.MaskNetworkInLog (default true),
+/// rewrites every string property of a log event (matchmaker lines, the "Request is" dump, request paths, …) so
+/// public IPv4 addresses become a.b.x.x and partner codes become AB******. Logging only.
+/// </summary>
+public sealed class NetworkMaskEnricher : ILogEventEnricher
+{
+    public void Enrich(LogEvent logEvent, ILogEventPropertyFactory propertyFactory)
+    {
+        List<LogEventProperty>? changed = null;
+        foreach (var kv in logEvent.Properties)
+        {
+            if (kv.Value is not ScalarValue { Value: string s } || s.Length < 7) continue;
+            var masked = LogMask.MaskNetwork(s);
+            if (!ReferenceEquals(masked, s) && masked != s)
+                (changed ??= new()).Add(new LogEventProperty(kv.Key, new ScalarValue(masked)));
+        }
+        if (changed != null)
+            foreach (var p in changed) logEvent.AddOrUpdateProperty(p);
+    }
+}
