+    // ---- /match: CheckMatching / CancelMatching bound to the entry's source IP ----
+
+    private static Request.EntryMatching TagEntry(uint node, string serial, uint am, uint world = Matchmaker.OnlineTagWorld)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial, LocId = "L" + serial, PrefCode = 13, GlobalIpaddress = "",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = c, MatchingTimeout = 150, Myplayer = new Player { BanapassportAmId = am },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 3, parameter = 0 });
+        return e;
+    }
+
+    private static Matchmaker Bound(List<string>? log = null) =>
+        new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, BindNodesToSource = true, NoCpuPartner = true, Log = log == null ? null : log.Add,
+            Warn = log == null ? null : log.Add
+        };
+
+    [Fact]
+    public void AStrangerCannotCancelSomeoneElsesSearch()
+    {
+        var log = new List<string>();
+        var mm = Bound(log);
+        Assert.Equal(ErrorCode.Success, mm.Entry(TagEntry(701, "A", 11, world: 23), 0, "203.0.113.10"));
+        mm.Cancel(701, 1, 1, "198.51.100.99");                       // guessed node id, other source
+        var still = mm.Check(701, 2, "203.0.113.10");
+        Assert.Equal(ErrorCode.Success, still.Code);                 // still waiting, not cancelled
+        Assert.Contains(log, l => l.StartsWith("SRC-WARN cancel for node=701"));
+        mm.Cancel(701, 3, 1, "203.0.113.10");                        // its own cancel works
+        Assert.NotEqual(ErrorCode.Success, mm.Check(701, 4, "203.0.113.10").Code);
+    }
+
+    [Fact]
+    public void AStrangerCannotReadSomeoneElsesRoomRoster()
+    {
+        var mm = Bound();
+        mm.Entry(TagEntry(711, "A", 11, world: 20), 0, "203.0.113.10");   // Fes 1on1: 2 humans make a room
+        mm.Entry(TagEntry(712, "B", 12, world: 20), 0, "198.51.100.20");
+        var spy = mm.Check(711, 1, "192.0.2.66");
+        Assert.Equal(ErrorCode.ErrMatchNoentry, spy.Code);
+        Assert.Null(spy.Room);
+        var own = mm.Check(711, 1, "203.0.113.10");
+        Assert.NotNull(own.Room);
+        Assert.Equal(2, own.Room!.Clients.Count);
+        Assert.NotNull(mm.Check(712, 1, "198.51.100.20").Room);
+    }
+
+    [Fact]
+    public void CabinetsBehindOneNatAndUnrecordedNodesStillWork()
+    {
+        var mm = Bound();
+        // four cabinets of one shop share a public IP
+        for (uint n = 721; n <= 724; n++) mm.Entry(TagEntry(n, "S" + n, n, world: 23), 0, "203.0.113.30");
+        var r = mm.Check(721, 1, "203.0.113.30");
+        Assert.NotNull(r.Room);
+        for (uint n = 722; n <= 724; n++) Assert.Same(r.Room, mm.Check(n, 1, "203.0.113.30").Room);
+        // binding off (default in the class) = old behaviour
+        var open = new Matchmaker(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1) { StaleAfter = 1e6 };
+        open.Entry(TagEntry(731, "X", 31, world: 23), 0, "203.0.113.10");
+        open.Cancel(731, 1, 1, "198.51.100.99");
+        Assert.NotEqual(ErrorCode.Success, open.Check(731, 2, "203.0.113.10").Code);
+        Assert.True(new SecurityConfigurations().BindMatchNodesToSourceIp);
+    }
