diff --git a/Tests/Matchmaking.Tests/PairAfterCpuTests.cs b/Tests/Matchmaking.Tests/PairAfterCpuTests.cs
new file mode 100644
index 0000000..412c314
--- /dev/null
+++ b/Tests/Matchmaking.Tests/PairAfterCpuTests.cs
@@ -0,0 +1,205 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// Class match test 2026-11-16 1:27-1:31 AM PT (VPS on 54cc909, ContinuePairSeconds 18): duo PCB_03 (node 1312) +
+// PCB_14 (node 1320) entered class-team (world 14) at 1:27:30, got the ContinuePair CPU room at 18.5 s (room 8), lost
+// to the CPUs and re-entered as the same pair at 1:30:27 (apply=4). Same WAIT replies as the first search, but the
+// leader cancelled after 11.7 s and the cabs showed the "continue with a CPU partner?" prompt, then the pair-split
+// black screen. ContinuePairAfterCpuSeconds answers such a re-entry on the leader's first poll (~3 s).
+public class PairAfterCpuTests
+{
+    private const uint Leader = 1312, Partner = 1320, ClassTeam = 14;
+
+    private static Client Cl(uint node, string serial)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial, LocId = "JPN0JPN1", PrefCode = 1, GlobalIpaddress = "203.0.113.1",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Entry(uint leader, uint? member, uint apply, uint world = ClassTeam)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = apply, Myclient = Cl(leader, $"PCB{leader}"), MatchingTimeout = 150, SeqNum = 1, CreateRoomFlag = 1,
+            Myplayer = new Player { BanapassportAmId = leader },
+            World = new World { MuchaGameId = "GIB1", Version = 106547, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 2 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = 3 });
+        if (member != null)
+            e.Groups.Add(new Request.EntryMatching.Group
+            {
+                Client = Cl(member.Value, $"PCB{member.Value}"),
+                Player = new Player { BanapassportAmId = member.Value }
+            });
+        return e;
+    }
+
+    /// <summary>The VPS policy at 1:27 AM PT (54cc909, ContinuePairSeconds 18) plus the new setting.</summary>
+    private static Matchmaker New(double afterCpu, List<string>? log = null) =>
+        new(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, MaxFillWait = 3, InStoreFillAfter = 3, InStoreMaxFillWait = 3,
+            NoCpuPartner = true,
+            ContinuePairMode = Matchmaker.ContinuePairPolicy.VsCpu,
+            ContinuePairSeconds = 18,
+            ContinuePairScope = Matchmaker.ContinuePairScopeKind.AnyDuo,
+            ContinuePairAfterCpuSeconds = afterCpu,
+            CpuPartnerCancelSeconds = 5,
+            PlaceCpuPartnerTeams = true,
+            PairSearchLog = true,
+            Log = log == null ? null : log.Add,
+        };
+
+    private static void AssertWait((ErrorCode Code, Matchmaker.Room? Room, uint ApplyId) r)
+    {
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+    }
+
+    private static void AssertCpuRoom(Matchmaker.Room? room)
+    {
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Humans);
+        Assert.Equal(new[] { Leader, Partner }, room.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).OrderBy(x => x));
+        Assert.Equal(2, room.Clients.Count(c => c.GroupId == 1 && c.Client.Properties.Any(p => p.PropertyValue == "N")));
+    }
+
+    /// <summary>1:27:30 first search: WAIT polls, CPU room at 18.5 s (unchanged by the new setting).</summary>
+    private static Matchmaker.Room FirstSearchGetsCpuRoomAt18s(Matchmaker mm)
+    {
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 3), 0));
+        foreach (var t in new[] { 3.1, 6.2, 9.2, 12.3, 15.4 }) AssertWait(mm.Check(Leader, t));
+        var r = mm.Check(Leader, 18.5);
+        AssertCpuRoom(r.Room);
+        return r.Room!;
+    }
+
+    [Fact]
+    public void Matchmaker_default_is_off_and_config_default_is_two_seconds()
+    {
+        Assert.Equal(-1, new Matchmaker(3, true, 15, 1).ContinuePairAfterCpuSeconds);
+        Assert.Equal(2, new ServerInfinite.Models.Config.OnlineMatchingConfigurations().ContinuePairAfterCpuSeconds);
+    }
+
+    [Fact]
+    public void Pair_back_from_its_CPU_room_gets_the_next_CPU_room_on_the_first_poll()
+    {
+        var log = new List<string>();
+        var mm = New(afterCpu: 2, log);
+        var first = FirstSearchGetsCpuRoomAt18s(mm);
+        // 1:30:27: re-entry as the same pair 177 s after the first entry
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        var r = mm.Check(Leader, 180.1);                     // first poll, ~3 s (the cab gave up at 11.7 s)
+        AssertCpuRoom(r.Room);
+        Assert.NotEqual(first.RoomId, r.Room!.RoomId);
+        Assert.Equal(4u, r.ApplyId);
+        Assert.Contains(log, l => l.Contains("PAIR-SEARCH entry") && l.Contains("apply=4") && l.Contains("after-cpu=1") && l.Contains("cpu-wait=2s"));
+        Assert.Contains(log, l => l.Contains("continue pair:") && l.Contains("back from a CPU room"));
+        // the partner's poll gets the same room
+        Assert.Equal(r.Room.RoomId, mm.Check(Partner, 180.5).Room?.RoomId);
+    }
+
+    [Fact]
+    public void Off_keeps_the_old_18_second_wait_for_the_re_entry()
+    {
+        var mm = New(afterCpu: -1);
+        FirstSearchGetsCpuRoomAt18s(mm);
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        foreach (var t in new[] { 180.1, 183.2, 186.2 }) AssertWait(mm.Check(Leader, t));
+        AssertCpuRoom(mm.Check(Leader, 195.5).Room);
+    }
+
+    [Fact]
+    public void First_search_still_waits_ContinuePairSeconds()
+    {
+        var mm = New(afterCpu: 2);
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 3), 0));
+        AssertWait(mm.Check(Leader, 3.1));
+        AssertWait(mm.Check(Leader, 15.4));
+        AssertCpuRoom(mm.Check(Leader, 18.5).Room);
+    }
+
+    [Fact]
+    public void Pair_back_from_a_4_human_room_still_waits_ContinuePairSeconds()
+    {
+        var mm = New(afterCpu: 2);
+        // a 4-human class-team room: our duo vs another duo
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 3), 0));
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(1400, 1402, apply: 1), 1));
+        var room = mm.Check(Leader, 3.1).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+        // the winners continue as the same pair
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        AssertWait(mm.Check(Leader, 180.1));
+        AssertWait(mm.Check(Leader, 192.4));
+        AssertCpuRoom(mm.Check(Leader, 195.5).Room);
+    }
+
+    [Fact]
+    public void A_4_human_room_still_wins_over_the_fast_CPU_room()
+    {
+        var mm = New(afterCpu: 2);
+        FirstSearchGetsCpuRoomAt18s(mm);
+        // another duo is already searching in class-team when ours comes back from the CPU room
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(1400, 1402, apply: 1), 176));
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        var room = mm.Check(Leader, 180.1).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+        Assert.Equal(1400u, mm.Check(1400, 180.2).Room?.Clients.Select(c => c.Client.NodeId).First(n => n == 1400));
+    }
+
+    [Fact]
+    public void A_different_duo_is_not_treated_as_back_from_the_CPU_room()
+    {
+        var mm = New(afterCpu: 2);
+        FirstSearchGetsCpuRoomAt18s(mm);
+        // PCB_03 now teams with someone who was not in the CPU room
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, 1500, apply: 4), 177));
+        AssertWait(mm.Check(Leader, 180.1));
+        AssertWait(mm.Check(Leader, 192.4));
+    }
+
+    [Fact]
+    public void An_old_CPU_room_does_not_count()
+    {
+        var mm = New(afterCpu: 2);
+        FirstSearchGetsCpuRoomAt18s(mm);
+        // back after more than ContinuePairWindow (900 s)
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 1000));
+        AssertWait(mm.Check(Leader, 1003.1));
+        AssertCpuRoom(mm.Check(Leader, 1018.5).Room);
+    }
+
+    [Fact]
+    public void Cancel_mode_uses_the_short_wait_too()
+    {
+        var mm = New(afterCpu: 2);
+        mm.ContinuePairMode = Matchmaker.ContinuePairPolicy.VsCpu;
+        FirstSearchGetsCpuRoomAt18s(mm);
+        mm.ContinuePairMode = Matchmaker.ContinuePairPolicy.Cancel;
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(Leader, 180.1).Code);
+    }
+
+    [Fact]
+    public void Never_shorter_than_ContinuePairSeconds_allows()
+    {
+        var mm = New(afterCpu: 30);   // a larger value never lengthens the wait
+        FirstSearchGetsCpuRoomAt18s(mm);
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(Leader, Partner, apply: 4), 177));
+        AssertWait(mm.Check(Leader, 192.4));
+        AssertCpuRoom(mm.Check(Leader, 195.5).Room);
+    }
+}
