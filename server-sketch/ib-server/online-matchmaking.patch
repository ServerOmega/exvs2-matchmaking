+@* exvs2-lobbies 2026-11-15: the card's online tag teams as a clickable list. Each row opens the existing team editor
+   (Customize page, Teams tab) at that team. Used by the Teams page and the Teams tab of the Friends page. *@
+@using WebUIInfinite.Shared.Dto.Common
+@using WebUIInfinite.Shared.Dto.Response
+@using WebUIInfinite.Shared.Models
+@inject HttpClient Http
+@inject NavigationManager Nav
+
+@if (_failed)
+{
+    <MudAlert Severity="Severity.Warning" Class="my-2">@localizer["teams_unavailable"]</MudAlert>
+}
+
+<MudTable T="Team" Items="_teams" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading="_loading" Elevation="0"
+          OnRowClick="OnRowClick" RowClass="teams-row" RowStyle="cursor: pointer" aria-label="@localizer["teams_list"]">
+    <HeaderContent>
+        <MudTh>@localizer["teams_col_team"]</MudTh>
+        <MudTh>@localizer["teams_col_partner"]</MudTh>
+        <MudTh>@localizer["teams_col_pilotid"]</MudTh>
+        <MudTh>@localizer["teams_col_kind"]</MudTh>
+        <MudTh Style="text-align: right"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap">@localizer["teams_edit"]</span></MudTh>
+    </HeaderContent>
+    <RowTemplate>
+        <MudTd DataLabel="@localizer["teams_col_team"]">
+            <MudLink Href="@TagTeamLinks.EditHref(ChipId, context.Id)" Typo="Typo.body2" Style="word-break: break-word; font-weight: 500"
+                     UserAttributes="@(new Dictionary<string, object> { ["data-team-id"] = context.Id })">
+                @TagTeamLinks.DisplayName(context, string.Format(localizer["teams_unnamed"], context.Id))
+            </MudLink>
+        </MudTd>
+        <MudTd DataLabel="@localizer["teams_col_partner"]">
+            @if (string.IsNullOrWhiteSpace(context.PartnerName))
+            {
+                <MudText Typo="Typo.body2" Style="font-style: italic; opacity: .7">@localizer["teams_unknown_partner"]</MudText>
+            }
+            else
+            {
+                <MudText Typo="Typo.body2" Style="word-break: break-word">@context.PartnerName</MudText>
+            }
+        </MudTd>
+        <MudTd DataLabel="@localizer["teams_col_pilotid"]"><span style="font-family: monospace">@(context.PartnerPilotId == 0 ? "—" : context.PartnerPilotId.ToString())</span></MudTd>
+        <MudTd DataLabel="@localizer["teams_col_kind"]">
+            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
+                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(context.IsRemote ? localizer["teams_kind_remote"] : localizer["teams_kind_local"])</MudChip>
+                @if (context.OnlineTag || context.IsRemote)
+                {
+                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Groups">@localizer["teams_online_tag"]</MudChip>
+                }
+            </MudStack>
+        </MudTd>
+        <MudTd DataLabel="@localizer["teams_edit"]" Style="text-align: right; white-space: nowrap">
+            <MudTooltip Text="@localizer["teams_edit"]">
+                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Href="@TagTeamLinks.EditHref(ChipId, context.Id)"
+                               aria-label="@($"{localizer["teams_edit"]} {TagTeamLinks.DisplayName(context, string.Format(localizer["teams_unnamed"], context.Id))}")" />
+            </MudTooltip>
+        </MudTd>
+    </RowTemplate>
+    <NoRecordsContent>
+        <MudText Class="pa-4">@localizer["teams_empty"]</MudText>
+    </NoRecordsContent>
+    <LoadingContent>
+        <MudText Class="pa-4">@localizer["teams_loading"]</MudText>
+    </LoadingContent>
+</MudTable>
+
+<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3">
+    <MudText Typo="Typo.body2" role="status" aria-live="polite">@(_loading ? "" : string.Format(localizer["teams_count"], _teams.Count))</MudText>
+    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.GroupAdd" Href="@TagTeamLinks.EditHref(ChipId, 0)">@localizer["teams_open_editor"]</MudButton>
+</MudStack>
+
+@code {
+    [Parameter] public string ChipId { get; set; } = string.Empty;
+    [Parameter] public string AccessCode { get; set; } = string.Empty;
+    /// <summary>Called after every load with the card's teams (the Friends page uses it for its tab count).</summary>
+    [Parameter] public EventCallback<List<Team>> OnLoaded { get; set; }
+
+    private List<Team> _teams = new();
+    private bool _loading = true;
+    private bool _failed;
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (_loadedFor == (ChipId, AccessCode)) return;
+        _loadedFor = (ChipId, AccessCode);
+        await Reload();
+    }
+
+    private (string, string)? _loadedFor;
+
+    public async Task Reload()
+    {
+        _loading = true;
+        _failed = false;
+        StateHasChanged();
+        try
+        {
+            var r = await Http.GetFromJsonAsync<TeamResponse>($"/ui/team/getTeams/{Uri.EscapeDataString(AccessCode)}/{Uri.EscapeDataString(ChipId)}");
+            _teams = (r?.Teams ?? new List<Team>()).OrderBy(t => string.IsNullOrWhiteSpace(t.Name) ? 1 : 0)
+                .ThenBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase).ThenBy(t => t.Id).ToList();
+        }
+        catch (Exception)
+        {
+            _failed = true;
+            _teams = new List<Team>();
+        }
+        finally
+        {
+            _loading = false;
+        }
+        await OnLoaded.InvokeAsync(_teams);
+        StateHasChanged();
+    }
+
+    private void OnRowClick(TableRowClickEventArgs<Team> e)
+    {
+        if (e.Item is null) return;
+        Nav.NavigateTo(TagTeamLinks.EditHref(ChipId, e.Item.Id));
+    }
+}
