new file mode 100644
index 0000000..dc6ed46
--- /dev/null
+++ b/WebUIInfinite/Client/Services/CardLogin.cs
@@ -0,0 +1,29 @@
+using System.Net.Http.Json;
+using WebUIInfinite.Shared.Dto.Request;
+using WebUIInfinite.Shared.Dto.Response;
+
+namespace WebUIInfinite.Client.Services;
+
+/// <summary>
+/// fix2 2026-11-15: checks a saved (chip id, access code) pair with the server before a card page uses it, so a stale
+/// tab / reload never combines one card's access code with another card's chip id. Both values travel in the POST
+/// body (never the URL, which is logged).
+/// </summary>
+public static class CardLogin
+{
+    public static async Task<bool> Verify(HttpClient http, string chipId, string accessCode)
+    {
+        if (string.IsNullOrEmpty(chipId) || string.IsNullOrEmpty(accessCode)) return false;
+        try
+        {
+            var response = await http.PostAsJsonAsync("ui/card/authorize",
+                new CardAuthorizationRequest { CardId = 0, ChipId = chipId, AccessCode = accessCode });
+            var result = await response.Content.ReadFromJsonAsync<CardAuthorizationResponse>();
+            return result is { Success: true } && result.ChipId == chipId;
+        }
+        catch (Exception)
+        {
+            return false;
+        }
+    }
+}
