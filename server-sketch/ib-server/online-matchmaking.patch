--- /dev/null
+++ b/Tests/Matchmaking.Tests/TagPairTests.cs
@@ -0,0 +1,52 @@
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>2026-11-15: joined pair codes used by friendships (auto online tag team).</summary>
+public class TagPairTests
+{
+    [Fact]
+    public void EnsureJoinedPairCreatesOnceAndFindsEitherDirection()
+    {
+        var t = new TagInviteStore();
+        var (code, created) = t.EnsureJoinedPair(1_000_002, "a", 2_000_002, "b");
+        Assert.True(created);
+        Assert.Equal(TagInviteStore.CodeLength, code.Length);
+        var inv = t.Get(code)!;
+        Assert.True(inv.Joined);
+        Assert.NotNull(inv.JoinedUtc);
+        var (again, created2) = t.EnsureJoinedPair(2_000_002, "b", 1_000_002, "a");
+        Assert.False(created2);
+        Assert.Equal(code, again);
+        Assert.Equal(new[] { code }, t.PairCodes(2_000_002, 1_000_002));
+        // the code is registrable for world 5 by both partners only
+        Assert.Single(t.RegisterSearch(1_000_002, new[] { code }));
+        Assert.Single(t.RegisterSearch(2_000_002, new[] { code }));
+        Assert.Empty(t.RegisterSearch(3_000_001, new[] { code }));
+    }
+
+    [Fact]
+    public void OpenCodesDoNotCountAsAPair()
+    {
+        var t = new TagInviteStore();
+        t.Create(1_000_002, "a");
+        Assert.Empty(t.PairCodes(1_000_002, 2_000_002));
+        Assert.Throws<ArgumentOutOfRangeException>(() => t.EnsureJoinedPair(1_000_002, "a", 1_000_002, "a"));
+        Assert.Throws<ArgumentOutOfRangeException>(() => t.EnsureJoinedPair(0, "a", 1, "b"));
+    }
+
+    [Fact]
+    public void DeletePairRemovesEverySharedCodeOnly()
+    {
+        var t = new TagInviteStore();
+        var c1 = t.Create(1_000_002, "a"); t.Join(c1, 2_000_002, "b");
+        var c2 = t.Create(2_000_002, "b"); t.Join(c2, 1_000_002, "a");
+        var other = t.Create(1_000_002, "a"); t.Join(other, 3_000_001, "c");
+        var deleted = t.DeletePair(1_000_002, 2_000_002);
+        Assert.Equal(2, deleted.Count);
+        Assert.Null(t.Get(c1)); Assert.Null(t.Get(c2));
+        Assert.NotNull(t.Get(other));
+        Assert.Empty(t.DeletePair(1_000_002, 2_000_002));
+    }
+}
