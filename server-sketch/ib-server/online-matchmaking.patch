+        // plus a burst of post-match requests every 60 s.
+        for (var c = 0; c < 16 * 3; c++) Assert.True(rl.TryAcquire("203.0.113.50", 0));
+        for (var t = 0.0; t < 600; t += 3)
+        {
+            for (var c = 0; c < 16; c++) Assert.True(rl.TryAcquire("203.0.113.50", t + c * 0.01));
+            if ((int)t % 60 == 0)
