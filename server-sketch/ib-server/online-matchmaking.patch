+using nue.protocol.mms;
+using Serilog.Events;
+using Serilog.Parsing;
+using ServerInfinite.Lobbies;
+using ServerInfinite.Lobbies.Serilog;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// fix2 2026-11-15 (after the 4-cab test at 6:58 AM PT): same-server online tag under the code rules, the
+// "waiting for partner" diagnostics line, two tag pairs becoming one 2v2, and card secrets masked in request paths.
+public class Fix2Tests
+{
+    // fake values shaped like a 20-digit access code and a 32-hex chip id (not real cards)
+    private const string Ac = "12345678901234567890";
+    private const string Chip = "0123456789ABCDEF0123456789ABCDEF";
+
+    private static Client Cl(uint node, string serial)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial, LocId = "L" + serial, PrefCode = 13, GlobalIpaddress = "",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Solo(uint node, uint am, uint world, long attr2 = 0, Client? partner = null,
+        Player? partnerPlayer = null, uint applyId = 1, bool cpuPartner = false)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = applyId, Myclient = Cl(node, "S" + node), MatchingTimeout = world == Matchmaker.OnlineTagWorld ? 90u : 150u,
+            Myplayer = new Player { BanapassportAmId = am },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = attr2 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 3, parameter = 0 });
+        if (partner != null)
+            e.Groups.Add(new Request.EntryMatching.Group { Client = partner, Player = partnerPlayer ?? new Player() });
+        if (cpuPartner)
+        {
+            var npc = new Client { NodeId = node + 1, PcbSerial = Matchmaker.NpcSerial };
+            npc.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "N" });
+            e.Groups.Add(new Request.EntryMatching.Group { Client = npc, Player = new Player() });
+        }
+        return e;
+    }
+
+    private static (Matchmaker mm, TagInviteStore store, List<string> log) New()
+    {
+        var log = new List<string>();
+        var store = new TagInviteStore();
+        var mm = new Matchmaker(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, NoCpuPartner = true, Invites = store, Log = log.Add, Warn = log.Add
+        };
+        return (mm, store, log);
+    }
+
+    [Fact]
+    public void SameServerCodeTeamStillPairsUnderTheCreatorOrPartnerRule()
+    {
+        var (mm, store, log) = New();
+        var code = store.Create(2_000_003, "LITTLE TEST");      // both cards on card server 2
+        store.Join(code, 2_000_004, "LITTLE TEST");
+        Assert.Single(store.RegisterSearch(2_000_003, new[] { code }));
+        Assert.Single(store.RegisterSearch(2_000_004, new[] { code }));
+        Assert.Empty(store.RegisterSearch(2_000_002, new[] { code }));   // a third pilot cannot borrow it
+        mm.Entry(Solo(1032, 2_000_003, Matchmaker.OnlineTagWorld, 2_000_003), 0);
+        mm.Entry(Solo(1030, 2_000_004, Matchmaker.OnlineTagWorld, 2_000_003), 1);
+        var room = mm.Check(1032, 2).Room;
+        Assert.NotNull(room);
+        Assert.Same(room, mm.Check(1030, 2).Room);
+        Assert.DoesNotContain(log, l => l.Contains("TAG-WAIT"));
+    }
+
+    [Fact]
+    public void AloneTagSearchLogsWaitingForPartnerOnceAfterTwentySeconds()
+    {
+        var (mm, store, log) = New();
+        var code = store.Create(2_000_003, "LITTLE TEST");
+        store.Join(code, 2_000_004, "LITTLE TEST");
+        store.RegisterSearch(2_000_003, new[] { code });
+        mm.Entry(Solo(1032, 2_000_003, Matchmaker.OnlineTagWorld, 2_000_003), 0);
+        mm.Check(1032, 10);
+        Assert.DoesNotContain(log, l => l.Contains("TAG-WAIT"));
+        mm.Check(1032, 20);
+        mm.Check(1032, 23);
+        mm.Check(1032, 60);
+        var waits = log.Where(l => l.Contains("TAG-WAIT")).ToList();
+        Assert.Single(waits);
+        Assert.Contains("waiting for partner 2000004: partner not searching", waits[0]);
+        Assert.Contains("node=1032", waits[0]);
+        Assert.DoesNotContain(code, waits[0]);                           // only the masked code
+        Assert.Contains("tag=" + TagInviteStore.MaskCode(code), waits[0]);
+    }
+
+    [Fact]
+    public void WaitLineSaysWhenThePartnerIsQueuedInAnotherModeInstead()
+    {
+        // 6:59 AM PT: cab 3 went to team mode with a CPU partner while cab 4 searched online tag for it
+        var (mm, store, log) = New();
+        var code = store.Create(2_000_003, "LITTLE TEST");
+        store.Join(code, 2_000_004, "LITTLE TEST");
+        store.RegisterSearch(2_000_003, new[] { code });
+        mm.Entry(Solo(1032, 2_000_003, Matchmaker.OnlineTagWorld, 2_000_003), 0);
+        mm.Entry(Solo(1030, 2_000_004, 14, cpuPartner: true), 5);
+        mm.Check(1032, 21);
+        var w = Assert.Single(log, l => l.Contains("TAG-WAIT"));
+        Assert.Contains("waiting for partner 2000004: partner is in the queue as node=1030", w);
+        Assert.Contains("cannot pair", w);
+    }
+
+    [Fact]
+    public void LegacySameServerSearchNamesThePartnerFromThePairKey()
+    {
+        var (mm, _, log) = New();
+        mm.Entry(Solo(1030, 2_000_004, Matchmaker.OnlineTagWorld, attr2: 2_000_003), 0);   // no code: attr2 = min
+        mm.Check(1030, 25);
+        Assert.Contains(log, l => l.Contains("TAG-WAIT") && l.Contains("waiting for partner 2000003: partner not searching"));
+    }
+
+    [Fact]
+    public void WaitLogCanBeTurnedOff()
+    {
+        var (mm, _, log) = New();
+        mm.PartnerWaitLogAfter = 0;
+        mm.Entry(Solo(1030, 2_000_004, Matchmaker.OnlineTagWorld, attr2: 2_000_003), 0);
+        mm.Check(1030, 60);
+        Assert.DoesNotContain(log, l => l.Contains("TAG-WAIT"));
+    }
+
+    [Fact]
+    public void TwoTagPairsCrossAndSameServerBecomeOne2v2Room()
+    {
+        var (mm, store, _) = New();
+        var big = store.Create(1_000_001, "BIG TEST"); store.Join(big, 2_000_002, "BIG TEST");
+        var little = store.Create(2_000_003, "LITTLE TEST"); store.Join(little, 2_000_004, "LITTLE TEST");
+        foreach (var (am, c) in new[] { (1_000_001u, big), (2_000_002u, big), (2_000_003u, little), (2_000_004u, little) })
+            store.RegisterSearch(am, new[] { c });
+        var e1 = Solo(1026, 1_000_001, Matchmaker.OnlineTagWorld, 1_000_001);
+        var e2 = Solo(1028, 2_000_002, Matchmaker.OnlineTagWorld, 1_000_001);
+        var e3 = Solo(1032, 2_000_003, Matchmaker.OnlineTagWorld, 2_000_003);
+        var e4 = Solo(1030, 2_000_004, Matchmaker.OnlineTagWorld, 2_000_003);
+        mm.Entry(e1, 0); mm.Entry(e2, 0); mm.Entry(e3, 1); mm.Entry(e4, 1);
+        var p1 = mm.Check(1026, 2).Room; var p2 = mm.Check(1032, 2).Room;
+        Assert.NotNull(p1); Assert.NotNull(p2); Assert.NotSame(p1, p2);
+        // each leader sends its duo into the team queue (world 14, as at 6:58:49)
+        mm.Entry(Solo(1026, 1_000_001, 14, attr2: 2, partner: e2.Myclient, partnerPlayer: e2.Myplayer, applyId: 2), 10);
+        mm.Entry(Solo(1032, 2_000_003, 14, attr2: 2, partner: e4.Myclient, partnerPlayer: e4.Myplayer, applyId: 2), 12);
+        var room = mm.Check(1026, 13).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Clients.Count);
+        Assert.Same(room, mm.Check(1032, 13).Room);
+    }
+
+    // ---- card secrets in request paths ----
+
+    [Theory]
+    [InlineData("/ui/team/getTeams/{0}/{1}")]
+    [InlineData("/ui/card/getBasicDisplayProfile/{0}/{1}")]
+    [InlineData("/ui/battle-history/get-recent-battle-histories/{0}/{1}")]
+    [InlineData("/ui/player-level/getPlayerLevelProfile/{0}/{1}")]
+    [InlineData("/ui/training/get/{0}/{1}")]
+    [InlineData("http://localhost:28090/ui/navi/getNaviProfile/{0}/{1}?x=1")]
+    [InlineData("/ui/card/getBy/{0}")]
+    [InlineData("/upload/uploadImage/12/{0}")]
+    [InlineData("/ui/team/checkPlayerExistence/2000004/{1}")]
+    [InlineData("/ui/x?accessCode={0}&chipId={1}")]
+    [InlineData("HTTP GET /something/{1} responded 200")]
+    public void RequestPathsNeverKeepAccessCodesOrChipIds(string template)
+    {
+        var raw = string.Format(template, Ac, Chip);
+        var m = LogMask.MaskUrlSecrets(raw);
+        Assert.DoesNotContain(Ac, m);
+        Assert.DoesNotContain(Chip, m);
+        Assert.Contains("<masked:", m);
+    }
+
+    [Theory]
+    [InlineData("/ui/team/upsertTeams")]
+    [InlineData("/tag/invites/for/2000004")]
+    [InlineData("/ui/rank/player-level-rank/getAll")]
+    [InlineData("key=GIB1|106547|5|0|2000003 level=1")]
+    public void OrdinaryPathsAreUnchanged(string raw) => Assert.Equal(raw, LogMask.MaskUrlSecrets(raw));
+
+    [Fact]
+    public void EnricherMasksTheRequestPathAndHttpClientUriProperties()
+    {
+        var ev = new LogEvent(DateTimeOffset.Now, LogEventLevel.Information, null,
+            new MessageTemplateParser().Parse("HTTP {RequestMethod} {RequestPath} responded {StatusCode} {Uri}"),
+            new[]
+            {
+                new LogEventProperty("RequestMethod", new ScalarValue("GET")),
+                new LogEventProperty("RequestPath", new ScalarValue($"/ui/team/getTeams/{Ac}/{Chip}")),
+                new LogEventProperty("StatusCode", new ScalarValue(200)),
+                new LogEventProperty("Uri", new ScalarValue(new Uri($"http://127.0.0.1:28090/ui/card/getBy/{Ac}"))),
+            });
+        new CardSecretMaskEnricher().Enrich(ev, null!);
+        var text = ev.RenderMessage();
+        Assert.DoesNotContain(Ac, text);
+        Assert.DoesNotContain(Chip, text);
+        Assert.Contains("/ui/team/getTeams/<masked:20>/<masked:32>", text);
+    }
+}
