@@ -0,0 +1,512 @@
+@page "/Cards/Friends/{ChipId}"
+@* exvs2-lobbies 2026-11-15: friends, friend requests and block list. Built for big lists: search, sort and paging
+   happen on the server (only one page is ever loaded), bulk select works per page, every destructive action asks first. *@
+@using WebUIInfinite.Shared.Dto.Request
+@using WebUIInfinite.Shared.Dto.Response
+@using WebUIInfinite.Client.Pages.Dialogs
+@inject ISnackbar Snackbar
+@inject HttpClient Http
+@inject IDialogService DialogService
+@inject IJSRuntime JS
+
+<PageTitle>@localizer["friends_title"]</PageTitle>
+<MudBreadcrumbs Items="_breadcrumbs" Class="px-0"></MudBreadcrumbs>
+
+@if (_errorMessage is not null)
+{
+    <MudAlert Severity="Severity.Error" Class="my-4">@_errorMessage</MudAlert>
+    return;
+}
+
+<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
+    <MudText Typo="Typo.h4" HtmlTag="h1">@localizer["friends_title"]</MudText>
+    @if (_page.YourPilotId != 0)
+    {
+        <MudPaper Outlined="true" Class="px-3 py-1 d-flex align-center gap-2">
+            <MudText Typo="Typo.body2">@localizer["friends_your_id"]</MudText>
+            <MudText Typo="Typo.subtitle1" Style="font-family: monospace">@_page.YourPilotId</MudText>
+            <MudTooltip Text="@localizer["friends_copy_id"]">
+                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="@localizer["friends_copy_id"]" OnClick="CopyId" />
+            </MudTooltip>
+        </MudPaper>
+    }
+</MudStack>
+<MudText Typo="Typo.body2" Class="mb-2">@localizer["friends_help"]</MudText>
+
+<MudTabs Outlined="true" Rounded="true" Border="true" Class="mt-4" PanelClass="pa-0"
+         ActivePanelIndex="_tabIndex" ActivePanelIndexChanged="OnTabChanged">
+    <MudTabPanel Text="@($"{localizer["friends_tab_friends"]} ({_page.Counts.Friends})")" />
+    <MudTabPanel Text="@($"{localizer["friends_tab_requests"]} ({_page.Counts.Incoming + _page.Counts.Outgoing})")"
+                 BadgeData="@(_page.Counts.Incoming > 0 ? _page.Counts.Incoming : null)" BadgeColor="Color.Error" />
+    <MudTabPanel Text="@($"{localizer["friends_tab_blocked"]} ({_page.Counts.Blocked})")" />
+</MudTabs>
+
+<MudPaper Outlined="true" Class="pa-4 mt-n1">
+    @if (_tab == "requests")
+    {
+        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3" aria-label="@localizer["friends_requests_filter"]">
+            <MudButton Variant="@(_requestsView == "requests" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetRequestsView("requests"))">@localizer["friends_requests_all"] (@(_page.Counts.Incoming + _page.Counts.Outgoing))</MudButton>
+            <MudButton Variant="@(_requestsView == "incoming" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetRequestsView("incoming"))">@localizer["friends_requests_incoming"] (@_page.Counts.Incoming)</MudButton>
+            <MudButton Variant="@(_requestsView == "outgoing" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetRequestsView("outgoing"))">@localizer["friends_requests_outgoing"] (@_page.Counts.Outgoing)</MudButton>
+        </MudButtonGroup>
+    }
+
