+    // ---- LAN-only / public matchmaker source filter ----
+
+    [Theory]
+    [InlineData("127.0.0.1", true)]
+    [InlineData("::1", true)]
+    [InlineData("10.10.0.2", true)]          // N2N overlay on the PC
