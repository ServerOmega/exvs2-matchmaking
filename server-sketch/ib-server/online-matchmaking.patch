+@* exvs2-lobbies 2026-11-15: the tag team(s) shared with one friend, each linking to that team's Edit Team page. *@
+@using WebUIInfinite.Shared.Dto.Common
+@using WebUIInfinite.Shared.Models
+
+@if (Teams is { Count: > 0 })
+{
+    <MudStack Row="@Row" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="@Class">
+        @foreach (var team in Teams)
+        {
+            var teamName = TagTeamLinks.DisplayName(team, string.Format(localizer["teams_unnamed"], team.Id));
+            <MudLink Href="@TagTeamLinks.EditHref(ChipId, team.Id)" Typo="@Typo"
+                     Class="d-inline-flex align-center gap-1" Style="word-break: break-word"
+                     aria-label="@string.Format(localizer["friends_open_team"], teamName)"
+                     data-team-id="@team.Id">
+                <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Success" Size="Size.Small" />@teamName
+            </MudLink>
+        }
+    </MudStack>
+}
+else if (HasTagTeam)
+{
+    <MudTooltip Text="@localizer["friends_tagteam_pending"]">
+        <MudLink Href="@TagTeamLinks.ListHref(ChipId)" Typo="@Typo" Class="d-inline-flex align-center gap-1"
+                 aria-label="@localizer["friends_has_tagteam"]">
+            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Success" Size="Size.Small" />@localizer["friends_tagteam_pending"]
+        </MudLink>
+    </MudTooltip>
+}
+else if (ShowDash)
+{
+    <span>—</span>
+}
+
+@code {
+    [Parameter] public string ChipId { get; set; } = string.Empty;
+    [Parameter] public List<Team>? Teams { get; set; }
+    [Parameter] public bool HasTagTeam { get; set; }
+    [Parameter] public bool ShowDash { get; set; }
+    [Parameter] public bool Row { get; set; } = true;
+    [Parameter] public Typo Typo { get; set; } = Typo.body2;
+    [Parameter] public string? Class { get; set; }
+}
