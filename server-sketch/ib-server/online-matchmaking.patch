+    /// <summary>CrossWorldTeamRooms: a lone all-human duo in a team world + exactly two all-human solos (and nobody else)
+    /// in the linked solo world -> one 4-human room.</summary>
+    private bool TryCrossWorldRoom(double now)
+    {
+        static bool AllHuman(Unit u) => u.Clients.All(Unit.IsHuman) && !u.Pair && !u.OneOnOne;
+        static string Game(Unit u) { var p = u.BaseKey.Split('|'); return p.Length >= 4 ? $"{p[0]}|{p[1]}|{p[3]}" : u.BaseKey; }
+        foreach (var d in _queue.Where(u => u.Room == null && u.IsTeam && u.Slots == TeamSlots && AllHuman(u)).ToList())
+        {
+            if (!CrossWorldOk.Contains(d.World) || !LinkedWorlds.TryGetValue(d.World, out var soloWorld) || !CrossWorldOk.Contains(soloWorld))
+                continue;
+            if (d.World < soloWorld) continue;                       // 14 -> 13, 19 -> 18: d must be the team world
+            if (_queue.Any(u => !ReferenceEquals(u, d) && u.Room == null && u.World == d.World && Game(u) == Game(d))) continue;
+            var solos = _queue.Where(u => u.Room == null && u.World == soloWorld && Game(u) == Game(d)).OrderBy(u => u.Created).ToList();
+            if (solos.Count != 2 || !solos.All(u => !u.IsTeam && AllHuman(u))) continue;
+            Log?.Invoke($"cross-world room: team nodes=[{string.Join(",", d.NodeIds)}] ({d.WorldName}) + solos " +
+                        $"[{solos[0].Clients[0].NodeId},{solos[1].Clients[0].NodeId}] ({solos[0].WorldName}), EXPERIMENTAL");
+            MakeRoom((new List<Unit> { d }, solos), now);
+            return true;
+        }
+        return false;
+    }
