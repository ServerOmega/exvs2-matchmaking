+#!/usr/bin/env python3
+"""exvs2-lobbies security hardening: add missing security defaults to a VPS server.json and, when a secret arrives on
+stdin, set OnlineTag.TagSecret. Never prints the secret. Used by deploy.sh (runs on the VPS as root).
+
+    python3 apply-security-config.py /opt/exvs2-mm/Configurations/server.json < secret_file
+"""
+import json, os, sys
+
+path = sys.argv[1]
+secret = sys.stdin.read().strip() if not sys.stdin.isatty() else ""
+with open(path, encoding="utf-8-sig") as f:
+    d = json.load(f)
+c = d.setdefault("CardServerConfig", {})
+sec = c.setdefault("Security", {})
+sec.setdefault("AccessMode", "PublicMatchmaker")   # internet: /match, /mms, /tag only
+tag = c.setdefault("OnlineTag", {})
+tag.setdefault("OpenCodeExpiryDays", 7)
+tag.setdefault("JoinedCodeExpiryDays", 90)
+if secret:
+    tag["TagSecret"] = secret
+tmp = path + ".tmp"
+fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
+with os.fdopen(fd, "w", encoding="utf-8") as f:
+    f.write(json.dumps(d, indent=4, ensure_ascii=False) + "\n")
+os.replace(tmp, path)
+print("   server.json: Security.AccessMode=%s, OnlineTag.TagSecret %s"
+      % (sec["AccessMode"], "set" if tag.get("TagSecret") else "NOT set (/tag answers loopback only)"))
