+                    <MudText Typo="Typo.h5" Color="@(rec.Battles == 0 ? Color.Default : Color.Primary)">@Pct(rec.WinRate, rec.Battles)</MudText>
+                    <MudText Typo="Typo.body2">@rec.Wins @localizer["card_stats_w"] / @rec.Losses @localizer["card_stats_l"]</MudText>
+                    <MudText Typo="Typo.caption">@rec.Battles @localizer["card_stats_battles"]</MudText>
+                </MudPaper>
+            </MudItem>
+        }
+    </MudGrid>
+
+    <MudGrid Spacing="2">
+        <MudItem xs="12" md="7">
+            <MudSimpleTable Dense="true" Elevation="2" Bordered="true">
+                <tbody>
+                    <tr><td>@localizer["card_stats_total_damage"]</td><td style="text-align:right">@CardStats.Totals.GivenDamage.ToString("N0")</td></tr>
+                    <tr><td>@localizer["card_stats_avg_damage"]</td><td style="text-align:right">@Avg(CardStats.Totals.GivenDamage, PvpBattles)</td></tr>
+                    <tr><td>@localizer["card_stats_defeated"]</td><td style="text-align:right">@CardStats.Totals.EnemyDefeated.ToString("N0")</td></tr>
+                    <tr><td>@localizer["card_stats_no_damage"]</td><td style="text-align:right">@CardStats.Totals.NoDamageBattles.ToString("N0")</td></tr>
+                    <tr><td>@localizer["card_stats_ex_burst_damage"]</td><td style="text-align:right">@CardStats.Totals.ExBurstDamage.ToString("N0")</td></tr>
+                    <tr><td>@localizer["card_stats_class_streaks"]</td><td style="text-align:right">@CardStats.Totals.ClassTenWinStreaks.ToString("N0")</td></tr>
+                </tbody>
+            </MudSimpleTable>
+        </MudItem>
+        <MudItem xs="12" md="5">
+            <MudSimpleTable Dense="true" Elevation="2" Bordered="true">
+                <thead>
+                    <tr><th>@localizer["card_stats_burst"]</th><th style="text-align:right">@localizer["card_stats_battles"]</th><th style="text-align:right">@localizer["card_stats_win_rate"]</th></tr>
+                </thead>
+                <tbody>
+                    @if (CardStats.Bursts.Count == 0)
+                    {
+                        <tr><td colspan="3">-</td></tr>
+                    }
+                    @foreach (var b in CardStats.Bursts)
+                    {
+                        <tr><td>@BurstName(b.BurstType)</td><td style="text-align:right">@b.Battles</td><td style="text-align:right">@Pct(b.WinRate, b.Battles)</td></tr>
+                    }
+                </tbody>
+            </MudSimpleTable>
+        </MudItem>
+    </MudGrid>
+
+    @* ---- per suit ---- *@
+    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-4">
+        <MudText Typo="Typo.h6">@localizer["card_stats_by_suit"]</MudText>
+        <MudSpacer/>
+        <div style="min-width:220px">
+            <MudSelect T="string" Value="_mode" ValueChanged="OnModeChanged" Label="@localizer["card_stats_mode"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
+                @foreach (var m in _modes)
+                {
+                    <MudSelectItem T="string" Value="@m">@ModeName(m)</MudSelectItem>
+                }
+            </MudSelect>
+        </div>
+    </MudStack>
+    <MudText Typo="Typo.caption">@(_mode == SuitStatsRow.AllModes ? localizer["card_stats_note_lifetime"] : localizer["card_stats_note_history"])</MudText>
+
+    <MudTable Elevation="3" Items="@_rows" T="SuitStatsRow" Hover="true" Dense="true" FixedHeader="true" Breakpoint="Breakpoint.Sm"
+              RowsPerPage="25">
+        <HeaderContent>
+            <MudTh><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => SuitName(x.MobileSuitId)))">@localizer["card_stats_suit"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => SuitCost(x.MobileSuitId)))">@localizer["card_stats_cost"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="@(new Func<SuitStatsRow, object>(x => x.Battles))">@localizer["card_stats_battles"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.Wins))">@localizer["card_stats_wins"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.Losses))">@localizer["card_stats_losses"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.WinRate))">@localizer["card_stats_win_rate"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.AverageDamage))">@localizer["card_stats_avg_damage"]</MudTableSortLabel></MudTh>
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.AverageTaken ?? -1))">@localizer["card_stats_avg_taken"]</MudTableSortLabel></MudTh>
+            @if (_mode == SuitStatsRow.AllModes)
+            {
+                <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.EnemyDefeated ?? 0))">@localizer["card_stats_defeated"]</MudTableSortLabel></MudTh>
+                <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.DefeatedPerBattle ?? 0))">@localizer["card_stats_defeated_per_battle"]</MudTableSortLabel></MudTh>
+                <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.NoDamageBattles ?? 0))">@localizer["card_stats_no_damage"]</MudTableSortLabel></MudTh>
+                <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.ExBurstDamage ?? 0))">@localizer["card_stats_ex_burst_damage"]</MudTableSortLabel></MudTh>
+            }
+            <MudTh Style="text-align:center"><MudTableSortLabel SortBy="@(new Func<SuitStatsRow, object>(x => x.LastPlayedAt))">@localizer["card_stats_last_played"]</MudTableSortLabel></MudTh>
+        </HeaderContent>
+        <RowTemplate>
+            <MudTd DataLabel="@localizer["card_stats_suit"]">
+                <div class="d-flex gap-3 align-center">
+                    <img src="@($"images/mobile_suits/{context.MobileSuitId}.webp")" alt="" style="width:72px" onerror="this.style.display='none'"/>
+                    <span>@SuitName(context.MobileSuitId)</span>
+                </div>
+            </MudTd>
+            <MudTd DataLabel="@localizer["card_stats_cost"]" Style="text-align:center">@CostText(context.MobileSuitId)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_battles"]" Style="text-align:center">@context.Battles</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_wins"]" Style="text-align:center">@context.Wins</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_losses"]" Style="text-align:center">@context.Losses</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_win_rate"]" Style="text-align:center">@Pct(context.WinRate, context.Battles)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_avg_damage"]" Style="text-align:center">@(context.Battles == 0 ? "-" : context.AverageDamage.ToString("N0"))</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_avg_taken"]" Style="text-align:center">@(context.AverageTaken is null ? "-" : context.AverageTaken.Value.ToString("N0"))</MudTd>
+            @if (_mode == SuitStatsRow.AllModes)
+            {
+                <MudTd DataLabel="@localizer["card_stats_defeated"]" Style="text-align:center">@context.EnemyDefeated</MudTd>
+                <MudTd DataLabel="@localizer["card_stats_defeated_per_battle"]" Style="text-align:center">@((context.DefeatedPerBattle ?? 0).ToString("0.00"))</MudTd>
+                <MudTd DataLabel="@localizer["card_stats_no_damage"]" Style="text-align:center">@context.NoDamageBattles</MudTd>
+                <MudTd DataLabel="@localizer["card_stats_ex_burst_damage"]" Style="text-align:center">@((context.ExBurstDamage ?? 0).ToString("N0"))</MudTd>
+            }
+            <MudTd DataLabel="@localizer["card_stats_last_played"]" Style="text-align:center">@Date(context.LastPlayedAt)</MudTd>
+        </RowTemplate>
+        <NoRecordsContent>
+            <MudText>@localizer["card_stats_no_battles"]</MudText>
+        </NoRecordsContent>
+        <PagerContent>
+            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50, 100 })"/>
+        </PagerContent>
+    </MudTable>
+
+    @* ---- recent battles ---- *@
+    <MudText Typo="Typo.h6" Class="mt-4">@localizer["card_stats_recent"]</MudText>
+    <MudTable Elevation="3" Items="@CardStats.RecentBattles" T="RecentBattleDto" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
+        <HeaderContent>
+            <MudTh>@localizer["card_stats_date"]</MudTh>
+            <MudTh>@localizer["card_stats_mode"]</MudTh>
+            <MudTh>@localizer["card_stats_suit"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_result"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_damage_dealt"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_damage_taken"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_time"]</MudTh>
+        </HeaderContent>
+        <RowTemplate>
+            <MudTd DataLabel="@localizer["card_stats_date"]">@Date(context.PlayedAt, true)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_mode"]">@ModeName(context.Mode)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_suit"]">@SuitName(context.MobileSuitId)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_result"]" Style="text-align:center">
+                @if (context.IsWin)
+                {
+                    <MudText Color="Color.Info" Typo="Typo.body2">WIN</MudText>
+                }
+                else
+                {
+                    <MudText Color="Color.Error" Typo="Typo.body2">LOSE</MudText>
+                }
+            </MudTd>
+            <MudTd DataLabel="@localizer["card_stats_damage_dealt"]" Style="text-align:center">@context.GivenDamage</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_damage_taken"]" Style="text-align:center">@context.TakenDamage</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_time"]" Style="text-align:center">@($"{context.ElapsedSeconds / 60}:{context.ElapsedSeconds % 60:00}")</MudTd>
+        </RowTemplate>
+        <NoRecordsContent>
+            <MudText>@localizer["card_stats_no_battles"]</MudText>
+        </NoRecordsContent>
+    </MudTable>
+</MudStack>
+
+@code {
+    [Parameter] public CardStatsDto? CardStats { get; set; }
+
+    private string _mode = SuitStatsRow.AllModes;
+    private List<string> _modes = new() { SuitStatsRow.AllModes };
+    private List<SuitStatsRow> _rows = new();
+    private CardStatsDto? _built;
+
+    private static readonly string[] SummaryOrder =
+    {
+        StatsModes.Total, StatsModes.Offline, StatsModes.ClassSolo, StatsModes.ClassTeam, StatsModes.Mix, StatsModes.Fes, StatsModes.Other,
+    };
+
+    private IEnumerable<ModeRecordDto> SummaryRecords => CardStats is null
+        ? Enumerable.Empty<ModeRecordDto>()
+        : SummaryOrder
+            .Select(m => CardStats.ModeRecords.FirstOrDefault(r => r.Mode == m))
+            .Where(r => r is not null && (r.Battles > 0 || r.Mode is StatsModes.Total or StatsModes.Offline or StatsModes.ClassSolo or StatsModes.Mix))
+            .Select(r => r!);
+
+    private ulong PvpBattles => CardStats is null ? 0 : (ulong)CardStats.Suits.Sum(s => (long)s.Battles);
+
+    protected override void OnParametersSet()
+    {
+        if (ReferenceEquals(_built, CardStats)) return;
+        _built = CardStats;
+        if (CardStats is null) return;
+        _modes = SuitStatsRow.AvailableModes(CardStats.Suits);
+        if (!_modes.Contains(_mode)) _mode = SuitStatsRow.AllModes;
+        _rows = SuitStatsRow.Build(CardStats.Suits, _mode);
+    }
+
+    private void OnModeChanged(string mode)
+    {
+        _mode = mode;
+        _rows = CardStats is null ? new() : SuitStatsRow.Build(CardStats.Suits, _mode);
+    }
+
+    private MobileSuit? Suit(uint id) => MobileSuitDataService.GetMobileSuitById(id);
+
+    private string SuitName(uint id)
+    {
+        var ms = Suit(id);
+        if (ms is null) return $"#{id}";
+        var lang = Thread.CurrentThread.CurrentCulture.Name;
+        var name = lang switch
+        {
+            "ja" => ms.ValueJP,
+            "zh-Hans" => ms.ValueCN,
+            "zh-Hant" => ms.ValueTC,
+            "zh-Hant-TW" => ms.ValueTC2,
+            _ => ms.Value,
+        };
+        return string.IsNullOrWhiteSpace(name) ? ms.Value : name;
+    }
+
+    private uint SuitCost(uint id) => Suit(id)?.Cost ?? 0;
+
+    private string CostText(uint id)
+    {
+        var cost = SuitCost(id);
+        return cost == 0 ? "-" : cost.ToString();
+    }
+
+    private string ModeName(string mode) => localizer[$"card_stats_mode_{mode}"];
+
+    private string BurstName(uint burstType) => burstType switch
+    {
+        0 => localizer["card_stats_burst_extend"],
+        1 => localizer["card_stats_burst_fighting"],
+        2 => localizer["card_stats_burst_shooting"],
+        _ => $"#{burstType}",
+    };
+
+    private static string Pct(double rate, uint battles) => battles == 0 ? "-" : rate.ToString("0.0") + "%";
+
+    private static string Avg(ulong total, ulong battles) => battles == 0 ? "-" : ((double)total / battles).ToString("N0");
+
+    private static string Date(ulong unixSeconds, bool withTime = false)
+    {
+        if (unixSeconds == 0) return "-";
+        var local = DateTimeOffset.FromUnixTimeSeconds((long)unixSeconds).ToLocalTime();
+        return withTime ? local.ToString("g") : local.ToString("d");
+    }
+}
