+using MediatR;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Lobbies;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Handlers.Game;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] RegisterOption (306): results-screen friend request (フレンド申請) and NG (block).
+/// The game gets the empty success reply at once (it only needs Error = Success); the request is then forwarded to
+/// the shared matchmaker in the background (Lobbies/RegisterOptionLogic) and queued in the friends outbox if the
+/// matchmaker cannot take it. Used whenever Friends.Enabled is true (independent of PostMatchStubs).
+/// </summary>
+public record RegisterOptionCommand(Request Request) : IRequest<Response>;
+
+public class RegisterOptionCommandHandler : IRequestHandler<RegisterOptionCommand, Response>
+{
+    private readonly ILogger<RegisterOptionCommandHandler> _logger;
+    private readonly ServerDbContext _context;
+    private readonly IFriendClient _friends;
+    private readonly FriendOutbox _outbox;
+
+    public RegisterOptionCommandHandler(ILogger<RegisterOptionCommandHandler> logger, ServerDbContext context,
+        IFriendClient friends, FriendOutbox outbox)
+    {
+        _logger = logger;
+        _context = context;
+        _friends = friends;
+        _outbox = outbox;
+    }
+
+    public Task<Response> Handle(RegisterOptionCommand command, CancellationToken cancellationToken)
+    {
+        var q = command.Request;
+        var r = new Response { Type = q.Type, RequestId = q.RequestId, Error = Error.Success, register_option = new Response.RegisterOption() };
+        var o = q.register_option;
+        if (o == null)
+        {
+            _logger.LogWarning("RegisterOption without a body: answered success, nothing stored");
+            return Task.FromResult(r);
+        }
+        var user = o.MobileUserId;
+        var friend = o.FriendPilotId;
+        var ng = o.NgPilotId;
+        _logger.LogInformation("RegisterOption user={User} friend={Friend} ng={Ng}", user, friend, ng);
+        if (friend == 0 && ng == 0) return Task.FromResult(r);
+
+        // Look the sender up now (the DbContext is request-scoped); forward after replying.
+        var local = PilotId.ToLocalOrUnmatched(user);
+        var name = local > 0
+            ? _context.CardProfiles.Where(x => x.Id == local).Select(x => x.UserName ?? "").FirstOrDefault()
+            : null;
+        var log = _logger;
+        var client = _friends;
+        var outbox = _outbox;
+        _ = Task.Run(async () =>
+        {
+            try
+            {
+                await RegisterOptionLogic.HandleAsync(user, friend, ng, id => id == local ? name : null, client, outbox,
+                    m => log.LogInformation("{Message}", m));
+            }
+            catch (Exception ex)
+            {
+                log.LogWarning("RegisterOption forwarding failed: {Error}", ex.Message);
+            }
+        });
+        return Task.FromResult(r);
+    }
+}
diff --git a/Server-Infinite/Handlers/UI/Friends/FriendsUiService.cs b/Server-Infinite/Handlers/UI/Friends/FriendsUiService.cs
new file mode 100644
index 0000000..516f43d
--- /dev/null
+++ b/Server-Infinite/Handlers/UI/Friends/FriendsUiService.cs
@@ -0,0 +1,162 @@
+using Microsoft.Extensions.Options;
+using ServerInfinite.Common.TagInvites;
+using ServerInfinite.Handlers.UI.Team;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Request;
+using WebUIInfinite.Shared.Dto.Response;
+
+namespace ServerInfinite.Handlers.UI.Friends;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Friends page backend on the card server: checks the card (access code + chip id, sent in
+/// the POST body), maps it to its wire pilot id and calls the matchmaker's /tag/friends API (or the in-process store).
+/// After a friendship forms the card's online tag teams are synced at once; after a remove / block with
+/// "also delete tag teams" the local rows of the deleted codes are dropped.
+/// </summary>
+public class FriendsUiService
+{
+    private readonly ServerDbContext _context;
+    private readonly IFriendClient _friends;
+    private readonly ITagInviteClient? _invites;
+    private readonly FriendsConfigurations _cfg;
+    private readonly OnlineTagConfigurations _tagCfg;
+    private readonly ILogger<FriendsUiService> _log;
+
+    public FriendsUiService(ServerDbContext context, IFriendClient friends, IOptions<CardServerConfig> options,
+        ILogger<FriendsUiService> log, ITagInviteClient? invites = null)
+    {
+        _context = context;
+        _friends = friends;
+        _invites = invites;
+        _cfg = options.Value.Friends;
+        _tagCfg = options.Value.OnlineTag;
+        _log = log;
+    }
+
+    public bool Enabled => _cfg.Enabled;
+
+    private CardProfile? Card(BasicCardRequest r) =>
+        string.IsNullOrEmpty(r.AccessCode) || string.IsNullOrEmpty(r.ChipId)
+            ? null
+            : _context.CardProfiles.FirstOrDefault(x => x.AccessCode == r.AccessCode && x.ChipId == r.ChipId);
+
+    public async Task<FriendsListResponse> List(FriendsListRequest r, CancellationToken ct)
+    {
+        var card = Card(r);
+        if (card is null) return new FriendsListResponse { Success = false, Message = "Card Profile is invalid" };
+        var self = PilotId.Wire(card.Id);
+        var resp = new FriendsListResponse { YourPilotId = self, YourName = card.UserName ?? "" };
+        try
+        {
+            if (r.Page <= 1 && string.IsNullOrWhiteSpace(r.Q) && _invites != null && !string.IsNullOrWhiteSpace(card.UserName))
+            {
+                try { await _invites.UpdateNameAsync(self, card.UserName, ct); }
+                catch (Exception ex) { _log.LogDebug("Friends: name report failed: {Error}", ex.Message); }
+            }
+            var page = await _friends.ListAsync(self, new FriendQuery
+            {
+                Tab = r.Tab, Q = r.Q, Sort = r.Sort, Dir = r.Dir, Page = r.Page, PageSize = r.PageSize,
+            }, ct);
+            resp.Success = true;
+            resp.Tab = page.Tab; resp.Sort = page.Sort; resp.Dir = page.Dir;
+            resp.Page = page.Page; resp.PageSize = page.PageSize; resp.Total = page.Total; resp.TotalPages = page.TotalPages;
+            resp.Counts = new FriendTabCounts
+            {
+                Friends = page.Counts.Friends, Incoming = page.Counts.Incoming,
+                Outgoing = page.Counts.Outgoing, Blocked = page.Counts.Blocked,
+            };
+            resp.Items = page.Items.Select(i => new FriendItem
+            {
+                PilotId = i.PilotId, Name = i.Name, Kind = i.Kind, AddedUtc = i.AddedUtc,
+                LastPlayedUtc = i.LastPlayedUtc, Source = i.Source, HasTagTeam = i.HasTagTeam,
+            }).ToList();
+        }
+        catch (Exception ex)
+        {
+            resp.Success = false;
+            resp.Message = ex.Message;
+        }
+        return resp;
+    }
+
+    public Task<FriendsActionResponse> Request(FriendsTargetRequest r, CancellationToken ct) =>
+        Act(r, async (card, self) =>
+        {
+            if (r.PilotId == 0) throw new ArgumentException("Enter a pilot id.");
+            return new[] { await _friends.RequestAsync(self, card.UserName ?? "", r.PilotId, "web", ct) };
+        }, ct);
+
+    public Task<FriendsActionResponse> BlockOne(FriendsTargetRequest r, CancellationToken ct) =>
+        Act(r, async (card, self) =>
+        {
+            if (r.PilotId == 0) throw new ArgumentException("Enter a pilot id.");
+            return await _friends.BlockAsync(self, new[] { r.PilotId }, "web", r.DeleteTagTeams, ct);
+        }, ct);
+
+    public Task<FriendsActionResponse> Accept(FriendsBulkRequest r, CancellationToken ct) =>
+        Act(r, (card, self) => _friends.AcceptAsync(self, card.UserName ?? "", Ids(r), ct), ct);
+
+    public Task<FriendsActionResponse> Decline(FriendsBulkRequest r, CancellationToken ct) =>
+        Act(r, (card, self) => _friends.DeclineAsync(self, Ids(r), ct), ct);
+
+    public Task<FriendsActionResponse> Remove(FriendsBulkRequest r, CancellationToken ct) =>
+        Act(r, (card, self) => _friends.RemoveAsync(self, Ids(r), r.DeleteTagTeams, ct), ct);
+
+    public Task<FriendsActionResponse> Block(FriendsBulkRequest r, CancellationToken ct) =>
+        Act(r, (card, self) => _friends.BlockAsync(self, Ids(r), "web", r.DeleteTagTeams, ct), ct);
+
+    public Task<FriendsActionResponse> Unblock(FriendsBulkRequest r, CancellationToken ct) =>
+        Act(r, (card, self) => _friends.UnblockAsync(self, Ids(r), ct), ct);
+
+    private static IReadOnlyList<uint> Ids(FriendsBulkRequest r)
+    {
+        if (r.PilotIds.Count > FriendLimits.MaxBulk) throw new ArgumentException($"Select at most {FriendLimits.MaxBulk} players at a time.");
+        var ids = FriendLimits.CleanIds(r.PilotIds);
+        if (ids.Count == 0) throw new ArgumentException("Select at least one player.");
+        return ids;
+    }
+
+    private async Task<FriendsActionResponse> Act(BasicCardRequest r,
+        Func<CardProfile, uint, Task<IReadOnlyList<FriendOutcome>>> call, CancellationToken ct)
+    {
+        var card = Card(r);
+        if (card is null) return new FriendsActionResponse { Success = false, Message = "Card Profile is invalid" };
+        var self = PilotId.Wire(card.Id);
+        IReadOnlyList<FriendOutcome> outcomes;
+        try { outcomes = await call(card, self); }
+        catch (Exception ex) { return new FriendsActionResponse { Success = false, Message = ex.Message }; }
+
+        var resp = new FriendsActionResponse
+        {
+            Success = outcomes.Count > 0 && outcomes.All(o => o.Ok),
+            Results = outcomes.Select(o => new FriendActionResult
+            {
+                PilotId = o.PilotId, Result = o.Result.ToString(), Ok = o.Ok, TagTeamCreated = o.TagTeamCreated,
+            }).ToList(),
+            TagTeamsCreated = outcomes.Count(o => o.TagTeamCreated),
+        };
+
+        // drop local rows of deleted online tag codes (any card on this server that had them)
+        var deleted = outcomes.SelectMany(o => o.DeletedTagCodes).Select(TagInviteStore.Normalize).Distinct().ToList();
+        if (deleted.Count > 0)
+        {
+            var rows = _context.TagTeamDataDbSet.Where(t => t.SharedTagCode != null && deleted.Contains(t.SharedTagCode)).ToList();
+            _context.TagTeamDataDbSet.RemoveRange(rows);
+            _context.SaveChanges();
+            resp.TagTeamsDeleted = deleted.Count;
+        }
+
+        // a new friendship may have created a team: pull it now so the Teams tab / next card insert has it
+        if (_invites != null && outcomes.Any(o => o.TagCode != null))
+        {
+            try { await CrossServerTeamSupport.SyncAsync(_context, card, _invites, _tagCfg.MaxTeams, _log, ct); }
+            catch (Exception ex) { _log.LogWarning("Friends: online tag sync after a new friendship failed for wire {Wire}: {Error}", self, ex.Message); }
+        }
+        _log.LogInformation("Friends page: wire {Wire} {Results}", self,
+            string.Join(", ", outcomes.Select(o => $"{o.PilotId}:{o.Result}")));
+        return resp;
+    }
+}
diff --git a/Server-Infinite/Lobbies/FriendOutbox.cs b/Server-Infinite/Lobbies/FriendOutbox.cs
new file mode 100644
index 0000000..aae502e
--- /dev/null
+++ b/Server-Infinite/Lobbies/FriendOutbox.cs
@@ -0,0 +1,227 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Card-server side record of friend requests and blocks that came from the game.
+/// The matchmaker owns friendships; when it is unreachable (or still on an older build without /tag/friends) the
+/// request is kept here and retried on the next RegisterOption / card insert, so a results-screen request is never
+/// lost. Also caches the last block list seen per card for LoadCard when the matchmaker does not answer in time.
+/// JSON file, atomic writes, thread-safe. Wire pilot ids and player names only (no card secrets).
+/// </summary>
+public sealed class FriendOutbox
+{
+    public const int MaxEntries = 1000;
+    public static readonly TimeSpan MaxAge = TimeSpan.FromDays(7);
+
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+    };
+
+    public sealed class Entry
+    {
+        /// <summary>request | block</summary>
+        public string Op { get; set; } = "request";
+        public uint From { get; set; }
+        public string FromName { get; set; } = "";
+        public uint To { get; set; }
+        public DateTime CreatedUtc { get; set; }
+        public int Attempts { get; set; }
+        public string? LastError { get; set; }
+    }
+
+    private sealed class Snapshot
+    {
+        public List<Entry> Pending { get; set; } = new();
+        public Dictionary<uint, uint[]> BlockedCache { get; set; } = new();
+    }
+
+    private readonly object _gate = new();
+    private readonly SemaphoreSlim _flush = new(1, 1);
+    private readonly string? _path;
+    private readonly List<Entry> _pending = new();
+    private readonly Dictionary<uint, uint[]> _blockedCache = new();
+
+    public Func<DateTime> UtcNow { get; set; } = () => DateTime.UtcNow;
+
+    public FriendOutbox(string? path = null)
+    {
+        _path = string.IsNullOrWhiteSpace(path) ? null : path;
+        if (_path == null || !File.Exists(_path)) return;
+        try
+        {
+            var s = JsonSerializer.Deserialize<Snapshot>(File.ReadAllText(_path), JsonOpts);
+            if (s?.Pending != null) _pending.AddRange(s.Pending.Where(e => e.From != 0 && e.To != 0));
+            if (s?.BlockedCache != null) foreach (var kv in s.BlockedCache) _blockedCache[kv.Key] = kv.Value ?? Array.Empty<uint>();
+        }
+        catch (Exception)
+        {
+            // corrupt: start empty
+        }
+    }
+
+    public int Count { get { lock (_gate) return _pending.Count; } }
+
+    public IReadOnlyList<Entry> PendingEntries() { lock (_gate) return _pending.Select(Clone).ToList(); }
+
+    public void Enqueue(string op, uint from, string fromName, uint to, string? error = null)
+    {
+        lock (_gate)
+        {
+            // the same op for the same pair is kept once
+            if (_pending.Any(e => e.Op == op && e.From == from && e.To == to)) return;
+            _pending.Add(new Entry { Op = op, From = from, FromName = fromName ?? "", To = to, CreatedUtc = UtcNow(), LastError = Short(error) });
+            while (_pending.Count > MaxEntries) _pending.RemoveAt(0);
+            Persist();
+        }
+    }
+
+    public void CacheBlocked(uint pilot, IReadOnlyList<uint> ids)
+    {
+        lock (_gate)
+        {
+            var arr = ids.ToArray();
+            if (_blockedCache.TryGetValue(pilot, out var old) && old.SequenceEqual(arr)) return;
+            if (arr.Length == 0) _blockedCache.Remove(pilot); else _blockedCache[pilot] = arr;
+            Persist();
+        }
+    }
+
+    public IReadOnlyList<uint> CachedBlocked(uint pilot)
+    {
+        lock (_gate)
+        {
+            var list = _blockedCache.TryGetValue(pilot, out var c) ? c.ToList() : new List<uint>();
+            // blocks still waiting in the outbox count too
+            foreach (var e in _pending.Where(e => e.Op == "block" && e.From == pilot && !list.Contains(e.To))) list.Insert(0, e.To);
+            return list;
+        }
+    }
+
+    /// <summary>
+    /// Send everything pending. An entry is dropped when the matchmaker answered (any result, including a refusal) or
+    /// when it is older than <see cref="MaxAge"/>; it stays when the call failed (network / old matchmaker).
+    /// Returns (sent, left).
+    /// </summary>
+    public async Task<(int Sent, int Left)> FlushAsync(IFriendClient client, Action<string>? log = null, CancellationToken ct = default)
+    {
+        if (Count == 0) return (0, 0);
+        if (!await _flush.WaitAsync(0, ct)) return (0, Count);   // another flush is running
+        try
+        {
+            List<Entry> work;
+            lock (_gate)
+            {
+                var now = UtcNow();
+                var expired = _pending.RemoveAll(e => now - e.CreatedUtc > MaxAge);
+                if (expired > 0) { log?.Invoke($"friends outbox: dropped {expired} request(s) older than {MaxAge.TotalDays:0} days"); Persist(); }
+                work = _pending.ToList();
+            }
+            var sent = 0;
+            foreach (var e in work)
+            {
+                try
+                {
+                    FriendResult r;
+                    if (e.Op == "block")
+                        r = (await client.BlockAsync(e.From, new[] { e.To }, "game", false, ct)).FirstOrDefault()?.Result ?? FriendResult.RefusedInvalid;
+                    else
+                        r = (await client.RequestAsync(e.From, e.FromName, e.To, "game", ct)).Result;
+                    lock (_gate) { _pending.Remove(e); Persist(); }
+                    sent++;
+                    log?.Invoke($"friends outbox: {e.Op} {e.From} -> {e.To} delivered: {r}");
+                }
+                catch (Exception ex)
+                {
+                    lock (_gate) { e.Attempts++; e.LastError = Short(ex.Message); Persist(); }
+                    break;   // matchmaker still down: keep order, try later
+                }
+            }
+            return (sent, Count);
+        }
+        finally { _flush.Release(); }
+    }
+
+    private static string? Short(string? s) => s is null ? null : s.Length > 200 ? s[..200] : s;
+
+    private static Entry Clone(Entry e) => new()
+    {
+        Op = e.Op, From = e.From, FromName = e.FromName, To = e.To, CreatedUtc = e.CreatedUtc, Attempts = e.Attempts, LastError = e.LastError,
+    };
+
+    private void Persist()
+    {
+        if (_path == null) return;
+        var dir = Path.GetDirectoryName(_path);
+        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+        var tmp = _path + ".tmp";
+        File.WriteAllText(tmp, JsonSerializer.Serialize(new Snapshot
+        {
+            Pending = _pending.ToList(),
+            BlockedCache = new Dictionary<uint, uint[]>(_blockedCache),
+        }, JsonOpts));
+        File.Move(tmp, _path, overwrite: true);
+    }
+}
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] RegisterOption (306) from the results screen. Captured live 2026-11-15 10:52 PT:
+/// mobile_user_id = sender's wire pilot id, friend_pilot_id = the partner's wire pilot id (may live on another card
+/// server), ng_pilot_id = 0. Only the requester sends it; the partner sends nothing.
+/// </summary>
+public static class RegisterOptionLogic
+{
+    public sealed record Outcome(bool SenderKnown, uint SenderWire, FriendOutcome? Friend, FriendOutcome? Block, bool Queued, string? Error);
+
+    /// <summary>
+    /// Map mobile_user_id to a local card (<paramref name="localName"/> returns null when this server has no such card),
+    /// then forward the friend request and / or block. A failed call is queued in <paramref name="outbox"/>.
+    /// </summary>
+    public static async Task<Outcome> HandleAsync(uint mobileUserId, uint friendPilotId, uint ngPilotId,
+        Func<int, string?> localName, IFriendClient client, FriendOutbox? outbox, Action<string>? log = null,
+        CancellationToken ct = default)
+    {
+        var local = PilotId.ToLocalOrUnmatched(mobileUserId);
+        var name = local > 0 ? localName(local) : null;
+        if (name is null)
+        {
+            log?.Invoke($"RegisterOption: user {mobileUserId} is not a card on this server; friend={friendPilotId} ng={ngPilotId} ignored");
+            return new Outcome(false, mobileUserId, null, null, false, "unknown sender");
+        }
+        var self = PilotId.Wire(local);
+
+        if (outbox != null && outbox.Count > 0)
+            await outbox.FlushAsync(client, log, ct);
+
+        FriendOutcome? friend = null, block = null;
+        var queued = false;
+        string? error = null;
+        if (friendPilotId != 0 && friendPilotId != self)
+        {
+            try { friend = await client.RequestAsync(self, name, friendPilotId, "game", ct); }
+            catch (Exception ex)
+            {
+                error = ex.Message;
+                if (outbox != null) { outbox.Enqueue("request", self, name, friendPilotId, ex.Message); queued = true; }
+            }
+        }
+        if (ngPilotId != 0 && ngPilotId != self)
+        {
+            try { block = (await client.BlockAsync(self, new[] { ngPilotId }, "game", false, ct)).FirstOrDefault(); }
+            catch (Exception ex)
+            {
+                error = ex.Message;
+                if (outbox != null) { outbox.Enqueue("block", self, name, ngPilotId, ex.Message); queued = true; }
+            }
+        }
+        log?.Invoke($"RegisterOption: user {self} friend={friendPilotId}{(friend != null ? $" -> {friend.Result}" : "")}" +
+                    $"{(friend?.TagTeamCreated == true ? " (online tag team created)" : "")}" +
+                    $" ng={ngPilotId}{(block != null ? $" -> {block.Result}" : "")}" +
+                    $"{(queued ? $" (matchmaker unreachable, queued for retry: {error})" : "")}");
+        return new Outcome(true, self, friend, block, queued, error);
+    }
+}
diff --git a/Server-Infinite/Matchmaking/FriendClient.cs b/Server-Infinite/Matchmaking/FriendClient.cs
new file mode 100644
index 0000000..7501217
--- /dev/null
+++ b/Server-Infinite/Matchmaking/FriendClient.cs
@@ -0,0 +1,59 @@
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// Card server → friend store. In-process on the matchmaker / an all-in-one server, HTTP (/tag/friends, X-Tag-Secret)
+/// on a split card server. Wire pilot ids only; never card secrets.
+/// </summary>
+public interface IFriendClient
+{
+    Task<FriendOutcome> RequestAsync(uint from, string fromName, uint to, string source, CancellationToken ct = default);
+    Task<IReadOnlyList<FriendOutcome>> AcceptAsync(uint by, string byName, IReadOnlyList<uint> others, CancellationToken ct = default);
+    Task<IReadOnlyList<FriendOutcome>> DeclineAsync(uint by, IReadOnlyList<uint> others, CancellationToken ct = default);
+    Task<IReadOnlyList<FriendOutcome>> RemoveAsync(uint by, IReadOnlyList<uint> others, bool deleteTagTeams, CancellationToken ct = default);
+    Task<IReadOnlyList<FriendOutcome>> BlockAsync(uint by, IReadOnlyList<uint> targets, string source, bool deleteTagTeams, CancellationToken ct = default);
+    Task<IReadOnlyList<FriendOutcome>> UnblockAsync(uint by, IReadOnlyList<uint> targets, CancellationToken ct = default);
+    Task<FriendPage> ListAsync(uint pilot, FriendQuery query, CancellationToken ct = default);
+    Task<IReadOnlyList<uint>> BlockedIdsAsync(uint pilot, int max, CancellationToken ct = default);
+}
+
+/// <summary>Most ids one bulk call may carry (the page's bulk select is at most one page of 100).</summary>
+public static class FriendLimits
+{
+    public const int MaxBulk = 100;
+
+    public static IReadOnlyList<uint> CleanIds(IEnumerable<uint>? ids) =>
+        (ids ?? Array.Empty<uint>()).Where(i => i != 0).Distinct().Take(MaxBulk).ToList();
+}
+
+public sealed class InProcessFriendClient : IFriendClient
+{
+    private readonly FriendStore _store;
+    public InProcessFriendClient(FriendStore store) => _store = store;
+
+    public Task<FriendOutcome> RequestAsync(uint from, string fromName, uint to, string source, CancellationToken ct = default) =>
+        Task.FromResult(_store.Request(from, fromName, to, source));
+
+    public Task<IReadOnlyList<FriendOutcome>> AcceptAsync(uint by, string byName, IReadOnlyList<uint> others, CancellationToken ct = default) =>
+        Many(others, o => _store.Accept(by, byName, o));
+
+    public Task<IReadOnlyList<FriendOutcome>> DeclineAsync(uint by, IReadOnlyList<uint> others, CancellationToken ct = default) =>
+        Many(others, o => _store.Decline(by, o));
+
+    public Task<IReadOnlyList<FriendOutcome>> RemoveAsync(uint by, IReadOnlyList<uint> others, bool deleteTagTeams, CancellationToken ct = default) =>
+        Many(others, o => _store.Remove(by, o, deleteTagTeams));
+
+    public Task<IReadOnlyList<FriendOutcome>> BlockAsync(uint by, IReadOnlyList<uint> targets, string source, bool deleteTagTeams, CancellationToken ct = default) =>
+        Many(targets, t => _store.Block(by, t, source, deleteTagTeams));
+
+    public Task<IReadOnlyList<FriendOutcome>> UnblockAsync(uint by, IReadOnlyList<uint> targets, CancellationToken ct = default) =>
+        Many(targets, t => _store.Unblock(by, t));
+
+    public Task<FriendPage> ListAsync(uint pilot, FriendQuery query, CancellationToken ct = default) =>
+        Task.FromResult(_store.List(pilot, query));
+
+    public Task<IReadOnlyList<uint>> BlockedIdsAsync(uint pilot, int max, CancellationToken ct = default) =>
+        Task.FromResult(_store.BlockedIds(pilot, max));
+
+    private static Task<IReadOnlyList<FriendOutcome>> Many(IReadOnlyList<uint> ids, Func<uint, FriendOutcome> f) =>
+        Task.FromResult<IReadOnlyList<FriendOutcome>>(FriendLimits.CleanIds(ids).Select(f).ToList());
+}
diff --git a/Server-Infinite/Matchmaking/FriendStore.cs b/Server-Infinite/Matchmaking/FriendStore.cs
new file mode 100644
index 0000000..4f79a5f
--- /dev/null
+++ b/Server-Infinite/Matchmaking/FriendStore.cs
@@ -0,0 +1,633 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>State of a friend link between two wire pilot ids.</summary>
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum FriendLinkState { Pending, Friends }
+
+/// <summary>Outcome of one friend / block action (sent to card servers as a string).</summary>
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum FriendResult
+{
+    Sent, AlreadyPending, BecameFriends, AlreadyFriends, Accepted, Removed, NotFound,
+    Blocked, AlreadyBlocked, Unblocked,
+    RefusedBlocked, RefusedYouBlocked, RefusedSelf, RefusedInvalid, RefusedLimit, Disabled,
+}
+
+/// <summary>One friendship or pending request. <see cref="A"/> &lt; <see cref="B"/> (one link per pair).</summary>
+public sealed class FriendLink
+{
+    public uint A { get; set; }
+    public uint B { get; set; }
+    public FriendLinkState State { get; set; }
+    /// <summary>Who asked first (the pending request goes from this pilot to the other one).</summary>
+    public uint RequestedBy { get; set; }
+    public DateTime CreatedUtc { get; set; }
+    public DateTime? AcceptedUtc { get; set; }
+    /// <summary>Last time the game reported the two together (a results-screen friend request comes right after a match).</summary>
+    public DateTime? LastPlayedUtc { get; set; }
+    /// <summary>"game" (results screen) or "web" (Friends page).</summary>
+    public string Source { get; set; } = "game";
+    /// <summary>Online tag code created for this friendship (auto team). Never logged unmasked.</summary>
+    public string? TagCode { get; set; }
+
+    public uint Other(uint self) => A == self ? B : A;
+}
+
+/// <summary>A block (NG) entry: <see cref="By"/> does not want <see cref="Target"/>.</summary>
+public sealed class FriendBlock
+{
+    public uint By { get; set; }
+    public uint Target { get; set; }
+    public DateTime CreatedUtc { get; set; }
+    public string Source { get; set; } = "game";
+}
+
+/// <summary>Friends page tabs.</summary>
+public static class FriendTabs
+{
+    public const string Friends = "friends";
+    public const string Incoming = "incoming";
+    public const string Outgoing = "outgoing";
+    public const string Requests = "requests";   // incoming + outgoing
+    public const string Blocked = "blocked";
+
+    public static string Normalize(string? tab) => (tab ?? "").Trim().ToLowerInvariant() switch
+    {
+        Incoming => Incoming,
+        Outgoing => Outgoing,
+        Requests => Requests,
+        Blocked => Blocked,
+        _ => Friends,
+    };
+}
+
+/// <summary>List query: search (name or pilot id), sort, page. Clamped by <see cref="Clamp"/>.</summary>
+public sealed class FriendQuery
+{
+    public string Tab { get; set; } = FriendTabs.Friends;
+    public string? Q { get; set; }
+    /// <summary>name | added | lastPlayed</summary>
+    public string Sort { get; set; } = "added";
+    /// <summary>asc | desc (empty = the sort's natural order: name asc, dates desc)</summary>
+    public string? Dir { get; set; }
+    public int Page { get; set; } = 1;
+    public int PageSize { get; set; } = 25;
+
+    public const int MaxPageSize = 100;
+
+    public FriendQuery Clamp()
+    {
+        Tab = FriendTabs.Normalize(Tab);
+        Sort = (Sort ?? "").Trim().ToLowerInvariant() switch
+        {
+            "name" => "name",
+            "lastplayed" or "last_played" or "played" => "lastPlayed",
+            _ => "added",
+        };
+        var d = (Dir ?? "").Trim().ToLowerInvariant();
+        Dir = d is "asc" or "desc" ? d : (Sort == "name" ? "asc" : "desc");
+        PageSize = PageSize <= 0 ? 25 : Math.Min(PageSize, MaxPageSize);
+        Page = Math.Max(1, Page);
+        Q = string.IsNullOrWhiteSpace(Q) ? null : Q.Trim();
+        if (Q is { Length: > 64 }) Q = Q[..64];
+        return this;
+    }
+}
+
