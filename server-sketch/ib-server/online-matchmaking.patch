+    /// <summary>Most other players one battle result may name (2v2: 1 partner + 2 foes; slack for odd modes).</summary>
+    public const int MaxPlayedOthers = 8;
+
+    /// <summary>
+    /// A finished battle: <paramref name="self"/>'s card server saved a versus result whose partner / foes were
+    /// <paramref name="others"/> (humans only). Stamps last played on every friendship (or pending request) between
+    /// <paramref name="self"/> and those players. Each player's own card server reports its own result, so a pair is
+    /// stamped when either side's server is updated. Never moves the time backwards. Returns the pilots updated.
+    /// </summary>
+    public IReadOnlyList<uint> RecordPlayed(uint self, IEnumerable<uint>? others)
+    {
+        if (self == 0 || others is null) return Array.Empty<uint>();
+        var ids = others.Where(o => o != 0 && o != self).Distinct().Take(MaxPlayedOthers).ToList();
+        if (ids.Count == 0) return Array.Empty<uint>();
+        lock (_gate)
+        {
+            var now = UtcNow();
+            var updated = new List<uint>();
+            foreach (var other in ids)
+            {
+                var link = GetLink(self, other);
+                if (link == null) continue;
+                if (link.LastPlayedUtc is { } prev && prev >= now) continue;
+                link.LastPlayedUtc = now;
+                updated.Add(other);
+            }
+            if (updated.Count > 0) Persist();
+            return updated;
+        }
+    }
+
