+++ b/Tests/Matchmaking.Tests/PairKeepSearchingTests.cs
@@ -0,0 +1,338 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// Official-cabinet test (2026-11-15): with PairNeverCpu / PairCpuFallbackSeconds=0 the server never answers a
+// searching all-human duo (including a ContinuePair) with a CPU room; it stays queued so later humans can still
+// join, and PAIR-SEARCH logs every poll so we can tell practice-while-searching from the partner-lost popup.
+public class PairKeepSearchingTests
+{
+    private uint _node = 11000;
+
+    private static Client Cl(uint node)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = $"P{node}", LocId = "JPN0JPN1", PrefCode = 13, GlobalIpaddress = "203.0.113.1",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Entry(uint leader, uint? member = null, uint apply = 1, uint world = 23)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = apply, Myclient = Cl(leader), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = leader },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        if (member != null)
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(member.Value), Player = new Player { BanapassportAmId = member.Value } });
+        return e;
+    }
+
+    private static Request.EntryMatching CpuPartnerEntry(uint leader)
+    {
+        var e = Entry(leader);
+        var npc = Cl(0);
+        npc.PcbSerial = "PCB00000NPC";
+        npc.Properties[0].PropertyValue = "N";
+        e.Groups.Add(new Request.EntryMatching.Group { Client = npc, Player = new Player { BanapassportAmId = 0 } });
+        return e;
+    }
+
+    /// <summary>Production-like policy on ddf3726, plus the test flags.</summary>
+    private static Matchmaker NewKeep(List<string>? log = null, bool hold = true, double stale = 1e6)
+    {
+        var mm = new Matchmaker(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = stale, MaxFillWait = 3, InStoreFillAfter = 3, InStoreMaxFillWait = 3,
+            NoCpuPartner = true,
+            ContinuePairMode = Matchmaker.ContinuePairPolicy.VsCpu,
+            ContinuePairSeconds = 12,
+            ContinuePairScope = Matchmaker.ContinuePairScopeKind.AnyDuo,
+            CpuPartnerCancelSeconds = 5,
+            PlaceCpuPartnerTeams = true,
+            SoloPairVsCpuSeconds = 0,
+            SoloPairRegroupSeconds = 75,
+            SoloPairReturnWaitSeconds = 270,
+            CrossWorldTeamRooms = false,
+            PairNeverCpu = hold,
+            PairCpuFallbackSeconds = hold ? 0 : -1,
+            PairSearchLog = true,
+            Log = log == null ? null : log.Add,
+        };
+        return mm;
+    }
+
+    private ((uint, uint) Mates0, (uint, uint) Mates1) PlayOneRoom(Matchmaker mm)
+    {
+        var ids = Enumerable.Range(0, 4).Select(_ => _node += 2).ToList();
+        foreach (var id in ids) Assert.Equal(ErrorCode.Success, mm.Entry(Entry(id), 0));
+        var room = mm.Check(ids[0], 1).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+        var g0 = room.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).ToList();
+        var g1 = room.Clients.Where(c => c.GroupId == 1).Select(c => c.Client.NodeId).ToList();
+        return ((g0[0], g0[1]), (g1[0], g1[1]));
+    }
+
+    private static void AssertStillWaiting((ErrorCode Code, Matchmaker.Room? Room, uint ApplyId) r)
+    {
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+    }
+
+    [Fact]
+    public void Defaults_do_not_hold_pairs()
+    {
+        var mm = new Matchmaker(3, true, 15, 1);
+        Assert.False(mm.PairNeverCpu);
+        Assert.Equal(-1, mm.PairCpuFallbackSeconds);
+        Assert.False(mm.HoldPairsWithoutCpu);
+        Assert.False(mm.PairSearchLog);
+    }
+
+    [Fact]
+    public void Off_flags_still_give_a_continuing_pair_the_cpu_room_at_12s()
+    {
+        var mm = NewKeep(hold: false);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        Assert.Null(mm.Check(mates.Item1, 441).Room);
+        var room = mm.Check(mates.Item1, 442).Room;
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Humans);
+        Assert.Equal(2, room.Clients.Count(c => !Matchmaker.Unit.IsHuman(c.Client)));
+    }
+
+    [Fact]
+    public void A_continuing_pair_is_kept_queued_past_12s_30s_and_60s_with_no_cpu_room()
+    {
+        var log = new List<string>();
+        var mm = NewKeep(log);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        foreach (var t in new[] { 441.0, 442, 460, 490, 579 })
+            AssertStillWaiting(mm.Check(mates.Item1, t));
+        Assert.DoesNotContain(log, l => l.Contains("humans-vs-cpu") || l.Contains("CPU-ROOM") || l.Contains("lone-team-vs-cpu"));
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH entry") && l.Contains("answer=WAIT") && l.Contains("hold-cpu=1"));
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH hold") && l.Contains("no CPU room"));
+        Assert.Contains(log, l => l.Contains("PAIR-SEARCH check") && l.Contains("past-pair-timer=1") && l.Contains("answer=WAIT"));
+        // matching timeout still applies
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(mates.Item1, 581).Code);
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH end") && l.Contains("matching timeout"));
+    }
+
+    [Fact]
+    public void PairCpuFallbackSeconds_zero_alone_also_holds_the_pair()
+    {
+        var mm = NewKeep(hold: false);
+        mm.PairNeverCpu = false;
+        mm.PairCpuFallbackSeconds = 0;
+        Assert.True(mm.HoldPairsWithoutCpu);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        AssertStillWaiting(mm.Check(mates.Item1, 460));
+    }
+
+    [Fact]
+    public void A_deliberate_duo_with_no_room_history_is_also_held()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        AssertStillWaiting(mm.Check(a, 12));
+        AssertStillWaiting(mm.Check(a, 40));
+        AssertStillWaiting(mm.Check(a, 149));
+    }
+
+    [Fact]
+    public void Later_solos_can_still_join_a_pair_after_the_30s_timer()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        AssertStillWaiting(mm.Check(a, 40));
+        uint s1 = _node += 2, s2 = _node += 2;
+        mm.Entry(Entry(s1), 41);
+        mm.Entry(Entry(s2), 42);
+        var room = mm.Check(a, 43).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+        Assert.DoesNotContain(room.Clients, c => !Matchmaker.Unit.IsHuman(c.Client));
+    }
+
+    [Fact]
+    public void Two_duos_still_make_a_four_human_room_immediately()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2, c = _node += 2, d = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        mm.Entry(Entry(c, d), 1);
+        var room = mm.Check(a, 2).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+
+    [Fact]
+    public void Cancel_mode_is_also_suppressed_so_the_pair_keeps_searching()
+    {
+        var mm = NewKeep();
+        mm.ContinuePairMode = Matchmaker.ContinuePairPolicy.Cancel;
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        AssertStillWaiting(mm.Check(a, 20));
+        AssertStillWaiting(mm.Check(a, 40));
+    }
+
+    [Fact]
+    public void LoneTeamVsCpu_does_not_answer_a_held_duo()
+    {
+        var mm = NewKeep();
+        mm.NoCpuPartner = false;
+        mm.AllowPartial = true;
+        mm.LoneTeamVsCpu = true;
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        AssertStillWaiting(mm.Check(a, 40));
+    }
+
+    [Fact]
+    public void PlaceCpuPartnerTeams_and_solo_pair_regroup_settings_are_unchanged()
+    {
+        var mm = NewKeep();
+        uint c = _node += 2, s1 = _node += 2, s2 = _node += 2;
+        mm.Entry(CpuPartnerEntry(c), 100);
+        mm.Entry(Entry(s1), 101);
+        mm.Entry(Entry(s2), 102);
+        var room = mm.Check(s1, 103).Room;
+        Assert.NotNull(room);
+        Assert.Equal(3, room!.Humans);
+
+        // two solos still hold (SoloPairVsCpu is off); they do not get a CPU room at 12 s
+        var mm2 = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm2.Entry(Entry(a), 0);
+        mm2.Entry(Entry(b), 0);
+        AssertStillWaiting(mm2.Check(a, 12));
+        AssertStillWaiting(mm2.Check(a, 74));
+    }
+
+    [Fact]
+    public void SoloPairVsCpu_still_applies_to_two_solos_when_enabled()
+    {
+        var mm = NewKeep();
+        mm.SoloPairVsCpuSeconds = 12;
+        mm.SoloPairRegroupSeconds = 0;
+        mm.SoloPairReturnWaitSeconds = 0;
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a), 0);
+        mm.Entry(Entry(b), 0);
+        var room = mm.Check(a, 12).Room;
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Humans);
+        Assert.Equal(2, room.Clients.Count(x => !Matchmaker.Unit.IsHuman(x.Client)));
+    }
+
+    [Fact]
+    public void Logs_every_poll_gap_and_a_cancel_from_the_cabinet()
+    {
+        var log = new List<string>();
+        var mm = NewKeep(log);
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 100);
+        mm.Check(a, 103);
+        mm.Check(a, 118);   // 15 s gap, like the pair leader's second poll
+        Assert.Contains(log, l => l.Contains("PAIR-SEARCH check") && l.Contains("since-last=15s") && l.Contains("poll-gap=15s"));
+        mm.Cancel(a, 119, applyId: 1);
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH cancel") && l.Contains("answer=CANCEL"));
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH end") && l.Contains("cancelled by node"));
+    }
+
+    [Fact]
+    public void Stopped_polling_is_logged_as_a_pair_search_end()
+    {
+        var log = new List<string>();
+        var mm = NewKeep(log, stale: 20);
+        uint a = _node += 2, b = _node += 2, s = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        mm.Check(a, 3);
+        // a later solo entry sweeps the stale duo
+        mm.Entry(Entry(s), 30);
+        Assert.Contains(log, l => l.StartsWith("PAIR-SEARCH end") && l.Contains("stopped polling (stale)"));
+        Assert.Contains(log, l => l.Contains("last-poll=") && l.Contains("s-ago"));
+    }
+
+    [Fact]
+    public void PairSearchContext_tags_a_waiting_duo_and_an_ended_one()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 10);
+        var ctx = mm.PairSearchContext(a, 20);
+        Assert.NotNull(ctx);
+        Assert.Contains("waiting", ctx);
+        Assert.Contains(a.ToString(), ctx);
+        mm.Cancel(a, 25, applyId: 1);
+        var ended = mm.PairSearchContext(a, 26);
+        Assert.NotNull(ended);
+        Assert.Contains("ended", ended);
+        Assert.Null(mm.PairSearchContext(a, 26 + 200));   // remember window over
+        Assert.Null(mm.PairSearchContext(99999, 26));
+    }
+
+    [Fact]
+    public void An_unhandled_mms_method_from_a_searching_pair_is_tagged()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b), 0);
+        var ctx = mm.PairSearchContext(a, 5);
+        var line = new MmsTrace().Line(new Request { Type = (MethodType)7, RequestId = "r" },
+            new Response { Code = ErrorCode.ErrRequest }, "10.10.0.2", null, 1, 5, ctx)!;
+        Assert.Contains("MMS-UNHANDLED", line);
+        Assert.Contains("PAIR-SEARCH", line);
+        var cancel = new MmsTrace().Line(new Request
+            {
+                Type = MethodType.CancelMatching, RequestId = "r",
+                cancel_matching = new Request.CancelMatching { NodeId = a, ApplyId = 1 }
+            },
+            new Response { Code = ErrorCode.Success }, "10.10.0.2", null, 2, 5, ctx)!;
+        Assert.StartsWith("PAIR-SEARCH mms method=CancelMatching", cancel);
+        Assert.Contains($"node={a}", cancel);
+        // Entry/Check stay in the matchmaker; MmsTrace does not double-log them from pair context alone
+        Assert.Null(new MmsTrace().Line(new Request
+            {
+                Type = MethodType.CheckMatching, RequestId = "r",
+                check_matching = new Request.CheckMatching { NodeId = a }
+            },
+            new Response { Code = ErrorCode.Success }, "x", null, 1, 5, ctx));
+    }
+
+    [Fact]
+    public void Class_team_duo_is_held_the_same_way()
+    {
+        var mm = NewKeep();
+        uint a = _node += 2, b = _node += 2;
+        mm.Entry(Entry(a, b, world: 14), 0);   // class-team
+        AssertStillWaiting(mm.Check(a, 40));
+        uint s1 = _node += 2, s2 = _node += 2;
+        // solos in the linked class-solo world (13) do not join while CrossWorldTeamRooms is off
+        mm.Entry(Entry(s1, world: 13), 41);
+        mm.Entry(Entry(s2, world: 13), 42);
+        AssertStillWaiting(mm.Check(a, 43));
+        // same-world team opponents still form a 4-human room
+        uint c = _node += 2, d = _node += 2;
+        mm.Entry(Entry(c, d, world: 14), 44);
+        var room = mm.Check(a, 45).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+}
