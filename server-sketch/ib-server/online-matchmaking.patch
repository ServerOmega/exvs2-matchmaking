         set: (value) => localStorage['BlazorDarkTheme'] = value
     };
 
+    // fix2 2026-11-15: the access code is saved together with the chip id it belongs to, and only one card at a
+    // time. A page for another card (stale tab, reload after logging in to a different card) gets "" and must log in
+    // again, so an access code is never sent with another card's chip id.
     window.accessCode = {
-        get: () => localStorage['accessCode'],
-        set: (value) => localStorage['accessCode'] = value
+        get: (chipId) => {
+            localStorage.removeItem('accessCode');   // pre-fix2 value without a chip id: never trusted
+            try {
+                const saved = JSON.parse(localStorage['cardLogin'] || 'null');
+                if (saved && chipId && saved.chipId === chipId && saved.accessCode) return saved.accessCode;
+            } catch (e) { }
+            return '';
+        },
+        set: (chipId, value) => {
+            localStorage.removeItem('accessCode');
+            if (!chipId || !value) { localStorage.removeItem('cardLogin'); return; }
+            localStorage['cardLogin'] = JSON.stringify({ chipId: chipId, accessCode: value });
+        },
+        clear: () => { localStorage.removeItem('accessCode'); localStorage.removeItem('cardLogin'); }
     };
 </script>
