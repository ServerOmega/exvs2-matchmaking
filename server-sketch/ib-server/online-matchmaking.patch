+using ServerInfinite.Lobbies;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>2026-11-15: RegisterOption (306) handling on the card server and the retry outbox.</summary>
+[Collection("PilotId")]   // PilotId.ServerId is static
+public class FriendOutboxTests
+{
+    /// <summary>Client that fails while <see cref="Down"/> is true, otherwise forwards to a real store.</summary>
+    private sealed class FlakyClient : IFriendClient
+    {
+        public readonly FriendStore Store = new();
+        public bool Down;
+        public int Calls;
+        private InProcessFriendClient Inner => new(Store);
+        private void Gate() { Calls++; if (Down) throw new HttpRequestException("matchmaker unreachable"); }
+
+        public Task<FriendOutcome> RequestAsync(uint f, string n, uint t, string s, CancellationToken ct = default) { Gate(); return Inner.RequestAsync(f, n, t, s, ct); }
+        public Task<IReadOnlyList<FriendOutcome>> AcceptAsync(uint b, string n, IReadOnlyList<uint> o, CancellationToken ct = default) { Gate(); return Inner.AcceptAsync(b, n, o, ct); }
+        public Task<IReadOnlyList<FriendOutcome>> DeclineAsync(uint b, IReadOnlyList<uint> o, CancellationToken ct = default) { Gate(); return Inner.DeclineAsync(b, o, ct); }
+        public Task<IReadOnlyList<FriendOutcome>> RemoveAsync(uint b, IReadOnlyList<uint> o, bool d, CancellationToken ct = default) { Gate(); return Inner.RemoveAsync(b, o, d, ct); }
+        public Task<IReadOnlyList<FriendOutcome>> BlockAsync(uint b, IReadOnlyList<uint> t, string s, bool d, CancellationToken ct = default) { Gate(); return Inner.BlockAsync(b, t, s, d, ct); }
+        public Task<IReadOnlyList<FriendOutcome>> UnblockAsync(uint b, IReadOnlyList<uint> t, CancellationToken ct = default) { Gate(); return Inner.UnblockAsync(b, t, ct); }
+        public Task<FriendPage> ListAsync(uint p, FriendQuery q, CancellationToken ct = default) { Gate(); return Inner.ListAsync(p, q, ct); }
+        public Task<IReadOnlyList<uint>> BlockedIdsAsync(uint p, int m, CancellationToken ct = default) { Gate(); return Inner.BlockedIdsAsync(p, m, ct); }
+    }
+
+    private static Func<int, string?> Cards(params (int Id, string Name)[] cards) =>
+        id => cards.Where(c => c.Id == id).Select(c => c.Name).FirstOrDefault();
+
+    [Fact]
+    public async Task CapturedFriendRequestIsForwardedAsPending()
+    {
+        PilotId.SetServerId(1);
+        try
+        {
+            var c = new FlakyClient();
+            // the live capture: MobileUserId 1000002 (card 2 on ServerId 1) -> FriendPilotId 2000002 (another server), NgPilotId 0
+            var o = await RegisterOptionLogic.HandleAsync(1_000_002, 2_000_002, 0, Cards((2, "server(2)")), c, new FriendOutbox());
+            Assert.True(o.SenderKnown);
+            Assert.Equal(1_000_002u, o.SenderWire);
+            Assert.Equal(FriendResult.Sent, o.Friend!.Result);
+            Assert.Null(o.Block);
+            Assert.Equal(FriendLinkState.Pending, c.Store.StateOf(1_000_002, 2_000_002));
+            Assert.Equal("server(2)", c.Store.NameOf(1_000_002));
+        }
+        finally { PilotId.SetServerId(0); }
+    }
+
+    [Fact]
+    public async Task NgPilotIdBlocks()
+    {
+        PilotId.SetServerId(1);
+        try
+        {
+            var c = new FlakyClient();
+            var o = await RegisterOptionLogic.HandleAsync(1_000_002, 0, 2_000_005, Cards((2, "me")), c, null);
+            Assert.Equal(FriendResult.Blocked, o.Block!.Result);
+            Assert.Equal(new uint[] { 2_000_005 }, c.Store.BlockedIds(1_000_002));
+        }
+        finally { PilotId.SetServerId(0); }
+    }
+
+    [Fact]
+    public async Task UnknownOrForeignSenderIsIgnored()
+    {
+        PilotId.SetServerId(1);
+        try
+        {
+            var c = new FlakyClient();
+            var o = await RegisterOptionLogic.HandleAsync(2_000_002, 1_000_002, 0, Cards((2, "me")), c, null);   // other server's id
+            Assert.False(o.SenderKnown);
+            var o2 = await RegisterOptionLogic.HandleAsync(1_000_077, 2_000_002, 0, Cards((2, "me")), c, null);  // no such card
+            Assert.False(o2.SenderKnown);
+            Assert.Equal(0, c.Calls);
+            var o3 = await RegisterOptionLogic.HandleAsync(1_000_002, 1_000_002, 1_000_002, Cards((2, "me")), c, null); // self
+            Assert.True(o3.SenderKnown);
+            Assert.Equal(0, c.Calls);
+        }
+        finally { PilotId.SetServerId(0); }
+    }
+
+    [Fact]
+    public async Task LegacyRawCardIdIsMappedToTheWireId()
+    {
+        PilotId.SetServerId(1);
+        try
+        {
+            var c = new FlakyClient();
+            var o = await RegisterOptionLogic.HandleAsync(2, 2_000_002, 0, Cards((2, "me")), c, null);
+            Assert.Equal(1_000_002u, o.SenderWire);
+            Assert.Equal(FriendLinkState.Pending, c.Store.StateOf(1_000_002, 2_000_002));
+        }
+        finally { PilotId.SetServerId(0); }
+    }
+
+    [Fact]
+    public async Task MatchmakerDownQueuesAndTheNextCallDelivers()
+    {
+        PilotId.SetServerId(1);
+        var path = Path.Combine(Path.GetTempPath(), $"friends-outbox-{Guid.NewGuid():n}.json");
+        try
+        {
+            var c = new FlakyClient { Down = true };
+            var box = new FriendOutbox(path);
+            var o = await RegisterOptionLogic.HandleAsync(1_000_002, 2_000_002, 2_000_009, Cards((2, "me")), c, box);
+            Assert.True(o.Queued);
+            Assert.Equal(2, box.Count);
+            Assert.Contains(2_000_009u, box.CachedBlocked(1_000_002));        // queued block already counts for LoadCard
+            // the same request again is not queued twice; the file survives a restart
+            await RegisterOptionLogic.HandleAsync(1_000_002, 2_000_002, 0, Cards((2, "me")), c, box);
+            box = new FriendOutbox(path);
+            Assert.Equal(2, box.Count);
+
+            c.Down = false;
+            var (sent, left) = await box.FlushAsync(c);
+            Assert.Equal(2, sent);
+            Assert.Equal(0, left);
+            Assert.Equal(FriendLinkState.Pending, c.Store.StateOf(1_000_002, 2_000_002));
+            Assert.Equal(new uint[] { 2_000_009 }, c.Store.BlockedIds(1_000_002));
+        }
+        finally { PilotId.SetServerId(0); File.Delete(path); }
+    }
+
+    [Fact]
+    public async Task FlushStopsAtTheFirstFailureAndDropsOldEntries()
+    {
+        var now = new DateTime(2026, 11, 15, 18, 0, 0, DateTimeKind.Utc);
+        var box = new FriendOutbox { UtcNow = () => now };
+        box.Enqueue("request", 1, "a", 2);
+        box.Enqueue("request", 1, "a", 3);
+        var c = new FlakyClient { Down = true };
+        var (sent, left) = await box.FlushAsync(c);
+        Assert.Equal((0, 2), (sent, left));
+        Assert.Equal(1, c.Calls);                  // stopped after the first failure
+        Assert.Equal(1, box.PendingEntries()[0].Attempts);
+        now = now.AddDays(8);
+        c.Down = false;
+        (sent, left) = await box.FlushAsync(c);
+        Assert.Equal((0, 0), (sent, left));        // older than 7 days: dropped, not sent
+    }
+
+    [Fact]
+    public void BlockedCacheRoundTrips()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"friends-outbox-{Guid.NewGuid():n}.json");
+        try
+        {
+            var box = new FriendOutbox(path);
+            box.CacheBlocked(1_000_002, new uint[] { 5, 6 });
+            Assert.Equal(new uint[] { 5, 6 }, new FriendOutbox(path).CachedBlocked(1_000_002));
+            box.CacheBlocked(1_000_002, Array.Empty<uint>());
+            Assert.Empty(new FriendOutbox(path).CachedBlocked(1_000_002));
+        }
+        finally { File.Delete(path); }
+    }
+}
