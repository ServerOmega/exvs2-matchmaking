+using WebUIInfinite.Shared.Dto.Common;
+using WebUIInfinite.Shared.Models;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>exvs2-lobbies 2026-11-15: Teams tab next to Friends; friends list links each friend to its tag team.</summary>
+public class TagTeamLinksTests
+{
+    private static Team T(uint id, uint partnerPilot, string name = "", bool remote = false) =>
+        new() { Id = id, PartnerPilotId = partnerPilot, Name = name, IsRemote = remote };
+
+    [Fact]
+    public void ForPartner_matches_the_friends_wire_pilot_id_only()
+    {
+        var teams = new[] { T(1, 2000002, "A"), T(2, 2000003, "B"), T(3, 1000001, "C", remote: true) };
+        Assert.Equal(new uint[] { 2 }, TagTeamLinks.ForPartner(teams, 2000003).Select(t => t.Id));
+        Assert.Equal(new uint[] { 3 }, TagTeamLinks.ForPartner(teams, 1000001).Select(t => t.Id));
+        Assert.Empty(TagTeamLinks.ForPartner(teams, 2000004));
+    }
+
+    [Fact]
+    public void ForPartner_ignores_zero_and_null()
+    {
+        var teams = new[] { T(1, 0, "no pilot id") };
+        Assert.Empty(TagTeamLinks.ForPartner(teams, 0));
+        Assert.Empty(TagTeamLinks.ForPartner(null, 2000002));
+    }
+
+    [Fact]
+    public void ByPartner_groups_named_teams_first_then_by_id()
+    {
+        var teams = new[] { T(9, 2000003, ""), T(4, 2000003, "Zeta"), T(2, 2000003, "Alpha"), T(5, 0, "skip"), T(6, 1000001, "X") };
+        var map = TagTeamLinks.ByPartner(teams);
+        Assert.Equal(2, map.Count);
+        Assert.False(map.ContainsKey(0));
+        Assert.Equal(new uint[] { 2, 4, 9 }, map[2000003].Select(t => t.Id));
+        Assert.Equal(new uint[] { 6 }, map[1000001].Select(t => t.Id));
+        Assert.Empty(TagTeamLinks.ByPartner(null));
+    }
+
+    [Fact]
+    public void Edit_link_opens_the_existing_team_editor_at_the_team()
+    {
+        Assert.Equal("Cards/Customize/ABC123?tab=teams&team=7", TagTeamLinks.EditHref("ABC123", 7));
+        Assert.Equal("Cards/Customize/ABC123?tab=teams", TagTeamLinks.EditHref("ABC123", 0));
+        Assert.Equal("Cards/Teams/ABC123", TagTeamLinks.ListHref("ABC123"));
+        // chip ids are escaped, never break the route
+        Assert.Equal("Cards/Teams/a%2Fb", TagTeamLinks.ListHref("a/b"));
+        Assert.StartsWith("Cards/Customize/a%20b?", TagTeamLinks.EditHref("a b", 1));
+    }
+
+    [Theory]
+    [InlineData("?tab=teams&team=12", true, 12u)]
+    [InlineData("?team=12&tab=teams", true, 12u)]
+    [InlineData("?TAB=Teams", true, 0u)]
+    [InlineData("?team=5", true, 5u)]
+    [InlineData("?tab=friends", false, 0u)]
+    [InlineData("?tab=teams&team=abc", true, 0u)]
+    [InlineData("?tab=teams&team=-1", true, 0u)]
+    [InlineData("", false, 0u)]
+    [InlineData(null, false, 0u)]
+    public void ParseEditQuery(string? q, bool tab, uint team)
+    {
+        var r = TagTeamLinks.ParseEditQuery(q);
+        Assert.Equal(tab, r.TeamsTab);
+        Assert.Equal(team, r.TeamId);
+    }
+
+    [Fact]
+    public void Round_trip_edit_link_query()
+    {
+        var href = TagTeamLinks.EditHref("CHIP", 42);
+        var r = TagTeamLinks.ParseEditQuery(href[href.IndexOf('?')..]);
+        Assert.True(r.TeamsTab);
+        Assert.Equal(42u, r.TeamId);
+    }
+
+    [Fact]
+    public void DisplayName_falls_back_for_unnamed_teams()
+    {
+        Assert.Equal("Team #3", TagTeamLinks.DisplayName(T(3, 1, "  "), "Team #3"));
+        Assert.Equal("Gundam Bros", TagTeamLinks.DisplayName(T(3, 1, " Gundam Bros "), "Team #3"));
+    }
+}
+
+/// <summary>Teams tab 2026-11-15: WebUI page routes with a (non-hex) chip id are masked in request logs too.</summary>
+public class CardsPageRouteMaskTests
+{
+    [Theory]
+    [InlineData("HTTP GET /Cards/Teams/TESTXSTCHIP00010001 responded 200")]
+    [InlineData("HTTP GET /Cards/Friends/TESTXSTCHIP00010001?tab=teams responded 200")]
+    [InlineData("HTTP GET /Cards/Customize/TESTXSTCHIP00010001?tab=teams&team=3 responded 200")]
+    [InlineData("/cards/viewdetail/TESTXSTCHIP00010001")]
+    [InlineData("/Cards/SingularCardMenu/TESTXSTCHIP00010001")]
+    public void ChipIdInPageRouteIsMasked(string raw)
+    {
+        var m = ServerInfinite.Lobbies.LogMask.MaskUrlSecrets(raw);
+        Assert.DoesNotContain("TESTXSTCHIP00010001", m);
+        Assert.Contains("<masked:19>", m);
+    }
+
+    [Theory]
+    [InlineData("/Cards")]
+    [InlineData("/ServerPlayerLevelRanks")]
+    public void OtherPagesUnchanged(string raw) => Assert.Equal(raw, ServerInfinite.Lobbies.LogMask.MaskUrlSecrets(raw));
+}
