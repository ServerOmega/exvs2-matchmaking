@@ -0,0 +1,139 @@
+using nue.protocol.exvs;
+using ServerInfinite.Lobbies;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+/// <summary>2026-11-15 friends' "last played" from saved versus results (partner + foes), across card servers.</summary>
+public class FriendPlayedTests
+{
+    private const uint A = 1_000_002, B = 2_000_002, C = 3_000_001, D = 1_000_009, E = 4_000_001;
+
+    private static FriendStore Friends(params (uint, uint)[] pairs)
+    {
+        var f = new FriendStore { Tags = new TagInviteStore() };
+        foreach (var (x, y) in pairs) { f.Request(x, "x", y, "web"); f.Accept(y, "y", x); }
+        return f;
+    }
+
+    private static DateTime? Last(FriendStore f, uint self, uint other) =>
+        f.List(self, new FriendQuery { Tab = "friends", PageSize = 100 }).Items.Single(i => i.PilotId == other).LastPlayedUtc;
+
+    [Fact]
+    public void ResultStampsFriendsInTheMatchOnlyTeammatesAndOpponents()
+    {
+        var f = Friends((A, B), (A, C), (A, E));
+        var t = new DateTime(2026, 11, 15, 19, 0, 0, DateTimeKind.Utc);
+        f.UtcNow = () => t;
+        Assert.Null(Last(f, A, B));                                     // web friends: never played yet
+
+        var updated = f.RecordPlayed(A, new[] { B, C, D });             // partner B, foes C + D (D is no friend)
+        Assert.Equal(new[] { B, C }, updated.OrderBy(x => x));
+        Assert.Equal(t, Last(f, A, B));
+        Assert.Equal(t, Last(f, B, A));                                 // same link seen from the other side
+        Assert.Equal(t, Last(f, A, C));
+        Assert.Null(Last(f, A, E));                                     // friend, but not in this match
+    }
+
+    [Fact]
+    public void IgnoresSelfZeroStrangersBlockedAndNeverGoesBack()
+    {
+        var f = Friends((A, B));
+        f.Block(A, C);
+        var t1 = new DateTime(2026, 11, 15, 19, 0, 0, DateTimeKind.Utc);
+        f.UtcNow = () => t1;
+        Assert.Empty(f.RecordPlayed(A, new uint[] { 0, A, C, D }));
+        Assert.Empty(f.RecordPlayed(0, new[] { B }));
+        Assert.Empty(f.RecordPlayed(A, null));
+        Assert.Single(f.RecordPlayed(A, new[] { B, B }));
+        f.UtcNow = () => t1.AddMinutes(-5);                             // a late report from the other server
+        Assert.Empty(f.RecordPlayed(B, new[] { A }));
+        Assert.Equal(t1, Last(f, A, B));
+    }
+
+    [Fact]
+    public void PendingRequestsAlsoGetLastPlayedAndItPersists()
+    {
+        var path = Path.Combine(Path.GetTempPath(), $"friends-played-{Guid.NewGuid():n}.json");
+        try
+        {
+            var f = new FriendStore(path) { Tags = new TagInviteStore() };
+            f.Request(A, "a", B, "web");
+            var t = new DateTime(2026, 11, 15, 20, 0, 0, DateTimeKind.Utc);
+            f.UtcNow = () => t;
+            Assert.Single(f.RecordPlayed(B, new[] { A }));
+            var again = new FriendStore(path) { Tags = new TagInviteStore() };
+            Assert.Equal(t, again.List(A, new FriendQuery { Tab = "outgoing" }).Items.Single().LastPlayedUtc);
+        }
+        finally { File.Delete(path); }
+    }
+
+    [Fact]
+    public void SortByLastPlayedFollowsResults()
+    {
+        var f = Friends((A, B), (A, C), (A, D));
+        var t = new DateTime(2026, 11, 15, 19, 0, 0, DateTimeKind.Utc);
+        f.UtcNow = () => t; f.RecordPlayed(A, new[] { C });
+        f.UtcNow = () => t.AddMinutes(3); f.RecordPlayed(B, new[] { A });   // B's server reports the next match
+        var order = f.List(A, new FriendQuery { Tab = "friends", Sort = "lastPlayed", Dir = "desc" }).Items.Select(i => i.PilotId).ToList();
+        Assert.Equal(new[] { B, C, D }, order);
+    }
+
+    [Fact]
+    public void OthersFromResultSkipsCpusSelfAndZeroAndCaps()
+    {
+        var partner = new AdversaryManGroup { PilotId = B };
+        var foes = new List<AdversaryManGroup>
+        {
+            new() { PilotId = C }, new() { PilotId = 0 }, new() { PilotId = 77, CpuFlag = 1 }, new() { PilotId = A }, new() { PilotId = C },
+        };
+        Assert.Equal(new[] { B, C }, FriendPlayedReporter.OthersFrom(A, partner, foes));
+        Assert.Empty(FriendPlayedReporter.OthersFrom(A, new AdversaryManGroup { PilotId = 5, CpuFlag = 1 }, null));
+        var many = Enumerable.Range(1, 20).Select(i => new AdversaryManGroup { PilotId = (uint)(100 + i) });
+        Assert.Equal(FriendStore.MaxPlayedOthers, FriendPlayedReporter.OthersFrom(A, null, many).Count);
+    }
+
+    [Fact]
+    public void SavedResultProtoRoundTripCarriesPartnerAndFoes()
+    {
+        // the ids the reporter reads survive the game's wire format (SaveVsmOnResult.result.partner / foes)
+        var save = new Request.SaveVsmOnResult { PilotId = A, SessionId = "s", Result = new Request.SaveVsmOnResult.PlayResultGroup() };
+        save.Result.Partner = new AdversaryManGroup { PilotId = B };
+        save.Result.Foes.Add(new AdversaryManGroup { PilotId = C });
+        save.Result.Foes.Add(new AdversaryManGroup { PilotId = 9, CpuFlag = 1 });
+        using var ms = new MemoryStream();
+        ProtoBuf.Serializer.Serialize(ms, save);
+        ms.Position = 0;
+        var back = ProtoBuf.Serializer.Deserialize<Request.SaveVsmOnResult>(ms);
+        Assert.Equal(new[] { B, C }, FriendPlayedReporter.OthersFrom(A, back.Result.Partner, back.Result.Foes));
+    }
+
+    [Fact]
+    public async Task ReporterSendsThroughTheClientAndSwallowsFailures()
+    {
+        var f = Friends((A, B));
+        var logs = new List<string>();
+        var ok = new FriendPlayedReporter(new InProcessFriendClient(f), logs.Add);
+        Assert.Equal(new[] { B }, await ok.ReportAsync(A, new[] { B, C }, "SaveVsmOnResult"));
+        Assert.Contains(logs, l => l.Contains("last played updated"));
+        var down = new FriendPlayedReporter(new ThrowingClient(), logs.Add);
+        Assert.Empty(await down.ReportAsync(A, new[] { B }, "SaveVsmOnResult"));
+        Assert.Contains(logs, l => l.Contains("last played not sent"));
+        Assert.Empty(await new FriendPlayedReporter(null).ReportAsync(A, new[] { B }, "x"));
+    }
+
+    private sealed class ThrowingClient : IFriendClient
+    {
+        private static Exception X() => new HttpRequestException("matchmaker unreachable");
+        public Task<FriendOutcome> RequestAsync(uint from, string fromName, uint to, string source, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<FriendOutcome>> AcceptAsync(uint by, string byName, IReadOnlyList<uint> others, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<FriendOutcome>> DeclineAsync(uint by, IReadOnlyList<uint> others, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<FriendOutcome>> RemoveAsync(uint by, IReadOnlyList<uint> others, bool deleteTagTeams, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<FriendOutcome>> BlockAsync(uint by, IReadOnlyList<uint> targets, string source, bool deleteTagTeams, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<FriendOutcome>> UnblockAsync(uint by, IReadOnlyList<uint> targets, CancellationToken ct = default) => throw X();
+        public Task<FriendPage> ListAsync(uint pilot, FriendQuery query, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<uint>> BlockedIdsAsync(uint pilot, int max, CancellationToken ct = default) => throw X();
+        public Task<IReadOnlyList<uint>> PlayedAsync(uint self, IReadOnlyList<uint> others, CancellationToken ct = default) => throw X();
+    }
+}
