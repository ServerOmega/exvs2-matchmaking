+@* exvs2-lobbies 2026-11-15: confirm a destructive Friends page action; optionally also delete shared online tag teams. *@
+<MudDialog aria-describedby="friends-confirm-text">
+    <DialogContent>
+        <MudText id="friends-confirm-text">@Text</MudText>
+        @if (Names.Count > 0)
+        {
+            <MudText Typo="Typo.body2" Class="mt-2" Style="word-break: break-word">@string.Join(", ", Names.Take(10))@(Names.Count > 10 ? $" … (+{Names.Count - 10})" : "")</MudText>
+        }
+        @if (ShowDeleteTagTeams)
+        {
+            <MudCheckBox T="bool" @bind-Value="_deleteTagTeams" Color="Color.Error" Class="mt-3"
+                         Label="@localizer["friends_confirm_delete_tagteams"]" />
+            <MudText Typo="Typo.caption">@localizer["friends_confirm_delete_tagteams_help"]</MudText>
+        }
+    </DialogContent>
+    <DialogActions>
+        <MudButton OnClick="Cancel">@localizer["friends_cancel"]</MudButton>
+        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="Confirm">@ConfirmText</MudButton>
+    </DialogActions>
+</MudDialog>
+@code {
+    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
+    [Parameter] public string Text { get; set; } = "";
+    [Parameter] public List<string> Names { get; set; } = new();
+    [Parameter] public string ConfirmText { get; set; } = "OK";
+    [Parameter] public Color ConfirmColor { get; set; } = Color.Error;
+    [Parameter] public bool ShowDeleteTagTeams { get; set; }
+
+    private bool _deleteTagTeams;
+
+    void Cancel() => MudDialog.Cancel();
+    void Confirm() => MudDialog.Close(DialogResult.Ok(_deleteTagTeams));
+}
