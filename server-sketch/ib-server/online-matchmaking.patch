diff --git a/Server-Infinite/Lobbies/IpRateLimiter.cs b/Server-Infinite/Lobbies/IpRateLimiter.cs
new file mode 100644
index 0000000..2fc2c54
--- /dev/null
+++ b/Server-Infinite/Lobbies/IpRateLimiter.cs
@@ -0,0 +1,54 @@
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// exvs2-lobbies security hardening (2026-11-15): per-key token bucket (key = source IP). Thread-safe.
+/// <see cref="PerMinute"/> tokens are added per minute up to <see cref="Burst"/>; each request takes one.
+/// Idle buckets are pruned so a scan of many addresses cannot grow memory without bound.
+/// </summary>
+public sealed class IpRateLimiter
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<string, (double Tokens, double Last)> _buckets = new();
+    private double _lastPrune;
+
+    public IpRateLimiter(int perMinute, int burst)
+    {
+        PerMinute = Math.Max(0, perMinute);
+        Burst = Math.Max(1, burst);
+    }
+
+    public int PerMinute { get; }
+    public int Burst { get; }
+    public int MaxKeys { get; set; } = 50_000;
+    public bool Enabled => PerMinute > 0;
+    public int Count { get { lock (_gate) return _buckets.Count; } }
+
+    /// <summary>Take one token for <paramref name="key"/> at time <paramref name="now"/> (seconds, monotonic).</summary>
+    public bool TryAcquire(string key, double now)
+    {
+        if (!Enabled) return true;
+        var rate = PerMinute / 60.0;
+        lock (_gate)
+        {
+            if (now - _lastPrune > 60 || _buckets.Count > MaxKeys) Prune(now, rate);
+            var (tokens, last) = _buckets.TryGetValue(key, out var b) ? b : (Burst, now);
+            tokens = Math.Min(Burst, tokens + Math.Max(0, now - last) * rate);
+            if (tokens < 1)
+            {
+                _buckets[key] = (tokens, now);
+                return false;
+            }
+            _buckets[key] = (tokens - 1, now);
+            return true;
+        }
+    }
+
+    private void Prune(double now, double rate)
+    {
+        _lastPrune = now;
+        var full = rate > 0 ? Burst / rate : 0;   // a bucket idle this long is full again = same as absent
+        foreach (var k in _buckets.Where(kv => now - kv.Value.Last >= full).Select(kv => kv.Key).ToList())
+            _buckets.Remove(k);
+        if (_buckets.Count > MaxKeys) _buckets.Clear();
+    }
+}
