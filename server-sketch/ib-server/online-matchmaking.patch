@@ -0,0 +1,40 @@
+namespace WebUIInfinite.Client.Services;
+
+/// <summary>
+/// Retries a GET / HEAD that failed before any response arrived ("TypeError: Failed to fetch").
+/// The browser occasionally cancels the very first data fetch of a fresh page load (seen on the stock build
+/// too: about 1 in 3 cold loads in headless Chrome, net::ERR_ABORTED on data/Bgms.json before it reaches the
+/// server). Startup loads its JSON data before the first render, so one dropped fetch left the whole site stuck
+/// on "Loading..." with "An unhandled error has occurred". Only idempotent requests are retried; POSTs (logins,
+/// saves, friend actions) are never repeated. HTTP error statuses are returned unchanged.
+/// </summary>
+public sealed class RetryGetHandler : DelegatingHandler
+{
+    private static readonly TimeSpan[] Delays = { TimeSpan.FromMilliseconds(200), TimeSpan.FromMilliseconds(600), TimeSpan.FromMilliseconds(1500) };
+
+    public RetryGetHandler(HttpMessageHandler inner) : base(inner) { }
+
+    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+    {
+        var idempotent = request.Method == HttpMethod.Get || request.Method == HttpMethod.Head;
+        for (var attempt = 0; ; attempt++)
+        {
+            try
+            {
+                return await base.SendAsync(attempt == 0 ? request : Clone(request), cancellationToken);
+            }
+            catch (HttpRequestException) when (idempotent && attempt < Delays.Length && !cancellationToken.IsCancellationRequested)
+            {
+                await Task.Delay(Delays[attempt], cancellationToken);
+            }
+        }
+    }
+
+    private static HttpRequestMessage Clone(HttpRequestMessage r)
+    {
+        var c = new HttpRequestMessage(r.Method, r.RequestUri) { Version = r.Version, VersionPolicy = r.VersionPolicy };
+        foreach (var h in r.Headers) c.Headers.TryAddWithoutValidation(h.Key, h.Value);
+        foreach (var o in r.Options) ((IDictionary<string, object?>)c.Options)[o.Key] = o.Value;
+        return c;
+    }
+}
