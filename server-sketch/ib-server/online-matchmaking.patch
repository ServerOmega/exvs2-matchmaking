@@ -0,0 +1,223 @@
+@* exvs2-lobbies 2026-11-15: Your information, cross-server create/join, and Add Team — tidied as
+   expandable sections above the Teams list (same behaviour as the old stacked Customize Teams tab). *@
+@using WebUIInfinite.Shared.Dto.Common
+@using WebUIInfinite.Shared.Dto.Request
+@using WebUIInfinite.Shared.Dto.Response
+@using WebUIInfinite.Shared.Models
+@inject ISnackbar Snackbar
+@inject HttpClient Http
+@inject NavigationManager Nav
+
+@if (_error is not null)
+{
+    <MudAlert Severity="Severity.Warning" Class="mb-3">@_error</MudAlert>
+}
+
+@if (_loaded)
+{
+    <MudExpansionPanels MultiExpansion="true" Class="mb-4" Elevation="0">
+        <MudExpansionPanel Text="@localizer["teamtag_yourinfo"]" IsInitiallyExpanded="false">
+            <MudGrid>
+                <MudItem xs="12" sm="6">
+                    <MudTextField Value="@_userId.ToString()" Label="@localizer["teamtag_youruserid"]" ReadOnly="true" Variant="Variant.Outlined" />
+                </MudItem>
+                <MudItem xs="12" sm="6">
+                    <MudTextField @bind-Value="@_inviteToken" Label="@localizer["teamtag_yourinvit"]" ReadOnly="true" Variant="Variant.Outlined" />
+                </MudItem>
+                <MudItem xs="12">
+                    <MudTextField Value="@_yourPilotId.ToString()" Label="@localizer["teamtag_yourpilotid"]" ReadOnly="true" Variant="Variant.Outlined" />
+                </MudItem>
+            </MudGrid>
+        </MudExpansionPanel>
+        @if (_teamCount < MaxTeamCount)
+        {
+            <MudExpansionPanel Text="@localizer["teamtag_crossserver"]" IsInitiallyExpanded="false">
+                <MudText Typo="Typo.body2" Class="mb-3">@localizer["teamtag_crossserver_help"]</MudText>
+                <MudGrid>
+                    <MudItem xs="12" sm="8">
+                        <MudTextField @bind-Value="@MyPartnerCode" Label="@localizer["teamtag_crossserver_yourcode"]" ReadOnly="true" Variant="Variant.Outlined" />
+                    </MudItem>
+                    <MudItem xs="12" sm="4" Class="d-flex align-center">
+                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="CreatePartnerCode">@localizer["teamtag_crossserver_create"]</MudButton>
+                    </MudItem>
+                    <MudItem xs="12" sm="8">
+                        <MudTextField @bind-Value="@JoinPartnerCode" Label="@localizer["teamtag_crossserver_joinlabel"]" Variant="Variant.Outlined" />
+                    </MudItem>
+                    <MudItem xs="12" sm="4" Class="d-flex align-center">
+                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="JoinPartnerCodeClick">@localizer["teamtag_crossserver_join"]</MudButton>
+                    </MudItem>
+                </MudGrid>
+            </MudExpansionPanel>
+            <MudExpansionPanel Text="@localizer["teamtag_addteam"]" IsInitiallyExpanded="@(_teamCount == 0)">
+                <MudGrid>
+                    <MudItem xs="12" sm="6">
+                        <MudNumericField T="uint" @bind-Value="@FriendUserId" Label="@localizer["teamtag_frienduserid"]" Variant="Variant.Outlined" />
+                    </MudItem>
+                    <MudItem xs="12" sm="6">
+                        <MudTextField @bind-Value="@FriendTeamToken" Label="@localizer["teamtag_friendinvit"]" Variant="Variant.Outlined" />
+                    </MudItem>
+                    <MudItem xs="12">
+                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="AddTeam">@localizer["add_team_button"]</MudButton>
+                    </MudItem>
+                </MudGrid>
+            </MudExpansionPanel>
+        }
+    </MudExpansionPanels>
+}
+
+@code {
+    [Parameter] public string ChipId { get; set; } = string.Empty;
+    [Parameter] public string AccessCode { get; set; } = string.Empty;
+    [Parameter] public EventCallback OnTeamsChanged { get; set; }
+
+    private const uint MaxTeamCount = 20;
+    private bool _loaded;
+    private string? _error;
+    private uint _userId;
+    private string _inviteToken = "";
+    private uint _yourPilotId;
+    private int _teamCount;
+    private List<uint> _partnerIds = new();
+    private uint FriendUserId { get; set; }
+    private string FriendTeamToken { get; set; } = string.Empty;
+    private string MyPartnerCode { get; set; } = string.Empty;
+    private string JoinPartnerCode { get; set; } = string.Empty;
+    private (string, string)? _loadedFor;
+
+    protected override async Task OnParametersSetAsync()
+    {
+        if (_loadedFor == (ChipId, AccessCode)) return;
+        _loadedFor = (ChipId, AccessCode);
+        await Reload();
+    }
+
+    public async Task Reload()
+    {
+        _error = null;
+        _loaded = false;
+        try
+        {
+            var profileTask = Http.GetFromJsonAsync<BasicProfile>($"/ui/card/getBasicDisplayProfile/{Uri.EscapeDataString(AccessCode)}/{Uri.EscapeDataString(ChipId)}");
+            var teamsTask = Http.GetFromJsonAsync<TeamResponse>($"/ui/team/getTeams/{Uri.EscapeDataString(AccessCode)}/{Uri.EscapeDataString(ChipId)}");
+            await Task.WhenAll(profileTask, teamsTask);
+            var profile = profileTask.Result;
+            var teams = teamsTask.Result;
+            _userId = profile?.UserId ?? 0;
+            _inviteToken = teams?.DistinctTeamFormationToken ?? "";
+            _yourPilotId = teams?.YourPilotId ?? 0;
+            var list = teams?.Teams ?? new List<Team>();
+            _teamCount = list.Count;
+            _partnerIds = list.Select(t => t.PartnerId).ToList();
+            _loaded = true;
+        }
+        catch (Exception)
+        {
+            _error = localizer["teams_unavailable"];
+        }
+        StateHasChanged();
+    }
+
+    private async void CreatePartnerCode()
+    {
+        var result = await Http.PostAsJsonAsync("/ui/team/crossServerInvite", new BasicCardRequest
+        {
+            AccessCode = AccessCode,
+            ChipId = ChipId
+        });
+        var body = await result.Content.ReadFromJsonAsync<CrossServerInviteResponse>();
+        if (body is null || !body.Success)
+        {
+            Snackbar.Add(body?.Message ?? localizer["teamtag_crossserver_failed"], Severity.Warning);
+            return;
+        }
+        MyPartnerCode = body.Code;
+        Snackbar.Add(localizer["teamtag_crossserver_created"], Severity.Success);
+        StateHasChanged();
+    }
+
+    private async void JoinPartnerCodeClick()
+    {
+        if (string.IsNullOrWhiteSpace(JoinPartnerCode))
+        {
+            Snackbar.Add(localizer["teamtag_crossserver_blank"], Severity.Warning);
+            return;
+        }
+        var result = await Http.PostAsJsonAsync("/ui/team/joinCrossServer", new JoinCrossServerTeamRequest
+        {
+            AccessCode = AccessCode,
+            ChipId = ChipId,
+            Code = JoinPartnerCode.Trim()
+        });
+        var body = await result.Content.ReadFromJsonAsync<CrossServerInviteResponse>();
+        if (body is null || !body.Success)
+        {
+            Snackbar.Add(body?.Message ?? localizer["teamtag_crossserver_failed"], Severity.Warning);
+            return;
+        }
+        JoinPartnerCode = string.Empty;
+        Snackbar.Add(localizer["teamtag_crossserver_joined"], Severity.Success);
+        await Reload();
+        await OnTeamsChanged.InvokeAsync();
+    }
+
+    private async void AddTeam()
+    {
+        if (FriendUserId == 0)
+        {
+            Snackbar.Add($"{localizer["add_team_warning_blank_friend_user_id"]}", Severity.Warning);
+            return;
+        }
+
+        if (FriendUserId == _userId)
+        {
+            Snackbar.Add($"{localizer["add_team_warning_self_user_id"]}", Severity.Warning);
+            return;
+        }
+
+        if (_partnerIds.Contains(FriendUserId))
+        {
+            Snackbar.Add($"{localizer["add_team_warning_already_form_team"]}", Severity.Warning);
+            return;
+        }
+
+        if (FriendTeamToken == string.Empty)
+        {
+            Snackbar.Add($"{localizer["add_team_warning_blank_friend_invitation_code"]}", Severity.Warning);
+            return;
+        }
+
+        var profileResult = await Http.GetFromJsonAsync<PlayerExistenceResult>($"/ui/team/checkPlayerExistence/{FriendUserId}/{FriendTeamToken}");
+
+        if (profileResult is null || !profileResult.Success)
+        {
+            Snackbar.Add($"{localizer["add_team_warning_invalid_player_profile"]}", Severity.Warning);
+            return;
+        }
+
+        var preCreateRequest = new PreCreateTeamRequest()
+        {
+            AccessCode = AccessCode,
+            ChipId = ChipId,
+            PartnerCardId = profileResult.PlayerId,
+            PartnerToken = FriendTeamToken
+        };
+
+        var preCreate = await Http.PostAsJsonAsync("/ui/team/preCreateTeam", preCreateRequest);
+        var preCreateResult = await preCreate.Content.ReadFromJsonAsync<PreCreateTeamResponse>();
+
+        if (preCreateResult is null || !preCreateResult.Success)
+        {
+            Snackbar.Add($"{localizer["add_team_warning_invalid_player_profile"]}", Severity.Warning);
+            return;
+        }
+
+        if (preCreateRequest.PartnerCardId == 0 || preCreateResult.NewTeamId == 0)
+        {
+            return;
+        }
+
+        FriendTeamToken = string.Empty;   // invitation codes are one-time by default (OnlineTag.OneTimeInviteCode)
+        await OnTeamsChanged.InvokeAsync();
+        Nav.NavigateTo(TagTeamLinks.EditHref(ChipId, preCreateResult.NewTeamId));
+    }
+}
