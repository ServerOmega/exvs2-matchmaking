 .../Config/OnlineMatchingConfigurations.cs    |   8 +
 Server-Infinite/Program.cs                    |   6 +-
 .../Matchmaking.Tests/PairCancelGuardTests.cs | 264 ++++++++++++++++++
 4 files changed, 409 insertions(+), 6 deletions(-)
