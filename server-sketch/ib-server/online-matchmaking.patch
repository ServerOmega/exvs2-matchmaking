@@ -0,0 +1,47 @@
+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// exvs2-lobbies security hardening (2026-11-15). Who may reach this server and how often.
+/// <para><see cref="AccessMode"/>:</para>
+/// <list type="bullet">
+/// <item><c>LanOnly</c> (default): every path answers only loopback / private / link-local sources
+/// (127/8, 10/8, 172.16/12, 192.168/16, 169.254/16, ::1, fc00::/7, fe80::/10) plus <see cref="ExtraAllowedCidrs"/>.
+/// For a card server whose cabinets are on the same LAN.</item>
+/// <item><c>PublicMatchmaker</c>: internet sources may reach only <c>/match</c>, <c>/mms</c> and <c>/tag</c>;
+/// the WebUI, card APIs (<c>/ui</c>, <c>/sys</c>, <c>/game</c> …) and static files stay LAN-only. For the VPS.</item>
+/// <item><c>Open</c>: upstream behaviour (no source filtering). Not recommended.</item>
+/// </list>
+/// </summary>
+public class SecurityConfigurations
+{
+    public string AccessMode { get; set; } = "LanOnly";
+
+    /// <summary>Extra source networks treated as LAN, e.g. "100.64.0.0/10 26.0.0.0/8" (Tailscale, Radmin). Space or comma separated.</summary>
+    public string ExtraAllowedCidrs { get; set; } = "";
+
+    /// <summary>Per source IP token bucket for /match and /mms: sustained requests per minute (0 = off).
+    /// A cabinet polls about every 3 s, so 1200/min leaves room for 16+ cabinets behind one NAT.</summary>
+    public int MatchRequestsPerMinute { get; set; } = 1200;
+
+    /// <summary>Burst size for /match (requests allowed at once before the per-minute rate applies).</summary>
+    public int MatchBurst { get; set; } = 300;
+
+    /// <summary>Per source IP token bucket for /tag (card servers only): requests per minute (0 = off).</summary>
+    public int TagRequestsPerMinute { get; set; } = 240;
+
+    /// <summary>Burst size for /tag.</summary>
+    public int TagBurst { get; set; } = 60;
+
+    /// <summary>Loopback sources are never rate limited.</summary>
+    public bool ExemptLoopbackFromRateLimit { get; set; } = true;
+
+    /// <summary>
+    /// /match CancelMatching and CheckMatching for a node are honoured only from the source IP that sent that node's
+    /// EntryMatching (when one was recorded). Stops a stranger from cancelling other cabinets' searches or reading
+    /// their room roster by guessing node ids. Cabinets behind one NAT share the IP, so this is safe for LAN setups.
+    /// </summary>
+    public bool BindMatchNodesToSourceIp { get; set; } = true;
+
+    /// <summary>Mask public IPv4 addresses (a.b.x.x) and partner codes in every log line. Private / loopback IPs are kept.</summary>
+    public bool MaskNetworkInLog { get; set; } = true;
+}
