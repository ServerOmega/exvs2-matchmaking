+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Controllers;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Shared friend / block API on the matchmaker. Lives under /tag so it inherits the /tag
+/// shared secret (X-Tag-Secret), the /tag rate limit and the PublicMatchmaker allowlist without new rules.
+/// Card servers call it (RegisterOption forwarding, the Friends page, LoadCard NG list); cabinets never do.
+/// Ids are wire pilot ids. Lists are searched, sorted and paged here so big lists never travel whole.
+/// </summary>
+[ApiController]
+[Route("tag/friends")]
+public class FriendsController : ControllerBase
+{
+    private readonly FriendStore _store;
+    private readonly FriendsConfigurations _cfg;
+
+    public FriendsController(FriendStore store, IOptions<CardServerConfig> options)
+    {
+        _store = store;
+        _cfg = options.Value.Friends;
+    }
+
+    public sealed class RequestBody
+    {
+        public uint FromPilotId { get; set; }
+        public string FromName { get; set; } = "";
+        public uint ToPilotId { get; set; }
+        public string Source { get; set; } = "game";
+    }
+
+    public sealed class BulkBody
+    {
+        public uint PilotId { get; set; }
+        public string Name { get; set; } = "";
+        public uint[] Others { get; set; } = Array.Empty<uint>();
+        public bool DeleteTagTeams { get; set; }
+        public string Source { get; set; } = "web";
+    }
+
+    [HttpPost("request")]
+    public IActionResult SendRequest([FromBody] RequestBody body)
+    {
+        if (!_cfg.Enabled) return NotFound();
+        if (body.FromPilotId == 0 || body.ToPilotId == 0) return BadRequest(new { error = "fromPilotId and toPilotId are required." });
+        if ((body.FromName?.Length ?? 0) > 2 * TagInviteStore.MaxNameLength) return BadRequest(new { error = "name is too long." });
+        return Ok(_store.Request(body.FromPilotId, body.FromName, body.ToPilotId, Src(body.Source)));
+    }
+
+    [HttpPost("accept")]
+    public IActionResult Accept([FromBody] BulkBody b) => Bulk(b, o => _store.Accept(b.PilotId, b.Name, o));
+
+    [HttpPost("decline")]
+    public IActionResult Decline([FromBody] BulkBody b) => Bulk(b, o => _store.Decline(b.PilotId, o));
+
+    [HttpPost("remove")]
+    public IActionResult Remove([FromBody] BulkBody b) => Bulk(b, o => _store.Remove(b.PilotId, o, b.DeleteTagTeams));
+
+    [HttpPost("block")]
+    public IActionResult Block([FromBody] BulkBody b) => Bulk(b, o => _store.Block(b.PilotId, o, Src(b.Source), b.DeleteTagTeams));
+
+    [HttpPost("unblock")]
+    public IActionResult Unblock([FromBody] BulkBody b) => Bulk(b, o => _store.Unblock(b.PilotId, o));
+
+    /// <summary>GET /tag/friends/{pilotId}?tab=friends|incoming|outgoing|requests|blocked&amp;q=&amp;sort=name|added|lastPlayed&amp;dir=asc|desc&amp;page=1&amp;pageSize=25</summary>
+    [HttpGet("{pilotId}")]
+    public IActionResult List(uint pilotId, [FromQuery] string? tab, [FromQuery] string? q, [FromQuery] string? sort,
+        [FromQuery] string? dir, [FromQuery] int page = 1, [FromQuery] int pageSize = 25)
+    {
+        if (!_cfg.Enabled) return NotFound();
+        if (pilotId == 0) return BadRequest(new { error = "pilotId is required." });
+        return Ok(_store.List(pilotId, new FriendQuery { Tab = tab ?? "", Q = q, Sort = sort ?? "", Dir = dir, Page = page, PageSize = pageSize }));
+    }
+
+    /// <summary>Block list ids, newest first (LoadCard NG list).</summary>
+    [HttpGet("{pilotId}/blocked")]
+    public IActionResult Blocked(uint pilotId, [FromQuery] int max = 100)
+    {
+        if (!_cfg.Enabled) return NotFound();
+        return Ok(_store.BlockedIds(pilotId, Math.Clamp(max, 0, 1000)));
+    }
+
+    private IActionResult Bulk(BulkBody b, Func<uint, FriendOutcome> f)
+    {
+        if (!_cfg.Enabled) return NotFound();
+        if (b.PilotId == 0) return BadRequest(new { error = "pilotId is required." });
+        if ((b.Others?.Length ?? 0) > FriendLimits.MaxBulk) return BadRequest(new { error = $"at most {FriendLimits.MaxBulk} ids per call." });
+        if ((b.Name?.Length ?? 0) > 2 * TagInviteStore.MaxNameLength) return BadRequest(new { error = "name is too long." });
+        var results = FriendLimits.CleanIds(b.Others).Select(f).ToList();
+        return Ok(new { ok = true, results });
+    }
+
+    private static string Src(string? s) => s == "web" ? "web" : "game";
+}
