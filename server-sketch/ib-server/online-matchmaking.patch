+@code {
+    [Parameter] public string ChipId { get; set; } = string.Empty;
+
+    private readonly List<BreadcrumbItem> _breadcrumbs = new();
+    private string _accessCode = "";
+    private string? _errorMessage;
+    private bool _busy;
+
+    private int _tabIndex;
+    private string _tab = "friends";            // friends | requests | blocked
+    private string _requestsView = "requests";  // requests (all) | incoming | outgoing
+    private string? _q;
+    private string _sort = "added";
+    private string _dir = "desc";
+    private int _pageSize = 25;
+    private int _pageNo = 1;
+    private string _addId = "";
+
+    private FriendsListResponse _page = new();
+    private HashSet<FriendItem> _selected = new();
+
+    protected override async Task OnInitializedAsync()
+    {
+        _breadcrumbs.Add(new BreadcrumbItem("Menu", href: $"Cards/SingularCardMenu/{ChipId}"));
+        _breadcrumbs.Add(new BreadcrumbItem(localizer["friends_title"], href: null, disabled: true));
+        _accessCode = await JS.InvokeAsync<string>("accessCode.get", ChipId) ?? "";
+        if (string.IsNullOrEmpty(_accessCode))
+        {
+            _errorMessage = localizer["invalid_user_login"];
+            return;
+        }
+        await Load();
+    }
+
+    private string ApiTab() => _tab == "requests" ? _requestsView : _tab;
+
+    private async Task Load()
+    {
+        _busy = true;
+        StateHasChanged();
+        try
+        {
+            var res = await Http.PostAsJsonAsync("ui/friends/list", new FriendsListRequest
+            {
+                AccessCode = _accessCode, ChipId = ChipId, Tab = ApiTab(), Q = _q, Sort = _sort, Dir = _dir,
+                Page = _pageNo, PageSize = _pageSize,
+            });
+            var body = res.IsSuccessStatusCode ? await res.Content.ReadFromJsonAsync<FriendsListResponse>() : null;
+            if (body is null)
+            {
+                Snackbar.Add(localizer["friends_unavailable"], Severity.Error);
+                return;
+            }
+            if (!body.Success)
+            {
+                if (body.YourPilotId == 0) _errorMessage = localizer["invalid_user_login"];
+                else Snackbar.Add($"{localizer["friends_unavailable"]} {body.Message}", Severity.Warning);
+                _page = new FriendsListResponse { YourPilotId = body.YourPilotId, YourName = body.YourName };
+                return;
+            }
+            _page = body;
+            _pageNo = body.Page;
+            _selected = new HashSet<FriendItem>();
+        }
+        catch (Exception)
+        {
+            Snackbar.Add(localizer["friends_unavailable"], Severity.Error);
+        }
+        finally
+        {
+            _busy = false;
+            StateHasChanged();
+        }
+    }
+
+    private Task OnTabChanged(int i)
+    {
+        _tabIndex = i;
+        _tab = i switch { 1 => "requests", 2 => "blocked", _ => "friends" };
+        if (_tab == "blocked" && _sort == "lastPlayed") _sort = "added";
+        _pageNo = 1;
+        _addId = "";
+        return Load();
+    }
+
+    private Task SetRequestsView(string v) { _requestsView = v; _pageNo = 1; return Load(); }
+    private Task OnSearchChanged(string? v) { _q = string.IsNullOrWhiteSpace(v) ? null : v.Trim(); _pageNo = 1; return Load(); }
+    private Task OnSortChanged(string v) { _sort = v; _dir = v == "name" ? "asc" : "desc"; _pageNo = 1; return Load(); }
+    private Task ToggleDir() { _dir = _dir == "asc" ? "desc" : "asc"; _pageNo = 1; return Load(); }
+    private Task OnPageSizeChanged(int v) { _pageSize = v; _pageNo = 1; return Load(); }
+    private Task OnPageChanged(int p) { _pageNo = p; return Load(); }
+    private void OnSelectionChanged(HashSet<FriendItem> s) => _selected = s;
+    private void ClearSelection() => _selected = new HashSet<FriendItem>();
+    private List<FriendItem> Selected() => _selected.ToList();
+
+    private string Label(FriendItem i) => string.IsNullOrEmpty(i.Name) ? i.PilotId.ToString() : $"{i.Name} ({i.PilotId})";
+
+    private string TabLabel() => _tab switch
+    {
+        "requests" => localizer["friends_tab_requests"],
+        "blocked" => localizer["friends_tab_blocked"],
+        _ => localizer["friends_tab_friends"],
+    };
+
+    private string EmptyText() => ApiTab() switch
+    {
+        "incoming" or "outgoing" or "requests" => localizer["friends_empty_requests"],
+        "blocked" => localizer["friends_empty_blocked"],
+        _ => localizer["friends_empty_friends"],
+    };
+
+    private async Task CopyId()
+    {
+        try
+        {
+            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _page.YourPilotId.ToString());
+            Snackbar.Add(localizer["friends_copied"], Severity.Info);
+        }
+        catch (Exception) { }
+    }
+
+    private async Task<(bool Ok, bool DeleteTagTeams)> Confirm(string text, List<FriendItem> items, string confirm, Color color, bool tagTeamsOption)
+    {
+        var p = new DialogParameters<FriendsConfirmDialog>
+        {
+            { x => x.Text, text },
+            { x => x.Names, items.Select(Label).ToList() },
+            { x => x.ConfirmText, confirm },
+            { x => x.ConfirmColor, color },
+            { x => x.ShowDeleteTagTeams, tagTeamsOption },
+        };
+        var dlg = await DialogService.ShowAsync<FriendsConfirmDialog>(localizer["friends_confirm_title"], p,
+            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
+        var r = await dlg.Result;
+        if (r is null || r.Canceled) return (false, false);
+        return (true, r.Data is bool b && b);
+    }
+
+    private async Task Accept(List<FriendItem> items)
+    {
+        if (items.Count == 0) return;
+        await Bulk("ui/friends/accept", items, false);
+    }
+
+    private async Task Decline(List<FriendItem> items)
+    {
+        if (items.Count == 0) return;
+        var (ok, _) = await Confirm(string.Format(localizer["friends_confirm_decline"], items.Count), items, localizer["friends_decline_cancel"], Color.Warning, false);
+        if (ok) await Bulk("ui/friends/decline", items, false);
+    }
+
+    private async Task Remove(List<FriendItem> items)
+    {
+        if (items.Count == 0) return;
+        var (ok, del) = await Confirm(string.Format(localizer["friends_confirm_remove"], items.Count), items, localizer["friends_remove"], Color.Warning, true);
+        if (ok) await Bulk("ui/friends/remove", items, del);
+    }
+
+    private async Task Block(List<FriendItem> items)
+    {
+        if (items.Count == 0) return;
+        var (ok, del) = await Confirm(string.Format(localizer["friends_confirm_block"], items.Count), items, localizer["friends_block"], Color.Error, true);
+        if (ok) await Bulk("ui/friends/block", items, del);
+    }
+
+    private async Task Unblock(List<FriendItem> items)
+    {
+        if (items.Count == 0) return;
+        if (items.Count > 1)
+        {
+            var (ok, _) = await Confirm(string.Format(localizer["friends_confirm_unblock"], items.Count), items, localizer["friends_unblock"], Color.Primary, false);
+            if (!ok) return;
+        }
+        await Bulk("ui/friends/unblock", items, false);
+    }
+
+    private async Task Bulk(string url, List<FriendItem> items, bool deleteTagTeams)
+    {
+        await Send(url, new FriendsBulkRequest
+        {
+            AccessCode = _accessCode, ChipId = ChipId, PilotIds = items.Select(i => i.PilotId).Distinct().Take(100).ToList(),
+            DeleteTagTeams = deleteTagTeams,
+        });
+    }
+
+    private async Task OnAddKey(KeyboardEventArgs e)
+    {
+        if (e.Key == "Enter") await AddById();
+    }
+
+    private async Task AddById()
+    {
+        if (!uint.TryParse((_addId ?? "").Trim(), out var id) || id == 0)
+        {
+            Snackbar.Add(localizer["friends_add_invalid"], Severity.Warning);
+            return;
+        }
+        if (id == _page.YourPilotId)
+        {
+            Snackbar.Add(localizer["friends_result_RefusedSelf"], Severity.Warning);
+            return;
+        }
+        var del = false;
+        if (_tab == "blocked")
+        {
+            var (ok, d) = await Confirm(string.Format(localizer["friends_confirm_block"], 1), new() { new FriendItem { PilotId = id } },
+                localizer["friends_block"], Color.Error, true);
+            if (!ok) return;
+            del = d;
+        }
+        var sent = await Send(_tab == "blocked" ? "ui/friends/blockId" : "ui/friends/request",
+            new FriendsTargetRequest { AccessCode = _accessCode, ChipId = ChipId, PilotId = id, DeleteTagTeams = del });
+        if (sent) _addId = "";
+    }
+
+    private async Task<bool> Send<T>(string url, T body)
+    {
+        _busy = true;
+        StateHasChanged();
+        FriendsActionResponse? r = null;
+        try
+        {
+            var res = await Http.PostAsJsonAsync(url, body);
+            r = res.IsSuccessStatusCode ? await res.Content.ReadFromJsonAsync<FriendsActionResponse>() : null;
+        }
+        catch (Exception) { }
+        _busy = false;
+        if (r is null)
+        {
+            Snackbar.Add(localizer["friends_unavailable"], Severity.Error);
+            return false;
+        }
+        if (r.Results.Count == 0)
+        {
+            Snackbar.Add(r.Message ?? localizer["friends_unavailable"].Value, Severity.Warning);
+            return false;
+        }
+        if (r.Results.Count == 1)
+        {
+            var one = r.Results[0];
+            Snackbar.Add(ResultText(one.Result), one.Ok ? Severity.Success : Severity.Warning);
+        }
+        else
+        {
+            var ok = r.Results.Count(x => x.Ok);
+            Snackbar.Add(string.Format(localizer["friends_bulk_done"], ok, r.Results.Count), ok == r.Results.Count ? Severity.Success : Severity.Warning);
+        }
+        if (r.TagTeamsCreated > 0) Snackbar.Add(localizer["friends_tagteam_created"], Severity.Info);
+        if (r.TagTeamsDeleted > 0) Snackbar.Add(string.Format(localizer["friends_tagteams_deleted"], r.TagTeamsDeleted), Severity.Info);
+        await Load();
+        return r.Results.Any(x => x.Ok);
+    }
+
+    private string ResultText(string result)
+    {
+        var s = localizer["friends_result_" + result];
+        return s.ResourceNotFound ? result : s.Value;
+    }
+}
