+using System.Text.Json;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Handlers.Game.Online;
+using ServerInfinite.Handlers.UI.Stats;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Cards.Battle.History;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Stats;
+using WebUIInfinite.Shared.Exception;
+using Xunit;
+
+namespace Server.Tests;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: View Card -> Stats (GetCardStatsCommand). Read-only, card owner only (access code +
+/// chip id), per-mode summary, per-suit table with a per-mode split, recent battles.
+/// </summary>
+public sealed class CardStatsTests : IDisposable
+{
+    private readonly SqliteConnection _connection;
+    private readonly ServerDbContext _db;
+
+    public CardStatsTests()
+    {
+        OnlineBattleResults.ResetForTests();
+        _connection = new SqliteConnection("DataSource=:memory:");
+        _connection.Open();
+        _db = NewContext();
+        _db.Database.Migrate();
+    }
+
+    public void Dispose()
+    {
+        _db.Dispose();
+        _connection.Dispose();
+    }
+
+    private ServerDbContext NewContext() =>
+        new(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_connection).Options);
+
+    private CardProfile NewCard(string session, string name = "PILOT")
+    {
+        var card = new CardProfile
+        {
+            AccessCode = "ac-" + session,
+            ChipId = "chip-" + session,
+            SessionId = session,
+            UserName = name,
+            IsNewCard = false,
+            DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+        };
+        _db.CardProfiles.Add(card);
+        _db.SaveChangesAsync().GetAwaiter().GetResult();
+        return card;
+    }
+
+    private void SendOnline(CardProfile card, OnlineMatchingMode mode, bool shuffle, bool win, uint suit, uint roomId,
+        ulong playedAt, uint given = 900, uint taken = 1500, uint burstType = 1)
+    {
+        var result = new Request.SaveVsmOnResult.PlayResultGroup
+        {
+            PlayedAt = playedAt, WinFlag = win, VsElapsedTime = 125, StageId = 5,
+            MstMobileSuitId = suit, SkillPointMobileSuitId = suit, ResultScore = 1000, ResultOrder = 1,
+            LevelId = 3, PlayerLevelId = 3, LevelExp = 10, Gp = 100,
+            GivenDamage = given, TakenDamage = taken, Burst = 1, BurstType = burstType, BurstGivenDamage = 100,
+            ComboGivenDamage = 200, ConsecutiveWin = win ? 1u : 0u, RoomId = roomId, OnlineMatchingMode = mode, BadgeId = 1,
+            Partner = new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 402 },
+        };
+        result.Foes.Add(new AdversaryManGroup { PilotId = 3_000_456, CpuFlag = 0, MstMobileSuitId = 332, DownNum = 1 });
+        result.Foes.Add(new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 333, DownNum = 1 });
+        if (mode == OnlineMatchingMode.OmmClass)
+        {
+            result.class_match_result = new Request.SaveVsmOnResult.PlayResultGroup.ClassMatchResult
+            {
+                ClassIdSolo = 2, ClassIdTeam = 2, BeforeRate = 1500f, AfterRate = 1500f, ObtainedRate = 0f, GradeId = 3,
+            };
+        }
+        var request = new Request
+        {
+            Type = MethodType.MthdSaveVsmOnResult,
+            RequestId = "test",
+            save_vsm_on_result = new Request.SaveVsmOnResult
+            {
+                PilotId = (uint)card.Id, SessionId = card.SessionId, ShuffleFlag = shuffle, Result = result,
+            },
+        };
+        var config = new CardServerConfig { LogNetworkReport = false };
+        using var db = NewContext();
+        var handler = new SaveVsmOnResultCommandHandler(NullLogger<SaveVsmOnResultCommandHandler>.Instance, db,
+            Options.Create(config));
+        var response = handler.Handle(new SaveVsmOnResultCommand(request), CancellationToken.None).GetAwaiter().GetResult();
+        Assert.Equal(Error.Success, response.Error);
+    }
+
+    /// <summary>An offline battle as SaveVsmResult would leave it: lifetime counters + a history row.</summary>
+    private void AddOffline(CardProfile card, bool win, uint suit, ulong playedAt, bool team = false)
+    {
+        using var db = NewContext();
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        if (win) wl.TotalWin++; else wl.TotalLose++;
+        if (team) { if (win) wl.TeamWin++; else wl.TeamLose++; }
+        else { if (win) wl.ShuffleWin++; else wl.ShuffleLose++; }
+        var pvp = db.MobileSuitPvPStatisticDbSet.FirstOrDefault(x => x.CardId == card.Id && x.MstMobileSuitId == suit);
+        if (pvp is null)
+        {
+            pvp = new ServerInfinite.Models.Cards.MobileSuit.MobileSuitPvPStatistic { CardId = card.Id, MstMobileSuitId = suit };
+            db.MobileSuitPvPStatisticDbSet.Add(pvp);
+        }
+        pvp.TotalBattleCount++;
+        if (win) pvp.TotalWinCount++;
+        pvp.TotalGivenDamage += 600;
+        pvp.TotalEnemyDefeatedCount += 2;
+        db.BattleHistoryDbSet.Add(new BattleHistory
+        {
+            CardId = card.Id, BattleMode = team ? "OfflineTeam" : "OfflineSolo", IsWin = win, PlayedAt = playedAt,
+            ElapsedSeconds = 90, GivenDamage = 600, TakenDamage = 300,
+            BattleSelf = new BattleSelf { CardId = (uint)card.Id, MobileSuitId = suit, PlayerName = card.UserName },
+        });
+        db.SaveChangesAsync().GetAwaiter().GetResult();
+    }
+
+    private CardStatsDto Stats(CardProfile card)
+    {
+        using var db = NewContext();
+        return new GetCardStatsCommandHandler(db)
+            .Handle(new GetCardStatsCommand(card.AccessCode, card.ChipId), CancellationToken.None).GetAwaiter().GetResult();
+    }
+
+    private static ModeRecordDto Mode(CardStatsDto s, string mode) => s.ModeRecords.Single(x => x.Mode == mode);
+
+    [Fact]
+    public void OnlyTheMatchingAccessCodeAndChipIdGetTheStats()
+    {
+        var a = NewCard("a");
+        var b = NewCard("b");
+        using var db = NewContext();
+        var handler = new GetCardStatsCommandHandler(db);
+        Task<CardStatsDto> Get(string ac, string chip) =>
+            handler.Handle(new GetCardStatsCommand(ac, chip), CancellationToken.None);
+
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get("wrong", a.ChipId)).GetAwaiter().GetResult();
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get(a.AccessCode, b.ChipId)).GetAwaiter().GetResult();
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get("", "")).GetAwaiter().GetResult();
+        Assert.NotNull(Get(a.AccessCode, a.ChipId).GetAwaiter().GetResult());
+    }
+
+    [Fact]
+    public void NewCardHasEmptyStats()
+    {
+        var s = Stats(NewCard("new"));
+        Assert.Equal(0u, Mode(s, StatsModes.Total).Battles);
+        Assert.Empty(s.Suits);
+        Assert.Empty(s.RecentBattles);
+        Assert.Equal(0, s.HistoryBattleCount);
+    }
+
+    [Fact]
+    public void OnlineAndOfflineBattlesAreSplitByModeAndSuit()
+    {
+        var card = NewCard("mix");
+        AddOffline(card, win: true, suit: 100, playedAt: 1_794_700_000);
+        AddOffline(card, win: false, suit: 100, playedAt: 1_794_700_100, team: true);
+        SendOnline(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true, suit: 313, roomId: 15, playedAt: 1_794_730_000);
+        SendOnline(card, OnlineMatchingMode.OmmFree, shuffle: true, win: false, suit: 313, roomId: 16, playedAt: 1_794_730_500, given: 500, taken: 2000);
+        SendOnline(card, OnlineMatchingMode.OmmFree, shuffle: true, win: true, suit: 401, roomId: 17, playedAt: 1_794_731_000, burstType: 2);
+
+        var s = Stats(card);
+
+        Assert.Equal((3u, 2u), (Mode(s, StatsModes.Total).Wins, Mode(s, StatsModes.Total).Losses));
+        Assert.Equal((1u, 1u), (Mode(s, StatsModes.Offline).Wins, Mode(s, StatsModes.Offline).Losses));
+        Assert.Equal((1u, 0u), (Mode(s, StatsModes.OfflineSolo).Wins, Mode(s, StatsModes.OfflineSolo).Losses));
+        Assert.Equal((0u, 1u), (Mode(s, StatsModes.OfflineTeam).Wins, Mode(s, StatsModes.OfflineTeam).Losses));
+        Assert.Equal((1u, 0u), (Mode(s, StatsModes.ClassSolo).Wins, Mode(s, StatsModes.ClassSolo).Losses));
+        Assert.Equal(0u, Mode(s, StatsModes.ClassTeam).Battles);
+        Assert.Equal((1u, 1u), (Mode(s, StatsModes.Mix).Wins, Mode(s, StatsModes.Mix).Losses));
+        Assert.Equal(0u, Mode(s, StatsModes.Other).Battles);
+        Assert.Equal(60.0, Mode(s, StatsModes.Total).WinRate, 3);
+
+        Assert.Equal(5, s.HistoryBattleCount);
+        Assert.Equal(new uint[] { 100, 313, 401 }, s.Suits.Select(x => x.MobileSuitId).OrderBy(x => x).ToArray());
+
+        var gx = s.Suits.Single(x => x.MobileSuitId == 313);
+        Assert.Equal(2u, gx.Battles);
+        Assert.Equal(1u, gx.Wins);
+        Assert.Equal(1u, gx.Losses);
+        Assert.Equal(1400ul, gx.GivenDamage);
+        Assert.Equal(700.0, gx.AverageDamage, 3);
+        Assert.Equal(2u, gx.TimesUsed);
+        Assert.Equal(1_794_730_500ul, gx.LastPlayedAt);
+        Assert.Equal(new[] { StatsModes.ClassSolo, StatsModes.Mix }, gx.Modes.Select(m => m.Mode).ToArray());
+        var gxMix = gx.Modes.Single(m => m.Mode == StatsModes.Mix);
+        Assert.Equal((1u, 0u, 500ul, 2000ul), (gxMix.Battles, gxMix.Wins, gxMix.GivenDamage, gxMix.TakenDamage));
+
+        var offlineSuit = s.Suits.Single(x => x.MobileSuitId == 100);
+        Assert.Equal((2u, 1u), (offlineSuit.Battles, offlineSuit.Wins));
+        Assert.Equal(new[] { StatsModes.OfflineSolo, StatsModes.OfflineTeam }, offlineSuit.Modes.Select(m => m.Mode).ToArray());
+
+        Assert.Equal(5, s.RecentBattles.Count);
+        Assert.Equal(new ulong[] { 1_794_731_000, 1_794_730_500, 1_794_730_000, 1_794_700_100, 1_794_700_000 },
+            s.RecentBattles.Select(x => x.PlayedAt).ToArray());
+        Assert.Equal((StatsModes.Mix, 401u, true), (s.RecentBattles[0].Mode, s.RecentBattles[0].MobileSuitId, s.RecentBattles[0].IsWin));
+        Assert.Equal(StatsModes.ClassSolo, s.RecentBattles[2].Mode);
+        Assert.Equal(StatsModes.OfflineTeam, s.RecentBattles[3].Mode);
+
+        Assert.Equal(2300ul, s.Totals.GivenDamage);   // the three online battles (900 + 500 + 900) (offline rows were seeded per-suit only)
+        Assert.Contains(s.Bursts, b => b.BurstType == 2 && b.Battles == 1 && b.Wins == 1);
+        Assert.Contains(s.Bursts, b => b.BurstType == 1 && b.Battles == 2 && b.Wins == 1);
+    }
+
+    [Fact]
+    public void OtherCardsBattlesAreNotIncluded()
+    {
+        var a = NewCard("own");
+        var b = NewCard("other");
+        SendOnline(a, OnlineMatchingMode.OmmFree, shuffle: true, win: true, suit: 313, roomId: 1, playedAt: 1_794_730_000);
+        SendOnline(b, OnlineMatchingMode.OmmFree, shuffle: true, win: false, suit: 401, roomId: 1, playedAt: 1_794_730_000);
+        AddOffline(b, win: true, suit: 100, playedAt: 1_794_700_000);
+
+        var s = Stats(a);
+        Assert.Equal(1u, Mode(s, StatsModes.Total).Battles);
+        Assert.Equal(new uint[] { 313 }, s.Suits.Select(x => x.MobileSuitId).ToArray());
+        Assert.Single(s.RecentBattles);
+        Assert.Equal(1, s.HistoryBattleCount);
+    }
+
+    [Fact]
+    public void RecentBattlesAreCapped()
+    {
+        var card = NewCard("many");
+        for (var i = 0; i < CardStatsDto.RecentLimit + 5; i++)
+        {
+            AddOffline(card, win: i % 2 == 0, suit: 100, playedAt: 1_794_700_000ul + (ulong)i);
+        }
+        var s = Stats(card);
+        Assert.Equal(CardStatsDto.RecentLimit, s.RecentBattles.Count);
+        Assert.Equal(1_794_700_000ul + CardStatsDto.RecentLimit + 4, s.RecentBattles[0].PlayedAt);
+        Assert.Equal((uint)CardStatsDto.RecentLimit + 5, s.Suits.Single().Modes.Single().Battles);
+    }
+
+    [Fact]
+    public void TotalIsNeverBelowTheSumOfTheModes()
+    {
+        // older data: class wins counted by the class persistence without the total
+        var card = NewCard("legacy");
+        using (var db = NewContext())
+        {
+            var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+            wl.ClassSoloWin = 4;
+            wl.ClassSoloLose = 2;
+            wl.ShuffleWin = 1;
+            wl.TotalWin = 1;
+            db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        var s = Stats(card);
+        Assert.Equal((5u, 2u), (Mode(s, StatsModes.Total).Wins, Mode(s, StatsModes.Total).Losses));
+        Assert.Equal(0u, Mode(s, StatsModes.Other).Battles);
+
+        using (var db = NewContext())
+        {
+            var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+            wl.TotalWin = 8; // e.g. private-room online battles: only in the total
+            wl.TotalLose = 2;
+            db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        s = Stats(card);
+        Assert.Equal((3u, 0u), (Mode(s, StatsModes.Other).Wins, Mode(s, StatsModes.Other).Losses));
+    }
+
+    [Fact]
+    public void ResponseCarriesNoCardSecrets()
+    {
+        var card = NewCard("secret-xyz");
+        SendOnline(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true, suit: 313, roomId: 3, playedAt: 1_794_730_000);
+        var json = JsonSerializer.Serialize(Stats(card));
+        Assert.DoesNotContain(card.ChipId, json);
+        Assert.DoesNotContain(card.AccessCode, json);
+        Assert.DoesNotContain(card.SessionId, json);
+    }
+
+    [Fact]
+    public void BattleModeKeys()
+    {
+        Assert.Equal(StatsModes.OfflineSolo, StatsModes.FromBattleMode("OfflineSolo"));
+        Assert.Equal(StatsModes.OfflineTeam, StatsModes.FromBattleMode("OfflineTeam"));
+        Assert.Equal(StatsModes.ClassSolo, StatsModes.FromBattleMode("ClassMatchSolo"));
+        Assert.Equal(StatsModes.ClassTeam, StatsModes.FromBattleMode("ClassMatchTeam"));
+        Assert.Equal(StatsModes.Mix, StatsModes.FromBattleMode("FreeSolo"));
+        Assert.Equal(StatsModes.Mix, StatsModes.FromBattleMode("FreeTeam"));
+        Assert.Equal(StatsModes.Fes, StatsModes.FromBattleMode("FesSolo"));
+        Assert.Equal(StatsModes.Fes, StatsModes.FromBattleMode("FesTeam"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode("OnlineOtherSolo"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode("Triad"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode(null));
+    }
+
+    [Fact]
+    public void SuitTableRowsPerModeFilter()
+    {
+        var suits = new List<SuitStatsDto>
+        {
+            new()
+            {
+                MobileSuitId = 1, Battles = 10, Wins = 6, GivenDamage = 8000, EnemyDefeated = 15, TimesUsed = 12,
+                Modes =
+                {
+                    new SuitModeStatsDto { Mode = StatsModes.OfflineSolo, Battles = 2, Wins = 1, GivenDamage = 1000, TakenDamage = 800 },
+                    new SuitModeStatsDto { Mode = StatsModes.OfflineTeam, Battles = 2, Wins = 2, GivenDamage = 1400, TakenDamage = 400 },
+                    new SuitModeStatsDto { Mode = StatsModes.Mix, Battles = 1, Wins = 0, GivenDamage = 300, TakenDamage = 1800 },
+                },
+            },
+            new() { MobileSuitId = 2, Battles = 3, Wins = 3, GivenDamage = 3000 },
+            new() { MobileSuitId = 3 },
+        };
+
+        var all = SuitStatsRow.Build(suits, SuitStatsRow.AllModes);
+        Assert.Equal(new uint[] { 1, 2 }, all.Select(r => r.MobileSuitId).ToArray()); // no empty rows
+        var r1 = all[0];
+        Assert.Equal((10u, 6u, 4u), (r1.Battles, r1.Wins, r1.Losses));
+        Assert.Equal(60.0, r1.WinRate, 3);
+        Assert.Equal(800.0, r1.AverageDamage, 3);
+        Assert.Equal(600.0, r1.AverageTaken!.Value, 3);      // 3000 taken over 5 history battles
+        Assert.Equal(1.5, r1.DefeatedPerBattle!.Value, 3);
+        Assert.Null(all[1].AverageTaken);                  // no history for suit 2
+
+        var offline = SuitStatsRow.Build(suits, StatsModes.Offline);
+        var o = Assert.Single(offline);
+        Assert.Equal((4u, 3u), (o.Battles, o.Wins));
+        Assert.Equal(600.0, o.AverageDamage, 3);
+        Assert.Equal(300.0, o.AverageTaken!.Value, 3);
+        Assert.Null(o.EnemyDefeated);
+
+        var mix = Assert.Single(SuitStatsRow.Build(suits, StatsModes.Mix));
+        Assert.Equal((1u, 0u, 0.0), (mix.Battles, mix.Wins, mix.WinRate));
+        Assert.Empty(SuitStatsRow.Build(suits, StatsModes.ClassSolo));
+
+        Assert.Equal(new[] { SuitStatsRow.AllModes, StatsModes.Offline, StatsModes.OfflineSolo, StatsModes.OfflineTeam, StatsModes.Mix },
+            SuitStatsRow.AvailableModes(suits).ToArray());
+    }
+}
