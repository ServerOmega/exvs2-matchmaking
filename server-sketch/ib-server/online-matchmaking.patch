new file mode 100644
index 0000000..17f1540
--- /dev/null
+++ b/Server-Infinite/Leaderboards/LeaderboardIdentity.cs
@@ -0,0 +1,109 @@
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card-server side identity for the global boards: the opaque card key (HMAC-SHA256 of the
+/// local card id with a random per-server salt that never leaves this machine) and the players' "hide my name"
+/// choices. The access code, chip id and session never go into the key or the snapshot.
+/// </summary>
+public sealed class LeaderboardIdentity
+{
+    private readonly object _gate = new();
+    private readonly string? _hiddenPath;
+    private readonly byte[] _salt;
+    private readonly HashSet<int> _hidden = new();
+    private readonly HashSet<int> _shown = new();
+
+    public LeaderboardIdentity(string? saltPath, string? hiddenPath, bool hideByDefault = false)
+    {
+        HideByDefault = hideByDefault;
+        _salt = LoadOrCreateSalt(saltPath);
+        _hiddenPath = string.IsNullOrWhiteSpace(hiddenPath) ? null : hiddenPath;
+        LoadHidden();
+    }
+
+    /// <summary>For tests: a fixed salt, nothing persisted.</summary>
+    public LeaderboardIdentity(byte[] salt, bool hideByDefault = false)
+    {
+        HideByDefault = hideByDefault;
+        _salt = salt.Length >= 16 ? salt : throw new ArgumentException("salt must be at least 16 bytes");
+    }
+
+    public bool HideByDefault { get; }
+
+    /// <summary>32 lowercase hex characters, stable for this server's salt and card id. One-way.</summary>
+    public string KeyFor(int cardId)
+    {
+        using var h = new HMACSHA256(_salt);
+        var mac = h.ComputeHash(Encoding.UTF8.GetBytes("exvs2-leaderboard-card:" + cardId));
+        return Convert.ToHexString(mac, 0, 16).ToLowerInvariant();
+    }
+
+    public bool IsHidden(int cardId)
+    {
+        lock (_gate) return HideByDefault ? !_shown.Contains(cardId) : _hidden.Contains(cardId);
+    }
+
+    public void SetHidden(int cardId, bool hidden)
+    {
+        lock (_gate)
+        {
+            if (hidden) { _hidden.Add(cardId); _shown.Remove(cardId); }
+            else { _hidden.Remove(cardId); _shown.Add(cardId); }
+            SaveHidden();
+        }
+    }
+
+    private static byte[] LoadOrCreateSalt(string? path)
+    {
+        if (!string.IsNullOrWhiteSpace(path) && File.Exists(path))
+        {
+            try
+            {
+                var b = Convert.FromBase64String(File.ReadAllText(path).Trim());
+                if (b.Length >= 16) return b;
+            }
+            catch (FormatException) { }
+        }
+        var salt = RandomNumberGenerator.GetBytes(32);
+        if (!string.IsNullOrWhiteSpace(path))
+        {
+            var dir = Path.GetDirectoryName(path);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+            File.WriteAllText(path, Convert.ToBase64String(salt));
+        }
+        return salt;
+    }
+
+    private sealed class HiddenFile
+    {
+        public List<int> Hidden { get; set; } = new();
+        public List<int> Shown { get; set; } = new();
+    }
+
+    private void LoadHidden()
+    {
+        if (_hiddenPath == null || !File.Exists(_hiddenPath)) return;
+        try
+        {
+            var f = JsonSerializer.Deserialize<HiddenFile>(File.ReadAllText(_hiddenPath));
+            if (f == null) return;
+            foreach (var id in f.Hidden) _hidden.Add(id);
+            foreach (var id in f.Shown) _shown.Add(id);
+        }
+        catch (Exception) { /* unreadable file: start with everyone at the default */ }
+    }
+
+    private void SaveHidden()
+    {
+        if (_hiddenPath == null) return;
+        var dir = Path.GetDirectoryName(_hiddenPath);
+        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+        var tmp = _hiddenPath + ".tmp";
+        File.WriteAllText(tmp, JsonSerializer.Serialize(new HiddenFile { Hidden = _hidden.OrderBy(x => x).ToList(), Shown = _shown.OrderBy(x => x).ToList() }));
+        File.Move(tmp, _hiddenPath, overwrite: true);
+    }
+}
diff --git a/Server-Infinite/Leaderboards/LeaderboardSnapshotBuilder.cs b/Server-Infinite/Leaderboards/LeaderboardSnapshotBuilder.cs
new file mode 100644
index 0000000..69a0ae0
--- /dev/null
+++ b/Server-Infinite/Leaderboards/LeaderboardSnapshotBuilder.cs
@@ -0,0 +1,99 @@
+using Microsoft.EntityFrameworkCore;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Builds this card server's leaderboard snapshot from existing tables (no migration):
+/// win/loss record (Class solo / Class team / Mix counters), class records (class, grade, rate) and battle history
+/// (most played suit per board). One entry per card with at least <c>minMatches</c> on any board.
+/// </summary>
+public static class LeaderboardSnapshotBuilder
+{
+    private static readonly string[] ClassSoloModes = { "ClassMatchSolo" };
+    private static readonly string[] ClassTeamModes = { "ClassMatchTeam" };
+    private static readonly string[] MixModes = { "FreeSolo", "FreeTeam" };
+
+    public static async Task<List<LeaderboardEntryIn>> BuildAsync(ServerDbContext db, LeaderboardIdentity identity,
+        int minMatches = 1, CancellationToken ct = default)
+    {
+        minMatches = Math.Max(1, minMatches);
+        var records = await db.WinLossRecordDbSet.AsNoTracking()
+            .Where(w => w.ClassSoloWin + w.ClassSoloLose + w.ClassTeamWin + w.ClassTeamLose + w.FreeWin + w.FreeLose > 0)
+            .Select(w => new
+            {
+                w.CardId, w.ClassSoloWin, w.ClassSoloLose, w.ClassTeamWin, w.ClassTeamLose, w.FreeWin, w.FreeLose,
+            })
+            .ToListAsync(ct);
+        records = records.Where(w => w.ClassSoloWin + w.ClassSoloLose >= minMatches
+                                     || w.ClassTeamWin + w.ClassTeamLose >= minMatches
+                                     || w.FreeWin + w.FreeLose >= minMatches).ToList();
+        if (records.Count == 0) return new List<LeaderboardEntryIn>();
+
+        var ids = records.Select(r => r.CardId).ToHashSet();
+        var names = (await db.CardProfiles.AsNoTracking().Select(c => new { c.Id, c.UserName }).ToListAsync(ct))
+            .Where(c => ids.Contains(c.Id)).ToDictionary(c => c.Id, c => c.UserName);
+        var solo = (await db.SoloClassMatchRecordDbSet.AsNoTracking()
+                .Select(r => new { r.CardId, r.ClassId, r.Grade, r.Rate }).ToListAsync(ct))
+            .Where(r => ids.Contains(r.CardId)).GroupBy(r => r.CardId).ToDictionary(g => g.Key, g => g.First());
+        var team = (await db.TeamClassMatchRecordDbSet.AsNoTracking()
+                .Select(r => new { r.CardId, r.ClassId, r.Grade, r.Rate }).ToListAsync(ct))
+            .Where(r => ids.Contains(r.CardId)).GroupBy(r => r.CardId).ToDictionary(g => g.Key, g => g.First());
+
+        var modes = ClassSoloModes.Concat(ClassTeamModes).Concat(MixModes).ToList();
+        var played = (await db.BattleHistoryDbSet.AsNoTracking()
+                .Where(h => modes.Contains(h.BattleMode))
+                .Select(h => new { h.CardId, h.BattleMode, Suit = h.BattleSelf.MobileSuitId })
+                .ToListAsync(ct))
+            .Where(h => h.Suit != 0 && ids.Contains(h.CardId))
+            .ToList();
+        uint TopSuit(int cardId, string[] boardModes) => played
+            .Where(h => h.CardId == cardId && boardModes.Contains(h.BattleMode))
+            .GroupBy(h => h.Suit)
+            .OrderByDescending(g => g.Count()).ThenBy(g => g.Key)
+            .Select(g => g.Key).FirstOrDefault();
+
+        var list = new List<LeaderboardEntryIn>(records.Count);
+        foreach (var r in records.OrderBy(r => r.CardId))
+        {
+            var hidden = identity.IsHidden(r.CardId);
+            var e = new LeaderboardEntryIn
+            {
+                Key = identity.KeyFor(r.CardId),
+                Name = hidden ? "" : TagInviteStore.CleanName(names.GetValueOrDefault(r.CardId)),
+                Hidden = hidden,
+            };
+            if (r.ClassSoloWin + r.ClassSoloLose > 0)
+            {
+                var c = solo.GetValueOrDefault(r.CardId);
+                e.ClassSolo = new LeaderboardStats
+                {
+                    Wins = r.ClassSoloWin, Losses = r.ClassSoloLose,
+                    ClassId = c?.ClassId ?? 0, Grade = c?.Grade ?? 0, Rate = c?.Rate ?? 0,
+                    TopSuitId = TopSuit(r.CardId, ClassSoloModes),
+                };
+            }
+            if (r.ClassTeamWin + r.ClassTeamLose > 0)
+            {
+                var c = team.GetValueOrDefault(r.CardId);
+                e.ClassTeam = new LeaderboardStats
+                {
+                    Wins = r.ClassTeamWin, Losses = r.ClassTeamLose,
+                    ClassId = c?.ClassId ?? 0, Grade = c?.Grade ?? 0, Rate = c?.Rate ?? 0,
+                    TopSuitId = TopSuit(r.CardId, ClassTeamModes),
+                };
+            }
+            if (r.FreeWin + r.FreeLose > 0)
+            {
+                e.Mix = new LeaderboardStats
+                {
+                    Wins = r.FreeWin, Losses = r.FreeLose,
+                    TopSuitId = TopSuit(r.CardId, MixModes),
+                };
+            }
+            list.Add(e);
+        }
+        return list;
+    }
+}
diff --git a/Server-Infinite/Leaderboards/LeaderboardSubmitter.cs b/Server-Infinite/Leaderboards/LeaderboardSubmitter.cs
new file mode 100644
index 0000000..4ee27ec
--- /dev/null
+++ b/Server-Infinite/Leaderboards/LeaderboardSubmitter.cs
@@ -0,0 +1,136 @@
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Leaderboards;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-16] Card server: sends a full leaderboard snapshot to the matchmaker every
+/// Leaderboard.SubmitIntervalMinutes and Leaderboard.SubmitAfterResultSeconds after a saved online Class / Mix result.
+/// Background only: never delays a game reply. One snapshot in flight at a time; failures are logged and retried
+/// at the next tick.
+/// </summary>
+public sealed class LeaderboardSubmitter : BackgroundService
+{
+    private readonly IServiceScopeFactory _scopes;
+    private readonly ILeaderboardClient _client;
+    private readonly LeaderboardIdentity _identity;
+    private readonly LeaderboardConfigurations _cfg;
+    private readonly ILogger<LeaderboardSubmitter> _log;
+    private readonly SemaphoreSlim _wake = new(0, 1);
+    private readonly object _gate = new();
+    private DateTime? _dueUtc;
+    private long _lastGeneratedMs;
+
+    public LeaderboardSubmitter(IServiceScopeFactory scopes, ILeaderboardClient client, LeaderboardIdentity identity,
+        IOptions<CardServerConfig> options, ILogger<LeaderboardSubmitter> log)
+    {
+        _scopes = scopes;
+        _client = client;
+        _identity = identity;
+        _cfg = options.Value.Leaderboard;
+        _log = log;
+    }
+
+    public bool Active => _cfg.Enabled && _cfg.SubmitEnabled;
+    public DateTime? LastSubmitUtc { get; private set; }
+    public string? LastError { get; private set; }
+    public int LastCount { get; private set; }
+
+    /// <summary>A Class / Mix result was saved: send a snapshot soon (batched with the rest of the room's results).</summary>
+    public void ResultSaved()
+    {
+        if (!Active || _cfg.SubmitAfterResultSeconds <= 0) return;
+        RequestIn(TimeSpan.FromSeconds(_cfg.SubmitAfterResultSeconds));
+    }
+
+    /// <summary>Send a snapshot after <paramref name="delay"/> (an earlier pending request wins).</summary>
+    public void RequestIn(TimeSpan delay)
+    {
+        if (!Active) return;
+        lock (_gate)
+        {
+            var due = DateTime.UtcNow + delay;
+            if (_dueUtc == null || due < _dueUtc) _dueUtc = due;
+        }
+        try { if (_wake.CurrentCount == 0) _wake.Release(); } catch (SemaphoreFullException) { }
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        if (!Active) return;
+        var interval = TimeSpan.FromMinutes(Math.Max(1, _cfg.SubmitIntervalMinutes));
+        RequestIn(TimeSpan.FromSeconds(20)); // first snapshot shortly after start
+        while (!stoppingToken.IsCancellationRequested)
+        {
+            TimeSpan wait;
+            lock (_gate)
+            {
+                var due = _dueUtc ?? DateTime.UtcNow + interval;
+                _dueUtc ??= due;
+                wait = due - DateTime.UtcNow;
+            }
+            if (wait > TimeSpan.Zero)
+            {
+                try { await _wake.WaitAsync(wait, stoppingToken); }
+                catch (OperationCanceledException) { break; }
+                continue; // re-evaluate the due time (a result may have moved it earlier)
+            }
+            lock (_gate) _dueUtc = null;
+            await SubmitOnceAsync(stoppingToken);
+        }
+    }
+
+    /// <summary>Build and send one full snapshot now. Returns the matchmaker's answer.</summary>
+    public async Task<LeaderboardSubmitResult> SubmitOnceAsync(CancellationToken ct = default)
+    {
+        try
+        {
+            List<LeaderboardEntryIn> entries;
+            using (var scope = _scopes.CreateScope())
+            {
+                var db = scope.ServiceProvider.GetRequiredService<ServerDbContext>();
+                entries = await LeaderboardSnapshotBuilder.BuildAsync(db, _identity, _cfg.SubmitMinMatches, ct);
+            }
+            if (entries.Count == 0 && LastCount == 0 && LastSubmitUtc == null)
+            {
+                // nothing to show and nothing sent before from this process (e.g. the matchmaker itself): stay quiet
+                return new LeaderboardSubmitResult { Ok = true };
+            }
+            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+            _lastGeneratedMs = Math.Max(now, _lastGeneratedMs + 1);
+            var submission = new LeaderboardSubmission
+            {
+                ServerId = (uint)Math.Max(1, PilotId.ServerId),
+                GeneratedUnixMs = _lastGeneratedMs,
+                Full = true,
+                Entries = entries,
+            };
+            using var cts = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            cts.CancelAfter(TimeSpan.FromSeconds(15));
+            var r = await _client.SubmitAsync(submission, cts.Token);
+            if (r.Ok)
+            {
+                LastSubmitUtc = DateTime.UtcNow;
+                LastError = null;
+                LastCount = entries.Count;
+                _log.LogInformation("LEADERBOARD snapshot sent: cards={Cards} accepted={Accepted} rejected={Rejected} removed={Removed}{Stale}",
+                    entries.Count, r.Accepted, r.Rejected, r.Removed, r.Stale ? " (stale, ignored)" : "");
+            }
+            else
+            {
+                LastError = r.Error ?? $"status {r.Status}";
+                _log.LogWarning("LEADERBOARD snapshot not accepted ({Status}): {Error}", r.Status, LastError);
+                if (r.Status == 429) RequestIn(TimeSpan.FromSeconds(Math.Max(5, _cfg.SubmitAfterResultSeconds) + 20));
+            }
+            return r;
+        }
+        catch (Exception ex) when (ex is not OperationCanceledException || !ct.IsCancellationRequested)
+        {
+            LastError = ex.Message;
+            _log.LogWarning("LEADERBOARD snapshot not sent ({Error})", ex.GetType().Name + ": " + ex.Message);
+            return new LeaderboardSubmitResult { Ok = false, Status = 0, Error = ex.Message };
+        }
+    }
+}
