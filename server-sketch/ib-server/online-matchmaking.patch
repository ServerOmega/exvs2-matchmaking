+@* exvs2-lobbies 2026-11-16: View Card -> Stats (VS Mobile style): mode summary, sortable per-suit table, recent battles. *@
+@using WebUIInfinite.Client.Services.MS
+@using WebUIInfinite.Shared.Dto.Common
+@using WebUIInfinite.Shared.Dto.Stats
+@inject IMobileSuitDataService MobileSuitDataService
+
+@if (CardStats is null)
+{
+    <MudAlert Severity="Severity.Info">@localizer["card_stats_unavailable"]</MudAlert>
+    return;
+}
+
+<MudStack Spacing="4">
+    @* ---- summary per mode ---- *@
+    <MudText Typo="Typo.h6">@localizer["card_stats_summary"]</MudText>
