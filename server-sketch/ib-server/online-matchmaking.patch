+using nue.protocol.exvs;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] "Last played" for friends from real battle results. When this card server saves a
+/// versus result (SaveVsmOnResult = online, SaveVsmResult = in-store / LAN), the result names the partner and the
+/// foes by wire pilot id (cpu_flag marks CPUs). Those ids go to the matchmaker (POST /tag/friends/played), which
+/// stamps last played on every friendship between this player and them, across card servers.
+/// Best effort: runs in the background after the reply, one try, a failure is only logged.
+/// </summary>
+public sealed class FriendPlayedReporter
+{
+    private readonly IFriendClient? _client;
+    private readonly Action<string>? _log;
+
+    public FriendPlayedReporter(IFriendClient? client, Action<string>? log = null)
+    {
+        _client = client;
+        _log = log;
+    }
+
+    /// <summary>Humans other than <paramref name="self"/> named by a result (partner first, then foes).</summary>
+    public static IReadOnlyList<uint> OthersFrom(uint self, AdversaryManGroup? partner, IEnumerable<AdversaryManGroup>? foes)
+    {
+        var all = new List<AdversaryManGroup>();
+        if (partner != null) all.Add(partner);
+        if (foes != null) all.AddRange(foes.Where(f => f != null));
+        return all.Where(a => a.CpuFlag == 0 && a.PilotId != 0 && a.PilotId != self)
+            .Select(a => a.PilotId).Distinct().Take(FriendStore.MaxPlayedOthers).ToList();
+    }
+
+    /// <summary>Report and wait (tests / callers that want the result).</summary>
+    public async Task<IReadOnlyList<uint>> ReportAsync(uint self, IReadOnlyList<uint> others, string source, CancellationToken ct = default)
+    {
+        if (_client == null || self == 0 || others.Count == 0) return Array.Empty<uint>();
+        try
+        {
+            var updated = await _client.PlayedAsync(self, others, ct);
+            if (updated.Count > 0)
+                _log?.Invoke($"Friends: {source} pilot {self} played with friend(s) {string.Join(",", updated)}: last played updated");
+            return updated;
+        }
+        catch (Exception ex)
+        {
+            _log?.Invoke($"Friends: {source} pilot {self}: last played not sent ({ex.Message})");
+            return Array.Empty<uint>();
+        }
+    }
+
+    /// <summary>Fire and forget after the game's reply (never delays or fails the result save).</summary>
+    public void Report(uint self, AdversaryManGroup? partner, IEnumerable<AdversaryManGroup>? foes, string source)
+    {
+        if (_client == null) return;
+        var others = OthersFrom(self, partner, foes);
+        if (others.Count == 0) return;
+        _ = Task.Run(async () =>
+        {
+            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+            await ReportAsync(self, others, source, cts.Token);
+        });
+    }
+}
