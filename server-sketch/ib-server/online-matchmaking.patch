+/// <summary>Result of one action plus any online tag codes it deleted (card servers drop their local rows).</summary>
+public sealed class FriendOutcome
+{
+    public uint PilotId { get; set; }
+    public FriendResult Result { get; set; }
+    /// <summary>Set when a request became mutual and an online tag team exists for the pair.</summary>
+    public string? TagCode { get; set; }
+    public bool TagTeamCreated { get; set; }
+    public List<string> DeletedTagCodes { get; set; } = new();
+
+    public bool Ok => Result is FriendResult.Sent or FriendResult.AlreadyPending or FriendResult.BecameFriends
+        or FriendResult.AlreadyFriends or FriendResult.Accepted or FriendResult.Removed or FriendResult.Blocked
+        or FriendResult.AlreadyBlocked or FriendResult.Unblocked;
+}
+
+/// <summary>
+/// Friend requests, friendships and block lists shared by every card server (lives with /tag on the matchmaker).
+/// Keys are wire pilot ids (ServerId * 1_000_000 + local card id). JSON-backed with atomic writes, thread-safe.
+///
+/// Policy (2026-11-15):
+///  * A → B is a pending request. It becomes a friendship when B also requests A (in game or on the Friends page) or
+///    B accepts it. With <see cref="AutoTagTeam"/> the matchmaker then makes sure the two share a joined online tag
+///    team (the official service turned a friend request into an online tag team).
+///  * A block (NG) removes any friendship or request between the two, and the blocked player cannot send the
+///    blocker a request (RefusedBlocked); the blocker must unblock before requesting (RefusedYouBlocked).
+///  * Removing a friend or blocking never deletes online tag teams unless the caller asks (deleteTagTeams).
+/// Never stores card access codes / chip ids.
+/// </summary>
+public sealed class FriendStore
+{
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        WriteIndented = false,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+    };
+
+    private readonly object _gate = new();
+    private readonly string? _path;
+    // adjacency: pilot -> other -> link (each link is in both pilots' maps)
+    private readonly Dictionary<uint, Dictionary<uint, FriendLink>> _links = new();
+    // blocker -> target -> block
+    private readonly Dictionary<uint, Dictionary<uint, FriendBlock>> _blocks = new();
+    // target -> blockers (reverse index for "is this sender blocked by the target")
+    private readonly Dictionary<uint, HashSet<uint>> _blockedBy = new();
+    private readonly Dictionary<uint, string> _names = new();
+
+    public Func<DateTime> UtcNow { get; set; } = () => DateTime.UtcNow;
+
+    /// <summary>Online tag store used to create / find / delete the pair's team. Null = no tag integration.</summary>
+    public TagInviteStore? Tags { get; set; }
+    public bool AutoTagTeam { get; set; } = true;
+
+    public int MaxFriends { get; set; } = 500;
+    public int MaxBlocked { get; set; } = 500;
+    public int MaxOutgoing { get; set; } = 100;
+    public int MaxIncoming { get; set; } = 200;
+    /// <summary>Unanswered requests expire after this long. Null / zero = never.</summary>
+    public TimeSpan? PendingTtl { get; set; } = TimeSpan.FromDays(30);
+
+    /// <summary>Optional log sink (no names, no codes: ids and results only).</summary>
+    public Action<string>? Log { get; set; }
+
+    public FriendStore(string? statePath = null)
+    {
+        _path = string.IsNullOrWhiteSpace(statePath) ? null : statePath;
+        if (_path == null || !File.Exists(_path)) return;
+        try
+        {
+            var snap = JsonSerializer.Deserialize<Snapshot>(File.ReadAllText(_path), JsonOpts);
+            foreach (var l in snap?.Links ?? new())
+            {
+                if (l.A == 0 || l.B == 0 || l.A == l.B) continue;
+                if (l.A > l.B) (l.A, l.B) = (l.B, l.A);
+                AddLink(l);
+            }
+            foreach (var b in snap?.Blocks ?? new())
+                if (b.By != 0 && b.Target != 0 && b.By != b.Target) AddBlock(b);
+            foreach (var kv in snap?.Names ?? new())
+                if (kv.Key != 0 && !string.IsNullOrEmpty(kv.Value)) _names[kv.Key] = TagInviteStore.CleanName(kv.Value);
+        }
+        catch (Exception)
+        {
+            // corrupt state: keep the bad file aside and start empty
+            try { File.Copy(_path, _path + ".corrupt-" + DateTime.UtcNow.ToString("yyyyMMddHHmmss"), true); } catch { }
+            _links.Clear(); _blocks.Clear(); _blockedBy.Clear(); _names.Clear();
+        }
+    }
+
+    // ---------------------------------------------------------------- actions
+
+    /// <summary>
+    /// <paramref name="from"/> asks <paramref name="to"/> to be friends. <paramref name="source"/> "game" (results
+    /// screen: also stamps last played) or "web".
+    /// </summary>
+    public FriendOutcome Request(uint from, string? fromName, uint to, string source = "game")
+    {
+        var o = new FriendOutcome { PilotId = to };
+        if (from == 0 || to == 0) { o.Result = FriendResult.RefusedInvalid; return o; }
+        if (from == to) { o.Result = FriendResult.RefusedSelf; return o; }
+        var game = source == "game";
+        lock (_gate)
+        {
+            PruneExpired();
+            SetName(from, fromName);
+            if (IsBlockedLocked(from, to)) { o.Result = FriendResult.RefusedYouBlocked; return Done(o, from); }
+            if (IsBlockedLocked(to, from)) { o.Result = FriendResult.RefusedBlocked; return Done(o, from); }
+            var now = UtcNow();
+            var link = GetLink(from, to);
+            if (link != null)
+            {
+                if (game) link.LastPlayedUtc = now;
+                if (link.State == FriendLinkState.Friends)
+                {
+                    o.Result = FriendResult.AlreadyFriends;
+                    EnsureTeam(link, o);
+                }
+                else if (link.RequestedBy == from)
+                {
+                    o.Result = FriendResult.AlreadyPending;
+                }
+                else
+                {
+                    if (CountFriends(from) >= MaxFriends || CountFriends(to) >= MaxFriends) { o.Result = FriendResult.RefusedLimit; return Done(o, from); }
+                    link.State = FriendLinkState.Friends;
+                    link.AcceptedUtc = now;
+                    o.Result = FriendResult.BecameFriends;
+                    EnsureTeam(link, o);
+                }
+                Persist();
+                return Done(o, from);
+            }
+            if (CountOutgoing(from) >= MaxOutgoing || CountIncoming(to) >= MaxIncoming || CountFriends(from) >= MaxFriends)
+            {
+                o.Result = FriendResult.RefusedLimit;
+                return Done(o, from);
+            }
+            AddLink(new FriendLink
+            {
+                A = Math.Min(from, to), B = Math.Max(from, to), State = FriendLinkState.Pending, RequestedBy = from,
+                CreatedUtc = now, LastPlayedUtc = game ? now : null, Source = game ? "game" : "web",
+            });
+            o.Result = FriendResult.Sent;
+            Persist();
+            return Done(o, from);
+        }
+    }
+
+    /// <summary><paramref name="by"/> accepts <paramref name="other"/>'s pending request.</summary>
+    public FriendOutcome Accept(uint by, string? byName, uint other)
+    {
+        var o = new FriendOutcome { PilotId = other };
+        if (by == 0 || other == 0 || by == other) { o.Result = FriendResult.RefusedInvalid; return o; }
+        lock (_gate)
+        {
+            PruneExpired();
+            SetName(by, byName);
+            var link = GetLink(by, other);
+            if (link == null) { o.Result = FriendResult.NotFound; return Done(o, by); }
+            if (link.State == FriendLinkState.Friends) { o.Result = FriendResult.AlreadyFriends; EnsureTeam(link, o); Persist(); return Done(o, by); }
+            if (link.RequestedBy != other) { o.Result = FriendResult.NotFound; return Done(o, by); }   // can't accept your own request
+            if (CountFriends(by) >= MaxFriends || CountFriends(other) >= MaxFriends) { o.Result = FriendResult.RefusedLimit; return Done(o, by); }
+            link.State = FriendLinkState.Friends;
+            link.AcceptedUtc = UtcNow();
+            o.Result = FriendResult.Accepted;
+            EnsureTeam(link, o);
+            Persist();
+            return Done(o, by);
+        }
+    }
+
+    /// <summary>Decline an incoming request or cancel an outgoing one.</summary>
+    public FriendOutcome Decline(uint by, uint other)
+    {
+        var o = new FriendOutcome { PilotId = other };
+        if (by == 0 || other == 0 || by == other) { o.Result = FriendResult.RefusedInvalid; return o; }
+        lock (_gate)
+        {
+            PruneExpired();
+            var link = GetLink(by, other);
+            if (link == null || link.State != FriendLinkState.Pending) { o.Result = FriendResult.NotFound; return Done(o, by); }
+            RemoveLink(link);
+            o.Result = FriendResult.Removed;
+            Persist();
+            return Done(o, by);
+        }
+    }
+
+    /// <summary>End a friendship. Online tag teams of the pair are deleted only with <paramref name="deleteTagTeams"/>.</summary>
+    public FriendOutcome Remove(uint by, uint other, bool deleteTagTeams = false)
+    {
+        var o = new FriendOutcome { PilotId = other };
+        if (by == 0 || other == 0 || by == other) { o.Result = FriendResult.RefusedInvalid; return o; }
+        lock (_gate)
+        {
+            PruneExpired();
+            var link = GetLink(by, other);
+            if (link == null || link.State != FriendLinkState.Friends) o.Result = FriendResult.NotFound;
+            else { RemoveLink(link); o.Result = FriendResult.Removed; Persist(); }
+        }
+        if (deleteTagTeams && Tags != null && o.Result is FriendResult.Removed or FriendResult.NotFound)
+            o.DeletedTagCodes.AddRange(Tags.DeletePair(by, other));
+        return Done(o, by);
+    }
+
+    /// <summary>
+    /// Block (NG) <paramref name="target"/>: drops any friendship / request between the two. Online tag teams are
+    /// deleted only with <paramref name="deleteTagTeams"/> (explicit choice).
+    /// </summary>
+    public FriendOutcome Block(uint by, uint target, string source = "game", bool deleteTagTeams = false)
+    {
+        var o = new FriendOutcome { PilotId = target };
+        if (by == 0 || target == 0) { o.Result = FriendResult.RefusedInvalid; return o; }
+        if (by == target) { o.Result = FriendResult.RefusedSelf; return o; }
+        lock (_gate)
+        {
+            PruneExpired();
+            if (IsBlockedLocked(by, target)) o.Result = FriendResult.AlreadyBlocked;
+            else if (_blocks.TryGetValue(by, out var mine) && mine.Count >= MaxBlocked) { o.Result = FriendResult.RefusedLimit; return Done(o, by); }
+            else
+            {
+                AddBlock(new FriendBlock { By = by, Target = target, CreatedUtc = UtcNow(), Source = source == "game" ? "game" : "web" });
+                o.Result = FriendResult.Blocked;
+            }
+            var link = GetLink(by, target);
+            if (link != null) RemoveLink(link);
+            Persist();
+        }
+        if (deleteTagTeams && Tags != null)
+            o.DeletedTagCodes.AddRange(Tags.DeletePair(by, target));
+        return Done(o, by);
+    }
+
+    public FriendOutcome Unblock(uint by, uint target)
+    {
+        var o = new FriendOutcome { PilotId = target };
+        if (by == 0 || target == 0 || by == target) { o.Result = FriendResult.RefusedInvalid; return o; }
+        lock (_gate)
+        {
+            if (!IsBlockedLocked(by, target)) { o.Result = FriendResult.NotFound; return Done(o, by); }
+            RemoveBlock(by, target);
+            o.Result = FriendResult.Unblocked;
+            Persist();
+            return Done(o, by);
+        }
+    }
+
+    /// <summary>Store a pilot's current name (card servers report it on every tag sync). Returns true when it changed.</summary>
+    public bool UpdateName(uint pilot, string? name)
+    {
+        lock (_gate)
+        {
+            if (!SetName(pilot, name)) return false;
+            Persist();
+            return true;
+        }
+    }
+
+    // ---------------------------------------------------------------- queries
+
+    /// <summary>Who <paramref name="by"/> has blocked, newest first (LoadCard NG list, field 25).</summary>
+    public IReadOnlyList<uint> BlockedIds(uint by, int max = 100)
+    {
+        lock (_gate)
+        {
+            if (!_blocks.TryGetValue(by, out var mine)) return Array.Empty<uint>();
+            return mine.Values.OrderByDescending(b => b.CreatedUtc).ThenBy(b => b.Target)
+                .Take(Math.Max(0, max)).Select(b => b.Target).ToList();
+        }
+    }
+
+    /// <summary>True when either pilot has blocked the other.</summary>
+    public bool EitherBlocked(uint a, uint b)
+    {
+        lock (_gate) return IsBlockedLocked(a, b) || IsBlockedLocked(b, a);
+    }
+
+    public FriendLinkState? StateOf(uint a, uint b)
+    {
+        lock (_gate) return GetLink(a, b)?.State;
+    }
+
+    public FriendCounts Counts(uint pilot)
+    {
+        lock (_gate)
+        {
+            PruneExpired();
+            return CountsLocked(pilot);
+        }
+    }
+
+    /// <summary>One page of a tab (search, sort, paging done here so huge lists never leave the matchmaker).</summary>
+    public FriendPage List(uint pilot, FriendQuery? query)
+    {
+        var q = (query ?? new FriendQuery()).Clamp();
+        List<FriendEntry> all;
+        FriendCounts counts;
+        lock (_gate)
+        {
+            PruneExpired();
+            counts = CountsLocked(pilot);
+            all = new List<FriendEntry>();
+            if (q.Tab == FriendTabs.Blocked)
+            {
+                if (_blocks.TryGetValue(pilot, out var mine))
+                    foreach (var b in mine.Values)
+                        all.Add(new FriendEntry { PilotId = b.Target, Name = NameOf(b.Target), Kind = "blocked", AddedUtc = b.CreatedUtc, Source = b.Source });
+            }
+            else if (_links.TryGetValue(pilot, out var map))
+            {
+                foreach (var l in map.Values)
+                {
+                    var other = l.Other(pilot);
+                    string kind = l.State == FriendLinkState.Friends ? "friend" : l.RequestedBy == pilot ? "outgoing" : "incoming";
+                    var wanted = q.Tab switch
+                    {
+                        FriendTabs.Friends => kind == "friend",
+                        FriendTabs.Incoming => kind == "incoming",
+                        FriendTabs.Outgoing => kind == "outgoing",
+                        FriendTabs.Requests => kind != "friend",
+                        _ => false,
+                    };
+                    if (!wanted) continue;
+                    all.Add(new FriendEntry
+                    {
+                        PilotId = other, Name = NameOf(other), Kind = kind,
+                        AddedUtc = l.State == FriendLinkState.Friends ? (l.AcceptedUtc ?? l.CreatedUtc) : l.CreatedUtc,
+                        LastPlayedUtc = l.LastPlayedUtc, Source = l.Source,
+                    });
+                }
+            }
+        }
+
+        IEnumerable<FriendEntry> rows = all;
+        if (q.Q != null) rows = rows.Where(e => Matches(e, q.Q));
+        var desc = q.Dir == "desc";
+        rows = q.Sort switch
+        {
+            "name" => desc
+                ? rows.OrderByDescending(e => e.Name, StringComparer.CurrentCultureIgnoreCase).ThenBy(e => e.PilotId)
+                : rows.OrderBy(e => string.IsNullOrEmpty(e.Name) ? 1 : 0).ThenBy(e => e.Name, StringComparer.CurrentCultureIgnoreCase).ThenBy(e => e.PilotId),
+            "lastPlayed" => desc
+                ? rows.OrderBy(e => e.LastPlayedUtc.HasValue ? 0 : 1).ThenByDescending(e => e.LastPlayedUtc).ThenBy(e => e.PilotId)
+                : rows.OrderBy(e => e.LastPlayedUtc.HasValue ? 0 : 1).ThenBy(e => e.LastPlayedUtc).ThenBy(e => e.PilotId),
+            _ => desc
+                ? rows.OrderByDescending(e => e.AddedUtc).ThenBy(e => e.PilotId)
+                : rows.OrderBy(e => e.AddedUtc).ThenBy(e => e.PilotId),
+        };
+        var filtered = rows.ToList();
+        var totalPages = Math.Max(1, (filtered.Count + q.PageSize - 1) / q.PageSize);
+        var page = Math.Min(q.Page, totalPages);
+        var items = filtered.Skip((page - 1) * q.PageSize).Take(q.PageSize).ToList();
+        if (Tags != null)
+            foreach (var e in items.Where(e => e.Kind == "friend"))
+                e.HasTagTeam = Tags.PairCodes(pilot, e.PilotId).Count > 0;
+        return new FriendPage
+        {
+            Tab = q.Tab, Q = q.Q, Sort = q.Sort, Dir = q.Dir!, Page = page, PageSize = q.PageSize,
+            Total = filtered.Count, TotalPages = totalPages, Items = items, Counts = counts,
+        };
+    }
+
+    /// <summary>Case-, width- and kana-insensitive name match, or a pilot id match when the query is all digits.</summary>
+    public static bool Matches(FriendEntry e, string q)
+    {
+        if (q.All(char.IsAsciiDigit) && e.PilotId.ToString(CultureInfo.InvariantCulture).Contains(q, StringComparison.Ordinal))
+            return true;
+        return CultureInfo.InvariantCulture.CompareInfo.IndexOf(e.Name ?? "", q,
+            CompareOptions.IgnoreCase | CompareOptions.IgnoreWidth | CompareOptions.IgnoreKanaType) >= 0;
+    }
+
+    public string NameOf(uint pilot)
+    {
+        lock (_gate) return _names.TryGetValue(pilot, out var n) ? n : "";
+    }
+
+    // ---------------------------------------------------------------- internals (lock held)
+
+    private FriendOutcome Done(FriendOutcome o, uint by)
+    {
+        Log?.Invoke($"friends: {by} -> {o.PilotId} {o.Result}{(o.TagTeamCreated ? " (tag team created)" : "")}{(o.DeletedTagCodes.Count > 0 ? $" (deleted {o.DeletedTagCodes.Count} tag team(s))" : "")}");
+        return o;
+    }
+
+    private void EnsureTeam(FriendLink link, FriendOutcome o)
+    {
+        if (Tags == null || !AutoTagTeam) return;
+        try
+        {
+            var creator = link.RequestedBy == 0 ? link.A : link.RequestedBy;
+            var partner = link.Other(creator);
+            var (code, created) = Tags.EnsureJoinedPair(creator, NameOf(creator), partner, NameOf(partner));
+            link.TagCode = code;
+            o.TagCode = code;
+            o.TagTeamCreated = created;
+        }
+        catch (Exception ex)
+        {
+            Log?.Invoke($"friends: could not create the online tag team for {link.A}/{link.B}: {ex.Message}");
+        }
+    }
+
+    private bool SetName(uint pilot, string? name)
+    {
+        if (pilot == 0) return false;
+        var clean = TagInviteStore.CleanName(name);
+        if (clean.Length == 0) return false;
+        if (_names.TryGetValue(pilot, out var old) && old == clean) return false;
+        _names[pilot] = clean;
+        return true;
+    }
+
+    private FriendLink? GetLink(uint a, uint b) =>
+        _links.TryGetValue(a, out var map) && map.TryGetValue(b, out var l) ? l : null;
+
+    private void AddLink(FriendLink l)
+    {
+        Map(_links, l.A)[l.B] = l;
+        Map(_links, l.B)[l.A] = l;
+    }
+
+    private void RemoveLink(FriendLink l)
+    {
+        if (_links.TryGetValue(l.A, out var ma)) { ma.Remove(l.B); if (ma.Count == 0) _links.Remove(l.A); }
+        if (_links.TryGetValue(l.B, out var mb)) { mb.Remove(l.A); if (mb.Count == 0) _links.Remove(l.B); }
+    }
+
+    private void AddBlock(FriendBlock b)
+    {
+        if (!_blocks.TryGetValue(b.By, out var mine)) _blocks[b.By] = mine = new Dictionary<uint, FriendBlock>();
+        mine[b.Target] = b;
+        if (!_blockedBy.TryGetValue(b.Target, out var rev)) _blockedBy[b.Target] = rev = new HashSet<uint>();
+        rev.Add(b.By);
+    }
+
+    private void RemoveBlock(uint by, uint target)
+    {
+        if (_blocks.TryGetValue(by, out var mine)) { mine.Remove(target); if (mine.Count == 0) _blocks.Remove(by); }
+        if (_blockedBy.TryGetValue(target, out var rev)) { rev.Remove(by); if (rev.Count == 0) _blockedBy.Remove(target); }
+    }
+
+    private bool IsBlockedLocked(uint by, uint target) =>
+        _blocks.TryGetValue(by, out var mine) && mine.ContainsKey(target);
+
+    private static Dictionary<uint, FriendLink> Map(Dictionary<uint, Dictionary<uint, FriendLink>> d, uint k)
+    {
+        if (!d.TryGetValue(k, out var m)) d[k] = m = new Dictionary<uint, FriendLink>();
+        return m;
+    }
+
+    private int CountFriends(uint p) => _links.TryGetValue(p, out var m) ? m.Values.Count(l => l.State == FriendLinkState.Friends) : 0;
+    private int CountOutgoing(uint p) => _links.TryGetValue(p, out var m) ? m.Values.Count(l => l.State == FriendLinkState.Pending && l.RequestedBy == p) : 0;
+    private int CountIncoming(uint p) => _links.TryGetValue(p, out var m) ? m.Values.Count(l => l.State == FriendLinkState.Pending && l.RequestedBy != p) : 0;
+
+    private FriendCounts CountsLocked(uint p) => new()
+    {
+        Friends = CountFriends(p),
+        Incoming = CountIncoming(p),
+        Outgoing = CountOutgoing(p),
+        Blocked = _blocks.TryGetValue(p, out var b) ? b.Count : 0,
+    };
+
+    private void PruneExpired()
+    {
+        if (PendingTtl is not { } ttl || ttl <= TimeSpan.Zero) return;
+        var now = UtcNow();
+        var dead = _links.Values.SelectMany(m => m.Values).Distinct()
+            .Where(l => l.State == FriendLinkState.Pending && now - l.CreatedUtc > ttl).ToList();
+        if (dead.Count == 0) return;
+        foreach (var l in dead) RemoveLink(l);
+        Persist();
+    }
+
+    private void Persist()
+    {
+        if (_path == null) return;
+        var snap = new Snapshot
+        {
+            Links = _links.Values.SelectMany(m => m.Values).Distinct().OrderBy(l => l.A).ThenBy(l => l.B).ToList(),
+            Blocks = _blocks.Values.SelectMany(m => m.Values).OrderBy(b => b.By).ThenBy(b => b.Target).ToList(),
+            Names = new Dictionary<uint, string>(_names),
+        };
+        var dir = Path.GetDirectoryName(_path);
+        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+        var tmp = _path + ".tmp";
+        File.WriteAllText(tmp, JsonSerializer.Serialize(snap, JsonOpts));
+        File.Move(tmp, _path, overwrite: true);
+    }
+
+    private sealed class Snapshot
+    {
+        public int Version { get; set; } = 1;
+        public List<FriendLink> Links { get; set; } = new();
+        public List<FriendBlock> Blocks { get; set; } = new();
+        public Dictionary<uint, string> Names { get; set; } = new();
+    }
+}
