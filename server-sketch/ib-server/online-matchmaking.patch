diff --git a/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs b/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs
new file mode 100644
index 0000000..2b94027
--- /dev/null
+++ b/Server-Infinite/Middlewares/SecurityGuardMiddleware.cs
@@ -0,0 +1,96 @@
+using System.Net;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Lobbies;
+using NetworkAccess = ServerInfinite.Lobbies.NetworkAccess;
+using ServerInfinite.Models.Config;
+
+namespace ServerInfinite.Middlewares;
+
+/// <summary>
+/// exvs2-lobbies security hardening (2026-11-15). Runs before static files, the WebUI and every controller:
+/// <list type="number">
+/// <item>Source filter (Security.AccessMode): LanOnly / PublicMatchmaker / Open. Refused requests get 403 with no body.</item>
+/// <item>/tag shared secret (OnlineTag.TagSecret, header X-Tag-Secret): 401 without it. No secret configured = LAN-only /tag.</item>
+/// <item>Per source IP token buckets for /match + /mms and for /tag: 429 when exceeded.</item>
+/// </list>
+/// The connection's remote address is used as is; X-Forwarded-For is never trusted.
+/// </summary>
+public sealed class SecurityGuardMiddleware
+{
+    private static readonly double TickFreq = System.Diagnostics.Stopwatch.Frequency;
+    private readonly RequestDelegate _next;
+    private readonly ILogger<SecurityGuardMiddleware> _log;
+    private readonly AccessMode _mode;
+    private readonly IReadOnlyList<IPNetwork> _extra;
+    private readonly string _secret;
+    private readonly bool _exemptLoopback;
+    private readonly IpRateLimiter _matchLimiter;
+    private readonly IpRateLimiter _tagLimiter;
+    private readonly IpRateLimiter _warnLimiter = new(6, 3);   // at most a few "refused" lines per source per minute
+
+    public SecurityGuardMiddleware(RequestDelegate next, IOptions<CardServerConfig> options, ILogger<SecurityGuardMiddleware> log)
+    {
+        _next = next;
+        _log = log;
+        var cfg = options.Value;
+        _mode = NetworkAccess.ParseMode(cfg.Security.AccessMode);
+        _extra = NetworkAccess.ParseCidrs(cfg.Security.ExtraAllowedCidrs);
+        _secret = cfg.OnlineTag.TagSecret ?? "";
+        _exemptLoopback = cfg.Security.ExemptLoopbackFromRateLimit;
+        _matchLimiter = new IpRateLimiter(cfg.Security.MatchRequestsPerMinute, cfg.Security.MatchBurst);
+        _tagLimiter = new IpRateLimiter(cfg.Security.TagRequestsPerMinute, cfg.Security.TagBurst);
+    }
+
+    public AccessMode Mode => _mode;
+
+    public async Task InvokeAsync(HttpContext context)
+    {
+        var ip = NetworkAccess.Normalize(context.Connection.RemoteIpAddress);
+        var path = context.Request.Path.Value ?? "/";
+        var now = System.Diagnostics.Stopwatch.GetTimestamp() / TickFreq;
+
+        if (!NetworkAccess.IsAllowed(_mode, path, ip, _extra))
+        {
+            Refuse(context, StatusCodes.Status403Forbidden, ip, "not allowed from this network", now);
+            return;
+        }
+
+        var isTag = NetworkAccess.IsTagPath(path);
+        if (isTag)
+        {
+            var presented = context.Request.Headers[NetworkAccess.TagSecretHeader].ToString();
+            if (!NetworkAccess.TagAuthorized(_secret, presented, ip, _extra))
+            {
+                Refuse(context, StatusCodes.Status401Unauthorized, ip, "/tag without a valid shared secret", now);
+                return;
+            }
+        }
+
+        var limiter = isTag ? _tagLimiter : NetworkAccess.IsMatchPath(path) ? _matchLimiter : null;
+        if (limiter != null && !(_exemptLoopback && NetworkAccess.IsLoopback(ip)) &&
+            !limiter.TryAcquire(ip?.ToString() ?? "?", now))
+        {
+            context.Response.Headers["Retry-After"] = "5";
+            Refuse(context, StatusCodes.Status429TooManyRequests, ip, isTag ? "/tag rate limit" : "/match rate limit", now);
+            return;
+        }
+
+        await _next(context);
+    }
+
+    private void Refuse(HttpContext context, int status, IPAddress? ip, string why, double now)
+    {
+        context.Response.StatusCode = status;
+        context.Response.ContentLength = 0;
+        var key = ip?.ToString() ?? "?";
+        if (_warnLimiter.TryAcquire(key + "|" + status, now))
+            _log.LogWarning("SEC-REFUSE {Status} {Method} {Path} from {Source}: {Why}", status, context.Request.Method,
+                LogMask.MaskNetwork(context.Request.Path.Value), NetworkAccess.MaskIp(key), why);
+    }
+}
+
+public static class SecurityGuardExtensions
+{
+    public static IApplicationBuilder UseSecurityGuard(this IApplicationBuilder builder) =>
+        builder.UseMiddleware<SecurityGuardMiddleware>();
+}
