+        var mm = new Matchmaker(3, true, 15, 1);
+        Assert.Equal(180, mm.PairCancelQuarantineSeconds);
+    }
+
+    [Fact]
+    public void Cancelled_pair_reentering_on_the_same_node_is_held_and_not_placed_with_fresh_cabs()
+    {
+        var log = new List<string>();
+        var mm = New(log);
