+        mm.Entry(Entry(leader, partner, apply: 3, serial: "PCB_03", memberSerial: "PCB_14"), 0, "192.168.1.71");
+        AssertWaiting(mm.Check(leader, 3));
+        mm.Cancel(leader, 30, applyId: 3, sourceIp: "192.168.1.71");
+        Assert.Contains(log, l => l.StartsWith("QUARANTINE add node=1258 serial=PCB_03") && l.Contains("cancelled by node 1258"));
