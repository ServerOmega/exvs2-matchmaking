 .../Online/SaveVsmOnResultCommandHandler.cs   |   8 +-
 .../Game/SaveVsmResultCommandHandler.cs       |   7 +-
 Server-Infinite/Lobbies/FriendPlayed.cs       |  64 ++++++++
 Server-Infinite/Matchmaking/FriendClient.cs   |   5 +
 Server-Infinite/Matchmaking/FriendStore.cs    |  31 ++++
 .../Models/Config/FriendsConfigurations.cs    |   4 +
 Server-Infinite/Program.cs                    |   9 ++
