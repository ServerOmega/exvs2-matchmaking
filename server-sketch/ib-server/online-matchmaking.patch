+    /// <summary>
+    /// PAIR-SEARCH: a short tag when this node is (or just was) a searching all-human duo, so unhandled or
+    /// unusual MMS methods from that cabinet are logged even after it stops CheckMatching.
+    /// </summary>
+    public string? PairSearchContext(uint nodeId, double now)
+    {
+        if (!PairSearchLog && !HoldPairsWithoutCpu) return null;
+        lock (_gate)
+        {
+            if (nodeId != 0 && _byNode.TryGetValue(nodeId, out var t) && IsLoneDuo(t))
+                return $"waiting nodes=[{string.Join(",", t.NodeIds)}] waited={now - t.Created:0.#}s " +
+                       $"polls={t.PairChecks} room={(t.Room == null ? "-" : t.Room.RoomId.ToString())}";
+            if (nodeId != 0 && _recentPairSearch.TryGetValue(nodeId, out var e) &&
+                now - e.At <= PairSearchRemember && now >= e.At)
+                return $"ended {e.Detail}";
+            return null;
+        }
+    }
+
+    private bool WantPairSearchLog(Unit t) => (PairSearchLog || HoldPairsWithoutCpu) && IsLoneDuo(t);
+
+    private void LogPairCheck(uint nodeId, double now, (ErrorCode Code, Room? Room, uint ApplyId) r)
+    {
+        Unit? t = null;
+        lock (_gate)
+        {
+            if (!_byNode.TryGetValue(nodeId, out t) || !WantPairSearchLog(t))
+            {
+                // just cancelled / stale-dropped: the end line already ran
+                if (t == null && _recentPairSearch.ContainsKey(nodeId) && (PairSearchLog || HoldPairsWithoutCpu))
+                    Log?.Invoke($"PAIR-SEARCH check now={now:0.###} node={nodeId} answer={r.Code} room=" +
+                                $"{r.Room?.RoomId.ToString() ?? "-"} (unit already ended)");
+                return;
+            }
+            var since = t.LastPairCheck > 0 ? now - t.LastPairCheck : 0;
+            t.PairChecks++;
+            t.LastPairCheck = now;
+            var past = now - t.Created >= PairTimerHintSeconds;
+            var gap = t.PairChecks > 1 && since >= 8 ? $" poll-gap={since:0.#}s" : "";
+            Log?.Invoke(PairSearchLine("check", t, now, PairCheckAnswer(r),
+                extra: $"node={nodeId} apply={t.ApplyId} code={r.Code} since-last={since:0.#}s polls={t.PairChecks} " +
+                       $"past-pair-timer={(past ? 1 : 0)} queue={_queue.Count(u => u.Room == null)}{gap}"));
+        }
+    }
+
+    private static string PairCheckAnswer((ErrorCode Code, Room? Room, uint ApplyId) r)
+    {
+        if (r.Room != null) return PairAnswer(r.Room);
+        if (r.Code == ErrorCode.MatchCanceled) return "CANCELED";
+        if (r.Code != ErrorCode.Success) return r.Code.ToString();
+        return "WAIT";
+    }
+
+    private static string PairAnswer(Room room)
+    {
+        var cpu = room.Clients.Count(c => !Unit.IsHuman(c.Client));
+        return cpu > 0 ? $"CPU-ROOM room={room.RoomId} humans={room.Humans} cpu={cpu}"
+                       : $"ROOM room={room.RoomId} humans={room.Humans}";
+    }
+
+    private static string PairSearchLine(string what, Unit t, double now, string answer, string? extra = null) =>
+        $"PAIR-SEARCH {what} now={now:0.###} waited={now - t.Created:0.#}s world={t.WorldName} " +
+        $"nodes=[{string.Join(",", t.NodeIds)}] apply={t.ApplyId} answer={answer}" +
+        (string.IsNullOrEmpty(extra) ? "" : $" {extra}");
+
     /// <summary>Remove a unit. With <paramref name="now"/>, its other human nodes (e.g. the partner of a
     /// fixed pair) get MATCH_CANCELED on their next poll instead of ERR_MATCH_NOENTRY.</summary>
     private void Drop(Unit t, double? now = null, uint? except = null, string? reason = null)
     {
         if (reason != null) Log?.Invoke($"drop nodes=[{string.Join(",", t.NodeIds)}] reason={reason}");
+        if (WantPairSearchLog(t))
+        {
+            var at = now ?? t.LastSeen;
+            var last = t.LastPairCheck > 0 ? at - t.LastPairCheck : at - t.LastSeen;
+            var detail = $"nodes=[{string.Join(",", t.NodeIds)}] reason={reason ?? "dropped"} " +
+                         $"waited={at - t.Created:0.#}s last-poll={last:0.#}s-ago polls={t.PairChecks}" +
+                         (t.Room != null ? $" room={t.Room.RoomId}" : "");
+            Log?.Invoke($"PAIR-SEARCH end now={at:0.###} {detail}");
+            foreach (var n in t.NodeIds)
+                _recentPairSearch[n] = (detail, at);
+            if (_recentPairSearch.Count > 4096)
+                foreach (var k in _recentPairSearch.OrderBy(kv => kv.Value.At).Take(_recentPairSearch.Count - 2048)
+                             .Select(kv => kv.Key).ToList())
+                    _recentPairSearch.Remove(k);
+        }
         if (now != null)
             foreach (var n in t.NodeIds)
                 if (n != except && _byNode.TryGetValue(n, out var u) && ReferenceEquals(u, t)) _ended[n] = now.Value;
