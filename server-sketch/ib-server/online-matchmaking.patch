+++ b/WebUIInfinite/Client/Pages/TeamEdit.razor
@@ -0,0 +1,147 @@
+@page "/Cards/Teams/{ChipId}/{TeamId:int}"
+@* exvs2-lobbies 2026-11-15: dedicated Edit Team page — only this team's fields, with Save / Remove / Back. *@
+@using WebUIInfinite.Client.Command.CustomizeCard.Save
+@using WebUIInfinite.Client.Context.CustomizeCard
+@using WebUIInfinite.Client.Pages.Components.Customize.Inner
+@using WebUIInfinite.Shared.Dto.Common
+@using WebUIInfinite.Shared.Dto.Response
+@using WebUIInfinite.Shared.Models
+@inject IJSRuntime JS
+@inject HttpClient Http
+@inject ISnackbar Snackbar
+@inject NavigationManager Nav
+@inject IConfiguration Configuration
+@inject TeamSaver TeamSaver
+
+<PageTitle>@(_team is null ? localizer["teams_edit"] : $"{localizer["teams_edit"]}: {PageTitleName()}")</PageTitle>
+<MudBreadcrumbs Items="_breadcrumbs" Class="px-0"></MudBreadcrumbs>
+
+@if (_errorMessage is not null)
+{
+    <MudAlert Severity="Severity.Error" Class="my-4">@_errorMessage</MudAlert>
+    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@TagTeamLinks.ListHref(ChipId)">@localizer["teams_back"]</MudButton>
+    return;
+}
+
+@if (_loading)
+{
+    <MudText Class="pa-4">@localizer["teams_loading"]</MudText>
+    return;
+}
+
+<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2 mb-2">
+    <MudText Typo="Typo.h4" HtmlTag="h1">@localizer["teams_edit"]</MudText>
+    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
+        <MudProgressCircular @bind-Class="@_progress.HideTeamTagsProgress" Color="Color.Default" Indeterminate="true" />
+        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@TagTeamLinks.ListHref(ChipId)">@localizer["teams_back"]</MudButton>
+        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveTask" Disabled="_saving">@localizer["teams_save"]</MudButton>
+    </MudStack>
+</MudStack>
+
+@if (_team!.IsRemote)
+{
+    <MudText Typo="Typo.caption" Class="mb-2">@localizer["teamtag_crossserver_remote"] @(string.IsNullOrEmpty(_team.SharedTagCode) ? "" : $"({_team.SharedTagCode})")</MudText>
+}
+
+<div id="@($"teamtag-{_team.Id}")" data-team-id="@_team.Id">
+    <TeamTag TagTeams="@_allTeams" CurrentTeam="@_team" DeletedTeamIds="@_deletedTeamIds"
+             OnDeleted="OnDeleted" EnableImagePreview="@_enableImagePreview" />
+</div>
+
+@code {
+    [Parameter] public string ChipId { get; set; } = string.Empty;
+    [Parameter] public int TeamId { get; set; }
+
+    private readonly List<BreadcrumbItem> _breadcrumbs = new();
+    private readonly CustomizeCardContext _ctx = new();
+    private readonly ProgressContext _progress = new();
+    private readonly List<uint> _deletedTeamIds = new();
+    private List<Team> _allTeams = new();
+    private Team? _team;
+    private string _accessCode = "";
+    private string? _errorMessage;
+    private bool _loading = true;
+    private bool _saving;
+    private bool _enableImagePreview;
+
+    protected override async Task OnInitializedAsync()
+    {
+        _enableImagePreview = Configuration.GetValue<bool>("EnableImagePreview");
+        _accessCode = await JS.InvokeAsync<string>("accessCode.get", ChipId) ?? "";
+        if (string.IsNullOrEmpty(_accessCode))
+        {
+            _errorMessage = localizer["invalid_user_login"];
+            _loading = false;
+            return;
+        }
+
+        try
+        {
+            var r = await Http.GetFromJsonAsync<TeamResponse>($"/ui/team/getTeams/{Uri.EscapeDataString(_accessCode)}/{Uri.EscapeDataString(ChipId)}");
+            _allTeams = r?.Teams ?? new List<Team>();
+            _team = _allTeams.FirstOrDefault(t => t.Id == (uint)TeamId);
+            if (_team is null)
+            {
+                _errorMessage = localizer["teams_not_found"];
+                _loading = false;
+                BuildCrumbs();
+                return;
+            }
+            _ctx.AccessCode = _accessCode;
+            _ctx.ChipId = ChipId;
+            _ctx.TeamResponse = r ?? new TeamResponse { Teams = _allTeams };
+            _ctx.DeletedTeamIds = _deletedTeamIds;
+        }
+        catch (Exception)
+        {
+            _errorMessage = localizer["teams_unavailable"];
+        }
+
+        _loading = false;
+        BuildCrumbs();
+    }
+
+    private void BuildCrumbs()
+    {
+        _breadcrumbs.Clear();
+        _breadcrumbs.Add(new BreadcrumbItem("Menu", href: $"Cards/SingularCardMenu/{ChipId}"));
+        _breadcrumbs.Add(new BreadcrumbItem(localizer["teams_title"], href: TagTeamLinks.ListHref(ChipId)));
+        _breadcrumbs.Add(new BreadcrumbItem(_team is null ? localizer["teams_edit"] : PageTitleName(), href: null, disabled: true));
+    }
+
+    private string PageTitleName() =>
+        TagTeamLinks.DisplayName(_team!, string.Format(localizer["teams_unnamed"], TeamId));
+
+    private async Task SaveTask()
+    {
+        if (_team is null) return;
+        _saving = true;
+        try
+        {
