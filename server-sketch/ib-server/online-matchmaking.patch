--- a/Server-Infinite/Matchmaking/Matchmaker.cs
+++ b/Server-Infinite/Matchmaking/Matchmaker.cs
@@ -118,6 +118,8 @@ public sealed class Matchmaker
         public bool PartnerWaitLogged;
         /// <summary>PairNeverCpu: the "kept queued, no CPU room" line was logged for this duo.</summary>
         public bool PairHoldLogged;
+        /// <summary>QUARANTINE hold line already logged for this unit.</summary>
+        public bool QuarantineHoldLogged;
         /// <summary>PAIR-SEARCH: CheckMatching polls from this duo (any of its cabinets).</summary>
         public int PairChecks;
         public double LastPairCheck;
@@ -401,9 +403,19 @@ public sealed class Matchmaker
     /// </summary>
     public bool PairSearchLog { get; set; } = false;
 
+    /// <summary>
+    /// After CancelMatching (or a stale / matching-timeout drop) of an all-human duo, keep those node ids
+    /// and cabinet serials out of human rooms until the cab enters with a new node id (IssueNodeId after a
+    /// clean restart) or this many seconds have passed. Default 180. 0 = off. Negative = no time expiry.
+    /// </summary>
+    public double PairCancelQuarantineSeconds { get; set; } = 180;
+
     /// <summary>In-game pair search / partner-lost timer (~30 s) used only in PAIR-SEARCH log wording.</summary>
     public const double PairTimerHintSeconds = 30;
 
+    private readonly Dictionary<(uint Node, string Serial), (double At, string? Source, string Reason)> _quarantine = new();
+    private const int QuarantineMax = 4096;
+
     private readonly List<Room> _cpuRooms = new();             // recent humans-vs-CPU rooms (SoloPairReturnWait)
