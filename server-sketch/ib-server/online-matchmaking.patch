+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// 21-01 guard (2026-11-16 12:19-12:23 AM PT): a searching all-human duo (PCB_03 node 1258 + partner 1260)
+// hit the ~30 s in-game pair timer, the leader sent CancelMatching (apply=3), both cabs black-screened, then
+// PCB_03 re-entered as a mix solo on the SAME node 1258 (apply=4, no IssueNodeId) and was placed in a 4-solo
+// room with cabs that had fresh nodes. The other three got LiveMonitor 21-01 during loading.
+//
+// After a pair cancel (or a stale / matching-timeout drop of an unplaced duo), those node ids + serials are
+// quarantined from human rooms. A quarantined re-entry is answered WAIT (Success, empty room): that is the
+// game's normal "keep polling" reply, so the dirty cab is never placed with others; MATCH_CANCELED is reserved
+// for a search that has actually ended (timeout, explicit cancel policy). Quarantine lifts when the cab enters
+// with a new node id (IssueNodeId after a clean restart) or after PairCancelQuarantineSeconds (default 180).
+public class PairCancelGuardTests
+{
+    private uint _node = 20000;
+
+    private static Client Cl(uint node, string? serial = null)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = serial ?? $"P{node}", LocId = "JPN0JPN1", PrefCode = 13,
+            GlobalIpaddress = "203.0.113.1",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Entry(uint leader, uint? member = null, uint apply = 1, uint world = 23,
+        string? serial = null, string? memberSerial = null, uint timeout = 150)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = apply, Myclient = Cl(leader, serial), MatchingTimeout = timeout,
+            Myplayer = new Player { BanapassportAmId = leader },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        if (member != null)
+            e.Groups.Add(new Request.EntryMatching.Group
+            {
+                Client = Cl(member.Value, memberSerial),
+                Player = new Player { BanapassportAmId = member.Value }
+            });
+        return e;
+    }
+
+    /// <summary>Production-like policy (ddf3726 / restored pair VsCpu), quarantine on unless overridden.</summary>
+    private static Matchmaker New(List<string>? log = null, double quarantine = 180, double stale = 1e6) =>
+        new(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = stale, MaxFillWait = 3, InStoreFillAfter = 3, InStoreMaxFillWait = 3,
+            NoCpuPartner = true,
+            ContinuePairMode = Matchmaker.ContinuePairPolicy.VsCpu,
+            ContinuePairSeconds = 12,
+            ContinuePairScope = Matchmaker.ContinuePairScopeKind.AnyDuo,
+            CpuPartnerCancelSeconds = 5,
+            PlaceCpuPartnerTeams = true,
+            SoloPairVsCpuSeconds = 0,
+            PairNeverCpu = false,
+            PairCpuFallbackSeconds = -1,
+            PairCancelQuarantineSeconds = quarantine,
+            Log = log == null ? null : log.Add,
+        };
+
+    private static void AssertWaiting((ErrorCode Code, Matchmaker.Room? Room, uint ApplyId) r)
+    {
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+    }
+
+    [Fact]
