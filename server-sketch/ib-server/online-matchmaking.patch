+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Friend requests and block (NG) lists.
+/// The game sends RegisterOption (306) from the results screen (hold Start → フレンド申請 / NG): mobile_user_id = the
+/// sender's wire pilot id, friend_pilot_id = the partner to befriend, ng_pilot_id = a player to block. The card server
+/// always answers it (empty success) and forwards it to the shared matchmaker's /tag/friends API (same X-Tag-Secret as
+/// /tag), which keeps friendships and blocks for every card server. See ONLINE_MATCHMAKING.md "Friends".
+/// </summary>
+public class FriendsConfigurations
+{
+    /// <summary>Handle RegisterOption (306) and serve the Friends page. false = upstream behaviour (306 is
+    /// "Unhandled case" unless PostMatchStubs is on) and the Friends API answers 404.</summary>
+    public bool Enabled { get; set; } = true;
+
+    /// <summary>When a request becomes mutual (both asked, or one accepted on the Friends page), create a joined online
+    /// tag team for the two players (the official service turned a friend request into an online tag team).
+    /// Only used by the process that owns /tag (the matchmaker).</summary>
+    public bool AutoCreateTagTeam { get; set; } = true;
+
+    /// <summary>Send this card's block list in LoadCard.MobileUserGroup.partner_recruit_am_id_nglist (field 25). The
+    /// cabinet copies it into EntryMatching.bl_banapassport_am_ids, which the matchmaker honours (partner recruit).</summary>
+    public bool SendNgList { get; set; } = true;
+
+    /// <summary>Most block-list entries sent in LoadCard field 25 (newest first).</summary>
+    public int MaxNgListEntries { get; set; } = 100;
+
+    /// <summary>JSON file for friendships, requests, blocks and known names (process that owns /tag only).</summary>
+    public string StateFile { get; set; } = "friends.json";
+
+    /// <summary>Card-server side: requests / blocks the matchmaker could not take yet (retried later) and the last
+    /// block list seen per card (used for LoadCard when the matchmaker is unreachable).</summary>
+    public string OutboxFile { get; set; } = "friends_outbox.json";
+
+    /// <summary>Limits per player (bound abuse and file size).</summary>
+    public int MaxFriends { get; set; } = 500;
+    public int MaxBlocked { get; set; } = 500;
+    public int MaxOutgoingRequests { get; set; } = 100;
+    public int MaxIncomingRequests { get; set; } = 200;
+
+    /// <summary>A request nobody answered is dropped after this many days (0 = never).</summary>
+    public double PendingExpiryDays { get; set; } = 30;
+
+    /// <summary>LoadCard waits at most this long for the block list before using the cached copy.</summary>
+    public int LoadCardTimeoutMs { get; set; } = 2500;
+}
