diff --git a/WebUIInfinite/Shared/Models/TagTeamLinks.cs b/WebUIInfinite/Shared/Models/TagTeamLinks.cs
new file mode 100644
index 0000000..92c65be
--- /dev/null
+++ b/WebUIInfinite/Shared/Models/TagTeamLinks.cs
@@ -0,0 +1,70 @@
+using WebUIInfinite.Shared.Dto.Common;
+
+namespace WebUIInfinite.Shared.Models;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Teams tab / Friends list helpers: which of the card's tag teams belongs to a friend
+/// (matched by the friend's wire pilot id), and the WebUI routes for the Teams list and a team's edit page
+/// (the Teams tab of the Customize page, opened at that team). Pure functions so they are unit tested.
+/// </summary>
+public static class TagTeamLinks
+{
+    public const string TeamsTab = "teams";
+
+    /// <summary>Standalone Teams list for a card.</summary>
+    public static string ListHref(string chipId) => $"Cards/Teams/{Uri.EscapeDataString(chipId ?? "")}";
+
+    /// <summary>The existing team editor (Customize page, Teams tab), scrolled to one team.</summary>
+    public static string EditHref(string chipId, uint teamId) =>
+        $"Cards/Customize/{Uri.EscapeDataString(chipId ?? "")}?tab={TeamsTab}" + (teamId != 0 ? $"&team={teamId}" : "");
+
+    /// <summary>Teams whose partner is <paramref name="pilotId"/> (wire pilot id), named first, then by id.</summary>
+    public static List<Team> ForPartner(IEnumerable<Team>? teams, uint pilotId) =>
+        pilotId == 0 || teams == null
+            ? new List<Team>()
+            : teams.Where(t => t != null && t.PartnerPilotId == pilotId)
+                .OrderBy(t => string.IsNullOrWhiteSpace(t.Name) ? 1 : 0).ThenBy(t => t.Id).ToList();
+
+    /// <summary>Lookup by partner wire pilot id (teams without a pilot id are skipped).</summary>
+    public static Dictionary<uint, List<Team>> ByPartner(IEnumerable<Team>? teams)
+    {
+        var map = new Dictionary<uint, List<Team>>();
+        foreach (var t in teams ?? Enumerable.Empty<Team>())
+        {
+            if (t == null || t.PartnerPilotId == 0) continue;
+            if (!map.TryGetValue(t.PartnerPilotId, out var list)) map[t.PartnerPilotId] = list = new List<Team>();
+            list.Add(t);
+        }
+        foreach (var list in map.Values)
+            list.Sort((a, b) =>
+            {
+                var c = (string.IsNullOrWhiteSpace(a.Name) ? 1 : 0).CompareTo(string.IsNullOrWhiteSpace(b.Name) ? 1 : 0);
+                return c != 0 ? c : a.Id.CompareTo(b.Id);
+            });
+        return map;
+    }
+
+    /// <summary>Team name for lists; <paramref name="fallback"/> (e.g. "Team #3") when the team has no name yet.</summary>
+    public static string DisplayName(Team t, string fallback) =>
+        string.IsNullOrWhiteSpace(t?.Name) ? fallback : t!.Name.Trim();
+
+    /// <summary>Parses "?tab=teams&amp;team=12" (any order, case-insensitive keys). TeamId 0 = none / invalid.</summary>
+    public static (bool TeamsTab, uint TeamId) ParseEditQuery(string? query)
+    {
+        var tab = false;
+        uint team = 0;
+        if (string.IsNullOrEmpty(query)) return (false, 0);
+        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
+        {
+            var kv = part.Split('=', 2);
+            var key = Uri.UnescapeDataString(kv[0]).Trim();
+            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]).Trim() : "";
+            if (key.Equals("tab", StringComparison.OrdinalIgnoreCase))
+                tab = val.Equals(TeamsTab, StringComparison.OrdinalIgnoreCase);
+            else if (key.Equals("team", StringComparison.OrdinalIgnoreCase) && uint.TryParse(val, out var id))
+                team = id;
+        }
+        if (team != 0) tab = true;
+        return (tab, team);
+    }
+}
