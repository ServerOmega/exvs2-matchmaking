+@page "/GlobalLeaderboards"
+@* exvs2-lobbies 2026-11-16: global online leaderboards page (also shown on the front page). *@
+
+<PageTitle>@localizer["leaderboard_title"]</PageTitle>
+<MudStack Row Class="flex-column">
