+    /// <summary>
+    /// Friend requests 2026-11-15: make sure the two pilots share a joined team code. Returns the existing joined
+    /// code of the pair if there is one (either direction), otherwise creates a new code that is already joined
+    /// (creator = <paramref name="creatorPilotId"/>, partner = <paramref name="partnerPilotId"/>). Card servers pick
+    /// it up on their next tag-team sync (card insert / Teams tab). Returns (code, created).
+    /// </summary>
+    public (string Code, bool Created) EnsureJoinedPair(uint creatorPilotId, string creatorName, uint partnerPilotId, string partnerName)
+    {
+        if (creatorPilotId == 0) throw new ArgumentOutOfRangeException(nameof(creatorPilotId));
+        if (partnerPilotId == 0 || partnerPilotId == creatorPilotId) throw new ArgumentOutOfRangeException(nameof(partnerPilotId));
+        lock (_gate)
+        {
+            PruneExpired();
+            var existing = _invites.Values.FirstOrDefault(i => i.Joined && IsPair(i, creatorPilotId, partnerPilotId));
+            if (existing != null)
+            {
+                existing.LastUsedUtc = UtcNow();
+                Persist();
+                return (existing.Code, false);
+            }
+            string code;
+            do { code = NewCode(); } while (_invites.ContainsKey(code));
+            var now = UtcNow();
+            _invites[code] = new TagInvite
+            {
+                Code = code,
+                CreatorPilotId = creatorPilotId,
+                CreatorName = CleanName(creatorName),
+                PartnerPilotId = partnerPilotId,
+                PartnerName = CleanName(partnerName),
+                CreatedUtc = now,
+                JoinedUtc = now,
+                LastUsedUtc = now,
+            };
+            Persist();
+            return (code, true);
+        }
+    }
+
+    /// <summary>Codes (joined or open-and-joined) the two pilots share, in either direction.</summary>
+    public IReadOnlyList<string> PairCodes(uint a, uint b)
+    {
+        if (a == 0 || b == 0) return Array.Empty<string>();
+        lock (_gate)
+        {
+            PruneExpired();
+            return _invites.Values.Where(i => i.Joined && IsPair(i, a, b)).Select(i => i.Code).ToList();
+        }
+    }
+
+    /// <summary>Delete every joined code the two pilots share (explicit choice when removing / blocking a friend).
+    /// Returns the deleted codes.</summary>
+    public IReadOnlyList<string> DeletePair(uint byPilotId, uint other)
+    {
+        var codes = PairCodes(byPilotId, other);
+        var done = new List<string>();
+        foreach (var c in codes)
+            if (Delete(c, byPilotId)) done.Add(c);
+        return done;
+    }
+
+    private static bool IsPair(TagInvite i, uint a, uint b) =>
+        (i.CreatorPilotId == a && i.PartnerPilotId == b) || (i.CreatorPilotId == b && i.PartnerPilotId == a);
+
