+// Security hardening 2026-11-15: source filtering, /tag shared secret, rate limits, log masking, partner-code expiry,
+// /match node-to-source binding. All test data is fake (documentation IP ranges, made-up codes).
+public class SecurityTests
+{
+    private static IPAddress Ip(string s) => IPAddress.Parse(s);
