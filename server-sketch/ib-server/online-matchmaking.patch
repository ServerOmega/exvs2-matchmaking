diff --git a/WebUIInfinite/Shared/Dto/Request/FriendsRequests.cs b/WebUIInfinite/Shared/Dto/Request/FriendsRequests.cs
new file mode 100644
index 0000000..1717e9c
--- /dev/null
+++ b/WebUIInfinite/Shared/Dto/Request/FriendsRequests.cs
@@ -0,0 +1,31 @@
+namespace WebUIInfinite.Shared.Dto.Request;
+
+/// <summary>Friends page: one page of a tab. Card credentials go in the body (never in the URL / request log).</summary>
+public class FriendsListRequest : BasicCardRequest
+{
+    /// <summary>friends | incoming | outgoing | requests | blocked</summary>
+    public string Tab { get; set; } = "friends";
+    /// <summary>Name (case / width insensitive) or pilot id digits.</summary>
+    public string? Q { get; set; }
+    /// <summary>name | added | lastPlayed</summary>
+    public string Sort { get; set; } = "added";
+    /// <summary>asc | desc (empty = natural order for the sort)</summary>
+    public string? Dir { get; set; }
+    public int Page { get; set; } = 1;
+    public int PageSize { get; set; } = 25;
+}
+
+/// <summary>Send a friend request or block by pilot id (the add forms).</summary>
+public class FriendsTargetRequest : BasicCardRequest
+{
+    public uint PilotId { get; set; }
+    public bool DeleteTagTeams { get; set; }
+}
+
+/// <summary>Accept / decline / remove / block / unblock one or many (bulk select, at most 100).</summary>
+public class FriendsBulkRequest : BasicCardRequest
+{
+    public List<uint> PilotIds { get; set; } = new();
+    /// <summary>Remove / block only: also delete the online tag teams you share with them.</summary>
+    public bool DeleteTagTeams { get; set; }
+}
diff --git a/WebUIInfinite/Shared/Dto/Response/FriendsResponses.cs b/WebUIInfinite/Shared/Dto/Response/FriendsResponses.cs
new file mode 100644
index 0000000..23aeee8
--- /dev/null
+++ b/WebUIInfinite/Shared/Dto/Response/FriendsResponses.cs
@@ -0,0 +1,58 @@
+namespace WebUIInfinite.Shared.Dto.Response;
+
+public class FriendItem
+{
+    public uint PilotId { get; set; }
+    public string Name { get; set; } = "";
+    /// <summary>friend | incoming | outgoing | blocked</summary>
+    public string Kind { get; set; } = "friend";
+    public DateTime AddedUtc { get; set; }
+    public DateTime? LastPlayedUtc { get; set; }
+    /// <summary>game | web</summary>
+    public string Source { get; set; } = "";
+    public bool HasTagTeam { get; set; }
+}
+
+public class FriendTabCounts
+{
+    public int Friends { get; set; }
+    public int Incoming { get; set; }
+    public int Outgoing { get; set; }
+    public int Blocked { get; set; }
+}
+
+public class FriendsListResponse
+{
+    public bool Success { get; set; }
+    public string? Message { get; set; }
+    public uint YourPilotId { get; set; }
+    public string YourName { get; set; } = "";
+    public string Tab { get; set; } = "friends";
+    public string Sort { get; set; } = "added";
+    public string Dir { get; set; } = "desc";
+    public int Page { get; set; } = 1;
+    public int PageSize { get; set; } = 25;
+    public int Total { get; set; }
+    public int TotalPages { get; set; } = 1;
+    public List<FriendItem> Items { get; set; } = new();
+    public FriendTabCounts Counts { get; set; } = new();
+}
+
+public class FriendActionResult
+{
+    public uint PilotId { get; set; }
+    /// <summary>Sent, AlreadyPending, BecameFriends, AlreadyFriends, Accepted, Removed, NotFound, Blocked, AlreadyBlocked,
+    /// Unblocked, RefusedBlocked, RefusedYouBlocked, RefusedSelf, RefusedInvalid, RefusedLimit</summary>
+    public string Result { get; set; } = "";
+    public bool Ok { get; set; }
+    public bool TagTeamCreated { get; set; }
+}
+
+public class FriendsActionResponse
+{
+    public bool Success { get; set; }
+    public string? Message { get; set; }
+    public List<FriendActionResult> Results { get; set; } = new();
+    public int TagTeamsCreated { get; set; }
+    public int TagTeamsDeleted { get; set; }
+}
