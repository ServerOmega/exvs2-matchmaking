+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// continue-pair fix 2026-11-15 (4-cab tests 12:45 and 13:19 PT): after a 4-human 2v2 the two idle teammates are
+// auto-continued by the game as a pair (EntryMatching apply 2, leader + member = their nodes from the last room).
+// With NoCpuPartner they were held, the leader's cabinet cancelled itself after ~30 s and both cabinets went black
+// waiting on each other. The matchmaker now answers such a pair before that (Cancel or VsCpu). Fake entries only.
+public class ContinuePairTests
+{
+    private uint _node = 9000;
+
+    private static Client Cl(uint node)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = $"P{node}", LocId = "JPN0JPN1", PrefCode = 13, GlobalIpaddress = "203.0.113.1",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Entry(uint leader, uint? member = null, uint apply = 1)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = apply, Myclient = Cl(leader), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = leader },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = 23 }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = 0 });
+        if (member != null)
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(member.Value), Player = new Player { BanapassportAmId = member.Value } });
+        return e;
+    }
+
+    private static Matchmaker New(Matchmaker.ContinuePairPolicy mode, List<string>? log = null, double postMatch = 1800) =>
+        new(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, MaxFillWait = 3, InStoreFillAfter = 3, InStoreMaxFillWait = 3,
+            NoCpuPartner = true, ContinuePairMode = mode, ContinuePairSeconds = 20, PostMatchWindow = postMatch,
+            Log = log == null ? null : log.Add,
+        };
+
+    /// <summary>4 solos play one room at t=0; returns (teammates side 0, teammates side 1).</summary>
+    private ((uint, uint) Mates0, (uint, uint) Mates1) PlayOneRoom(Matchmaker mm)
+    {
+        var ids = Enumerable.Range(0, 4).Select(_ => _node += 2).ToList();
+        foreach (var id in ids) Assert.Equal(ErrorCode.Success, mm.Entry(Entry(id), 0));
+        var room = mm.Check(ids[0], 1).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+        var g0 = room.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).ToList();
+        var g1 = room.Clients.Where(c => c.GroupId == 1).Select(c => c.Client.NodeId).ToList();
+        return ((g0[0], g0[1]), (g1[0], g1[1]));
+    }
+
+    [Fact]
+    public void Idle_teammates_continued_as_a_pair_get_MatchCanceled_before_the_cabinet_gives_up()
+    {
+        var log = new List<string>();
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel, log);
+        var (mates, _) = PlayOneRoom(mm);
+        // results at ~400 s, auto-continue entry ~30 s later (like 13:19:28 -> 13:19:59)
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430));
+        var r = mm.Check(mates.Item1, 445);
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(mates.Item1, 450).Code);   // 20 s, the cabinet gives up at ~30 s
+        Assert.Contains(log, l => l.Contains("continue pair") && l.Contains("drop nodes"));
+        // a repeated poll of the cancelled pair keeps getting MATCH_CANCELED, then they may enter again
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(mates.Item1, 451).Code);
+        Assert.Equal(ErrorCode.Success, mm.Entry(Entry(mates.Item1, mates.Item2, apply: 3), 452));
+    }
+
+    [Fact]
+    public void VsCpu_mode_gives_the_continuing_pair_a_lone_team_room()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        Assert.Null(mm.Check(mates.Item1, 440).Room);
+        var room = mm.Check(mates.Item1, 451).Room;
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Clients.Count);
+        Assert.All(room.Clients, c => Assert.Equal(0u, c.GroupId));                // both humans one side, CPUs opposite
+        Assert.Equal(new[] { mates.Item1, mates.Item2 }.OrderBy(x => x), room.Clients.Select(c => c.Client.NodeId).OrderBy(x => x));
+    }
+
+    [Fact]
+    public void Both_pairs_continuing_still_make_a_four_human_room()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel);
+        var (m0, m1) = PlayOneRoom(mm);
+        mm.Entry(Entry(m0.Item1, m0.Item2, apply: 2), 430);
+        mm.Entry(Entry(m1.Item1, m1.Item2, apply: 2), 440);
+        var room = mm.Check(m0.Item1, 441).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+
+    [Fact]
+    public void A_continuing_pair_plus_two_solos_within_the_wait_make_a_four_human_room()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        uint s1 = _node += 2, s2 = _node += 2;
+        mm.Entry(Entry(s1), 435);
+        mm.Entry(Entry(s2), 436);
+        var room = mm.Check(mates.Item1, 437).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+
+    [Fact]
+    public void A_deliberate_duo_is_not_affected()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel);
+        PlayOneRoom(mm);
+        uint a = _node += 2, b = _node += 2;   // fresh nodes: a duo picked on TEAM SELECT
+        mm.Entry(Entry(a, b), 430);
+        var r = mm.Check(a, 460);
+        Assert.Equal(ErrorCode.Success, r.Code);                          // keeps waiting for 4 humans (own 150 s timeout)
+        Assert.Null(r.Room);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(a, 581).Code);
+    }
+
+    [Fact]
+    public void Former_opponents_as_a_pair_are_not_a_continuing_pair()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel);
+        var (m0, m1) = PlayOneRoom(mm);
+        mm.Entry(Entry(m0.Item1, m1.Item1, apply: 2), 430);
+        Assert.Equal(ErrorCode.Success, mm.Check(m0.Item1, 460).Code);
+    }
+
+    [Fact]
+    public void An_old_room_does_not_count()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 1000);       // > 900 s after the room
+        Assert.Equal(ErrorCode.Success, mm.Check(mates.Item1, 1030).Code);
+    }
+
+    [Fact]
+    public void Off_keeps_the_old_hold()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Off);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        var r = mm.Check(mates.Item1, 470);
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+    }
+
+    [Fact]
+    public void Works_with_post_match_trace_off()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.Cancel, postMatch: 0);
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(mates.Item1, 451).Code);
+    }
+
+    // ---- fast MATCH_CANCELED for a "human + CPU partner" entry (4-cab test 13:40-13:46 PT) ----
+
+    private Request.EntryMatching CpuPartnerEntry(uint leader, uint apply = 1)
+    {
+        var e = Entry(leader, apply: apply);
+        var npc = Cl(0);
+        npc.PcbSerial = "PCB00000NPC";
+        npc.Properties[0].PropertyValue = "N";
+        e.Groups.Add(new Request.EntryMatching.Group { Client = npc, Player = new Player { BanapassportAmId = 0 } });
+        return e;
+    }
+
+    [Fact]
+    public void A_cpu_partner_entry_gets_MatchCanceled_after_CpuPartnerCancelSeconds()
+    {
+        var log = new List<string>();
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu, log);
+        mm.CpuPartnerCancelSeconds = 5;
+        uint a = _node += 2;
+        Assert.Equal(ErrorCode.Success, mm.Entry(CpuPartnerEntry(a), 100));
+        var r = mm.Check(a, 103);
+        Assert.Equal(ErrorCode.Success, r.Code);
+        Assert.Null(r.Room);
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(a, 105.5).Code);
+        Assert.Contains(log, l => l.Contains("CPU-partner entry") && l.Contains("drop nodes"));
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(a, 106).Code);           // a retried poll stays cancelled
+    }
+
+    [Fact]
+    public void After_the_fast_cancel_the_cabinet_re_entering_solo_completes_a_four_human_room()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        mm.CpuPartnerCancelSeconds = 5;
+        uint a = _node += 2, s1 = _node += 2, s2 = _node += 2, s3 = _node += 2;
+        mm.Entry(CpuPartnerEntry(a), 100);
+        mm.Entry(Entry(s1), 101); mm.Entry(Entry(s2), 101); mm.Entry(Entry(s3), 101);
+        Assert.Null(mm.Check(s1, 102).Room);                                     // 3 humans + a CPU-partner entry: no room
+        Assert.Equal(ErrorCode.MatchCanceled, mm.Check(a, 106).Code);
+        mm.Entry(Entry(a, apply: 2), 108);                                        // re-enters solo
+        var room = mm.Check(a, 109).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+
+    [Fact]
+    public void Cpu_partner_cancel_off_keeps_waiting_for_the_cabinet_timeout()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        uint a = _node += 2;
+        mm.Entry(CpuPartnerEntry(a), 100);
+        Assert.Equal(ErrorCode.Success, mm.Check(a, 160).Code);
+    }
+
+    [Fact]
+    public void Cpu_partner_cancel_does_nothing_without_NoCpuPartner()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        mm.NoCpuPartner = false;
+        mm.CpuPartnerCancelSeconds = 5;
+        uint a = _node += 2;
+        mm.Entry(CpuPartnerEntry(a), 100);
+        Assert.NotEqual(ErrorCode.MatchCanceled, mm.Check(a, 110).Code);
+    }
+
+    [Fact]
+    public void VsCpu_at_18s_still_prefers_a_four_human_room()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        mm.ContinuePairSeconds = 18;
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        Assert.Null(mm.Check(mates.Item1, 445).Room);
+        uint s1 = _node += 2, s2 = _node += 2;
+        mm.Entry(Entry(s1), 446); mm.Entry(Entry(s2), 446);
+        var room = mm.Check(mates.Item1, 447).Room;
+        Assert.NotNull(room);
+        Assert.Equal(4, room!.Humans);
+    }
+
+    [Fact]
+    public void VsCpu_at_18s_answers_the_pair_before_the_cabinet_gives_up()
+    {
+        var mm = New(Matchmaker.ContinuePairPolicy.VsCpu);
+        mm.ContinuePairSeconds = 18;
+        var (mates, _) = PlayOneRoom(mm);
+        mm.Entry(Entry(mates.Item1, mates.Item2, apply: 2), 430);
+        Assert.Null(mm.Check(mates.Item1, 447).Room);
+        var room = mm.Check(mates.Item1, 448.5).Room;                             // well before ~30 s self-cancel
+        Assert.NotNull(room);
+        Assert.Equal(2, room!.Humans);
+    }
+
+    [Theory]
+    [InlineData("Cancel", Matchmaker.ContinuePairPolicy.Cancel)]
+    [InlineData(" vscpu ", Matchmaker.ContinuePairPolicy.VsCpu)]
+    [InlineData("VS-CPU", Matchmaker.ContinuePairPolicy.VsCpu)]
+    [InlineData("off", Matchmaker.ContinuePairPolicy.Off)]
+    [InlineData("", Matchmaker.ContinuePairPolicy.Off)]
+    [InlineData(null, Matchmaker.ContinuePairPolicy.Off)]
+    public void ParseMode(string? s, Matchmaker.ContinuePairPolicy want) => Assert.Equal(want, Matchmaker.ParseContinuePairMode(s));
+}
