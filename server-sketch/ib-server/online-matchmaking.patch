+/// [exvs2-lobbies 2026-11-15] LoadCard.MobileUserGroup.partner_recruit_am_id_nglist (25) = this card's block (NG)
+/// list from the matchmaker, newest first, capped at Friends.MaxNgListEntries. The cabinet copies the list into
+/// EntryMatching.bl_banapassport_am_ids (analysis/partner-invites.md), which the matchmaker honours. Waits at most
+/// Friends.LoadCardTimeoutMs, then uses the last list seen (FriendOutbox cache). Also retries queued requests.
+/// The game has no friend-list field in LoadCard (only counts in SaveUserPlayResearchData), so friends are not sent.
+/// </summary>
+public class FriendNgListCommand : ILoadCardMobileUserCommand
+{
+    private readonly FriendsConfigurations _cfg;
+    private readonly IFriendClient? _client;
+    private readonly FriendOutbox? _outbox;
+    private readonly ILogger? _logger;
+
+    public FriendNgListCommand(FriendsConfigurations cfg, IFriendClient? client, FriendOutbox? outbox, ILogger? logger = null)
+    {
+        _cfg = cfg;
+        _client = client;
+        _outbox = outbox;
+        _logger = logger;
+    }
+
+    public void Fill(CardProfile cardProfile, Response.LoadCard.MobileUserGroup mobileUserGroup)
+    {
+        if (!_cfg.Enabled || _client == null) return;
+        var self = PilotId.Wire(cardProfile.Id);
+        var ids = Resolve(self).GetAwaiter().GetResult();
+        if (_cfg.SendNgList && ids.Count > 0)
+        {
+            mobileUserGroup.PartnerRecruitAmIdNglists = ids.Take(Math.Max(0, _cfg.MaxNgListEntries)).ToArray();
+            _logger?.LogInformation("LoadCard friends: wire {Wire} ng_list={Count}", self, mobileUserGroup.PartnerRecruitAmIdNglists.Length);
+        }
+    }
+
+    private async Task<IReadOnlyList<uint>> Resolve(uint self)
+    {
+        using var cts = new CancellationTokenSource(Math.Clamp(_cfg.LoadCardTimeoutMs, 200, 10000));
+        try
+        {
+            if (_outbox is { Count: > 0 })
+                await _outbox.FlushAsync(_client!, m => _logger?.LogInformation("{Message}", m), cts.Token);
+            var ids = await _client!.BlockedIdsAsync(self, Math.Max(0, _cfg.MaxNgListEntries), cts.Token);
+            _outbox?.CacheBlocked(self, ids);
+            return ids;
+        }
+        catch (Exception ex)
+        {
+            var cached = _outbox?.CachedBlocked(self) ?? Array.Empty<uint>();
+            _logger?.LogWarning("LoadCard friends: block list for wire {Wire} not available ({Error}); using {Count} cached", self,
+                ex is OperationCanceledException ? "timeout" : ex.Message, cached.Count);
+            return cached;
+        }
+    }
+}
diff --git a/Server-Infinite/Common/Friends/HttpFriendClient.cs b/Server-Infinite/Common/Friends/HttpFriendClient.cs
new file mode 100644
index 0000000..0d21011
--- /dev/null
+++ b/Server-Infinite/Common/Friends/HttpFriendClient.cs
@@ -0,0 +1,106 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.Friends;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-15] Card server → matchmaker /tag/friends API. Same base URL and X-Tag-Secret header as the
+/// online tag client (/tag), so no new port, allowlist entry or secret is needed. Never sends card secrets.
+/// </summary>
+public sealed class HttpFriendClient : IFriendClient
+{
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        Converters = { new JsonStringEnumConverter() },
+    };
+
+    private readonly HttpClient _http;
+    private readonly string _base;
+
+    /// <param name="tagBaseUrl">The /tag URL (for example http://host:28080/tag); /friends is appended.</param>
+    public HttpFriendClient(HttpClient http, string tagBaseUrl, string? sharedSecret = null)
+    {
+        _http = http;
+        _base = tagBaseUrl.TrimEnd('/') + "/friends";
+        _http.Timeout = TimeSpan.FromSeconds(6);
+        if (!string.IsNullOrEmpty(sharedSecret))
+            _http.DefaultRequestHeaders.TryAddWithoutValidation(ServerInfinite.Lobbies.NetworkAccess.TagSecretHeader, sharedSecret);
+    }
+
+    public async Task<FriendOutcome> RequestAsync(uint from, string fromName, uint to, string source, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/request",
+            new { fromPilotId = from, fromName = TagInviteStore.CleanName(fromName), toPilotId = to, source }, Json, ct);
+        await EnsureOk(r, ct);
+        return await r.Content.ReadFromJsonAsync<FriendOutcome>(Json, ct)
+               ?? throw new InvalidOperationException("Empty friend-request response.");
+    }
+
+    public Task<IReadOnlyList<FriendOutcome>> AcceptAsync(uint by, string byName, IReadOnlyList<uint> others, CancellationToken ct = default) =>
+        Bulk("accept", new { pilotId = by, name = TagInviteStore.CleanName(byName), others = FriendLimits.CleanIds(others) }, ct);
+
+    public Task<IReadOnlyList<FriendOutcome>> DeclineAsync(uint by, IReadOnlyList<uint> others, CancellationToken ct = default) =>
+        Bulk("decline", new { pilotId = by, others = FriendLimits.CleanIds(others) }, ct);
+
+    public Task<IReadOnlyList<FriendOutcome>> RemoveAsync(uint by, IReadOnlyList<uint> others, bool deleteTagTeams, CancellationToken ct = default) =>
+        Bulk("remove", new { pilotId = by, others = FriendLimits.CleanIds(others), deleteTagTeams }, ct);
+
+    public Task<IReadOnlyList<FriendOutcome>> BlockAsync(uint by, IReadOnlyList<uint> targets, string source, bool deleteTagTeams, CancellationToken ct = default) =>
+        Bulk("block", new { pilotId = by, others = FriendLimits.CleanIds(targets), source, deleteTagTeams }, ct);
+
+    public Task<IReadOnlyList<FriendOutcome>> UnblockAsync(uint by, IReadOnlyList<uint> targets, CancellationToken ct = default) =>
+        Bulk("unblock", new { pilotId = by, others = FriendLimits.CleanIds(targets) }, ct);
+
+    public async Task<FriendPage> ListAsync(uint pilot, FriendQuery query, CancellationToken ct = default)
+    {
+        var q = query.Clamp();
+        var url = $"{_base}/{pilot}?tab={Uri.EscapeDataString(q.Tab)}&sort={Uri.EscapeDataString(q.Sort)}&dir={q.Dir}" +
+                  $"&page={q.Page}&pageSize={q.PageSize}" + (q.Q is null ? "" : $"&q={Uri.EscapeDataString(q.Q)}");
+        var r = await _http.GetAsync(url, ct);
+        await EnsureOk(r, ct);
+        return await r.Content.ReadFromJsonAsync<FriendPage>(Json, ct) ?? new FriendPage();
+    }
+
+    public async Task<IReadOnlyList<uint>> BlockedIdsAsync(uint pilot, int max, CancellationToken ct = default)
+    {
+        var r = await _http.GetAsync($"{_base}/{pilot}/blocked?max={Math.Clamp(max, 0, 1000)}", ct);
+        await EnsureOk(r, ct);
+        return await r.Content.ReadFromJsonAsync<List<uint>>(Json, ct) ?? new List<uint>();
+    }
+
+    private async Task<IReadOnlyList<FriendOutcome>> Bulk(string path, object body, CancellationToken ct)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/{path}", body, Json, ct);
+        await EnsureOk(r, ct);
+        var b = await r.Content.ReadFromJsonAsync<BulkBody>(Json, ct);
+        return b?.Results ?? new List<FriendOutcome>();
+    }
+
+    private static async Task EnsureOk(HttpResponseMessage r, CancellationToken ct)
+    {
+        if (r.IsSuccessStatusCode) return;
+        switch ((int)r.StatusCode)
+        {
+            case 401:
+                throw new InvalidOperationException(
+                    "The matchmaker refused this card server: OnlineTag.TagSecret in server.json is missing or does not match the matchmaker's.");
+            case 403:
+                throw new InvalidOperationException("The matchmaker refused this card server's network address (Security.AccessMode).");
+            case 429:
+                throw new InvalidOperationException("The matchmaker is rate limiting this card server; try again in a few seconds.");
+            case 404 or 405:
+                throw new InvalidOperationException(
+                    "The matchmaker does not support friends yet (it needs the 2026-11-15 friend-request update), or Friends.Enabled is false there.");
+        }
+        string? err = null;
+        try { err = (await r.Content.ReadFromJsonAsync<ErrorBody>(Json, ct))?.Error; } catch { }
+        throw new InvalidOperationException(err ?? $"Friends request failed ({(int)r.StatusCode}).");
+    }
+
+    private sealed class BulkBody { public List<FriendOutcome> Results { get; set; } = new(); }
+    private sealed class ErrorBody { public string? Error { get; set; } }
+}
