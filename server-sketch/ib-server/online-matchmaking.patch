+        {
+            var mine = a.NodeIds.Concat(b.NodeIds).ToHashSet();
+            foreach (var n in mine)
+            {
+                if (!_lastSideByNode.TryGetValue(n, out var last) || now - last.At > RegroupRoomMaxAge) continue;
+                var members = _lastSideByNode.Where(kv => kv.Value.Room == last.Room).Select(kv => kv.Key).ToList();
