+        Assert.Equal(1, s.HistoryBattleCount);
+    }
+
+    [Fact]
+    public void RecentBattlesAreCapped()
+    {
+        var card = NewCard("many");
+        for (var i = 0; i < CardStatsDto.RecentLimit + 5; i++)
+        {
+            AddOffline(card, win: i % 2 == 0, suit: 100, playedAt: 1_794_700_000ul + (ulong)i);
+        }
+        var s = Stats(card);
+        Assert.Equal(CardStatsDto.RecentLimit, s.RecentBattles.Count);
+        Assert.Equal(1_794_700_000ul + CardStatsDto.RecentLimit + 4, s.RecentBattles[0].PlayedAt);
+        Assert.Equal((uint)CardStatsDto.RecentLimit + 5, s.Suits.Single().Modes.Single().Battles);
+    }
+
+    [Fact]
+    public void TotalIsNeverBelowTheSumOfTheModes()
+    {
+        // older data: class wins counted by the class persistence without the total
+        var card = NewCard("legacy");
+        using (var db = NewContext())
+        {
+            var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+            wl.ClassSoloWin = 4;
+            wl.ClassSoloLose = 2;
+            wl.ShuffleWin = 1;
+            wl.TotalWin = 1;
+            db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        var s = Stats(card);
+        Assert.Equal((5u, 2u), (Mode(s, StatsModes.Total).Wins, Mode(s, StatsModes.Total).Losses));
+        Assert.Equal(0u, Mode(s, StatsModes.Other).Battles);
+
+        using (var db = NewContext())
+        {
+            var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+            wl.TotalWin = 8; // e.g. private-room online battles: only in the total
+            wl.TotalLose = 2;
+            db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        s = Stats(card);
+        Assert.Equal((3u, 0u), (Mode(s, StatsModes.Other).Wins, Mode(s, StatsModes.Other).Losses));
+    }
+
+    [Fact]
