+        SendOnline(card, OnlineMatchingMode.OmmFree, shuffle: true, win: false, suit: 313, roomId: 16, playedAt: 1_794_730_500, given: 500, taken: 2000);
+        SendOnline(card, OnlineMatchingMode.OmmFree, shuffle: true, win: true, suit: 401, roomId: 17, playedAt: 1_794_731_000, burstType: 2);
+
+        var s = Stats(card);
+
+        Assert.Equal((3u, 2u), (Mode(s, StatsModes.Total).Wins, Mode(s, StatsModes.Total).Losses));
