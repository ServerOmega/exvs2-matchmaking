diff --git a/WebUIInfinite/Shared/Dto/Stats/CardStatsDto.cs b/WebUIInfinite/Shared/Dto/Stats/CardStatsDto.cs
new file mode 100644
index 0000000..68d2156
--- /dev/null
+++ b/WebUIInfinite/Shared/Dto/Stats/CardStatsDto.cs
@@ -0,0 +1,207 @@
+namespace WebUIInfinite.Shared.Dto.Stats;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: one card's stats page (View Card -> Stats), VS Mobile style.
+/// Read-only snapshot built from the existing tables; no card identifiers (chip id / access code) are included.
+/// </summary>
+public class CardStatsDto
+{
+    /// <summary>Win/loss per mode from the card's win/loss record (lifetime). Keys: see <see cref="StatsModes"/>.</summary>
+    public List<ModeRecordDto> ModeRecords { get; set; } = new();
+
+    /// <summary>Lifetime totals from the player statistics row.</summary>
+    public CareerTotalsDto Totals { get; set; } = new();
+
+    /// <summary>One row per mobile suit the card has played in PvP (lifetime per-suit stats + battle-history split).</summary>
+    public List<SuitStatsDto> Suits { get; set; } = new();
+
+    /// <summary>Lifetime battles / wins per burst type (see BurstType: 0 Extend, 1 Fighting, 2 Shooting).</summary>
+    public List<BurstStatsDto> Bursts { get; set; } = new();
+
+    /// <summary>Most recent battles, newest first (at most <see cref="RecentLimit"/>).</summary>
+    public List<RecentBattleDto> RecentBattles { get; set; } = new();
+
+    /// <summary>Battle-history rows the per-mode split is based on (history only exists for battles saved by this server).</summary>
+    public int HistoryBattleCount { get; set; }
+
+    public const int RecentLimit = 30;
+}
+
+public static class StatsModes
+{
+    public const string Total = "Total";
+    public const string Offline = "Offline";
+    public const string OfflineSolo = "OfflineSolo";
+    public const string OfflineTeam = "OfflineTeam";
+    public const string ClassSolo = "ClassSolo";
+    public const string ClassTeam = "ClassTeam";
+    public const string Mix = "Mix";
+    public const string Fes = "Fes";
+    public const string Other = "Other";
+
+    /// <summary>Modes a battle can be in (battle-history split); <see cref="Total"/> and <see cref="Offline"/> are sums.</summary>
+    public static readonly string[] BattleModes = { OfflineSolo, OfflineTeam, ClassSolo, ClassTeam, Mix, Fes, Other };
+
+    /// <summary>Stored BattleHistory.BattleMode -> stats mode key.</summary>
+    public static string FromBattleMode(string? battleMode) => battleMode switch
+    {
+        "OfflineSolo" => OfflineSolo,
+        "OfflineTeam" => OfflineTeam,
+        "ClassMatchSolo" => ClassSolo,
+        "ClassMatchTeam" => ClassTeam,
+        "FreeSolo" or "FreeTeam" => Mix,
+        "FesSolo" or "FesTeam" => Fes,
+        _ => Other,
+    };
+
+    public static bool IsOffline(string mode) => mode is OfflineSolo or OfflineTeam;
+}
+
+public class ModeRecordDto
+{
+    public string Mode { get; set; } = string.Empty;
+    public uint Wins { get; set; }
+    public uint Losses { get; set; }
+    public uint Battles => Wins + Losses;
+    public double WinRate => Battles == 0 ? 0 : 100.0 * Wins / Battles;
+}
+
+public class CareerTotalsDto
+{
+    public ulong GivenDamage { get; set; }
+    public ulong EnemyDefeated { get; set; }
+    public ulong NoDamageBattles { get; set; }
+    public ulong ExBurstDamage { get; set; }
+    public ulong ClassTenWinStreaks { get; set; }
+}
+
+public class SuitModeStatsDto
+{
+    public string Mode { get; set; } = string.Empty;
+    public uint Battles { get; set; }
+    public uint Wins { get; set; }
+    public ulong GivenDamage { get; set; }
+    public ulong TakenDamage { get; set; }
+}
+
+public class SuitStatsDto
+{
+    public uint MobileSuitId { get; set; }
+
+    // lifetime per-suit PvP statistics (exvs2ob_ms_pvp_stat)
+    public uint Battles { get; set; }
+    public uint Wins { get; set; }
+    public uint Losses => Battles >= Wins ? Battles - Wins : 0;
+    public double WinRate => Battles == 0 ? 0 : 100.0 * Wins / Battles;
+    public ulong GivenDamage { get; set; }
+    public ulong EnemyDefeated { get; set; }
+    public ulong NoDamageBattles { get; set; }
+    public ulong ExBurstDamage { get; set; }
+    public ulong ClassTenWinStreaks { get; set; }
+    public double AverageDamage => Battles == 0 ? 0 : (double)GivenDamage / Battles;
+    public double DefeatedPerBattle => Battles == 0 ? 0 : (double)EnemyDefeated / Battles;
+
+    /// <summary>Times the suit was chosen (exvs2ob_ms_usage), includes non-PvP play.</summary>
+    public uint TimesUsed { get; set; }
+
+    // battle-history split (only battles with a stored history row)
+    public List<SuitModeStatsDto> Modes { get; set; } = new();
+    public ulong LastPlayedAt { get; set; }
+}
+
+public class BurstStatsDto
+{
+    public uint BurstType { get; set; }
+    public uint Battles { get; set; }
+    public uint Wins { get; set; }
+    public double WinRate => Battles == 0 ? 0 : 100.0 * Wins / Battles;
+}
+
+public class RecentBattleDto
+{
+    public ulong PlayedAt { get; set; }
+    public string Mode { get; set; } = string.Empty;
+    public uint MobileSuitId { get; set; }
+    public bool IsWin { get; set; }
+    public uint GivenDamage { get; set; }
+    public uint TakenDamage { get; set; }
+    public uint ElapsedSeconds { get; set; }
+    public uint Score { get; set; }
+    public uint BurstType { get; set; }
+}
+
+/// <summary>One per-suit table row for a mode filter ("All" = lifetime per-suit stats, else the battle-history split).</summary>
+public class SuitStatsRow
+{
+    public const string AllModes = "All";
+
+    public uint MobileSuitId { get; init; }
+    public uint Battles { get; init; }
+    public uint Wins { get; init; }
+    public uint Losses => Battles >= Wins ? Battles - Wins : 0;
+    public double WinRate => Battles == 0 ? 0 : 100.0 * Wins / Battles;
+    public double AverageDamage { get; init; }
+    /// <summary>Average damage taken; only known from battle history (null when no history battles).</summary>
+    public double? AverageTaken { get; init; }
+    /// <summary>Lifetime-only columns (null for a single-mode filter, the tables do not split them per mode).</summary>
+    public ulong? EnemyDefeated { get; init; }
+    public double? DefeatedPerBattle { get; init; }
+    public ulong? NoDamageBattles { get; init; }
+    public ulong? ExBurstDamage { get; init; }
+    public uint TimesUsed { get; init; }
+    public ulong LastPlayedAt { get; init; }
+
+    public static List<SuitStatsRow> Build(IEnumerable<SuitStatsDto> suits, string mode)
+    {
+        var rows = new List<SuitStatsRow>();
+        foreach (var s in suits)
+        {
+            var historyBattles = (uint)s.Modes.Sum(m => (long)m.Battles);
+            var historyTaken = (ulong)s.Modes.Sum(m => (decimal)m.TakenDamage);
+            if (mode == AllModes)
+            {
+                if (s.Battles == 0 && historyBattles == 0) continue;
+                rows.Add(new SuitStatsRow
+                {
+                    MobileSuitId = s.MobileSuitId,
+                    Battles = s.Battles,
+                    Wins = s.Wins,
+                    AverageDamage = s.AverageDamage,
+                    AverageTaken = historyBattles == 0 ? null : (double)historyTaken / historyBattles,
+                    EnemyDefeated = s.EnemyDefeated,
+                    DefeatedPerBattle = s.DefeatedPerBattle,
+                    NoDamageBattles = s.NoDamageBattles,
+                    ExBurstDamage = s.ExBurstDamage,
+                    TimesUsed = s.TimesUsed,
+                    LastPlayedAt = s.LastPlayedAt,
+                });
+                continue;
+            }
+
+            var picked = s.Modes.Where(m => m.Mode == mode || (mode == StatsModes.Offline && StatsModes.IsOffline(m.Mode))).ToList();
+            var battles = (uint)picked.Sum(m => (long)m.Battles);
+            if (battles == 0) continue;
+            rows.Add(new SuitStatsRow
+            {
+                MobileSuitId = s.MobileSuitId,
+                Battles = battles,
+                Wins = (uint)picked.Sum(m => (long)m.Wins),
+                AverageDamage = (double)picked.Sum(m => (decimal)m.GivenDamage) / battles,
+                AverageTaken = (double)picked.Sum(m => (decimal)m.TakenDamage) / battles,
+                TimesUsed = s.TimesUsed,
+                LastPlayedAt = s.LastPlayedAt,
+            });
+        }
+        return rows;
+    }
+
+    /// <summary>Mode filters that have at least one history battle, in display order.</summary>
+    public static List<string> AvailableModes(IEnumerable<SuitStatsDto> suits)
+    {
+        var present = suits.SelectMany(s => s.Modes).Where(m => m.Battles > 0).Select(m => m.Mode).ToHashSet();
+        var list = new List<string> { AllModes };
+        if (present.Contains(StatsModes.OfflineSolo) && present.Contains(StatsModes.OfflineTeam)) list.Add(StatsModes.Offline);
+        list.AddRange(StatsModes.BattleModes.Where(present.Contains));
+        return list;
+    }
+}
