+using MediatR;
+using Microsoft.AspNetCore.Mvc;
+using ServerInfinite.Handlers.UI.Stats;
+using WebUIInfinite.Shared.Dto.Stats;
+
+namespace ServerInfinite.Controllers.UI;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: View Card -> Stats. Read-only; the access code + chip id pair must match one card,
+/// exactly like ui/battle-history.
+/// </summary>
+[ApiController]
+[Route("ui/card-stats")]
+public class CardStatsController(IMediator mediator) : BaseController<CardStatsController>
+{
+    [HttpGet("get-card-stats/{accessCode}/{chipId}")]
+    [Produces("application/json")]
+    public async Task<ActionResult<CardStatsDto>> GetCardStats(string accessCode, string chipId)
+    {
+        return await mediator.Send(new GetCardStatsCommand(accessCode, chipId));
+    }
+}
diff --git a/Server-Infinite/Handlers/UI/Stats/GetCardStatsCommand.cs b/Server-Infinite/Handlers/UI/Stats/GetCardStatsCommand.cs
new file mode 100644
index 0000000..a5b8454
--- /dev/null
+++ b/Server-Infinite/Handlers/UI/Stats/GetCardStatsCommand.cs
@@ -0,0 +1,217 @@
+using MediatR;
+using Microsoft.EntityFrameworkCore;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Stats;
+using WebUIInfinite.Shared.Exception;
+
+namespace ServerInfinite.Handlers.UI.Stats;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: per-card stats page (View Card -> Stats). Read-only; same card check as the battle
+/// history page (access code + chip id must belong to the same card). Sources, all existing tables (no migration):
+/// win/loss record (per-mode lifetime counters), player statistics, per-suit PvP statistics, suit usage, burst
+/// statistics, and battle history + self rows (per-mode split per suit, recent battles).
+/// </summary>
+public record GetCardStatsCommand(string AccessCode, string ChipId) : IRequest<CardStatsDto>;
+
+public class GetCardStatsCommandHandler(ServerDbContext context) : IRequestHandler<GetCardStatsCommand, CardStatsDto>
+{
+    public async Task<CardStatsDto> Handle(GetCardStatsCommand request, CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrEmpty(request.AccessCode) || string.IsNullOrEmpty(request.ChipId))
+        {
+            throw new InvalidCardDataException("Card Profile is invalid");
+        }
+
+        var cardId = await context.CardProfiles.AsNoTracking()
+            .Where(x => x.AccessCode == request.AccessCode && x.ChipId == request.ChipId)
+            .Select(x => (int?)x.Id)
+            .FirstOrDefaultAsync(cancellationToken);
+
+        if (cardId is null)
+        {
+            throw new InvalidCardDataException("Card Profile is invalid");
+        }
+
+        return await Build(context, cardId.Value, cancellationToken);
+    }
+
+    public static async Task<CardStatsDto> Build(ServerDbContext context, int cardId, CancellationToken ct = default)
+    {
+        var dto = new CardStatsDto();
+
+        // ---- per-mode lifetime win/loss ----
+        var wl = await context.WinLossRecordDbSet.AsNoTracking().FirstOrDefaultAsync(x => x.CardId == cardId, ct);
+        if (wl is not null)
+        {
+            var offlineWin = wl.ShuffleWin + wl.TeamWin;
+            var offlineLose = wl.ShuffleLose + wl.TeamLose;
+            var knownWin = offlineWin + wl.ClassSoloWin + wl.ClassTeamWin + wl.FreeWin + wl.FesWin;
+            var knownLose = offlineLose + wl.ClassSoloLose + wl.ClassTeamLose + wl.FreeLose + wl.FesLose;
+            // Class win/loss is counted by the class-match persistence; older data may have per-mode counters that
+            // were never added to the totals, so the total is never shown below the sum of the modes.
+            var totalWin = Math.Max(wl.TotalWin, knownWin);
+            var totalLose = Math.Max(wl.TotalLose, knownLose);
+            dto.ModeRecords.Add(Rec(StatsModes.Total, totalWin, totalLose));
+            dto.ModeRecords.Add(Rec(StatsModes.Offline, offlineWin, offlineLose));
+            dto.ModeRecords.Add(Rec(StatsModes.OfflineSolo, wl.ShuffleWin, wl.ShuffleLose));
+            dto.ModeRecords.Add(Rec(StatsModes.OfflineTeam, wl.TeamWin, wl.TeamLose));
+            dto.ModeRecords.Add(Rec(StatsModes.ClassSolo, wl.ClassSoloWin, wl.ClassSoloLose));
+            dto.ModeRecords.Add(Rec(StatsModes.ClassTeam, wl.ClassTeamWin, wl.ClassTeamLose));
+            dto.ModeRecords.Add(Rec(StatsModes.Mix, wl.FreeWin, wl.FreeLose));
+            dto.ModeRecords.Add(Rec(StatsModes.Fes, wl.FesWin, wl.FesLose));
+            dto.ModeRecords.Add(Rec(StatsModes.Other, totalWin - knownWin, totalLose - knownLose));
+        }
+
+        // ---- lifetime totals ----
+        var ps = await context.PlayerBattleStatisticDbSet.AsNoTracking().FirstOrDefaultAsync(x => x.CardId == cardId, ct);
+        if (ps is not null)
+        {
+            dto.Totals = new CareerTotalsDto
+            {
+                GivenDamage = ps.TotalGivenDamage,
+                EnemyDefeated = ps.TotalEnemyDefeatedCount,
+                NoDamageBattles = ps.TotalNoDamageBattleCount,
+                ExBurstDamage = ps.TotalExBurstDamage,
+                ClassTenWinStreaks = ps.TotalClassMatchTenConsecutiveWinCount,
+            };
+        }
+
+        // ---- burst types ----
+        dto.Bursts = (await context.PlayerBurstStatisticsDbSet.AsNoTracking()
+                .Where(x => x.CardId == cardId)
+                .Select(x => new { x.BurstType, x.TotalBattle, x.TotalWin })
+                .ToListAsync(ct))
+            .GroupBy(x => x.BurstType)
+            .Select(g => new BurstStatsDto
+            {
+                BurstType = g.Key,
+                Battles = (uint)g.Sum(x => (long)x.TotalBattle),
+                Wins = (uint)g.Sum(x => (long)x.TotalWin),
+            })
+            .OrderBy(x => x.BurstType)
+            .ToList();
+
+        // ---- per suit: lifetime PvP stats ----
+        var suits = new Dictionary<uint, SuitStatsDto>();
+        SuitStatsDto Suit(uint id)
+        {
+            if (!suits.TryGetValue(id, out var s))
+            {
+                s = new SuitStatsDto { MobileSuitId = id };
+                suits[id] = s;
+            }
+            return s;
+        }
+
+        var pvp = await context.MobileSuitPvPStatisticDbSet.AsNoTracking()
+            .Where(x => x.CardId == cardId)
+            .ToListAsync(ct);
+        foreach (var row in pvp)
+        {
+            var s = Suit(row.MstMobileSuitId);
+            s.Battles += row.TotalBattleCount;
+            s.Wins += row.TotalWinCount;
+            s.GivenDamage += row.TotalGivenDamage;
+            s.EnemyDefeated += row.TotalEnemyDefeatedCount;
+            s.NoDamageBattles += row.TotalNoDamageBattleCount;
+            s.ExBurstDamage += row.TotalExBurstDamage;
+            s.ClassTenWinStreaks += row.TotalClassMatchTenConsecutiveWinCount;
+        }
+
+        // ---- battle history (per-mode split + recent) ----
+        var histories = await context.BattleHistoryDbSet.AsNoTracking()
+            .Where(x => x.CardId == cardId)
+            .Select(x => new
+            {
+                x.Id, x.BattleMode, x.IsWin, x.PlayedAt, x.GivenDamage, x.TakenDamage, x.ElapsedSeconds, x.Score,
+                x.BurstType,
+            })
+            .ToListAsync(ct);
+        var historyIds = histories.Select(x => x.Id).ToList();
+        var selfSuitByHistory = new Dictionary<int, uint>();
+        foreach (var chunk in historyIds.Chunk(500))
+        {
+            var ids = chunk.ToList();
+            var selves = await context.BattleSelfDbSet.AsNoTracking()
+                .Where(x => ids.Contains(x.BattleHistoryId))
+                .Select(x => new { x.BattleHistoryId, x.CardId, x.MobileSuitId })
+                .ToListAsync(ct);
+            foreach (var self in selves.OrderBy(x => x.CardId == (uint)cardId ? 0 : 1))
+            {
+                selfSuitByHistory.TryAdd(self.BattleHistoryId, self.MobileSuitId);
+            }
+        }
+
+        dto.HistoryBattleCount = histories.Count;
+        foreach (var h in histories)
+        {
+            if (!selfSuitByHistory.TryGetValue(h.Id, out var suitId) || suitId == 0)
+            {
+                continue;
+            }
+            var mode = StatsModes.FromBattleMode(h.BattleMode);
+            var s = Suit(suitId);
+            var m = s.Modes.FirstOrDefault(x => x.Mode == mode);
+            if (m is null)
+            {
+                m = new SuitModeStatsDto { Mode = mode };
+                s.Modes.Add(m);
+            }
+            m.Battles++;
+            if (h.IsWin) m.Wins++;
+            m.GivenDamage += h.GivenDamage;
+            m.TakenDamage += h.TakenDamage;
+            if (h.PlayedAt > s.LastPlayedAt) s.LastPlayedAt = h.PlayedAt;
+        }
+
+        dto.RecentBattles = histories
+            .OrderByDescending(x => x.PlayedAt)
+            .ThenByDescending(x => x.Id)
+            .Take(CardStatsDto.RecentLimit)
+            .Select(h => new RecentBattleDto
+            {
+                PlayedAt = h.PlayedAt,
+                Mode = StatsModes.FromBattleMode(h.BattleMode),
+                MobileSuitId = selfSuitByHistory.GetValueOrDefault(h.Id),
+                IsWin = h.IsWin,
+                GivenDamage = h.GivenDamage,
+                TakenDamage = h.TakenDamage,
+                ElapsedSeconds = h.ElapsedSeconds,
+                Score = h.Score,
+                BurstType = h.BurstType,
+            })
+            .ToList();
+
+        // ---- times used (only for suits that have PvP data) ----
+        if (suits.Count > 0)
+        {
+            var usage = await context.MobileSuitUsageDbSet.AsNoTracking()
+                .Where(x => x.CardId == cardId)
+                .Select(x => new { x.MstMobileSuitId, x.MsUsedNum })
+                .ToListAsync(ct);
+            foreach (var u in usage)
+            {
+                if (suits.TryGetValue(u.MstMobileSuitId, out var s))
+                {
+                    s.TimesUsed += u.MsUsedNum;
+                }
+            }
+        }
+
+        foreach (var s in suits.Values)
+        {
+            s.Modes = s.Modes.OrderBy(x => Array.IndexOf(StatsModes.BattleModes, x.Mode)).ToList();
+        }
+
+        dto.Suits = suits.Values
+            .OrderByDescending(x => x.Battles)
+            .ThenByDescending(x => x.Modes.Sum(m => m.Battles))
+            .ThenBy(x => x.MobileSuitId)
+            .ToList();
+
+        return dto;
+    }
+
+    private static ModeRecordDto Rec(string mode, uint win, uint lose) => new() { Mode = mode, Wins = win, Losses = lose };
+}
