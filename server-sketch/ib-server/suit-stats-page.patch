+        Assert.Equal(0u, Mode(s, StatsModes.ClassTeam).Battles);
+        Assert.Equal((1u, 1u), (Mode(s, StatsModes.Mix).Wins, Mode(s, StatsModes.Mix).Losses));
+        Assert.Equal(0u, Mode(s, StatsModes.Other).Battles);
+        Assert.Equal(60.0, Mode(s, StatsModes.Total).WinRate, 3);
