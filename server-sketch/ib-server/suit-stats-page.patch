@@ -0,0 +1,344 @@
+using System.Text.Json;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Handlers.Game.Online;
+using ServerInfinite.Handlers.UI.Stats;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Cards.Battle.History;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Stats;
+using WebUIInfinite.Shared.Exception;
+using Xunit;
+
+namespace Server.Tests;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: View Card -> Stats (GetCardStatsCommand). Read-only, card owner only (access code +
+/// chip id), per-mode summary, per-suit table with a per-mode split, recent battles.
+/// </summary>
+public sealed class CardStatsTests : IDisposable
+{
+    private readonly SqliteConnection _connection;
+    private readonly ServerDbContext _db;
+
+    public CardStatsTests()
+    {
+        OnlineBattleResults.ResetForTests();
+        _connection = new SqliteConnection("DataSource=:memory:");
+        _connection.Open();
+        _db = NewContext();
+        _db.Database.Migrate();
+    }
+
+    public void Dispose()
+    {
+        _db.Dispose();
+        _connection.Dispose();
+    }
+
+    private ServerDbContext NewContext() =>
+        new(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_connection).Options);
+
+    private CardProfile NewCard(string session, string name = "PILOT")
+    {
+        var card = new CardProfile
+        {
+            AccessCode = "ac-" + session,
+            ChipId = "chip-" + session,
+            SessionId = session,
+            UserName = name,
+            IsNewCard = false,
+            DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+        };
+        _db.CardProfiles.Add(card);
+        _db.SaveChangesAsync().GetAwaiter().GetResult();
+        return card;
+    }
+
+    private void SendOnline(CardProfile card, OnlineMatchingMode mode, bool shuffle, bool win, uint suit, uint roomId,
+        ulong playedAt, uint given = 900, uint taken = 1500, uint burstType = 1)
+    {
+        var result = new Request.SaveVsmOnResult.PlayResultGroup
+        {
+            PlayedAt = playedAt, WinFlag = win, VsElapsedTime = 125, StageId = 5,
+            MstMobileSuitId = suit, SkillPointMobileSuitId = suit, ResultScore = 1000, ResultOrder = 1,
+            LevelId = 3, PlayerLevelId = 3, LevelExp = 10, Gp = 100,
+            GivenDamage = given, TakenDamage = taken, Burst = 1, BurstType = burstType, BurstGivenDamage = 100,
+            ComboGivenDamage = 200, ConsecutiveWin = win ? 1u : 0u, RoomId = roomId, OnlineMatchingMode = mode, BadgeId = 1,
+            Partner = new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 402 },
+        };
+        result.Foes.Add(new AdversaryManGroup { PilotId = 3_000_456, CpuFlag = 0, MstMobileSuitId = 332, DownNum = 1 });
+        result.Foes.Add(new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 333, DownNum = 1 });
+        if (mode == OnlineMatchingMode.OmmClass)
+        {
+            result.class_match_result = new Request.SaveVsmOnResult.PlayResultGroup.ClassMatchResult
+            {
+                ClassIdSolo = 2, ClassIdTeam = 2, BeforeRate = 1500f, AfterRate = 1500f, ObtainedRate = 0f, GradeId = 3,
+            };
+        }
+        var request = new Request
+        {
+            Type = MethodType.MthdSaveVsmOnResult,
+            RequestId = "test",
+            save_vsm_on_result = new Request.SaveVsmOnResult
+            {
+                PilotId = (uint)card.Id, SessionId = card.SessionId, ShuffleFlag = shuffle, Result = result,
+            },
+        };
+        var config = new CardServerConfig { LogNetworkReport = false };
+        using var db = NewContext();
+        var handler = new SaveVsmOnResultCommandHandler(NullLogger<SaveVsmOnResultCommandHandler>.Instance, db,
+            Options.Create(config));
+        var response = handler.Handle(new SaveVsmOnResultCommand(request), CancellationToken.None).GetAwaiter().GetResult();
+        Assert.Equal(Error.Success, response.Error);
+    }
+
+    /// <summary>An offline battle as SaveVsmResult would leave it: lifetime counters + a history row.</summary>
+    private void AddOffline(CardProfile card, bool win, uint suit, ulong playedAt, bool team = false)
+    {
+        using var db = NewContext();
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        if (win) wl.TotalWin++; else wl.TotalLose++;
+        if (team) { if (win) wl.TeamWin++; else wl.TeamLose++; }
+        else { if (win) wl.ShuffleWin++; else wl.ShuffleLose++; }
+        var pvp = db.MobileSuitPvPStatisticDbSet.FirstOrDefault(x => x.CardId == card.Id && x.MstMobileSuitId == suit);
+        if (pvp is null)
+        {
+            pvp = new ServerInfinite.Models.Cards.MobileSuit.MobileSuitPvPStatistic { CardId = card.Id, MstMobileSuitId = suit };
+            db.MobileSuitPvPStatisticDbSet.Add(pvp);
+        }
+        pvp.TotalBattleCount++;
+        if (win) pvp.TotalWinCount++;
+        pvp.TotalGivenDamage += 600;
+        pvp.TotalEnemyDefeatedCount += 2;
+        db.BattleHistoryDbSet.Add(new BattleHistory
+        {
+            CardId = card.Id, BattleMode = team ? "OfflineTeam" : "OfflineSolo", IsWin = win, PlayedAt = playedAt,
+            ElapsedSeconds = 90, GivenDamage = 600, TakenDamage = 300,
+            BattleSelf = new BattleSelf { CardId = (uint)card.Id, MobileSuitId = suit, PlayerName = card.UserName },
+        });
+        db.SaveChangesAsync().GetAwaiter().GetResult();
+    }
+
+    private CardStatsDto Stats(CardProfile card)
+    {
+        using var db = NewContext();
+        return new GetCardStatsCommandHandler(db)
+            .Handle(new GetCardStatsCommand(card.AccessCode, card.ChipId), CancellationToken.None).GetAwaiter().GetResult();
+    }
+
+    private static ModeRecordDto Mode(CardStatsDto s, string mode) => s.ModeRecords.Single(x => x.Mode == mode);
+
+    [Fact]
+    public void OnlyTheMatchingAccessCodeAndChipIdGetTheStats()
+    {
+        var a = NewCard("a");
+        var b = NewCard("b");
+        using var db = NewContext();
+        var handler = new GetCardStatsCommandHandler(db);
+        Task<CardStatsDto> Get(string ac, string chip) =>
+            handler.Handle(new GetCardStatsCommand(ac, chip), CancellationToken.None);
+
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get("wrong", a.ChipId)).GetAwaiter().GetResult();
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get(a.AccessCode, b.ChipId)).GetAwaiter().GetResult();
+        Assert.ThrowsAsync<InvalidCardDataException>(() => Get("", "")).GetAwaiter().GetResult();
+        Assert.NotNull(Get(a.AccessCode, a.ChipId).GetAwaiter().GetResult());
+    }
+
+    [Fact]
+    public void NewCardHasEmptyStats()
+    {
+        var s = Stats(NewCard("new"));
+        Assert.Equal(0u, Mode(s, StatsModes.Total).Battles);
+        Assert.Empty(s.Suits);
+        Assert.Empty(s.RecentBattles);
+        Assert.Equal(0, s.HistoryBattleCount);
+    }
+
+    [Fact]
+    public void OnlineAndOfflineBattlesAreSplitByModeAndSuit()
+    {
+        var card = NewCard("mix");
+        AddOffline(card, win: true, suit: 100, playedAt: 1_794_700_000);
+        AddOffline(card, win: false, suit: 100, playedAt: 1_794_700_100, team: true);
