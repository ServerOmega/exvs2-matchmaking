+            <MudTh>@localizer["card_stats_suit"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_result"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_damage_dealt"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_damage_taken"]</MudTh>
+            <MudTh Style="text-align:center">@localizer["card_stats_time"]</MudTh>
+        </HeaderContent>
+        <RowTemplate>
+            <MudTd DataLabel="@localizer["card_stats_date"]">@Date(context.PlayedAt, true)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_mode"]">@ModeName(context.Mode)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_suit"]">@SuitName(context.MobileSuitId)</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_result"]" Style="text-align:center">
+                @if (context.IsWin)
+                {
+                    <MudText Color="Color.Info" Typo="Typo.body2">WIN</MudText>
+                }
+                else
+                {
+                    <MudText Color="Color.Error" Typo="Typo.body2">LOSE</MudText>
+                }
+            </MudTd>
+            <MudTd DataLabel="@localizer["card_stats_damage_dealt"]" Style="text-align:center">@context.GivenDamage</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_damage_taken"]" Style="text-align:center">@context.TakenDamage</MudTd>
+            <MudTd DataLabel="@localizer["card_stats_time"]" Style="text-align:center">@($"{context.ElapsedSeconds / 60}:{context.ElapsedSeconds % 60:00}")</MudTd>
+        </RowTemplate>
+        <NoRecordsContent>
+            <MudText>@localizer["card_stats_no_battles"]</MudText>
+        </NoRecordsContent>
+    </MudTable>
+</MudStack>
+
+@code {
+    [Parameter] public CardStatsDto? CardStats { get; set; }
+
+    private string _mode = SuitStatsRow.AllModes;
+    private List<string> _modes = new() { SuitStatsRow.AllModes };
+    private List<SuitStatsRow> _rows = new();
+    private CardStatsDto? _built;
+
+    private static readonly string[] SummaryOrder =
+    {
+        StatsModes.Total, StatsModes.Offline, StatsModes.ClassSolo, StatsModes.ClassTeam, StatsModes.Mix, StatsModes.Fes, StatsModes.Other,
+    };
+
+    private IEnumerable<ModeRecordDto> SummaryRecords => CardStats is null
+        ? Enumerable.Empty<ModeRecordDto>()
+        : SummaryOrder
+            .Select(m => CardStats.ModeRecords.FirstOrDefault(r => r.Mode == m))
+            .Where(r => r is not null && (r.Battles > 0 || r.Mode is StatsModes.Total or StatsModes.Offline or StatsModes.ClassSolo or StatsModes.Mix))
+            .Select(r => r!);
+
+    private ulong PvpBattles => CardStats is null ? 0 : (ulong)CardStats.Suits.Sum(s => (long)s.Battles);
+
+    protected override void OnParametersSet()
+    {
+        if (ReferenceEquals(_built, CardStats)) return;
+        _built = CardStats;
+        if (CardStats is null) return;
+        _modes = SuitStatsRow.AvailableModes(CardStats.Suits);
+        if (!_modes.Contains(_mode)) _mode = SuitStatsRow.AllModes;
+        _rows = SuitStatsRow.Build(CardStats.Suits, _mode);
+    }
+
+    private void OnModeChanged(string mode)
+    {
+        _mode = mode;
+        _rows = CardStats is null ? new() : SuitStatsRow.Build(CardStats.Suits, _mode);
+    }
+
+    private MobileSuit? Suit(uint id) => MobileSuitDataService.GetMobileSuitById(id);
+
+    private string SuitName(uint id)
+    {
+        var ms = Suit(id);
+        if (ms is null) return $"#{id}";
+        var lang = Thread.CurrentThread.CurrentCulture.Name;
+        var name = lang switch
+        {
+            "ja" => ms.ValueJP,
+            "zh-Hans" => ms.ValueCN,
+            "zh-Hant" => ms.ValueTC,
+            "zh-Hant-TW" => ms.ValueTC2,
+            _ => ms.Value,
+        };
+        return string.IsNullOrWhiteSpace(name) ? ms.Value : name;
+    }
+
+    private uint SuitCost(uint id) => Suit(id)?.Cost ?? 0;
+
+    private string CostText(uint id)
+    {
+        var cost = SuitCost(id);
+        return cost == 0 ? "-" : cost.ToString();
+    }
+
+    private string ModeName(string mode) => localizer[$"card_stats_mode_{mode}"];
+
+    private string BurstName(uint burstType) => burstType switch
+    {
+        0 => localizer["card_stats_burst_extend"],
+        1 => localizer["card_stats_burst_fighting"],
+        2 => localizer["card_stats_burst_shooting"],
+        _ => $"#{burstType}",
+    };
+
+    private static string Pct(double rate, uint battles) => battles == 0 ? "-" : rate.ToString("0.0") + "%";
+
+    private static string Avg(ulong total, ulong battles) => battles == 0 ? "-" : ((double)total / battles).ToString("N0");
+
+    private static string Date(ulong unixSeconds, bool withTime = false)
+    {
+        if (unixSeconds == 0) return "-";
+        var local = DateTimeOffset.FromUnixTimeSeconds((long)unixSeconds).ToLocalTime();
+        return withTime ? local.ToString("g") : local.ToString("d");
+    }
+}
