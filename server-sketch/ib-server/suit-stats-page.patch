+        var json = JsonSerializer.Serialize(Stats(card));
+        Assert.DoesNotContain(card.ChipId, json);
+        Assert.DoesNotContain(card.AccessCode, json);
+        Assert.DoesNotContain(card.SessionId, json);
+    }
+
+    [Fact]
+    public void BattleModeKeys()
+    {
+        Assert.Equal(StatsModes.OfflineSolo, StatsModes.FromBattleMode("OfflineSolo"));
+        Assert.Equal(StatsModes.OfflineTeam, StatsModes.FromBattleMode("OfflineTeam"));
+        Assert.Equal(StatsModes.ClassSolo, StatsModes.FromBattleMode("ClassMatchSolo"));
+        Assert.Equal(StatsModes.ClassTeam, StatsModes.FromBattleMode("ClassMatchTeam"));
+        Assert.Equal(StatsModes.Mix, StatsModes.FromBattleMode("FreeSolo"));
+        Assert.Equal(StatsModes.Mix, StatsModes.FromBattleMode("FreeTeam"));
+        Assert.Equal(StatsModes.Fes, StatsModes.FromBattleMode("FesSolo"));
+        Assert.Equal(StatsModes.Fes, StatsModes.FromBattleMode("FesTeam"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode("OnlineOtherSolo"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode("Triad"));
+        Assert.Equal(StatsModes.Other, StatsModes.FromBattleMode(null));
+    }
+
+    [Fact]
+    public void SuitTableRowsPerModeFilter()
+    {
+        var suits = new List<SuitStatsDto>
+        {
+            new()
+            {
+                MobileSuitId = 1, Battles = 10, Wins = 6, GivenDamage = 8000, EnemyDefeated = 15, TimesUsed = 12,
+                Modes =
+                {
+                    new SuitModeStatsDto { Mode = StatsModes.OfflineSolo, Battles = 2, Wins = 1, GivenDamage = 1000, TakenDamage = 800 },
+                    new SuitModeStatsDto { Mode = StatsModes.OfflineTeam, Battles = 2, Wins = 2, GivenDamage = 1400, TakenDamage = 400 },
+                    new SuitModeStatsDto { Mode = StatsModes.Mix, Battles = 1, Wins = 0, GivenDamage = 300, TakenDamage = 1800 },
+                },
+            },
+            new() { MobileSuitId = 2, Battles = 3, Wins = 3, GivenDamage = 3000 },
+            new() { MobileSuitId = 3 },
+        };
+
+        var all = SuitStatsRow.Build(suits, SuitStatsRow.AllModes);
+        Assert.Equal(new uint[] { 1, 2 }, all.Select(r => r.MobileSuitId).ToArray()); // no empty rows
+        var r1 = all[0];
+        Assert.Equal((10u, 6u, 4u), (r1.Battles, r1.Wins, r1.Losses));
+        Assert.Equal(60.0, r1.WinRate, 3);
+        Assert.Equal(800.0, r1.AverageDamage, 3);
+        Assert.Equal(600.0, r1.AverageTaken!.Value, 3);      // 3000 taken over 5 history battles
+        Assert.Equal(1.5, r1.DefeatedPerBattle!.Value, 3);
+        Assert.Null(all[1].AverageTaken);                  // no history for suit 2
+
+        var offline = SuitStatsRow.Build(suits, StatsModes.Offline);
+        var o = Assert.Single(offline);
+        Assert.Equal((4u, 3u), (o.Battles, o.Wins));
+        Assert.Equal(600.0, o.AverageDamage, 3);
+        Assert.Equal(300.0, o.AverageTaken!.Value, 3);
+        Assert.Null(o.EnemyDefeated);
+
+        var mix = Assert.Single(SuitStatsRow.Build(suits, StatsModes.Mix));
+        Assert.Equal((1u, 0u, 0.0), (mix.Battles, mix.Wins, mix.WinRate));
+        Assert.Empty(SuitStatsRow.Build(suits, StatsModes.ClassSolo));
+
+        Assert.Equal(new[] { SuitStatsRow.AllModes, StatsModes.Offline, StatsModes.OfflineSolo, StatsModes.OfflineTeam, StatsModes.Mix },
+            SuitStatsRow.AvailableModes(suits).ToArray());
+    }
+}
