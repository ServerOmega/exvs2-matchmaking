+
+        Assert.Equal(2300ul, s.Totals.GivenDamage);   // the three online battles (900 + 500 + 900) (offline rows were seeded per-suit only)
+        Assert.Contains(s.Bursts, b => b.BurstType == 2 && b.Battles == 1 && b.Wins == 1);
+        Assert.Contains(s.Bursts, b => b.BurstType == 1 && b.Battles == 2 && b.Wins == 1);
