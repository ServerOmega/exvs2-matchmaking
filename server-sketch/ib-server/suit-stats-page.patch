+using System.Net.Http.Json;
+using WebUIInfinite.Client.Context.ViewCard;
+using WebUIInfinite.Shared.Dto.Stats;
+
+namespace WebUIInfinite.Client.Command.ViewCard.Filler;
+
+/// <summary>exvs2-lobbies 2026-11-16: View Card -> Stats tab data. A failure leaves the tab empty, not the page.</summary>
+public class CardStatsFiller : IViewCardContextFiller
+{
+    private readonly HttpClient _httpClient;
+
+    public CardStatsFiller(HttpClient httpClient)
+    {
+        _httpClient = httpClient;
+    }
+
+    public async Task Fill(ViewCardContext viewCardContext)
+    {
+        try
+        {
+            viewCardContext.CardStats = await _httpClient.GetFromJsonAsync<CardStatsDto>(
+                $"/ui/card-stats/get-card-stats/{Uri.EscapeDataString(viewCardContext.AccessCode)}/{Uri.EscapeDataString(viewCardContext.ChipId)}");
+        }
+        catch (Exception)
+        {
+            viewCardContext.CardStats = null;
+        }
+    }
+}
