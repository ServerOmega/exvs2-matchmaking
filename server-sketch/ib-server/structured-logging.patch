@@ -0,0 +1,42 @@
+using ServerInfinite.Lobbies;
+
+// exvs2-lobbies 2026-11-17: match-timeline [--list] [--match <id>] [--loading N --connect N --fetch N --battle N] <files or folders...>
+// Reads structured event files (events-*.jsonl) from the matchmaker and/or card servers and prints one match's
+// timeline, with stage gaps over the thresholds. Read-only.
+var files = new List<string>();
+string? match = null;
+var list = false;
+var gaps = new GapThresholds();
+for (var i = 0; i < args.Length; i++)
+{
+    var a = args[i];
+    double Num() => double.Parse(args[++i], System.Globalization.CultureInfo.InvariantCulture);
+    switch (a)
+    {
+        case "--match": match = args[++i]; break;
+        case "--list": list = true; break;
+        case "--fetch": gaps.RoomFetchSeconds = Num(); break;
+        case "--connect": gaps.ConnectSeconds = Num(); break;
+        case "--loading": gaps.LoadingSeconds = Num(); break;
+        case "--battle": gaps.BattleSeconds = Num(); break;
+        case "-h" or "--help":
+            Console.WriteLine("usage: match-timeline [--list] [--match m-<boot>-<room>] [--loading 20] [--connect 40] [--fetch 10] [--battle 480] <events files or folders>");
+            return 0;
+        default:
+            if (Directory.Exists(a)) files.AddRange(Directory.GetFiles(a, "events-*.jsonl").OrderBy(x => x));
+            else files.Add(a);
+            break;
+    }
+}
+if (files.Count == 0) files.AddRange(Directory.Exists("Logs/events") ? Directory.GetFiles("Logs/events", "events-*.jsonl") : Array.Empty<string>());
+var events = MatchTimeline.ParseLines(MatchTimeline.ReadFiles(files));
+if (events.Count == 0) { Console.Error.WriteLine("No structured events found."); return 1; }
+var matches = MatchTimeline.ListMatches(events);
+if (list || match == null)
+{
+    foreach (var m in matches.Take(50))
+        Console.WriteLine($"{m.At:yyyy-MM-dd HH:mm:ss}  {m.MatchId,-22} room {m.Room,-5} {m.World,-14} humans {m.Humans}/{m.Seats}");
+    if (match == null) return 0;
+}
+Console.Write(MatchTimeline.Render(MatchTimeline.Build(events, match!, gaps)));
+return 0;
