--- /dev/null
+++ b/Tests/Matchmaking.Tests/StructuredEventBench.cs
@@ -0,0 +1,65 @@
+using System.Diagnostics;
+using ServerInfinite.Lobbies;
+using Xunit;
+using Xunit.Abstractions;
+using G = nue.protocol.exvs;
+
+namespace Matchmaking.Tests;
+
+// exvs2-lobbies 2026-11-17: opt-in micro benchmark of the card-server side (not run by default).
+//   SL_BENCH=1 dotnet test Tests/Matchmaking.Tests --filter StructuredEventBench --logger "console;verbosity=detailed"
+public class StructuredEventBench(ITestOutputHelper output)
+{
+    [Fact]
+    public async Task CardTrackerCostPerRequest()
+    {
+        if (Environment.GetEnvironmentVariable("SL_BENCH") != "1") return;
+        var dir = Path.Combine(Path.GetTempPath(), "sl-bench-" + Guid.NewGuid().ToString("N"));
+        using var writer = new EventLogWriter(new EventLogOptions { Directory = dir, QueueCapacity = 1_000_000, MaxTotalBytes = 1L << 31 });
+        var ok = new G.Response { Error = G.Error.Success };
+        G.Request Mk(G.MethodType t, string serial) => new() { Type = t, RequestId = "1", PcbSerial = serial, LocId = "JPN0JPN1" };
+        // one match cycle per cab: LoadCard, CheckCommunication, SaveBattleLogOn, SaveVsmOnResult, plus 6 unrelated requests
+        G.Request[] Cycle(int i, string serial)
+        {
+            var cc = Mk(G.MethodType.MthdCheckCommunication, serial);
+            cc.check_communication = new G.Request.CheckCommunication { StartDate = 1794730093, EndDate = 1794730115, ApplyId = (uint)i, FoundPlayerFlag = true, UdpHpResult = G.UdpHpResultType.UdphpSuccess, MatchingTryNum = 1, stun_result = new() };
+            cc.check_communication.Players.Add(new() { PcbSerial = "OTHER" + i, Rtt = 16 });
+            var bl = Mk(G.MethodType.MthdSaveBattleLogOn, serial);
+            bl.save_battle_log_on = new() { BattleLog = new() { OnlineMatchingMode = G.OnlineMatchingMode.OmmFes } };
+            var rs = Mk(G.MethodType.MthdSaveVsmOnResult, serial);
+            rs.save_vsm_on_result = new() { Result = new() { RoomId = (uint)i, WinFlag = true, VsElapsedTime = 150 }, NetworkReport = new() };
+            var lc = Mk(G.MethodType.MthdLoadCard, serial);
+            lc.load_card = new() { PilotId = 1 };
+            var other = Mk(G.MethodType.MthdLoadGameData, serial);
+            return new[] { lc, other, other, cc, other, bl, other, rs, other, other };
+        }
+        var serials = Enumerable.Range(0, 100).Select(i => $"2895{i:D8}").ToArray();
+        var cycles = Enumerable.Range(0, 2000).Select(i => Cycle(i, serials[i % 100])).ToArray();
+
+        double Run(CardEventTracker? t)
+        {
+            var sw = Stopwatch.StartNew();
+            foreach (var c in cycles) foreach (var r in c) t?.Observe(r, ok);
+            return sw.Elapsed.TotalMilliseconds * 1e6 / (cycles.Length * 10);   // ns per request
+        }
+        for (var w = 0; w < 3; w++) { Run(new CardEventTracker(new CountSink())); Run(new CardEventTracker(writer) { MatchmakerBoot = () => "t3k9qa" }); }
+        await writer.FlushAsync(TimeSpan.FromSeconds(30));
+        var b0 = writer.BytesWritten; var n0 = writer.Written;
+        var off = Enumerable.Range(0, 5).Select(_ => Run(null)).Min();
+        var nul = Enumerable.Range(0, 5).Select(_ => Run(new CardEventTracker(new CountSink()))).Min();
+        var on = Enumerable.Range(0, 5).Select(_ => Run(new CardEventTracker(writer) { MatchmakerBoot = () => "t3k9qa" })).Min();
+        await writer.FlushAsync(TimeSpan.FromSeconds(30));
+        var lines = writer.Written - n0; var bytes = writer.BytesWritten - b0;
+        var sample = new List<EventRecord>(); var cs = new CardEventTracker(new ListSink(sample)) { MatchmakerBoot = () => "t3k9qa" };
+        foreach (var c in cycles.Take(500)) foreach (var r in c) cs.Observe(r, ok);
+        var sw2 = Stopwatch.StartNew(); var reps = 0;
+        for (var k = 0; k < 20; k++) foreach (var e in sample) { EventJson.Serialize(e, e.At ?? DateTimeOffset.Now); reps++; }
+        var serNs = sw2.Elapsed.TotalMilliseconds * 1e6 / reps;
+        output.WriteLine($"writer thread: mask+JSON {serNs:F0} ns/event");
+        output.WriteLine($"ns/request (caller thread): off={off:F0} tracker-only={nul:F0} tracker+writer(enqueue)={on:F0}; per cab-match cycle {lines / (5.0 * cycles.Length):F1} events, {bytes / (5.0 * cycles.Length):F0} bytes; avg line {bytes / (double)lines:F0} B; dropped {writer.Dropped}");
+        Directory.Delete(dir, true);
+    }
+
+    private sealed class CountSink : IEventSink { public int N; public bool Enabled => true; public void Emit(EventRecord e) { e.At ??= DateTimeOffset.Now; N++; } }
+    private sealed class ListSink(List<EventRecord> l) : IEventSink { public bool Enabled => true; public void Emit(EventRecord e) { e.At ??= DateTimeOffset.Now; l.Add(e); } }
+}
