+        Assert.DoesNotContain("boot", JsonSerializer.Serialize(without));
+    }
+
+    // ---------------------------------------------------------------- matchmaker events
+
+    [Fact]
+    public void MatchmakerEmitsQueueRoomAndFetchEventsWithTheMatchId()
+    {
+        var sink = new ListEventSink();
+        var mm = NewMm(sink);
