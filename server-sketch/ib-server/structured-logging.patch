+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Structured match events (JSON lines, docs in ONLINE_MATCHMAKING.md "Structured events").
+/// Written next to the text logs, through a background queue, so a request never waits on the disk. Logging only.
+/// </summary>
+public class StructuredLogConfigurations
+{
+    /// <summary>On by default. false = no events file, no extra work per request (text logs are unchanged either way).</summary>
+    public bool Enabled { get; set; } = true;
+
+    /// <summary>Folder for events-YYYYMMDD.jsonl (relative to the server folder).</summary>
+    public string Directory { get; set; } = "./Logs/events";
+
+    /// <summary>Days of event files to keep.</summary>
+    public int RetentionDays { get; set; } = 14;
+
+    /// <summary>Total size cap for the folder; the oldest files are deleted first.</summary>
+    public int MaxTotalMegabytes { get; set; } = 200;
+
+    /// <summary>Events waiting for the disk; when full, events are dropped (and counted) instead of slowing requests.</summary>
+    public int QueueCapacity { get; set; } = 20000;
+
+    /// <summary>
+    /// Card server only: read the matchmaker's boot id from GET {MatchUrl host}/status every minute so result and
+    /// disconnect events carry the same match id as the matchmaker's ("m-&lt;boot&gt;-&lt;room&gt;"). One small GET per
+    /// minute, off the request path. false = events carry the room id only.
+    /// </summary>
+    public bool FetchMatchmakerBootId { get; set; } = true;
+
+    /// <summary>Thresholds for gap_warning events (seconds, 0 = that check off).</summary>
+    public ServerInfinite.Lobbies.GapThresholds Gaps { get; set; } = new();
+}
