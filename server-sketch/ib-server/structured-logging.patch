diff --git a/Server-Infinite/Lobbies/CardEventTracker.cs b/Server-Infinite/Lobbies/CardEventTracker.cs
new file mode 100644
index 0000000..3aa8fb3
--- /dev/null
+++ b/Server-Infinite/Lobbies/CardEventTracker.cs
@@ -0,0 +1,240 @@
+using nue.protocol.exvs;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Card-server side of the structured events. Looks at each game request after it was
+/// answered (never changes the reply) and emits card_insert / peer_connect / load_end / battle_start / result_saved /
+/// disconnect, plus gap_warning when a cabinet stays in loading or on the results screen too long.
+///
+/// Per cabinet it remembers the last stage, apply_id and room so later events carry them. The match id comes from
+/// <see cref="MatchmakerBoot"/> (the matchmaker's boot id, read from its /status) + the room id the game reports in
+/// its result; earlier events carry <c>cab</c> + <c>apply</c>, which the matchmaker's events also carry, so the
+/// timeline tool can join them.
+/// </summary>
+public sealed class CardEventTracker
+{
+    private sealed class CabState
+    {
+        public string Stage = "";
+        public DateTimeOffset StageAt;
+        public uint Apply;
+        public ulong Room;
+        public string? Match;
+        public string? Warned;
+    }
+
+    private readonly IEventSink _sink;
+    private readonly Func<DateTimeOffset> _now;
+    private readonly Dictionary<string, CabState> _cabs = new();
+    private readonly object _gate = new();
+
+    public CardEventTracker(IEventSink sink, GapThresholds? gaps = null, Func<DateTimeOffset>? now = null)
+    {
+        _sink = sink;
+        Gaps = gaps ?? new GapThresholds();
+        _now = now ?? (() => DateTimeOffset.Now);
+    }
+
+    public GapThresholds Gaps { get; }
+
+    /// <summary>Boot id of the matchmaker the cabinets use (null = unknown: events carry room, not match).</summary>
+    public Func<string?> MatchmakerBoot { get; set; } = () => null;
+
+    public bool Enabled => _sink.Enabled;
+
+    /// <summary>Call after the reply is built. Never throws.</summary>
+    public void Observe(Request? req, Response? resp)
+    {
+        if (req == null || !_sink.Enabled) return;
+        try { ObserveCore(req, resp); }
+        catch (Exception) { /* logging only */ }
+    }
+
+    private void ObserveCore(Request req, Response? resp)
+    {
+        var cab = EventIds.Cab(req.PcbSerial);
+        if (cab == null) return;
+        var now = _now();
+        var ok = resp == null || resp.Error == Error.Success;
+        List<EventRecord> outEvents = new(3);
+        lock (_gate)
+        {
+            // the other cabs are swept at most once a second (and every 2 s by the hosted service);
+            // this cab's own stage is checked now, before this request moves it on
+            if ((now - _lastSweep).TotalSeconds >= 1) SweepLocked(now, outEvents);
+            if (!_cabs.TryGetValue(cab, out var st))
+            {
+                if (_cabs.Count > 4096) _cabs.Clear();
+                _cabs[cab] = st = new CabState();
+            }
+            else CheckLocked(cab, st, now, outEvents);
+            // any request from the cabinet ends a results-screen wait
+            switch (req.Type)
+            {
+                case MethodType.MthdLoadCard:
+                    outEvents.Add(Ev(EventNames.CardInsert, cab, now).With("ok", ok));
+                    SetStage(st, "menus", now);
+                    break;
+
+                case MethodType.MthdCheckCommunication when req.check_communication is { } cc:
+                {
+                    st.Apply = cc.ApplyId;
+                    st.Room = 0;
+                    st.Match = null;
+                    var udp = cc.UdpHpResult;
+                    var e = Ev(EventNames.PeerConnect, cab, now)
+                        .With("apply", cc.ApplyId)
+                        .With("ok", udp == UdpHpResultType.UdphpSuccess && cc.FoundPlayerFlag)
+                        .With("udp", Name(udp))
+                        .With("found", cc.FoundPlayerFlag)
+                        .With("try", cc.MatchingTryNum)
+                        .With("line", Name(cc.LineType))
+                        .With("peers", cc.Players.Count)
+                        .With("rtt_max", cc.Players.Count > 0 ? cc.Players.Max(p => p.Rtt) : (uint?)null)
+                        .With("nat", cc.stun_result != null ? $"{(int)cc.stun_result.nat_mapping_type}/{(int)cc.stun_result.nat_filtering_type}" : null);
+                    // start_date / end_date are the cabinet's own unix seconds: search start -> connection done
+                    if (cc.StartDate > 1_600_000_000 && cc.EndDate >= cc.StartDate && cc.EndDate - cc.StartDate < 3600)
+                        e.With("search_s", (long)(cc.EndDate - cc.StartDate));
+                    outEvents.Add(e);
+                    if (udp != UdpHpResultType.UdphpSuccess)
+                    {
+                        outEvents.Add(Ev(EventNames.Disconnect, cab, now).With("apply", cc.ApplyId)
+                            .With("stage", "connect").With("reason", "udp-" + Name(udp)));
+                        SetStage(st, "menus", now);
+                    }
+                    else SetStage(st, "loading", now);
+                    break;
+                }
+
+                case MethodType.MthdSaveBattleLogOn when req.save_battle_log_on is { } bl:
+                {
+                    var g = bl.BattleLog;
+                    var loadS = st.Stage == "loading" ? (now - st.StageAt).TotalSeconds : (double?)null;
+                    outEvents.Add(Ev(EventNames.LoadEnd, cab, now).With("apply", NonZero(st.Apply)).With("load_s", loadS));
+                    outEvents.Add(Ev(EventNames.BattleStart, cab, now).With("apply", NonZero(st.Apply))
+                        .With("mode", g != null ? Name(g.OnlineMatchingMode) : null)
+                        .With("humans", g?.Pilots.Count(p => p.IsHuman))
+                        .With("seats", g?.Pilots.Count));
+                    SetStage(st, "battle", now);
+                    break;
+                }
+
+                case MethodType.MthdSaveVsmOnResult when req.save_vsm_on_result is { } r:
+                {
+                    var res = r.Result;
+                    var room = res?.RoomId ?? 0;
+                    st.Room = room;
+                    st.Match = EventIds.MatchId(MatchmakerBoot(), room);
+                    var e = Ev(EventNames.ResultSaved, cab, now)
+                        .With("match", st.Match).With("room", NonZero(room)).With("apply", NonZero(st.Apply))
+                        .With("ok", ok).With("method", "vsm_on")
+                        .With("mode", res != null ? Name(res.OnlineMatchingMode) : null)
+                        .With("win", res?.WinFlag)
+                        .With("battle_s", res?.VsElapsedTime);
+                    var nr = r.NetworkReport;
+                    if (nr != null && nr.PcbDatas.Count > 0)
+                    {
+                        e.With("rtt_max", nr.PcbDatas.Max(p => p.MaxRtt));
+                        e.With("loss_max", nr.PcbDatas.Max(p => p.PacketLostRate));
+                    }
+                    outEvents.Add(e);
+                    SetStage(st, "results", now);
+                    break;
+                }
+
+                case MethodType.MthdSaveVsmResult when req.save_vsm_result is { } r2:
+                    outEvents.Add(Ev(EventNames.ResultSaved, cab, now).With("apply", NonZero(st.Apply)).With("ok", ok)
+                        .With("method", "vsm").With("win", r2.Result?.WinFlag).With("battle_s", r2.Result?.VsElapsedTime));
+                    SetStage(st, "results", now);
+                    break;
+
+                case MethodType.MthdSaveFailedBattleLogOn when req.save_failed_battle_log_on is { } f:
+                {
+                    st.Room = f.RoomId;
+                    st.Match = EventIds.MatchId(MatchmakerBoot(), f.RoomId);
+                    outEvents.Add(Ev(EventNames.Disconnect, cab, now)
+                        .With("match", st.Match).With("room", NonZero(f.RoomId)).With("apply", NonZero(st.Apply))
+                        .With("stage", st.Stage.Length > 0 ? st.Stage : null)
+                        .With("reason", "failed-battle-log")
+                        .With("my_fault", f.MyFaultFlag)
+                        .With("mode", Name(f.OnlineMatchingMode)));
+                    SetStage(st, "menus", now);
+                    break;
+                }
+
+                default:
+                    if (st.Stage == "results" && !ResultGapTrace.IsResultSave(req.Type))
+                        SetStage(st, "menus", now);
+                    break;
+            }
+        }
+        foreach (var e in outEvents) _sink.Emit(e);
+    }
+
+    /// <summary>Timer tick (every few seconds): gap warnings for cabinets that went silent.</summary>
+    public void Sweep()
+    {
+        if (!_sink.Enabled) return;
+        List<EventRecord> outEvents = new();
+        lock (_gate) SweepLocked(_now(), outEvents);
+        foreach (var e in outEvents) _sink.Emit(e);
+    }
+
+    private DateTimeOffset _lastSweep;
+
+    private void SweepLocked(DateTimeOffset now, List<EventRecord> outEvents)
+    {
+        _lastSweep = now;
+        foreach (var (cab, st) in _cabs) CheckLocked(cab, st, now, outEvents);
+    }
+
+    private void CheckLocked(string cab, CabState st, DateTimeOffset now, List<EventRecord> outEvents)
+    {
+        {
+            var limit = st.Stage switch
+            {
+                "loading" => Gaps.LoadingSeconds,
+                "battle" => Gaps.BattleSeconds,
+                "results" => Gaps.ResultsSeconds,
+                _ => 0,
+            };
+            if (limit <= 0 || st.Warned == st.Stage) return;
+            var waited = (now - st.StageAt).TotalSeconds;
+            if (waited < limit) return;
+            st.Warned = st.Stage;
+            outEvents.Add(Ev(EventNames.GapWarning, cab, now)
+                .With("match", st.Match).With("room", NonZero(st.Room)).With("apply", NonZero(st.Apply))
+                .With("stage", st.Stage).With("waited_s", Math.Round(waited, 1)).With("limit_s", limit)
+                .With("after", st.Stage switch { "loading" => EventNames.PeerConnect, "battle" => EventNames.BattleStart, _ => EventNames.ResultSaved }));
+        }
+    }
+
+    private static void SetStage(CabState st, string stage, DateTimeOffset now)
+    {
+        st.Stage = stage;
+        st.StageAt = now;
+        st.Warned = null;
+    }
+
+    private static EventRecord Ev(string name, string cab, DateTimeOffset now) =>
+        new EventRecord("card", name) { At = now }.With("cab", cab);
+
+    private static uint? NonZero(uint v) => v == 0 ? null : v;
+    private static ulong? NonZero(ulong v) => v == 0 ? null : v;
+
+    private static string Name<T>(T v) where T : struct, Enum
+    {
+        var s = v.ToString();
+        // UdphpFailTimeout -> fail-timeout, OmmClass -> class, OnlinetSolo -> solo
+        foreach (var p in new[] { "Udphp", "Omm", "Onlinet" })
+            if (s.StartsWith(p, StringComparison.Ordinal) && s.Length > p.Length) { s = s[p.Length..]; break; }
+        var sb = new System.Text.StringBuilder(s.Length + 4);
+        for (var i = 0; i < s.Length; i++)
+        {
+            if (char.IsUpper(s[i]) && i > 0) sb.Append('-');
+            sb.Append(char.ToLowerInvariant(s[i]));
+        }
+        return sb.ToString();
+    }
+}
diff --git a/Server-Infinite/Lobbies/EventLogWriter.cs b/Server-Infinite/Lobbies/EventLogWriter.cs
new file mode 100644
index 0000000..460dcd3
--- /dev/null
+++ b/Server-Infinite/Lobbies/EventLogWriter.cs
@@ -0,0 +1,237 @@
+using System.Globalization;
+using System.Text;
+using System.Threading.Channels;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>Options for <see cref="EventLogWriter"/> (StructuredLog.* in server.json).</summary>
+public sealed class EventLogOptions
+{
+    public string Directory { get; set; } = "./Logs/events";
+    public int RetentionDays { get; set; } = 14;
+    public long MaxTotalBytes { get; set; } = 200L * 1024 * 1024;
+    /// <summary>Events waiting for the disk. When full, new events are dropped (counted) instead of blocking.</summary>
+    public int QueueCapacity { get; set; } = 20000;
+}
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Background JSON-lines writer. <see cref="Emit"/> only serializes and enqueues (no disk, no
+/// lock held while writing); one background task appends to <c>events-YYYYMMDD.jsonl</c> (local date), flushing when
+/// the queue runs empty. Rotation: a new file per day, and a new part (<c>-002</c>, ...) when one file passes a quarter
+/// of the size cap. Retention: files older than RetentionDays are deleted, then the oldest files until the folder is
+/// under MaxTotalBytes. A full queue drops events (a <c>log_dropped</c> line reports how many) rather than slowing a
+/// request.
+/// </summary>
+public sealed class EventLogWriter : IEventSink, IDisposable
+{
+    private readonly EventLogOptions _opt;
+    private readonly Func<DateTimeOffset> _now;
+    private readonly Channel<EventRecord> _queue;   // serialized on the writer thread, not the request thread
+    private readonly Task _pump;
+    private long _dropped, _droppedReported, _written, _bytes, _accepted, _processed;
+    private StreamWriter? _file;
+    private string? _fileDate;
+    private int _part;
+    private long _fileBytes;
+    private long _sinceCleanup;
+    private volatile bool _disposed;
+
+    public EventLogWriter(EventLogOptions options, Func<DateTimeOffset>? now = null)
+    {
+        _opt = options;
+        _now = now ?? (() => DateTimeOffset.Now);
+        System.IO.Directory.CreateDirectory(_opt.Directory);
+        LoadOrCreateSalt();
+        _queue = Channel.CreateBounded<EventRecord>(new BoundedChannelOptions(Math.Max(100, _opt.QueueCapacity))
+        {
+            SingleReader = true, SingleWriter = false, FullMode = BoundedChannelFullMode.Wait,   // only TryWrite is used: false when full (DropWrite would hide drops)
+        });
+        Cleanup();
+        _pump = Task.Run(PumpAsync);
+    }
+
+    public bool Enabled => !_disposed;
+    public long Written => Interlocked.Read(ref _written);
+    public long Dropped => Interlocked.Read(ref _dropped);
+    /// <summary>Events taken into the queue (each one is written unless the disk fails).</summary>
+    public long Accepted => Interlocked.Read(ref _accepted);
+    public long BytesWritten => Interlocked.Read(ref _bytes);
+    public string Directory => _opt.Directory;
+
+    public void Emit(EventRecord e)
+    {
+        if (_disposed) return;
+        // the caller only stamps the time and enqueues; masking + JSON happen on the writer thread
+        e.At ??= _now();
+        if (_queue.Writer.TryWrite(e)) Interlocked.Increment(ref _accepted);
+        else Interlocked.Increment(ref _dropped);
+    }
+
+    /// <summary>Waits until everything queued so far is on disk (tests, shutdown).</summary>
+    public async Task FlushAsync(TimeSpan? timeout = null)
+    {
+        var until = DateTime.UtcNow + (timeout ?? TimeSpan.FromSeconds(10));
+        while (Interlocked.Read(ref _processed) < Interlocked.Read(ref _accepted) && DateTime.UtcNow < until) await Task.Delay(5);
+        lock (_fileGate) { ReportDrops(); _file?.Flush(); }
+    }
+
+    private readonly object _fileGate = new();
+
+    private async Task PumpAsync()
+    {
+        var reader = _queue.Reader;
+        try
+        {
+            while (await reader.WaitToReadAsync().ConfigureAwait(false))
+            {
+                lock (_fileGate)
+                {
+                    while (reader.TryRead(out var e))
+                    {
+                        string? line = null;
+                        try { line = EventJson.Serialize(e, e.At ?? _now()); }
+                        catch (Exception) { Interlocked.Increment(ref _dropped); }
+                        if (line != null) WriteLine(line);
+                        Interlocked.Increment(ref _processed);
+                    }
+                    ReportDrops();
+                    _file?.Flush();
+                }
+            }
+        }
+        catch (Exception) { /* logging must never take the server down */ }
+        finally
+        {
+            lock (_fileGate) { _file?.Flush(); _file?.Dispose(); _file = null; }
+        }
+    }
+
+    private void ReportDrops()
+    {
+        var d = Interlocked.Read(ref _dropped);
+        if (d == _droppedReported) return;
+        var e = new EventRecord("log", EventNames.LogDropped).With("count", d - _droppedReported).With("total", d);
+        _droppedReported = d;
+        WriteLine(EventJson.Serialize(e, _now()));
+    }
+
+    private void WriteLine(string line)
+    {
+        try
+        {
+            var now = _now();
+            var date = now.ToString("yyyyMMdd", CultureInfo.InvariantCulture);
+            var partCap = Math.Max(64 * 1024, _opt.MaxTotalBytes / 4);
+            if (_file == null || date != _fileDate || _fileBytes >= partCap)
+                Open(date, rollPart: _file != null && date == _fileDate);
+            var n = Encoding.UTF8.GetByteCount(line) + 1;
+            _file!.Write(line);
+            _file.Write('\n');
+            _fileBytes += n;
+            _sinceCleanup += n;
+            Interlocked.Add(ref _bytes, n);
+            Interlocked.Increment(ref _written);
+            if (_sinceCleanup > Math.Max(1024 * 1024, _opt.MaxTotalBytes / 20))
+            {
+                _sinceCleanup = 0;
+                Cleanup();
+            }
+        }
+        catch (Exception)
+        {
+            Interlocked.Increment(ref _dropped);
+        }
+    }
+
+    private void Open(string date, bool rollPart)
+    {
+        _file?.Flush();
+        _file?.Dispose();
+        _part = rollPart ? _part + 1 : 1;
+        string path;
+        while (true)
+        {
+            path = PathFor(date, _part);
+            if (rollPart || !File.Exists(path) || new FileInfo(path).Length < Math.Max(64 * 1024, _opt.MaxTotalBytes / 4)) break;
+            _part++;
+        }
+        var fs = new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite | FileShare.Delete, 64 * 1024);
+        _file = new StreamWriter(fs, new UTF8Encoding(false), 64 * 1024) { AutoFlush = false };
+        _fileDate = date;
+        _fileBytes = fs.Length;
+        Cleanup();
+    }
+
+    private string PathFor(string date, int part) =>
+        Path.Combine(_opt.Directory, part <= 1 ? $"events-{date}.jsonl" : $"events-{date}-{part:000}.jsonl");
+
+    /// <summary>Deletes files past retention, then the oldest until the folder is under the size cap.</summary>
+    public void Cleanup()
+    {
+        try
+        {
+            var files = new DirectoryInfo(_opt.Directory).GetFiles("events-*.jsonl")
+                .OrderBy(f => f.Name, StringComparer.Ordinal).ToList();
+            var current = _file?.BaseStream is FileStream fs ? fs.Name : null;
+            var cutoff = _now().Date.AddDays(-Math.Max(1, _opt.RetentionDays) + 1);
+            foreach (var f in files.ToList())
+            {
+                if (DateOf(f.Name) is DateTime d && d < cutoff && !SamePath(f.FullName, current))
+                {
+                    TryDelete(f);
+                    files.Remove(f);
+                }
+            }
+            long total = files.Sum(f => f.Length);
+            foreach (var f in files.ToList())
+            {
+                if (total <= _opt.MaxTotalBytes) break;
+                if (SamePath(f.FullName, current)) continue;
+                total -= f.Length;
+                TryDelete(f);
+            }
+        }
+        catch (Exception) { }
+    }
+
+    private static bool SamePath(string a, string? b) => b != null && string.Equals(Path.GetFullPath(a), Path.GetFullPath(b), StringComparison.OrdinalIgnoreCase);
+
+    private static void TryDelete(FileInfo f)
+    {
+        try { f.Delete(); } catch (Exception) { }
+    }
+
+    public static DateTime? DateOf(string fileName)
+    {
+        // events-20261117.jsonl / events-20261117-002.jsonl
+        if (fileName.Length < 15 || !fileName.StartsWith("events-", StringComparison.Ordinal)) return null;
+        return DateTime.TryParseExact(fileName.Substring(7, 8), "yyyyMMdd", CultureInfo.InvariantCulture,
+            DateTimeStyles.None, out var d) ? d : null;
+    }
+
+    private void LoadOrCreateSalt()
+    {
+        try
+        {
+            var path = Path.Combine(_opt.Directory, ".salt");
+            byte[] salt;
+            if (File.Exists(path) && (salt = File.ReadAllBytes(path)).Length >= 16)
+            {
+                EventIds.SetIpSalt(salt);
+                return;
+            }
+            salt = System.Security.Cryptography.RandomNumberGenerator.GetBytes(32);
+            File.WriteAllBytes(path, salt);
+            EventIds.SetIpSalt(salt);
+        }
+        catch (Exception) { /* keep the per-process random salt */ }
+    }
+
+    public void Dispose()
+    {
+        if (_disposed) return;
+        _disposed = true;
+        _queue.Writer.TryComplete();
+        try { _pump.Wait(TimeSpan.FromSeconds(5)); } catch (Exception) { }
+    }
+}
