+namespace ServerInfinite.Lobbies;
+
+/// <summary>Gap thresholds (StructuredLog.Gaps.*). 0 = that check is off.</summary>
+public sealed class GapThresholds
+{
+    /// <summary>Matchmaker: room made -> a cabinet has not fetched it (polls every ~3 s).</summary>
+    public double RoomFetchSeconds { get; set; } = 10;
+    /// <summary>Room fetched (match_found) -> peer_connect. Seen 19-23 s in the 2026-11-14/15 real-cab logs.</summary>
+    public double ConnectSeconds { get; set; } = 40;
+    /// <summary>peer_connect -> battle_start (the loading screen). Seen 14-19 s (2 humans) and 30 s (4 humans).</summary>
+    public double LoadingSeconds { get; set; } = 20;
+    /// <summary>battle_start -> result_saved. Battles take ~2-4 min.</summary>
+    public double BattleSeconds { get; set; } = 480;
+    /// <summary>result_saved -> the cabinet's next request (results screen). Normal 24-35 s.</summary>
+    public double ResultsSeconds { get; set; } = 60;
+}
