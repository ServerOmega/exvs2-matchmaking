+
+    // ---------------------------------------------------------------- card server events
+
+    [Fact]
+    public void CardServerEmitsStagesWithTheSharedMatchIdAndNoSecrets()
+    {
+        var sink = new ListEventSink();
+        var clock = new Clock();
