+    [Fact]
+    public void BattleSaveFailureRollsBackAndKeepsBadgeAndClassOnly()
+    {
+        var card = NewCard();
+        using (var db = NewContext())
+        {
+            // a damaged card without its statistics row: SavePlayerStatisticCommand throws
+            db.PlayerBattleStatisticDbSet.RemoveRange(db.PlayerBattleStatisticDbSet.Where(x => x.CardId == card.Id));
+            db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        Send(SaveRequest(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true), Config());
+
+        using var check = NewContext();
+        Assert.Equal(0, check.BattleHistoryDbSet.Count(x => x.CardId == card.Id));
+        Assert.Equal(StartGp, check.CardProfiles.Single(x => x.Id == card.Id).Gp); // GP rolled back
+        var wl = check.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        Assert.Equal(0u, wl.TotalWin);
+        Assert.Equal(1u, wl.ClassSoloWin); // the class part (old behaviour) is still stored, once
+        Assert.Equal(1520f, check.SoloClassMatchRecordDbSet.Single(x => x.CardId == card.Id).Rate);
+        Assert.Equal(1u, check.SoloClassMatchRecordDbSet.Single(x => x.CardId == card.Id).WeeklyTotalBattleCount);
