+    }
+
+    [Fact]
+    public void MixMatchCountsAsFree()
+    {
+        var card = NewCard();
+        Send(SaveRequest(card, OnlineMatchingMode.OmmFree, shuffle: true, win: true), Config());
+        Send(SaveRequest(card, OnlineMatchingMode.OmmFree, shuffle: false, win: false, playedAt: 1794730400, humanPartner: false), Config());
+
+        using var db = NewContext();
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        Assert.Equal(1u, wl.FreeWin);
+        Assert.Equal(1u, wl.FreeLose);
+        Assert.Equal(1u, wl.TotalWin);
