+using ServerInfinite.Context.Battle;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Enum;
+
+namespace ServerInfinite.Commands.SaveBattle.PvP;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: win/loss record for online battles (SaveVsmOnResult).
+/// Unlike <see cref="SaveWinLossRecordCommand"/> (offline: skips Free), this counts every online battle in
+/// TotalWin/TotalLose and in its mode's counter: Mix (Free) -> FreeWin/FreeLose, Fes -> FesWin/FesLose,
+/// Class -> ClassSoloWin/ClassTeamWin... Other online modes only count in the totals.
+/// Class win/loss is skipped when <paramref name="classAlreadyCounted"/> is set: the class-match persistence
+/// (OnlineMatching.PersistClassMatchResult) has already counted it, so it is never counted twice.
+/// </summary>
+public class SaveOnlineWinLossRecordCommand : ISaveBattleDataCommand
+{
+    private readonly ServerDbContext _context;
+    private readonly bool _classAlreadyCounted;
+
+    public SaveOnlineWinLossRecordCommand(ServerDbContext context, bool classAlreadyCounted)
+    {
+        _context = context;
+        _classAlreadyCounted = classAlreadyCounted;
+    }
+
+    public void Save(CardProfile cardProfile, BattleResultContext battleResultContext)
+    {
+        var winLossRecord = _context.WinLossRecordDbSet.Local.FirstOrDefault(x => x.CardId == cardProfile.Id)
+                            ?? _context.WinLossRecordDbSet.FirstOrDefault(x => x.CardProfile == cardProfile);
+        if (winLossRecord is null)
+        {
+            return;
+        }
+
+        var mode = battleResultContext.CommonDomain.BattleMode;
+        var win = battleResultContext.CommonDomain.IsWin ? 1u : 0u;
+        var lose = 1u - win;
+
+        winLossRecord.TotalWin += win;
+        winLossRecord.TotalLose += lose;
+
+        if (mode == BattleModeConstant.FreeSolo || mode == BattleModeConstant.FreeTeam)
+        {
+            winLossRecord.FreeWin += win;
+            winLossRecord.FreeLose += lose;
+        }
+        else if (mode == BattleModeConstant.FesSolo || mode == BattleModeConstant.FesTeam)
+        {
+            winLossRecord.FesWin += win;
+            winLossRecord.FesLose += lose;
+        }
+        else if (mode == BattleModeConstant.ClassMatchSolo && !_classAlreadyCounted)
+        {
+            winLossRecord.ClassSoloWin += win;
+            winLossRecord.ClassSoloLose += lose;
+        }
+        else if (mode == BattleModeConstant.ClassMatchTeam && !_classAlreadyCounted)
+        {
+            winLossRecord.ClassTeamWin += win;
+            winLossRecord.ClassTeamLose += lose;
+        }
+    }
+}
