+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Handlers.Game.Online;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Enum;
+using Xunit;
+
+[assembly: CollectionBehavior(DisableTestParallelization = true)]
+
+namespace Server.Tests;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: SaveVsmOnResult (online battle result) is stored like an offline SaveVsmResult:
+/// battle history, win/loss, player and per-suit statistics, GP/level; once per battle; behind config flags.
+/// </summary>
+public sealed class OnlineResultSaveTests : IDisposable
+{
+    private static readonly uint StartGp = new CardProfile().Gp;
+    private static readonly float StartRate = new ServerInfinite.Models.Cards.Battle.SoloClassMatchRecord().Rate;
+    private readonly SqliteConnection _connection;
+    private readonly ServerDbContext _db;
+
+    public OnlineResultSaveTests()
+    {
+        OnlineBattleResults.ResetForTests();
+        _connection = new SqliteConnection("DataSource=:memory:");
+        _connection.Open();
+        _db = NewContext();
+        _db.Database.Migrate();
+    }
+
+    public void Dispose()
+    {
+        _db.Dispose();
+        _connection.Dispose();
+    }
+
+    private ServerDbContext NewContext() =>
+        new(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_connection).Options);
+
+    private CardProfile NewCard(string session = "sess-a", string name = "PILOT-A")
+    {
+        var card = new CardProfile
+        {
+            AccessCode = "test-" + session,
+            ChipId = "test-" + session,
+            SessionId = session,
+            UserName = name,
+            IsNewCard = false,
+            DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+        };
+        _db.CardProfiles.Add(card);
+        // like PreLoadCard: SaveChangesAsync (the sync SaveChanges override stamps BaseEntity times and does not
+        // accept the non-BaseEntity rows a new card creates)
+        _db.SaveChangesAsync().GetAwaiter().GetResult();
+        return card;
+    }
+
+    private static CardServerConfig Config(bool online = true, bool progress = true, bool classPersist = true)
+    {
+        var c = new CardServerConfig { LogNetworkReport = false };
+        c.OnlineMatching.PersistOnlineBattleResults = online;
+        c.OnlineMatching.PersistOnlineProgress = progress;
+        c.OnlineMatching.PersistClassMatchResult = classPersist;
+        return c;
+    }
+
+    private static Request SaveRequest(CardProfile card, OnlineMatchingMode mode, bool shuffle, bool win,
+        uint roomId = 7, ulong playedAt = 1794730125, uint suit = 313, bool humanPartner = true, bool withClass = false)
+    {
+        var result = new Request.SaveVsmOnResult.PlayResultGroup
+        {
+            PlayedAt = playedAt,
+            WinFlag = win,
+            VsElapsedTime = 108,
+            StageId = 5,
+            MstMobileSuitId = suit,
+            SkillPointMobileSuitId = suit,
+            ResultScore = 1200,
+            ResultOrder = 1,
+            LevelId = 3,
+            PlayerLevelId = 3,
+            LevelExp = 10,
+            Gp = 150,
+            GivenDamage = 900,
+            TakenDamage = 1540,
+            Burst = 1,
+            BurstType = 1,
+            BurstGivenDamage = 200,
+            ComboGivenDamage = 300,
+            ConsecutiveWin = win ? 2u : 0u,
+            RoomId = roomId,
+            OnlineMatchingMode = mode,
+            BadgeId = 1,
+        };
+        if (humanPartner)
+            result.Partner = new AdversaryManGroup { PilotId = 2_000_123, CpuFlag = 0, MstMobileSuitId = 401, PlayerLevelId = 5 };
+        else
+            result.Partner = new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 402 };
+        result.Foes.Add(new AdversaryManGroup { PilotId = 3_000_456, CpuFlag = 0, MstMobileSuitId = 332, DownNum = 1 });
+        result.Foes.Add(new AdversaryManGroup { PilotId = 0, CpuFlag = 1, MstMobileSuitId = 333, DownNum = 1 });
+        result.PlayerBattleLogs.Add(new WarSituationGroup { Frame = 3679, Status = 1 });
+        if (withClass || mode == OnlineMatchingMode.OmmClass)
+        {
+            result.class_match_result = new Request.SaveVsmOnResult.PlayResultGroup.ClassMatchResult
+            {
+                ClassIdSolo = 2, ClassIdTeam = 2, BeforeRate = 1500f, AfterRate = win ? 1520f : 1485f,
+                ObtainedRate = win ? 20f : -15f, GradeId = 3,
+            };
+        }
+        return new Request
+        {
+            Type = MethodType.MthdSaveVsmOnResult,
+            RequestId = "test",
+            save_vsm_on_result = new Request.SaveVsmOnResult
+            {
+                PilotId = (uint)card.Id,
+                SessionId = card.SessionId,
+                ShuffleFlag = shuffle,
+                Result = result,
+            },
+        };
+    }
+
+    private void Send(Request request, CardServerConfig config)
+    {
+        // a fresh DbContext per request, like the per-request scope in the server
+        using var db = NewContext();
+        var handler = new SaveVsmOnResultCommandHandler(NullLogger<SaveVsmOnResultCommandHandler>.Instance, db,
+            Options.Create(config));
+        var response = handler.Handle(new SaveVsmOnResultCommand(request), CancellationToken.None).GetAwaiter().GetResult();
+        Assert.Equal(Error.Success, response.Error);
+        Assert.NotNull(response.save_vsm_on_result);
+    }
+
+    private (int history, uint totalWin, uint totalLose) Totals(CardProfile card)
+    {
+        using var db = NewContext();
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        return (db.BattleHistoryDbSet.Count(x => x.CardId == card.Id), wl.TotalWin, wl.TotalLose);
+    }
+
+    [Fact]
+    public void BattleModeMapping()
+    {
+        Assert.Equal(BattleModeConstant.ClassMatchSolo, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmClass, true));
+        Assert.Equal(BattleModeConstant.ClassMatchTeam, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmClass, false));
+        Assert.Equal(BattleModeConstant.FreeSolo, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmFree, true));
+        Assert.Equal(BattleModeConstant.FreeTeam, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmFree, false));
+        Assert.Equal(BattleModeConstant.FesSolo, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmFes, true));
+        Assert.Equal(BattleModeConstant.FesTeam, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmFes, false));
+        Assert.Equal(BattleModeConstant.OnlineOtherSolo, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmPrivate, true));
+        Assert.Equal(BattleModeConstant.OnlineOtherTeam, OnlineBattleResults.BattleModeFor(OnlineMatchingMode.OmmLocal, false));
+    }
+
+    [Fact]
+    public void ClassSoloWinIsStoredOnceWithRateAndHistory()
+    {
+        var card = NewCard();
+        Send(SaveRequest(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true), Config());
+
+        using var db = NewContext();
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
+        Assert.Equal(1u, wl.TotalWin);
+        Assert.Equal(0u, wl.TotalLose);
+        Assert.Equal(1u, wl.ClassSoloWin); // counted once (class persistence), not again by the online W/L command
+        Assert.Equal(0u, wl.ClassTeamWin);
+        var solo = db.SoloClassMatchRecordDbSet.Single(x => x.CardId == card.Id);
+        Assert.Equal(1520f, solo.Rate);
+        Assert.Equal(2u, solo.ClassId);
+        Assert.Equal(3u, solo.Grade);
+        Assert.Equal(1u, solo.WeeklyTotalBattleCount);
+
+        var h = db.BattleHistoryDbSet.Include(x => x.BattleSelf).Include(x => x.Ally).Include(x => x.Targets)
+            .Single(x => x.CardId == card.Id);
+        Assert.Equal(BattleModeConstant.ClassMatchSolo, h.BattleMode);
+        Assert.True(h.IsWin);
+        Assert.Equal(1794730125ul, h.PlayedAt);
+        Assert.Equal(108u, h.ElapsedSeconds);
+        Assert.Equal(900u, h.GivenDamage);
+        Assert.Equal(1540u, h.TakenDamage);
+        Assert.Equal(313u, h.BattleSelf.MobileSuitId);
+        Assert.Equal("PILOT-A", h.BattleSelf.PlayerName);
+        Assert.NotNull(h.Ally);
+        Assert.Equal(401u, h.Ally!.MobileSuitId);
+        Assert.Single(h.Targets); // the CPU foe is not listed, as offline
+
+        var suit = db.MobileSuitPvPStatisticDbSet.Single(x => x.CardId == card.Id && x.MstMobileSuitId == 313);
+        Assert.Equal(1u, suit.TotalBattleCount);
+        Assert.Equal(1u, suit.TotalWinCount);
+        Assert.Equal(900u, suit.TotalGivenDamage);
+        var stats = db.PlayerBattleStatisticDbSet.Single(x => x.CardId == card.Id);
+        Assert.Equal(900u, stats.TotalGivenDamage);
+        Assert.Equal(1u, stats.TotalEnemyDefeatedCount);
+
+        var profile = db.CardProfiles.Single(x => x.Id == card.Id);
+        Assert.Equal(StartGp + 150u, profile.Gp);
+        Assert.Equal(10u, db.PlayerLevelDbSet.Single(x => x.CardId == card.Id).PlayerExp);
+        Assert.Equal(1u, db.MobileSuitUsageDbSet.Single(x => x.CardId == card.Id && x.MstMobileSuitId == 313).MsUsedNum);
+    }
+
+    [Fact]
+    public void ClassTeamLossGoesToTheTeamRecord()
+    {
