+    [Fact]
+    public void FlagOffKeepsThePreviousBehaviour()
+    {
+        var card = NewCard();
+        var config = Config(online: false);
+        Send(SaveRequest(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true), config);
+        Send(SaveRequest(card, OnlineMatchingMode.OmmFree, shuffle: true, win: true, playedAt: 1794730400), config);
+
+        using var db = NewContext();
+        Assert.Equal(0, db.BattleHistoryDbSet.Count(x => x.CardId == card.Id));
+        var wl = db.WinLossRecordDbSet.Single(x => x.CardId == card.Id);
