+        Assert.Equal(BattleModeConstant.ClassMatchTeam, db.BattleHistoryDbSet.Single(x => x.CardId == card.Id).BattleMode);
+    }
+
+    [Fact]
+    public void ClassWinLossIsCountedByTheOnlineSaveWhenClassPersistenceIsOff()
+    {
+        var card = NewCard();
+        Send(SaveRequest(card, OnlineMatchingMode.OmmClass, shuffle: true, win: true), Config(classPersist: false));
+
+        using var db = NewContext();
