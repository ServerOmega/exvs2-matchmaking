+using System.Collections.Concurrent;
+using nue.protocol.exvs;
+using ServerInfinite.Context.Battle;
+using ServerInfinite.Mapper.Context;
+using WebUIInfinite.Shared.Dto.Enum;
+
+namespace ServerInfinite.Handlers.Game.Online;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-16: helpers for saving online battle results (SaveVsmOnResult) through the same
+/// save commands as offline results: battle-mode mapping, context building and retry de-duplication.
+/// </summary>
+public static class OnlineBattleResults
+{
+    /// <summary>History / W-L battle mode for an online result. shuffle_flag = solo queue, otherwise team (pair).</summary>
+    public static string BattleModeFor(OnlineMatchingMode mode, bool shuffle) => mode switch
+    {
+        OnlineMatchingMode.OmmClass => shuffle ? BattleModeConstant.ClassMatchSolo : BattleModeConstant.ClassMatchTeam,
+        OnlineMatchingMode.OmmFree => shuffle ? BattleModeConstant.FreeSolo : BattleModeConstant.FreeTeam,
+        OnlineMatchingMode.OmmFes => shuffle ? BattleModeConstant.FesSolo : BattleModeConstant.FesTeam,
+        _ => shuffle ? BattleModeConstant.OnlineOtherSolo : BattleModeConstant.OnlineOtherTeam,
+    };
+
+    /// <summary>Builds the battle context exactly like the offline SaveVsmResult handler does.</summary>
+    public static BattleResultContext ToContext(Request.SaveVsmOnResult save)
+    {
+        var result = save.Result;
+        var context = result.ToBattleResultContext();
+        context.CommonDomain.BattleMode = BattleModeFor(result.OnlineMatchingMode, save.ShuffleFlag);
+        context.OnlineBattleDomain.OnlineMatchingMode = result.OnlineMatchingMode;
+        context.OnlineBattleDomain.IsShuffle = save.ShuffleFlag;
+
+        var ally = result.Partner;
+        if (ally is not null && ally.CpuFlag == 0)
+        {
+            context.BattleHistoryDomain.Ally = ally;
+        }
+
+        context.BattleHistoryDomain.PlayerActions = result.PlayerBattleLogs;
+        context.BattleHistoryDomain.FilteredTargets = result.Foes.Where(foe => foe.CpuFlag == 0).ToList();
+        foreach (var foe in context.BattleHistoryDomain.FilteredTargets)
+        {
+            context.BattleStatisticDomain.TotalEnemyDefeatedCount += foe.DownNum;
+        }
+        return context;
+    }
+
+    /// <summary>Process-wide gate: a retry that arrives while the first save is still running (for example after
+    /// the post-match watchdog answered early) waits and is then recognised as a duplicate.</summary>
+    public static readonly object Gate = new();
+
+    private static readonly ConcurrentDictionary<string, DateTime> Recent = new();
+    private static readonly TimeSpan RecentTtl = TimeSpan.FromHours(2);
+    private const int RecentMax = 20000;
+
+    /// <summary>Identity of one battle result of one card. room_id + played_at + suit pin down one battle.</summary>
+    public static string Key(int cardId, Request.SaveVsmOnResult.PlayResultGroup r) =>
+        $"{cardId}|{r.RoomId}|{r.PlayedAt}|{r.MstMobileSuitId}|{(int)r.OnlineMatchingMode}";
+
+    public static bool SeenRecently(string key, DateTime nowUtc) =>
+        Recent.TryGetValue(key, out var until) && until > nowUtc;
+
+    public static void Remember(string key, DateTime nowUtc)
+    {
+        if (Recent.Count >= RecentMax)
+        {
+            foreach (var kv in Recent)
+            {
+                if (kv.Value <= nowUtc) Recent.TryRemove(kv.Key, out _);
+            }
+            if (Recent.Count >= RecentMax) Recent.Clear();
+        }
+        Recent[key] = nowUtc + RecentTtl;
+    }
+
+    /// <summary>Tests only.</summary>
+    public static void ResetForTests() => Recent.Clear();
+}
