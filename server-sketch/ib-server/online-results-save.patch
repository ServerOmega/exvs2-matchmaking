+        var second = db.BattleHistoryDbSet.Include(x => x.Ally).OrderBy(x => x.Id).Last(x => x.CardId == card.Id);
+        Assert.Null(second.Ally); // CPU partner is not stored as an ally
+        Assert.Equal(StartRate, db.SoloClassMatchRecordDbSet.Single(x => x.CardId == card.Id).Rate); // no class data
+        Assert.Equal(2u, db.MobileSuitPvPStatisticDbSet.Single(x => x.CardId == card.Id && x.MstMobileSuitId == 313).TotalBattleCount);
