+    /// <summary>Previous behaviour (and the fallback): badge exp / badge, then the class-match rate / class / grade.
+    /// Returns true when the class persistence counted this battle in the class win/loss record.</summary>
+    private bool SaveBadgeAndClass(CardProfile cardProfile, Request.SaveVsmOnResult save)
+    {
+        // exp delta first, then the reported badge (a badge change may reset exp, see SaveBadgeCommand).
+        SaveBadgeCommand badge = new SaveBadgeCommand(_context, _config, _logger);
+        badge.Save(cardProfile, save.Result.ObtainedBadgePoint);
+        badge.ApplyReportedBadge(cardProfile, save.Result.BadgeId, "SaveVsmOnResult");
+        return _config.OnlineMatching.PersistClassMatchResult && SaveClassMatchResult(cardProfile, save);
+    }
+
+    /// <summary>
+    /// exvs2-lobbies 2026-11-16 (OnlineMatching.PersistOnlineBattleResults): store the online result like the offline
+    /// SaveVsmResult does: battle history, win/loss, player statistics, per-suit statistics, burst-type statistics,
+    /// challenge counters, and (PersistOnlineProgress) GP / level / navigator / mastery / team points.
+    /// A retry of a result already stored (same card, room_id, played_at, suit, mode) changes nothing.
+    /// Runs in one transaction; if the battle part fails, only the badge + class part is kept (old behaviour).
+    /// </summary>
+    private void SaveFullResult(CardProfile cardProfile, Request.SaveVsmOnResult save)
+    {
+        var result = save.Result;
+        var now = DateTime.UtcNow;
+        var key = OnlineBattleResults.Key(cardProfile.Id, result);
+        var mode = OnlineBattleResults.BattleModeFor(result.OnlineMatchingMode, save.ShuffleFlag);
+        if (IsDuplicate(cardProfile, result, key, mode, now))
+        {
+            _logger.LogInformation("SaveVsmOnResult duplicate ignored CardId={CardId} room={RoomId} played_at={PlayedAt} mode={Mode}",
+                cardProfile.Id, result.RoomId, result.PlayedAt, mode);
+            return;
+        }
+
+        var cardId = cardProfile.Id;
+        using (var tx = _context.Database.BeginTransaction())
+        {
+            try
+            {
+                var classCounted = SaveBadgeAndClass(cardProfile, save);
+                SaveBattle(cardProfile, save, classCounted);
+                _context.SaveChanges();
+                tx.Commit();
+                OnlineBattleResults.Remember(key, now);
+                _logger.LogInformation("SaveVsmOnResult stored CardId={CardId} mode={Mode} room={RoomId} win={Win} suit={Suit} progress={Progress}",
+                    cardId, mode, result.RoomId, result.WinFlag, result.MstMobileSuitId, _config.OnlineMatching.PersistOnlineProgress);
+                return;
+            }
+            catch (Exception e)
+            {
+                tx.Rollback();
+                _context.ChangeTracker.Clear();
+                _logger.LogWarning("SaveVsmOnResult battle save failed for CardId={CardId} mode={Mode} ({Error}); keeping badge + class only",
+                    cardId, mode, e.GetType().Name + ": " + e.Message);
+            }
+        }
+
+        var reloaded = _context.CardProfiles.FirstOrDefault(x => x.Id == cardId);
+        if (reloaded != null)
+        {
+            SaveBadgeAndClass(reloaded, save);
+            _context.SaveChanges();
+        }
+    }
+
+    private bool IsDuplicate(CardProfile cardProfile, Request.SaveVsmOnResult.PlayResultGroup result, string key, string mode, DateTime now)
+    {
+        if (OnlineBattleResults.SeenRecently(key, now))
+        {
+            return true;
+        }
+        if (result.PlayedAt == 0)
+        {
+            return false; // no timestamp: only the in-memory key can tell a retry from a new battle
+        }
+        var playedAt = result.PlayedAt;
+        var suit = result.MstMobileSuitId;
+        return _context.BattleHistoryDbSet.Any(x => x.CardId == cardProfile.Id && x.PlayedAt == playedAt
+                                                    && x.BattleMode == mode && x.BattleSelf.MobileSuitId == suit);
+    }
+
+    private void SaveBattle(CardProfile cardProfile, Request.SaveVsmOnResult save, bool classCounted)
+    {
+        var battleResultContext = OnlineBattleResults.ToContext(save);
+        var commands = new List<ISaveBattleDataCommand>();
+        if (_config.OnlineMatching.PersistOnlineProgress)
+        {
+            commands.Add(new SaveGpCommand(_context));
+            commands.Add(new SavePlayerLevelCommand(_context));
+            commands.Add(new SaveNaviCommand(_context));
+            commands.Add(new SaveMobileSuitMasteryCommand(_context));
+            commands.Add(new SaveTeamCommand(_context));
+        }
+        commands.Add(new SaveOnlineWinLossRecordCommand(_context, classCounted));
+        commands.Add(new SavePlayerStatisticCommand(_context));
+        commands.Add(new SaveChallengeMissionDataCommand(_context));
+        commands.Add(new SaveMobileSuitTrackerStatCommand(_context));
+        commands.Add(new SaveBurstTypeCommand(_context));
+        commands.Add(new SaveBattleHistoryCommand(_context));
+        commands.Add(new RemovePreBattleHistoryCommand(_context));
+        commands.ForEach(command => command.Save(cardProfile, battleResultContext));
+    }
+
     /// <summary>
