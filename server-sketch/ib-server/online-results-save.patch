+        Assert.Equal(0u, wl.TotalWin);
+        Assert.Equal(0u, wl.FreeWin);
+        Assert.Equal(1520f, db.SoloClassMatchRecordDbSet.Single(x => x.CardId == card.Id).Rate);
+        Assert.Equal(StartGp, db.CardProfiles.Single(x => x.Id == card.Id).Gp);
