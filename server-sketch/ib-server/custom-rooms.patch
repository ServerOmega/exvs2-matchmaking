@@ -0,0 +1,129 @@
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Handlers.UI.CustomRooms;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Cards.Battle;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Request;
+using Xunit;
+
+namespace Server.Tests;
+
+/// <summary>exvs2-lobbies 2026-11-17: Rooms page backend (card auth, HH:mm times, class range on join, close).</summary>
+public sealed class CustomRoomsUiTests : IDisposable
+{
+    private static readonly DateTime T0 = new(2026, 11, 17, 17, 0, 0, DateTimeKind.Utc);
+    private readonly SqliteConnection _connection;
+    private readonly ServerDbContext _db;
+    private readonly CustomRoomStore _store;
+    private readonly CustomRoomsUiService _svc;
+    private DateTime _now = T0;
+
+    public CustomRoomsUiTests()
+    {
+        _connection = new SqliteConnection("DataSource=:memory:");
+        _connection.Open();
+        _db = new ServerDbContext(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_connection).Options);
+        _db.Database.Migrate();
+        _store = new CustomRoomStore { UtcNow = () => _now, Zone = TimeZoneInfo.Utc, DayResetHour = 5 };
+        var cfg = new CardServerConfig();
+        cfg.CustomRooms.Enabled = true;
+        _svc = new CustomRoomsUiService(_db, new InProcessCustomRoomClient(_store), _store, Options.Create(cfg),
+            NullLogger<CustomRoomsUiService>.Instance);
+    }
+
+    public void Dispose()
+    {
+        _db.Dispose();
+        _connection.Dispose();
+    }
+
+    private (string ac, string chip, uint pilot) NewCard(string key, string name, uint soloClass = 0)
+    {
+        var card = new CardProfile
+        {
+            AccessCode = "test-" + key, ChipId = "test-" + key, SessionId = key, UserName = name, IsNewCard = false,
+            DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+        };
+        _db.CardProfiles.Add(card);
+        _db.SaveChangesAsync().GetAwaiter().GetResult();
+        if (soloClass != 0)
+        {
+            _db.SoloClassMatchRecordDbSet.Add(new SoloClassMatchRecord { CardId = card.Id, ClassId = soloClass });
+            _db.SaveChangesAsync().GetAwaiter().GetResult();
+        }
+        return (card.AccessCode, card.ChipId, PilotId.Wire(card.Id));
+    }
+
+    [Fact]
+    public async Task BadCard_IsRejected()
+    {
+        var r = await _svc.List(new RoomsListRequest { AccessCode = "x", ChipId = "y" }, default);
+        Assert.False(r.Success);
+        Assert.False((await _svc.Create(new RoomCreateRequest { AccessCode = "x", ChipId = "y" }, default)).Success);
+    }
+
+    [Fact]
+    public async Task Create_List_Join_Leave_Close()
+    {
+        var (ac, chip, owner) = NewCard("a", "OWNER");
+        var (ac2, chip2, guest) = NewCard("b", "GUEST");
+        var c = await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, Name = "Night", MatchingType = 2, Start = "18:00", End = "21:30" }, default);
+        Assert.True(c.Success, c.Message);
+        Assert.Equal("18:00", c.Room!.Start);
+        Assert.Equal("21:30", c.Room.End);
+        Assert.Equal(0u, c.Room.RuleType); // web UI default: unit rule off
+        var code = c.Room.Code;
+
+        var j = await _svc.Join(new RoomCodeRequest { AccessCode = ac2, ChipId = chip2, Code = code.ToLowerInvariant() }, default);
+        Assert.True(j.Success, j.Message);
+        var list = await _svc.List(new RoomsListRequest { AccessCode = ac, ChipId = chip }, default);
+        Assert.True(list.Success);
+        var item = Assert.Single(list.Rooms);
+        Assert.True(item.IsOwner);
+        Assert.False(item.OpenNow); // 17:00 now, opens 18:00
+        Assert.Equal(new[] { "OWNER", "GUEST" }, item.Members.Select(m => m.Name));
+        Assert.Equal("05:00", list.DayEnd);
+
+        Assert.Equal("NotOwner", (await _svc.Close(new RoomCodeRequest { AccessCode = ac2, ChipId = chip2, Code = code }, default)).Status);
+        Assert.True((await _svc.Leave(new RoomCodeRequest { AccessCode = ac2, ChipId = chip2, Code = code }, default)).Success);
+        Assert.True((await _svc.Close(new RoomCodeRequest { AccessCode = ac, ChipId = chip, Code = code }, default)).Success);
+        Assert.Empty((await _svc.List(new RoomsListRequest { AccessCode = ac, ChipId = chip }, default)).Rooms);
+    }
+
+    [Fact]
+    public async Task Join_EnforcesClassRange()
+    {
+        var (ac, chip, _) = NewCard("a", "OWNER", soloClass: 4);
+        var (ac2, chip2, _) = NewCard("b", "PILOT", soloClass: 1);
+        var c = await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, ClassIdMin = 3, ClassIdMax = 4 }, default);
+        Assert.True(c.Success, c.Message);
+        var j = await _svc.Join(new RoomCodeRequest { AccessCode = ac2, ChipId = chip2, Code = c.Room!.Code }, default);
+        Assert.False(j.Success);
+        Assert.Equal("NotAllowed", j.Status);
+    }
+
+    [Fact]
+    public async Task Create_RejectsEventRoomsAndBadTimes()
+    {
+        var (ac, chip, _) = NewCard("a", "OWNER");
+        Assert.False((await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, TagType = 1 }, default)).Success);
+        Assert.False((await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, Start = "25:00" }, default)).Success);
+        Assert.False((await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, End = "16:00" }, default)).Success); // already past
+        var late = await _svc.Create(new RoomCreateRequest { AccessCode = ac, ChipId = chip, End = "02:00" }, default); // after midnight, before 05:00 reset
+        Assert.True(late.Success, late.Message);
+        Assert.Equal("02:00", late.Room!.End);
+    }
+
+    [Theory]
+    [InlineData(1u, 3u, 1u, 3u)]
+    [InlineData(2u, 3u, 1u, 1u)]
+    [InlineData(3u, 2u, 4u, 4u)]
+    [InlineData(1u, 0u, 0u, 1u)]
+    public void ClassFor_PicksTheModeClass(uint matching, uint solo, uint team, uint expected) =>
+        Assert.Equal(expected, CustomRoomsUiService.ClassFor(matching, solo, team));
+}
