+using MediatR;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Handlers.Game.CustomRooms;
+
+// [exvs2-lobbies 2026-11-17] Live Monitor "カスタムマッチのルーム検索" (Custom Match room search).
+// Before this the LM got ErrServer "Unhandled case" for LoadRoom and showed "このカードは使用できません".
+
+public record LoadRoomQuery(Request Request) : IRequest<Response>;
+
+/// <summary>
+/// LoadRoom (418): request {is_card, access_code, chip_id, mucha_country_code}. Looks the card up like
+/// LoadMeetingCard (access code + chip id; unknown card → ErrServer, the LM's "card cannot be used"), then lists the
+/// rooms the card has joined today. An empty list is a valid reply. A registry outage also gives an empty list.
+/// </summary>
+public class LoadRoomQueryHandler : IRequestHandler<LoadRoomQuery, Response>
+{
+    private readonly ILogger<LoadRoomQueryHandler> _logger;
+    private readonly ServerDbContext _context;
+    private readonly ICustomRoomClient _rooms;
+    private readonly CustomRoomConfigurations _cfg;
+
+    public LoadRoomQueryHandler(ILogger<LoadRoomQueryHandler> logger, ServerDbContext context, ICustomRoomClient rooms,
+        IOptions<CardServerConfig> options)
+    {
+        _logger = logger;
+        _context = context;
+        _rooms = rooms;
+        _cfg = options.Value.CustomRooms;
+    }
+
+    public async Task<Response> Handle(LoadRoomQuery query, CancellationToken cancellationToken)
+    {
+        var request = query.Request;
+        var response = new Response { Type = request.Type, RequestId = request.RequestId, Error = Error.Success };
+        var req = request.load_room;
+        if (req == null || string.IsNullOrEmpty(req.AccessCode) || string.IsNullOrEmpty(req.ChipId))
+        {
+            _logger.LogWarning("LoadRoom without a card (is_card={IsCard})", req?.IsCard);
+            response.Error = Error.ErrServer;
+            return response;
+        }
+
+        var card = await _context.CardProfiles
+            .FirstOrDefaultAsync(x => x.AccessCode == req.AccessCode && x.ChipId == req.ChipId, cancellationToken);
+        if (card == null)
+        {
+            _logger.LogWarning("LoadRoom: card not found on this server");
+            response.Error = Error.ErrServer;
+            return response;
+        }
+
+        var pilot = PilotId.Wire(card.Id);
+        IReadOnlyList<CustomRoom> rooms = Array.Empty<CustomRoom>();
+        if (!card.IsNewCard)
+        {
+            try
+            {
+                rooms = await _rooms.RoomsForAsync(pilot, cancellationToken);
+            }
+            catch (Exception e)
+            {
+                _logger.LogWarning("LoadRoom: room registry unavailable ({Error}); answering an empty list", e.GetBaseException().Message);
+            }
+        }
+
+        response.load_room = CustomRoomReplies.LoadRoom(pilot, card.IsNewCard, rooms, _cfg.ClassIdMin, _cfg.ClassIdMax);
+        _logger.LogInformation("ROOM-LOAD pilot={Pilot} new={New} rooms={Count}", pilot, card.IsNewCard, response.load_room.rooms.Count);
+        return response;
+    }
+}
+
+public record RegisterRoomCommand(Request Request) : IRequest<Response>;
+
+/// <summary>RegisterRoom (419): request {pilot_id, room_id (= LoadRoom tag_id), tag_type}; reply {status}.</summary>
+public class RegisterRoomCommandHandler : IRequestHandler<RegisterRoomCommand, Response>
+{
+    private readonly ILogger<RegisterRoomCommandHandler> _logger;
+    private readonly ICustomRoomClient _rooms;
+
+    public RegisterRoomCommandHandler(ILogger<RegisterRoomCommandHandler> logger, ICustomRoomClient rooms)
+    {
+        _logger = logger;
+        _rooms = rooms;
+    }
+
+    public async Task<Response> Handle(RegisterRoomCommand command, CancellationToken cancellationToken)
+    {
+        var request = command.Request;
+        var response = new Response { Type = request.Type, RequestId = request.RequestId, Error = Error.Success };
+        var req = request.register_room;
+        if (req == null || req.PilotId == 0 || req.RoomId == 0)
+        {
+            response.register_room = CustomRoomReplies.RegisterRoom(false);
+            return response;
+        }
+
+        CustomRoomResult result;
+        try
+        {
+            result = await _rooms.RegisterAsync(req.PilotId, req.RoomId, cancellationToken);
+        }
+        catch (Exception e)
+        {
+            _logger.LogWarning("RegisterRoom: room registry unavailable ({Error})", e.GetBaseException().Message);
+            result = new CustomRoomResult(CustomRoomStatus.NotFound);
+        }
+
+        if (result.Ok && result.Room != null && result.Room.TagType != req.TagType)
+            _logger.LogInformation("RegisterRoom: tag_type {Sent} differs from room {Room}", req.TagType, result.Room.TagType);
+        response.register_room = CustomRoomReplies.RegisterRoom(result.Ok);
+        _logger.LogInformation("ROOM-REGISTER pilot={Pilot} room={Room} status={Status}", req.PilotId, req.RoomId, result.Status);
+        return response;
+    }
+}
