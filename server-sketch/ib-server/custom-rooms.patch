+        var a = Entry(6, attr2: 77); a.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 3, parameter = 1 });
+        var b = Entry(6, attr2: 77); b.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 3, parameter = 2 });
+        mm.Entry(a, 0); mm.Entry(b, 0);
+        var room = mm.Check(a.Myclient.NodeId, 40).Room;
+        Assert.NotNull(room);
+        Assert.Contains(room!.Clients, x => x.Client.NodeId == b.Myclient.NodeId);
+    }
+
+    [Fact]
+    public void CustomRooms_RoomIdDoesNotLeakIntoOtherWorlds()
+    {
+        Assert.True(Matchmaker.IsCustomRoomWorld(6));
+        Assert.True(Matchmaker.IsCustomRoomWorld(33));
+        Assert.False(Matchmaker.IsCustomRoomWorld(5));   // online tag pair key
+        Assert.False(Matchmaker.IsCustomRoomWorld(13));  // ranked class
+        Assert.False(Matchmaker.IsCustomRoomWorld(23));  // casual
+    }
 }
