+    public async Task<RoomActionResponse> Close(RoomCodeRequest r, CancellationToken ct) =>
+        await Simple(r, "close", (code, self) => _rooms.CloseAsync(code, self, ct));
+
+    private async Task<RoomActionResponse> Simple(RoomCodeRequest r, string what, Func<string, uint, Task<CustomRoomResult>> call)
+    {
+        var card = Card(r);
+        if (card is null) return Fail("Invalid", "Card Profile is invalid");
+        var self = PilotId.Wire(card.Id);
+        var code = CustomRoomStore.Normalize(r.Code);
+        if (code.Length == 0) return Fail("NotFound", "Room code is required.");
+        try
+        {
+            var res = await call(code, self);
+            _log.LogInformation("Rooms: pilot {Pilot} {What} {Code}: {Status}", self, what, CustomRoomStore.MaskCode(code), res.Status);
+            return From(res, self);
+        }
+        catch (Exception ex)
+        {
+            _log.LogWarning("Rooms: {What} failed: {Error}", what, ex.Message);
+            return Fail("Error", "Room server is unreachable.");
+        }
+    }
+}
