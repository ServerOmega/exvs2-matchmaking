@@ -0,0 +1,49 @@
+namespace ServerInfinite.Models.Config;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Custom Match rooms (カスタムマッチ). The Live Monitor's "カスタムマッチのルーム検索" sends
+/// LoadRoom (418) with the touched card and RegisterRoom (419) when a room is picked. Officially rooms are made and
+/// joined on vsmobile; here the launcher stands in for vsmobile (room codes) and the room registry lives with the
+/// shared matchmaker under /tag/rooms (same X-Tag-Secret / LAN-only guard as /tag). No public-queue fallback, no CPU fill.
+/// </summary>
+public class CustomRoomConfigurations
+{
+    /// <summary>Answer LoadRoom / RegisterRoom. false = the old "Unhandled case" ErrServer reply.</summary>
+    public bool Enabled { get; set; } = true;
+
+    /// <summary>true = keep the room registry in this process (single-PC tests: only this card server is swapped).
+    /// false = use the matchmaker's /tag/rooms (OnlineTag.InviteUrl or OnlineMatching.MatchUrl), or this process when
+    /// neither URL is set.</summary>
+    public bool LocalStore { get; set; } = false;
+
+    /// <summary>JSON state file for the registry (when it lives in this process).</summary>
+    public string StateFile { get; set; } = "custom_rooms.json";
+
+    /// <summary>EXPERIMENTAL, off by default: send PreLoadCard.matching_tag (room id, tag/matching type, world_id) for a
+    /// card that picked a room today on the LM. The cabinet's world override path is static analysis only.</summary>
+    public bool SendMatchingTag { get; set; } = false;
+
+    /// <summary>Default world_id for solo rooms (matching_type 1) and team rooms (matching_type 2). The matchmaker
+    /// hard-buckets the tag worlds 6, 7, 24, 26, 27, 32, 33.</summary>
