+    /// <summary>Clock time from a time box: "H:mm", "HH:mm", "HH:mm:ss" (seconds ignored), "h:mm AM/PM",
+    /// "h:mm:ss PM" (invariant AM/PM, with or without a space) and "24:00". Returns hour 0-24 (24 only with :00).</summary>
+    public static bool TryParseClock(string? text, out int hour, out int minute)
+    {
+        hour = minute = 0;
+        if (string.IsNullOrWhiteSpace(text)) return false;
+        var t = text.Trim().ToUpperInvariant().Replace('\u00A0', ' ').Replace('\u202F', ' ');
+        int? half = null; // 0 = AM, 12 = PM
+        if (t.EndsWith("AM") || t.EndsWith("PM"))
+        {
+            half = t.EndsWith("PM") ? 12 : 0;
+            t = t[..^2].TrimEnd(' ', '.');
+        }
+        else if (t.EndsWith("A.M.") || t.EndsWith("P.M."))
+        {
+            half = t.EndsWith("P.M.") ? 12 : 0;
+            t = t[..^4].TrimEnd();
+        }
+        var parts = t.Split(':');
+        if (parts.Length is < 2 or > 3) return false;
+        foreach (var part in parts)
+            if (part.Length is < 1 or > 2 || !part.All(char.IsAsciiDigit)) return false;
+        if (parts[1].Length != 2 || (parts.Length == 3 && parts[2].Length != 2)) return false;
+        var h = int.Parse(parts[0], CultureInfo.InvariantCulture);
+        var m = int.Parse(parts[1], CultureInfo.InvariantCulture);
+        var sec = parts.Length == 3 ? int.Parse(parts[2], CultureInfo.InvariantCulture) : 0;
+        if (m > 59 || sec > 59) return false;
+        if (half is int hf)
+        {
+            if (h is < 1 or > 12) return false;
+            h = h % 12 + hf;
+        }
+        else if (h > 24 || (h == 24 && (m != 0 || sec != 0))) return false;
+        hour = h; minute = m;
+        return true;
+    }
