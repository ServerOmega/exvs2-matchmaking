+namespace ServerInfinite.Matchmaking;
+
+/// <summary>[exvs2-lobbies 2026-11-17] Card server → Custom Match room registry (in process or the matchmaker's /tag/rooms).</summary>
+public interface ICustomRoomClient
+{
+    Task<CustomRoomResult> CreateAsync(uint ownerPilotId, string ownerName, CustomRoomOptions options, CancellationToken ct = default);
+    Task<CustomRoomResult> JoinAsync(string code, uint pilotId, CancellationToken ct = default);
+    Task<CustomRoomResult> LeaveAsync(string code, uint pilotId, CancellationToken ct = default);
+    Task<IReadOnlyList<CustomRoom>> RoomsForAsync(uint pilotId, CancellationToken ct = default);
+    Task<CustomRoomResult> RegisterAsync(uint pilotId, uint roomId, CancellationToken ct = default);
+    Task<CustomRoom?> SelectedForAsync(uint pilotId, CancellationToken ct = default);
+}
+
+public sealed class InProcessCustomRoomClient : ICustomRoomClient
+{
+    private readonly CustomRoomStore _store;
+    public InProcessCustomRoomClient(CustomRoomStore store) => _store = store;
+
+    public Task<CustomRoomResult> CreateAsync(uint ownerPilotId, string ownerName, CustomRoomOptions options, CancellationToken ct = default) =>
+        Task.FromResult(_store.Create(ownerPilotId, ownerName, options));
+    public Task<CustomRoomResult> JoinAsync(string code, uint pilotId, CancellationToken ct = default) =>
+        Task.FromResult(_store.Join(code, pilotId));
+    public Task<CustomRoomResult> LeaveAsync(string code, uint pilotId, CancellationToken ct = default) =>
+        Task.FromResult(_store.Leave(code, pilotId));
+    public Task<IReadOnlyList<CustomRoom>> RoomsForAsync(uint pilotId, CancellationToken ct = default) =>
+        Task.FromResult(_store.RoomsFor(pilotId));
+    public Task<CustomRoomResult> RegisterAsync(uint pilotId, uint roomId, CancellationToken ct = default) =>
+        Task.FromResult(_store.Register(pilotId, roomId));
+    public Task<CustomRoom?> SelectedForAsync(uint pilotId, CancellationToken ct = default) =>
+        Task.FromResult(_store.SelectedFor(pilotId));
+}
