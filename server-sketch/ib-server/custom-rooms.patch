+        var code = CustomRoomStore.Normalize(r.Code);
+        if (code.Length != CustomRoomStore.CodeLength) return Fail("NotFound", "Room codes are 6 letters / digits.");
+        try
+        {
+            var room = await _rooms.GetAsync(code, ct);
+            if (room == null) return Fail("NotFound", "No open room with that code.");
