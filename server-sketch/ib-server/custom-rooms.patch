+@page "/Cards/Rooms/{ChipId}"
+@* exvs2-lobbies 2026-11-17: Custom Match rooms (stand-in for vsmobile's room maker). Make a room code, share it, join
+   friends' rooms by code. The LM's Custom Match menu then lists the rooms this card is in. Times are in the server's
+   room time zone; rooms close at the daily reset. *@
+@using WebUIInfinite.Shared.Dto.Request
+@using WebUIInfinite.Shared.Dto.Response
+@inject ISnackbar Snackbar
+@inject HttpClient Http
+@inject IDialogService DialogService
+@inject IJSRuntime JS
+
+<PageTitle>@localizer["rooms_title"]</PageTitle>
+<MudBreadcrumbs Items="_breadcrumbs" Class="px-0"></MudBreadcrumbs>
+
+@if (_errorMessage is not null)
+{
+    <MudAlert Severity="Severity.Error" Class="my-4">@_errorMessage</MudAlert>
+    return;
+}
+
+<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
+    <MudText Typo="Typo.h4" HtmlTag="h1">@localizer["rooms_title"]</MudText>
+    @if (_list.Success)
+    {
+        <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Schedule">
+            @string.Format(localizer["rooms_clock"], _list.Now, _list.DayEnd, _list.TimeZone)
+        </MudChip>
+    }
+</MudStack>
+<MudText Typo="Typo.body2" Class="mb-4">@localizer["rooms_help"]</MudText>
+
+<MudGrid Spacing="3">
+    <MudItem xs="12" md="5">
+        <MudPaper Outlined="true" Class="pa-4 mb-3">
+            <MudText Typo="Typo.h6" Class="mb-2">@localizer["rooms_join_title"]</MudText>
+            <MudStack Row="true" AlignItems="AlignItems.Center">
+                <MudTextField T="string" @bind-Value="_joinCode" Label="@localizer["rooms_code"]" Variant="Variant.Outlined" Margin="Margin.Dense"
+                              MaxLength="7" Immediate="true" Style="font-family: monospace; text-transform: uppercase" OnKeyUp="OnJoinKey" />
+                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_joinCode))"
+                           StartIcon="@Icons.Material.Filled.Login" OnClick="Join">@localizer["rooms_join"]</MudButton>
+            </MudStack>
+            @if (_list.YourSoloClass != 0 || _list.YourTeamClass != 0)
+            {
+                <MudText Typo="Typo.caption" Class="mt-2 d-block">@string.Format(localizer["rooms_your_class"], ClassName(_list.YourSoloClass), ClassName(_list.YourTeamClass))</MudText>
+            }
+        </MudPaper>
+
+        <MudPaper Outlined="true" Class="pa-4">
+            <MudText Typo="Typo.h6" Class="mb-2">@localizer["rooms_create_title"]</MudText>
+            <MudGrid Spacing="2">
+                <MudItem xs="12">
+                    <MudTextField T="string" @bind-Value="_new.Name" Label="@localizer["rooms_name"]" HelperText="@localizer["rooms_name_hint"]"
+                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="36" Counter="36" />
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.TagType" Label="@localizer["rooms_kind"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        <MudSelectItem T="uint" Value="2u">@localizer["rooms_kind_private"]</MudSelectItem>
+                        <MudSelectItem T="uint" Value="4u">@localizer["rooms_kind_public"]</MudSelectItem>
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.MatchingType" Label="@localizer["rooms_mode"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        <MudSelectItem T="uint" Value="1u">@localizer["rooms_mode_solo"]</MudSelectItem>
+                        <MudSelectItem T="uint" Value="2u">@localizer["rooms_mode_team"]</MudSelectItem>
+                        <MudSelectItem T="uint" Value="3u">@localizer["rooms_mode_mix"]</MudSelectItem>
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="4">
+                    <MudNumericField T="uint" @bind-Value="_new.MemberLimit" Label="@localizer["rooms_members"]" Min="2" Max="@MaxMembers"
+                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
+                </MudItem>
+                <MudItem xs="4">
+                    <MudTextField T="string" @bind-Value="_new.Start" InputType="InputType.Time" Label="@localizer["rooms_start"]"
+                                  HelperText="@localizer["rooms_start_hint"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
+                </MudItem>
+                <MudItem xs="4">
+                    <MudTextField T="string" @bind-Value="_new.End" InputType="InputType.Time" Label="@localizer["rooms_end"]"
+                                  HelperText="@localizer["rooms_end_hint"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.ClassIdMin" Label="@localizer["rooms_class_min"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        @for (uint c = 1; c <= 4; c++) { var v = c; <MudSelectItem T="uint" Value="v">@ClassName(v)</MudSelectItem> }
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.ClassIdMax" Label="@localizer["rooms_class_max"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        @for (uint c = 1; c <= 4; c++) { var v = c; <MudSelectItem T="uint" Value="v">@ClassName(v)</MudSelectItem> }
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="6">
+                    <MudNumericField T="uint" @bind-Value="_new.WinRateLower" Label="@localizer["rooms_winrate_low"]" Min="0" Max="100"
+                                     Adornment="Adornment.End" AdornmentText="%" Variant="Variant.Outlined" Margin="Margin.Dense" />
+                </MudItem>
+                <MudItem xs="6">
+                    <MudNumericField T="uint" @bind-Value="_new.WinRateUpper" Label="@localizer["rooms_winrate_high"]" Min="0" Max="100"
+                                     Adornment="Adornment.End" AdornmentText="%" Variant="Variant.Outlined" Margin="Margin.Dense" />
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.FesRuleType" Label="@localizer["rooms_fes"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        @foreach (var f in FesRules) { <MudSelectItem T="uint" Value="f">@FesName(f)</MudSelectItem> }
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="6">
+                    <MudSelect T="uint" @bind-Value="_new.Comment" Label="@localizer["rooms_comment"]" Variant="Variant.Outlined" Margin="Margin.Dense">
+                        @for (uint m = 0; m <= 11; m++) { var v = m; <MudSelectItem T="uint" Value="v">@CommentName(v)</MudSelectItem> }
+                    </MudSelect>
+                </MudItem>
+                <MudItem xs="12">
+                    <MudSwitch T="bool" Value="@(_new.RuleType != 0)" ValueChanged="@(v => _new.RuleType = v ? 1u : 0u)" Color="Color.Primary"
+                               Label="@localizer["rooms_unit_rule"]" />
+                    <MudText Typo="Typo.caption" Class="d-block">@localizer["rooms_unit_rule_hint"]</MudText>
+                </MudItem>
+                <MudItem xs="12">
+                    <MudExpansionPanels Outlined="true" Elevation="0">
+                        <MudExpansionPanel Text="@localizer["rooms_advanced"]">
+                            <MudText Typo="Typo.caption" Class="d-block mb-2">@localizer["rooms_advanced_hint"]</MudText>
+                            <MudNumericField T="uint" @bind-Value="_new.Timer" Label="@localizer["rooms_timer"]" Min="0" Max="999"
+                                             HelperText="@localizer["rooms_timer_hint"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
+                            <MudSwitch T="bool" @bind-Value="_new.RevengeFlag" Color="Color.Primary" Label="@localizer["rooms_revenge"]" />
+                            <MudSwitch T="bool" @bind-Value="_new.RandomStageOnly" Color="Color.Primary" Label="@localizer["rooms_random_stage"]" />
+                        </MudExpansionPanel>
+                    </MudExpansionPanels>
+                </MudItem>
+                <MudItem xs="12">
+                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy"
+                               StartIcon="@Icons.Material.Filled.AddCircle" OnClick="Create">@localizer["rooms_create"]</MudButton>
+                </MudItem>
+            </MudGrid>
+        </MudPaper>
+    </MudItem>
+
+    <MudItem xs="12" md="7">
+        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
+            <MudText Typo="Typo.h6">@localizer["rooms_today"] (@_list.Rooms.Count)</MudText>
+            <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="@localizer["rooms_refresh"]" Disabled="_busy" OnClick="Load" />
+        </MudStack>
+        @if (_busy && _list.Rooms.Count == 0)
+        {
+            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
+        }
+        else if (_list.Rooms.Count == 0)
+        {
+            <MudPaper Outlined="true" Class="pa-4"><MudText Typo="Typo.body2">@localizer["rooms_empty"]</MudText></MudPaper>
+        }
+        @foreach (var r in _list.Rooms)
+        {
+            var room = r;
+            <MudPaper Outlined="true" Class="pa-4 mb-3">
+                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
+                    <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(room.Name) ? localizer["rooms_unnamed"].Value : room.Name)</MudText>
+                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
+                        <MudText Typo="Typo.h5" Style="font-family: monospace; letter-spacing: 0.15em">@FormatCode(room.Code)</MudText>
+                        <MudTooltip Text="@localizer["rooms_copy"]">
+                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="@localizer["rooms_copy"]" OnClick="@(() => Copy(room.Code))" />
+                        </MudTooltip>
+                    </MudStack>
+                </MudStack>
+                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="my-2">
+                    <MudChip T="string" Size="Size.Small" Color="@(room.TagType == 4 ? Color.Info : Color.Default)">@(room.TagType == 4 ? localizer["rooms_kind_public"] : localizer["rooms_kind_private"])</MudChip>
+                    <MudChip T="string" Size="Size.Small">@ModeName(room.MatchingType)</MudChip>
+                    @if (room.OpenNow)
+                    {
+                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">@localizer["rooms_open"]</MudChip>
+                    }
+                    else
+                    {
+                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule">@localizer["rooms_scheduled"]</MudChip>
+                    }
+                    @if (room.IsOwner)
+                    {
+                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Star">@localizer["rooms_owner"]</MudChip>
+                    }
+                    @if (room.Selected)
+                    {
+                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Icon="@Icons.Material.Filled.SportsEsports">@localizer["rooms_selected"]</MudChip>
+                    }
+                </MudStack>
+                <MudSimpleTable Dense="true" Elevation="0" Class="mb-2">
+                    <tbody>
+                        <tr><td>@localizer["rooms_hours"]</td><td>@room.Start ~ @room.End</td></tr>
+                        <tr><td>@localizer["rooms_players"]</td><td>@room.MemberCount / @room.MemberLimit</td></tr>
+                        <tr><td>@localizer["rooms_class"]</td><td>@ClassName(room.ClassIdMin) ~ @ClassName(room.ClassIdMax)</td></tr>
+                        <tr><td>@localizer["rooms_winrate"]</td><td>@room.WinRateLower% ~ @room.WinRateUpper%</td></tr>
+                        <tr><td>@localizer["rooms_unit_rule_short"]</td><td>@(room.RuleType != 0 ? localizer["rooms_on"] : localizer["rooms_off"])</td></tr>
+                        <tr><td>@localizer["rooms_fes"]</td><td>@FesName(room.FesRuleType)</td></tr>
+                        @if (room.Comment != 0)
+                        {
+                            <tr><td>@localizer["rooms_comment"]</td><td>@CommentName(room.Comment)</td></tr>
+                        }
+                        @if (room.Timer != 0 || room.RevengeFlag || room.RandomStageOnly)
+                        {
+                            <tr><td>@localizer["rooms_advanced"]</td><td>@AdvancedText(room)</td></tr>
+                        }
+                    </tbody>
+                </MudSimpleTable>
+                <MudText Typo="Typo.subtitle2">@localizer["rooms_member_list"]</MudText>
+                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
+                    @foreach (var m in room.Members)
+                    {
+                        <MudChip T="string" Size="Size.Small" Variant="@(m.IsYou ? Variant.Filled : Variant.Outlined)"
+                                 Icon="@(m.IsOwner ? Icons.Material.Filled.Star : Icons.Material.Filled.Person)">
+                            @(string.IsNullOrEmpty(m.Name) ? m.PilotId.ToString() : m.Name)
+                        </MudChip>
+                    }
+                </MudStack>
+                <MudStack Row="true" Justify="Justify.FlexEnd">
+                    @if (room.IsOwner)
+                    {
+                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" Disabled="_busy"
+                                   OnClick="@(() => Close(room))">@localizer["rooms_close"]</MudButton>
+                    }
+                    else
+                    {
+                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Logout" Disabled="_busy"
+                                   OnClick="@(() => Leave(room))">@localizer["rooms_leave"]</MudButton>
+                    }
+                </MudStack>
+            </MudPaper>
+        }
+    </MudItem>
+</MudGrid>
+
+@code {
+    [Parameter] public string ChipId { get; set; } = "";
+
+    private static readonly uint[] FesRules = { 0, 1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 20, 21, 22, 23, 24 };
+    private readonly List<BreadcrumbItem> _breadcrumbs = new();
+    private string? _errorMessage;
+    private string _accessCode = "";
+    private bool _busy;
+    private string _joinCode = "";
+    private RoomsListResponse _list = new();
+    private RoomCreateRequest _new = new();
+
+    private uint MaxMembers => _list.MaxMembers == 0 ? 32u : _list.MaxMembers;
+
+    protected override async Task OnInitializedAsync()
+    {
+        _breadcrumbs.Add(new BreadcrumbItem("Menu", href: $"Cards/SingularCardMenu/{ChipId}"));
+        _breadcrumbs.Add(new BreadcrumbItem(localizer["rooms_title"], href: null, disabled: true));
+        _accessCode = await JS.InvokeAsync<string>("accessCode.get", ChipId) ?? "";
+        if (string.IsNullOrEmpty(_accessCode))
+        {
+            _errorMessage = localizer["invalid_user_login"];
+            return;
+        }
+        ResetForm();
+        await Load();
+        _new.ClassIdMin = _list.DefaultClassIdMin == 0 ? 1u : _list.DefaultClassIdMin;
+        _new.ClassIdMax = _list.DefaultClassIdMax == 0 ? 4u : _list.DefaultClassIdMax;
+        _new.MemberLimit = Math.Min(8u, MaxMembers);
+    }
+
+    private void ResetForm()
+    {
+        _new = new RoomCreateRequest
+        {
+            TagType = 2, MatchingType = 1, MemberLimit = Math.Min(8u, MaxMembers), RuleType = 0,
+            ClassIdMin = _list.DefaultClassIdMin == 0 ? 1u : _list.DefaultClassIdMin,
+            ClassIdMax = _list.DefaultClassIdMax == 0 ? 4u : _list.DefaultClassIdMax,
+            WinRateUpper = 100, WinRateLower = 0, GradeIdMin = 1, GradeIdMax = 11,
+        };
+    }
+
+    private async Task Load()
+    {
+        _busy = true;
+        StateHasChanged();
+        try
+        {
+            var res = await Http.PostAsJsonAsync("ui/rooms/list", new RoomsListRequest { AccessCode = _accessCode, ChipId = ChipId });
+            if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
+            {
+                _errorMessage = localizer["rooms_disabled"];
+                return;
+            }
+            var body = res.IsSuccessStatusCode ? await res.Content.ReadFromJsonAsync<RoomsListResponse>() : null;
+            if (body is null) { Snackbar.Add(localizer["rooms_unavailable"], Severity.Error); return; }
+            if (!body.Success)
+            {
+                if (body.YourPilotId == 0) _errorMessage = localizer["invalid_user_login"];
+                else Snackbar.Add($"{localizer["rooms_unavailable"]} {body.Message}", Severity.Warning);
+                return;
+            }
+            _list = body;
+        }
+        catch (Exception)
+        {
+            Snackbar.Add(localizer["rooms_unavailable"], Severity.Error);
+        }
+        finally
+        {
+            _busy = false;
+            StateHasChanged();
+        }
+    }
+
+    private async Task<RoomActionResponse?> Post(string url, object body)
+    {
+        _busy = true;
+        StateHasChanged();
+        try
+        {
+            var res = await Http.PostAsJsonAsync(url, body);
+            var r = res.IsSuccessStatusCode ? await res.Content.ReadFromJsonAsync<RoomActionResponse>() : null;
+            if (r is null) Snackbar.Add(localizer["rooms_unavailable"], Severity.Error);
+            else if (!r.Success) Snackbar.Add(StatusText(r), Severity.Warning);
+            return r;
+        }
+        catch (Exception)
+        {
+            Snackbar.Add(localizer["rooms_unavailable"], Severity.Error);
+            return null;
+        }
+        finally
+        {
+            _busy = false;
+            StateHasChanged();
+        }
+    }
+
+    private string StatusText(RoomActionResponse r)
+    {
+        var key = $"rooms_status_{r.Status}";
+        var s = localizer[key];
+        if (r.Status is "Invalid" or "TooManyRooms" && !string.IsNullOrEmpty(r.Message)) return r.Message!;
+        return s.ResourceNotFound ? (r.Message ?? r.Status) : s.Value;
+    }
+
+    private async Task Create()
+    {
+        if (_new.WinRateLower > _new.WinRateUpper || _new.ClassIdMin > _new.ClassIdMax)
+        {
+            Snackbar.Add(localizer["rooms_range_invalid"], Severity.Warning);
+            return;
+        }
+        _new.AccessCode = _accessCode;
+        _new.ChipId = ChipId;
+        var r = await Post("ui/rooms/create", _new);
+        _new.AccessCode = "";
+        if (r is { Success: true })
+        {
+            Snackbar.Add(localizer["rooms_created"], Severity.Success);
+            ResetForm();
+            await Load();
+        }
+    }
+
+    private async Task OnJoinKey(KeyboardEventArgs e)
+    {
+        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_joinCode)) await Join();
+    }
+
+    private async Task Join()
+    {
+        var r = await Post("ui/rooms/join", new RoomCodeRequest { AccessCode = _accessCode, ChipId = ChipId, Code = _joinCode.Trim() });
+        if (r is { Success: true })
+        {
+            Snackbar.Add(localizer["rooms_joined"], Severity.Success);
+            _joinCode = "";
+            await Load();
+        }
+    }
+
+    private async Task Leave(RoomItem room)
+    {
+        var ok = await DialogService.ShowMessageBox(localizer["rooms_leave"], string.Format(localizer["rooms_confirm_leave"], DisplayName(room)),
+            yesText: localizer["rooms_leave"], cancelText: localizer["rooms_cancel"]);
+        if (ok != true) return;
+        var r = await Post("ui/rooms/leave", new RoomCodeRequest { AccessCode = _accessCode, ChipId = ChipId, Code = room.Code });
+        if (r is { Success: true }) await Load();
+    }
+
+    private async Task Close(RoomItem room)
+    {
+        var ok = await DialogService.ShowMessageBox(localizer["rooms_close"], string.Format(localizer["rooms_confirm_close"], DisplayName(room)),
+            yesText: localizer["rooms_close"], cancelText: localizer["rooms_cancel"]);
+        if (ok != true) return;
+        var r = await Post("ui/rooms/close", new RoomCodeRequest { AccessCode = _accessCode, ChipId = ChipId, Code = room.Code });
+        if (r is { Success: true }) await Load();
+    }
+
+    private async Task Copy(string code)
+    {
+        try
+        {
+            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
+            Snackbar.Add(localizer["rooms_copied"], Severity.Info);
+        }
+        catch (Exception) { /* clipboard blocked (http): the code is on screen */ }
+    }
+
+    private string DisplayName(RoomItem r) => string.IsNullOrEmpty(r.Name) ? FormatCode(r.Code) : r.Name;
+    private static string FormatCode(string c) => c.Length == 6 ? $"{c[..3]}-{c[3..]}" : c;
+
+    private string ClassName(uint c) => c switch
+    {
+        1 => localizer["rooms_class_1"], 2 => localizer["rooms_class_2"], 3 => localizer["rooms_class_3"],
+        4 => localizer["rooms_class_4"], _ => "-",
+    };
+
+    private string ModeName(uint m) => m switch
+    {
+        2 => localizer["rooms_mode_team"], 3 => localizer["rooms_mode_mix"], _ => localizer["rooms_mode_solo"],
+    };
+
+    private string FesName(uint f) => f switch
+    {
+        0 => localizer["rooms_fes_none"],
+        >= 1 and <= 7 => localizer[$"rooms_fes_{f}"],
+        >= 10 and <= 14 => string.Format(localizer["rooms_fes_one"], f - 10),
+        >= 20 and <= 24 => string.Format(localizer["rooms_fes_onexu"], f - 20),
+        _ => f.ToString(),
+    };
+
+    private string CommentName(uint m) => m == 0 ? localizer["rooms_comment_none"] : string.Format(localizer["rooms_comment_n"], m);
+
+    private string AdvancedText(RoomItem r)
+    {
+        var parts = new List<string>();
+        if (r.Timer != 0) parts.Add(string.Format(localizer["rooms_timer_short"], r.Timer));
+        if (r.RevengeFlag) parts.Add(localizer["rooms_revenge"]);
+        if (r.RandomStageOnly) parts.Add(localizer["rooms_random_stage"]);
+        return string.Join(", ", parts);
+    }
+}
