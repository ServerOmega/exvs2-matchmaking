+using Microsoft.AspNetCore.Mvc;
+using ServerInfinite.Handlers.UI.CustomRooms;
+using WebUIInfinite.Shared.Dto.Request;
+using WebUIInfinite.Shared.Dto.Response;
+
+namespace ServerInfinite.Controllers.UI;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Rooms page API (card server WebUI): make Custom Match room codes, join by code, leave,
+/// close. Every call is a POST with the card's access code and chip id in the JSON body (never in URLs / request log).
+/// </summary>
+[ApiController]
+[Route("ui/rooms")]
+public class CustomRoomsUiController : BaseController<CustomRoomsUiController>
+{
+    private readonly CustomRoomsUiService _svc;
+
+    public CustomRoomsUiController(CustomRoomsUiService svc) => _svc = svc;
+
+    [HttpPost("list")]
+    public async Task<ActionResult<RoomsListResponse>> List([FromBody] RoomsListRequest r, CancellationToken ct) =>
+        _svc.Enabled ? await _svc.List(r, ct) : NotFound();
+
+    [HttpPost("create")]
+    public async Task<ActionResult<RoomActionResponse>> Create([FromBody] RoomCreateRequest r, CancellationToken ct) =>
+        _svc.Enabled ? await _svc.Create(r, ct) : NotFound();
+
+    [HttpPost("join")]
+    public async Task<ActionResult<RoomActionResponse>> Join([FromBody] RoomCodeRequest r, CancellationToken ct) =>
+        _svc.Enabled ? await _svc.Join(r, ct) : NotFound();
+
+    [HttpPost("leave")]
+    public async Task<ActionResult<RoomActionResponse>> Leave([FromBody] RoomCodeRequest r, CancellationToken ct) =>
+        _svc.Enabled ? await _svc.Leave(r, ct) : NotFound();
+
+    [HttpPost("close")]
+    public async Task<ActionResult<RoomActionResponse>> Close([FromBody] RoomCodeRequest r, CancellationToken ct) =>
+        _svc.Enabled ? await _svc.Close(r, ct) : NotFound();
+}
diff --git a/Server-Infinite/Handlers/UI/CustomRooms/CustomRoomsUiService.cs b/Server-Infinite/Handlers/UI/CustomRooms/CustomRoomsUiService.cs
new file mode 100644
index 0000000..10ff276
--- /dev/null
+++ b/Server-Infinite/Handlers/UI/CustomRooms/CustomRoomsUiService.cs
@@ -0,0 +1,243 @@
+using System.Globalization;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Request;
+using WebUIInfinite.Shared.Dto.Response;
+
+namespace ServerInfinite.Handlers.UI.CustomRooms;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Rooms page backend (stand-in for vsmobile's Custom Match room maker). Checks the card
+/// (access code + chip id in the POST body), maps it to its wire pilot id and calls the room registry (in process or
+/// the matchmaker's /tag/rooms). Times are "HH:mm" in the room time zone (CustomRooms.TimeZone, day reset
+/// CustomRooms.DayResetHour). Room codes are masked in logs.
+/// </summary>
+public class CustomRoomsUiService
+{
+    private readonly ServerDbContext _context;
+    private readonly ICustomRoomClient _rooms;
+    private readonly CustomRoomStore _clock; // zone / day-reset math only (same config as the registry)
+    private readonly CustomRoomConfigurations _cfg;
+    private readonly ILogger<CustomRoomsUiService> _log;
+
+    public CustomRoomsUiService(ServerDbContext context, ICustomRoomClient rooms, CustomRoomStore clock,
+        IOptions<CardServerConfig> options, ILogger<CustomRoomsUiService> log)
+    {
+        _context = context;
+        _rooms = rooms;
+        _clock = clock;
+        _cfg = options.Value.CustomRooms;
+        _log = log;
+    }
+
+    public bool Enabled => _cfg.Enabled && _cfg.WebUi;
+
+    private CardProfile? Card(BasicCardRequest r) =>
+        string.IsNullOrEmpty(r.AccessCode) || string.IsNullOrEmpty(r.ChipId)
+            ? null
+            : _context.CardProfiles.FirstOrDefault(x => x.AccessCode == r.AccessCode && x.ChipId == r.ChipId);
+
+    private DateTime Now => _clock.UtcNow();
+
+    private string LocalHm(DateTime utc) =>
+        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), _clock.Zone).ToString("HH:mm", CultureInfo.InvariantCulture);
+
+    /// <summary>"HH:mm" in the room zone → UTC inside the current room day (a time before the day start is the next
+    /// calendar day, so 01:00 works with a 05:00 reset). Empty → null. "24:00" / the reset time as an end → day end.</summary>
+    public DateTime? ParseHm(string? hm, bool isEnd)
+    {
+        if (string.IsNullOrWhiteSpace(hm)) return null;
+        var parts = hm.Trim().Split(':');
+        if (parts.Length != 2 || !int.TryParse(parts[0], out var h) || !int.TryParse(parts[1], out var m) ||
+            h < 0 || h > 24 || m < 0 || m > 59 || (h == 24 && m != 0))
+            throw new FormatException("Times must be HH:mm.");
+        var dayEndUtc = _clock.EndOfDayUtc(Now);
+        var dayEndLocal = TimeZoneInfo.ConvertTimeFromUtc(dayEndUtc, _clock.Zone);
+        var dayStartLocal = dayEndLocal.AddDays(-1);
+        var t = dayStartLocal.Date.AddHours(h).AddMinutes(m);
+        if (t < dayStartLocal) t = t.AddDays(1);
+        if (isEnd && t == dayStartLocal) t = dayEndLocal;
+        if (t > dayEndLocal) t = dayEndLocal;
+        try { return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(t, DateTimeKind.Unspecified), _clock.Zone); }
+        catch (ArgumentException) { return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(t.AddHours(1), DateTimeKind.Unspecified), _clock.Zone); }
+    }
+
+    private (uint solo, uint team) Classes(CardProfile card)
+    {
+        var solo = _context.SoloClassMatchRecordDbSet.Where(x => x.CardId == card.Id).Select(x => x.ClassId).FirstOrDefault();
+        var team = _context.TeamClassMatchRecordDbSet.Where(x => x.CardId == card.Id).Select(x => x.ClassId).FirstOrDefault();
+        return (solo, team);
+    }
+
+    /// <summary>Class the room range is checked against: solo class (solo rooms), team class (team rooms), the higher
+    /// of the two (mix). 0 (no class record yet) counts as Pilot (1).</summary>
+    public static uint ClassFor(uint matchingType, uint solo, uint team)
+    {
+        solo = Math.Max(1, solo); team = Math.Max(1, team);
+        return matchingType switch { 1 => solo, 2 => team, _ => Math.Max(solo, team) };
+    }
+
+    private RoomItem Item(CustomRoom r, uint self, uint selectedRoomId)
+    {
+        var now = Now;
+        return new RoomItem
+        {
+            RoomId = r.RoomId, Code = r.Code, Name = r.Name, OwnerName = r.OwnerName, OwnerPilotId = r.OwnerPilotId,
+            IsOwner = r.OwnerPilotId == self, TagType = r.TagType, MatchingType = r.MatchingType,
+            MemberCount = Math.Max(r.Members.Count, r.MemberCount), MemberLimit = r.MemberLimit,
+            Start = LocalHm(r.OpensUtc), End = LocalHm(r.ExpiresUtc), OpenNow = r.IsOpenAt(now),
+            Selected = selectedRoomId != 0 && selectedRoomId == r.RoomId,
+            ClassIdMin = r.ClassIdMin, ClassIdMax = r.ClassIdMax, GradeIdMin = r.GradeIdMin, GradeIdMax = r.GradeIdMax,
+            WinRateUpper = r.WinRateUpper, WinRateLower = r.WinRateLower, RuleType = r.RuleType,
+            FesRuleType = r.FesRuleType, Comment = r.Comment, Timer = r.Timer, RevengeFlag = r.RevengeFlag,
+            RandomStageOnly = r.RandomStageOnly,
+            Members = r.Members.Select(id => new RoomMemberItem
+            {
+                PilotId = id, Name = r.MemberNames.TryGetValue(id, out var n) ? n : (id == r.OwnerPilotId ? r.OwnerName : ""),
+                IsOwner = id == r.OwnerPilotId, IsYou = id == self,
+            }).ToList(),
+        };
+    }
+
+    private static RoomActionResponse Fail(string status, string message) => new() { Success = false, Status = status, Message = message };
+
+    private RoomActionResponse From(CustomRoomResult res, uint self)
+    {
+        var resp = new RoomActionResponse { Success = res.Ok, Status = res.Status.ToString() };
+        if (res.Room != null) resp.Room = Item(res.Room, self, 0);
+        resp.Message = res.Status switch
+        {
+            CustomRoomStatus.Ok => null,
+            CustomRoomStatus.NotFound => "No open room with that code.",
+            CustomRoomStatus.Full => "That room is full.",
+            CustomRoomStatus.NotMember => "You are not in that room.",
+            CustomRoomStatus.TooManyRooms => res.Error ?? "Room limit reached (rooms you own or are in).",
+            CustomRoomStatus.Invalid => res.Error ?? "Invalid room settings.",
+            CustomRoomStatus.NotOwner => "Only the room owner can do that.",
+            CustomRoomStatus.NotAllowed => res.Error ?? "Your class is outside this room's class range.",
+            _ => res.Error ?? res.Status.ToString(),
+        };
+        return resp;
+    }
+
+    public async Task<RoomsListResponse> List(RoomsListRequest r, CancellationToken ct)
+    {
+        var card = Card(r);
+        if (card is null) return new RoomsListResponse { Success = false, Message = "Card Profile is invalid" };
+        var self = PilotId.Wire(card.Id);
+        var (solo, team) = Classes(card);
+        var now = Now;
+        var resp = new RoomsListResponse
+        {
+            YourPilotId = self, YourName = card.UserName ?? "", TimeZone = _clock.Zone.Id,
+            Now = LocalHm(now), DayEnd = LocalHm(_clock.EndOfDayUtc(now)),
