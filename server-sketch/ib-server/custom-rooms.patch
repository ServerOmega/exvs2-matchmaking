diff --git a/Tests/Server.Tests/CustomRoomRegistryTests.cs b/Tests/Server.Tests/CustomRoomRegistryTests.cs
new file mode 100644
index 0000000..cbf9521
--- /dev/null
+++ b/Tests/Server.Tests/CustomRoomRegistryTests.cs
@@ -0,0 +1,192 @@
+using Microsoft.AspNetCore.Builder;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Hosting.Server;
+using Microsoft.AspNetCore.Hosting.Server.Features;
+using Microsoft.AspNetCore.Http;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Logging.Abstractions;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Common.CustomRooms;
+using ServerInfinite.Controllers;
+using ServerInfinite.Handlers.UI.CustomRooms;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Request;
+using Xunit;
+
+namespace Server.Tests;
+
+/// <summary>
+/// exvs2-lobbies 2026-11-17: the shared room registry (CustomRooms.LocalStore = false). A real Kestrel host serves
+/// the matchmaker's CustomRoomController at /tag/rooms (behind a stand-in X-Tag-Secret check); two "card servers"
+/// (separate databases) talk to it through HttpCustomRoomClient, like two LMs on different card servers.
+/// </summary>
+public sealed class CustomRoomRegistryTests : IAsyncLifetime
+{
+    private const string Secret = "unit-test-secret";
+    private static readonly DateTime T0 = new(2026, 11, 17, 17, 0, 0, DateTimeKind.Utc);
+    private WebApplication _app = null!;
+    private CustomRoomStore _registry = null!;
+    private string _tagUrl = "";
+
+    public async Task InitializeAsync()
+    {
+        var b = WebApplication.CreateBuilder();
+        b.Logging.ClearProviders();
+        b.WebHost.UseUrls("http://127.0.0.1:0");
+        _registry = new CustomRoomStore { UtcNow = () => T0, Zone = TimeZoneInfo.Utc };
+        b.Services.AddSingleton(_registry);
+        b.Services.AddControllers().AddApplicationPart(typeof(CustomRoomController).Assembly);
+        _app = b.Build();
+        _app.Use(async (ctx, next) =>
+        {
+            if (ctx.Request.Path.StartsWithSegments("/tag") && ctx.Request.Headers["X-Tag-Secret"] != Secret)
+            {
+                ctx.Response.StatusCode = StatusCodes.Status401Unauthorized;
+                return;
+            }
+            await next();
+        });
+        _app.MapControllers();
+        await _app.StartAsync();
+        var addr = _app.Services.GetRequiredService<IServer>().Features.Get<IServerAddressesFeature>()!.Addresses.First();
+        _tagUrl = addr.TrimEnd('/') + "/tag";
+    }
+
+    public async Task DisposeAsync() => await _app.DisposeAsync();
+
+    private HttpCustomRoomClient Client(string? secret = Secret) => new(new HttpClient(), _tagUrl, secret);
+
+    [Fact]
+    public async Task HttpClient_RoundTripsEveryCall()
+    {
+        var c = Client();
+        var created = await c.CreateAsync(1001, "Owner", new CustomRoomOptions
+        {
+            Name = "Night", MatchingType = 3, TagType = 4, RuleType = 0, FesRuleType = 21, Comment = 3,
+            ClassIdMin = 2, ClassIdMax = 4, GradeIdMin = 2, GradeIdMax = 10, WinRateUpper = 80, WinRateLower = 20,
+            Timer = 120, RevengeFlag = true, RandomStageOnly = true, EndUtc = T0.AddHours(3),
+        });
+        Assert.True(created.Ok, created.Error);
+        var room = created.Room!;
+        var stored = _registry.Get(room.Code)!;
+        Assert.Equal((3u, 4u, 0u, 21u, 3u), (stored.MatchingType, stored.TagType, stored.RuleType, stored.FesRuleType, stored.Comment));
+        Assert.Equal((2u, 4u, 2u, 10u, 80u, 20u), (stored.ClassIdMin, stored.ClassIdMax, stored.GradeIdMin, stored.GradeIdMax, stored.WinRateUpper, stored.WinRateLower));
+        Assert.Equal((120u, true, true), (stored.Timer, stored.RevengeFlag, stored.RandomStageOnly));
+        Assert.Equal(T0.AddHours(3), stored.ExpiresUtc);
+
+        var bad = await c.CreateAsync(1001, "Owner", new CustomRoomOptions { FesRuleType = 9 });
+        Assert.Equal(CustomRoomStatus.Invalid, bad.Status);
+        Assert.False(string.IsNullOrEmpty(bad.Error));
+
+        Assert.True((await c.JoinAsync(room.Code.ToLowerInvariant(), 2002, "Guest")).Ok);
+        var summary = (await c.GetAsync(room.Code))!;
+        Assert.Empty(summary.Members);
+        Assert.Equal(2, summary.MemberCount);
+        Assert.Null(await c.GetAsync("ZZZZZZ"));
+        Assert.Null(await c.GetAsync("../x"));
+
+        Assert.Single(await c.RoomsForAsync(2002));
+        Assert.True((await c.RegisterAsync(2002, room.RoomId)).Ok);
+        Assert.Equal(room.RoomId, (await c.SelectedForAsync(2002))!.RoomId);
+        Assert.Equal(CustomRoomStatus.NotOwner, (await c.CloseAsync(room.Code, 2002)).Status);
+        Assert.True((await c.LeaveAsync(room.Code, 2002)).Ok);
+        Assert.Null(await c.SelectedForAsync(2002));
+        Assert.True((await c.CloseAsync(room.Code, 1001)).Ok);
+        Assert.Empty(await c.RoomsForAsync(1001));
+    }
+
+    [Fact]
+    public async Task HttpClient_WithoutSecret_Throws()
+    {
+        await Assert.ThrowsAsync<HttpRequestException>(() => Client(null).CreateAsync(1, "x", new CustomRoomOptions()));
+    }
+
+    [Fact]
+    public async Task HttpClient_OldMatchmakerWithoutRooms_Throws()
+    {
+        var c = new HttpCustomRoomClient(new HttpClient(), _tagUrl.Replace("/tag", "/nope"), Secret);
+        await Assert.ThrowsAsync<HttpRequestException>(() => c.CreateAsync(1, "x", new CustomRoomOptions()));
+    }
+
+    [Fact]
+    public async Task TwoCardServers_ShareRooms_ThroughTheRegistry()
+    {
+        using var a = new CardServer(Client());
+        using var b = new CardServer(Client());
+        var (acA, chipA) = a.NewCard("a", "PILOT-A");
+        // real card servers have distinct PilotId.ServerId prefixes; here server B simply has an earlier card
+        b.NewCard("b0", "OTHER");
+        var (acB, chipB) = b.NewCard("b", "PILOT-B");
+
+        var made = await a.Ui.Create(new RoomCreateRequest { AccessCode = acA, ChipId = chipA, Name = "Cross", MatchingType = 1 }, default);
+        Assert.True(made.Success, made.Message);
+        var code = made.Room!.Code;
+
+        var joined = await b.Ui.Join(new RoomCodeRequest { AccessCode = acB, ChipId = chipB, Code = code }, default);
+        Assert.True(joined.Success, joined.Message);
+
+        // both LMs list the room (LoadRoom reads RoomsForAsync through the same client)
+        var listA = await a.Ui.List(new RoomsListRequest { AccessCode = acA, ChipId = chipA }, default);
+        var listB = await b.Ui.List(new RoomsListRequest { AccessCode = acB, ChipId = chipB }, default);
+        Assert.Equal(2, Assert.Single(listA.Rooms).MemberCount);
+        var seenByB = Assert.Single(listB.Rooms);
+        Assert.Equal(made.Room.RoomId, seenByB.RoomId);
+        Assert.False(seenByB.IsOwner);
+
+        // PreLoadCard on each cab carries the same matching_tag.id -> same matchmaker key (attr2)
+        var pilotA = listA.YourPilotId; var pilotB = listB.YourPilotId;
+        Assert.NotEqual(pilotA, pilotB);
+        Assert.True((await b.Rooms.RegisterAsync(pilotB, seenByB.RoomId)).Ok);
+        Assert.True((await a.Rooms.RegisterAsync(pilotA, seenByB.RoomId)).Ok);
+        var tagA = CustomRoomReplies.MatchingTag((await a.Rooms.SelectedForAsync(pilotA))!, 6, 7);
+        var tagB = CustomRoomReplies.MatchingTag((await b.Rooms.SelectedForAsync(pilotB))!, 6, 7);
+        Assert.Equal(tagA.Id, tagB.Id);
+        Assert.Equal(tagA.WorldId, tagB.WorldId);
+    }
+
+    private sealed class CardServer : IDisposable
+    {
+        private readonly SqliteConnection _conn;
+        public readonly ServerDbContext Db;
+        public readonly ICustomRoomClient Rooms;
+        public readonly CustomRoomsUiService Ui;
+
+        public CardServer(ICustomRoomClient rooms)
+        {
+            _conn = new SqliteConnection("DataSource=:memory:");
+            _conn.Open();
+            Db = new ServerDbContext(new DbContextOptionsBuilder<ServerDbContext>().UseSqlite(_conn).Options);
+            Db.Database.Migrate();
+            Rooms = rooms;
+            var cfg = new CardServerConfig();
+            cfg.CustomRooms.Enabled = true;
+            cfg.CustomRooms.LocalStore = false;
+            var clock = new CustomRoomStore { UtcNow = () => T0, Zone = TimeZoneInfo.Utc };
+            Ui = new CustomRoomsUiService(Db, rooms, clock, Options.Create(cfg), NullLogger<CustomRoomsUiService>.Instance);
+        }
+
+        public (string ac, string chip) NewCard(string key, string name)
+        {
+            var card = new CardProfile
+            {
+                AccessCode = "test-" + key, ChipId = "test-" + key, SessionId = key, UserName = name, IsNewCard = false,
+                DistinctTeamFormationToken = Guid.NewGuid().ToString("n")[..16],
+            };
+            Db.CardProfiles.Add(card);
+            Db.SaveChangesAsync().GetAwaiter().GetResult();
+            return (card.AccessCode, card.ChipId);
+        }
+
+        public void Dispose()
+        {
+            Db.Dispose();
+            _conn.Dispose();
+        }
+    }
+}
