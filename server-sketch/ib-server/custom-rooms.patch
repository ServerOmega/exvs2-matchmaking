+using Microsoft.AspNetCore.Mvc;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Controllers;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Shared Custom Match room registry (lives with the matchmaker, next to /tag invites).
+/// Card servers call it for the LM's LoadRoom / RegisterRoom; the launcher (stand-in for vsmobile) makes and joins
+/// rooms through its card server. Under /tag, so SecurityGuardMiddleware requires X-Tag-Secret (LAN-only when no
+/// secret is set) and rate limits per IP. Room codes are logged masked. No card secrets are accepted.
+/// Logical outcomes come back as 200 with {status, room}; only bad input is 400.
+/// </summary>
+[ApiController]
+[Route("tag/rooms")]
+public class CustomRoomController : ControllerBase
+{
+    private readonly CustomRoomStore _store;
+
+    public CustomRoomController(CustomRoomStore store) => _store = store;
+
+    public sealed class CreateRequest
+    {
+        public uint OwnerPilotId { get; set; }
+        public string OwnerName { get; set; } = "";
+        public string Name { get; set; } = "";
+        public uint TagType { get; set; } = 1;
+        public uint MatchingType { get; set; } = 1;
+        public uint RuleType { get; set; } = 1;
+        public uint WorldId { get; set; }
+        public uint MemberLimit { get; set; }
+    }
+
+    public sealed class CodeRequest
+    {
+        public string Code { get; set; } = "";
+        public uint PilotId { get; set; }
+    }
+
+    public sealed class RegisterRequest
+    {
+        public uint PilotId { get; set; }
+        public uint RoomId { get; set; }
+    }
+
+    [HttpPost("")]
+    public IActionResult Create([FromBody] CreateRequest b)
+    {
+        if (b.OwnerPilotId == 0) return BadRequest(new { error = "ownerPilotId is required." });
+        return Ok(_store.Create(b.OwnerPilotId, b.OwnerName ?? "", new CustomRoomOptions
+        {
+            Name = b.Name ?? "", TagType = b.TagType, MatchingType = b.MatchingType, RuleType = b.RuleType,
+            WorldId = b.WorldId, MemberLimit = b.MemberLimit,
+        }));
+    }
+
+    [HttpPost("join")]
+    public IActionResult Join([FromBody] CodeRequest b)
+    {
+        if (b.PilotId == 0 || string.IsNullOrWhiteSpace(b.Code)) return BadRequest(new { error = "code and pilotId are required." });
+        return Ok(_store.Join(b.Code, b.PilotId));
+    }
+
+    [HttpPost("leave")]
+    public IActionResult Leave([FromBody] CodeRequest b)
+    {
+        if (b.PilotId == 0 || string.IsNullOrWhiteSpace(b.Code)) return BadRequest(new { error = "code and pilotId are required." });
+        return Ok(_store.Leave(b.Code, b.PilotId));
+    }
+
+    [HttpPost("register")]
+    public IActionResult Register([FromBody] RegisterRequest b)
+    {
+        if (b.PilotId == 0 || b.RoomId == 0) return BadRequest(new { error = "pilotId and roomId are required." });
+        return Ok(_store.Register(b.PilotId, b.RoomId));
+    }
+
+    [HttpGet("pilot/{pilotId}")]
+    public IActionResult RoomsFor(uint pilotId) => Ok(_store.RoomsFor(pilotId));
+
+    [HttpGet("pilot/{pilotId}/selected")]
+    public IActionResult Selected(uint pilotId)
+    {
+        var room = _store.SelectedFor(pilotId);
+        return room == null ? NoContent() : Ok(room);
+    }
+
+    [HttpGet("{code}")]
+    public IActionResult Get(string code)
+    {
+        var room = _store.Get(code);
+        if (room == null) return NotFound(new { status = CustomRoomStatus.NotFound });
+        // public-ish view: no member ids
+        return Ok(new
+        {
+            room.RoomId, room.Code, room.Name, room.OwnerName, room.TagType, room.MatchingType, room.RuleType,
+            currentNum = room.Members.Count, room.MemberLimit, room.ExpiresUtc,
+        });
+    }
+}
