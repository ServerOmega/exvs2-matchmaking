diff --git a/WebUIInfinite/Shared/Dto/Request/RoomsRequests.cs b/WebUIInfinite/Shared/Dto/Request/RoomsRequests.cs
new file mode 100644
index 0000000..05cf7a8
--- /dev/null
+++ b/WebUIInfinite/Shared/Dto/Request/RoomsRequests.cs
@@ -0,0 +1,40 @@
+namespace WebUIInfinite.Shared.Dto.Request;
+
+/// <summary>Rooms page: list this card's rooms for today. Card credentials go in the body.</summary>
+public class RoomsListRequest : BasicCardRequest
+{
+}
+
+/// <summary>Create a Custom Match room. Times are "HH:mm" in the server's room time zone ("" = now / day reset).</summary>
+public class RoomCreateRequest : BasicCardRequest
+{
+    public string Name { get; set; } = "";
+    /// <summary>2 = private (LM private list), 4 = public (LM's single public slot).</summary>
+    public uint TagType { get; set; } = 2;
+    /// <summary>1 = solo (shuffle), 2 = team, 3 = mix.</summary>
+    public uint MatchingType { get; set; } = 1;
+    public uint MemberLimit { get; set; }
+    public string Start { get; set; } = "";
+    public string End { get; set; } = "";
+    public uint ClassIdMin { get; set; } = 1;
+    public uint ClassIdMax { get; set; } = 4;
+    public uint GradeIdMin { get; set; } = 1;
+    public uint GradeIdMax { get; set; } = 11;
+    public uint WinRateUpper { get; set; } = 100;
+    public uint WinRateLower { get; set; }
+    /// <summary>LM "unit setting rule" row (rule_type): 0 = off, 1 = on.</summary>
+    public uint RuleType { get; set; }
+    public uint FesRuleType { get; set; }
+    /// <summary>Preset comment CUSTOM_MTCH_MSG_n (0 = none, 1-11).</summary>
+    public uint Comment { get; set; }
+    /// <summary>Advanced (cabinet side): battle timer override in seconds, 0 = normal.</summary>
+    public uint Timer { get; set; }
+    public bool RevengeFlag { get; set; }
+    public bool RandomStageOnly { get; set; }
+}
+
+/// <summary>Join / leave / close by room code.</summary>
+public class RoomCodeRequest : BasicCardRequest
+{
+    public string Code { get; set; } = "";
+}
diff --git a/WebUIInfinite/Shared/Dto/Response/RoomsResponses.cs b/WebUIInfinite/Shared/Dto/Response/RoomsResponses.cs
new file mode 100644
index 0000000..8b85070
--- /dev/null
+++ b/WebUIInfinite/Shared/Dto/Response/RoomsResponses.cs
@@ -0,0 +1,72 @@
+namespace WebUIInfinite.Shared.Dto.Response;
+
+public class RoomMemberItem
+{
+    public uint PilotId { get; set; }
+    public string Name { get; set; } = "";
+    public bool IsOwner { get; set; }
+    public bool IsYou { get; set; }
+}
+
+public class RoomItem
+{
+    public uint RoomId { get; set; }
+    public string Code { get; set; } = "";
+    public string Name { get; set; } = "";
+    public string OwnerName { get; set; } = "";
+    public uint OwnerPilotId { get; set; }
+    public bool IsOwner { get; set; }
+    public uint TagType { get; set; }
+    public uint MatchingType { get; set; }
+    public int MemberCount { get; set; }
+    public uint MemberLimit { get; set; }
+    /// <summary>"HH:mm" in the room time zone.</summary>
+    public string Start { get; set; } = "";
+    public string End { get; set; } = "";
+    public bool OpenNow { get; set; }
+    /// <summary>Picked on the LM (RegisterRoom) by this card.</summary>
+    public bool Selected { get; set; }
+    public uint ClassIdMin { get; set; }
+    public uint ClassIdMax { get; set; }
+    public uint GradeIdMin { get; set; }
+    public uint GradeIdMax { get; set; }
+    public uint WinRateUpper { get; set; }
+    public uint WinRateLower { get; set; }
+    public uint RuleType { get; set; }
+    public uint FesRuleType { get; set; }
+    public uint Comment { get; set; }
+    public uint Timer { get; set; }
+    public bool RevengeFlag { get; set; }
+    public bool RandomStageOnly { get; set; }
+    public List<RoomMemberItem> Members { get; set; } = new();
+}
+
+public class RoomsListResponse
+{
+    public bool Success { get; set; }
+    public string? Message { get; set; }
+    public uint YourPilotId { get; set; }
+    public string YourName { get; set; } = "";
+    /// <summary>Room time zone id and the current time / day reset there ("HH:mm").</summary>
+    public string TimeZone { get; set; } = "";
+    public string Now { get; set; } = "";
+    public string DayEnd { get; set; } = "";
+    public int MaxRoomsPerOwner { get; set; }
+    public uint MaxMembers { get; set; }
+    /// <summary>Default class range for new rooms.</summary>
+    public uint DefaultClassIdMin { get; set; } = 1;
+    public uint DefaultClassIdMax { get; set; } = 4;
+    /// <summary>This card's solo / team class (1-4, 0 = none yet).</summary>
+    public uint YourSoloClass { get; set; }
+    public uint YourTeamClass { get; set; }
+    public List<RoomItem> Rooms { get; set; } = new();
+}
+
+public class RoomActionResponse
+{
+    public bool Success { get; set; }
+    /// <summary>Ok, NotFound, Full, Limit, Invalid, NotOwner, NotAllowed, ...</summary>
+    public string Status { get; set; } = "";
+    public string? Message { get; set; }
+    public RoomItem? Room { get; set; }
