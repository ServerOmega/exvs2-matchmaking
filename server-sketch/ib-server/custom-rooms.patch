@@ -0,0 +1,74 @@
+using nue.protocol.exvs;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Builds the LM Custom Match replies (pure, no DB) so they can be unit tested.
+/// Field layout is from the exe's own descriptor (analysis/proto/from_exe/game_server_nue.proto):
+/// Response.LoadRoom {pilot_id 1, is_new_card 2, rooms 3 (RoomGroup), status 4, acid_error 5};
+/// RoomGroup required: tag_id, registration_code, tag_type, matching_type, start_date, end_date, class_id_min/max;
+/// Response.RegisterRoom {status 1 (required)}.
+/// </summary>
+public static class CustomRoomReplies
+{
+    /// <summary>LoadRoom / RegisterRoom status values we send. 0 = OK (assumed; the LM's reading is unverified).</summary>
+    public const uint StatusOk = 0;
+    public const uint StatusError = 1;
+
+    public static Response.LoadRoom LoadRoom(uint pilotId, bool isNewCard, IEnumerable<CustomRoom> rooms,
+        uint classIdMin = 1, uint classIdMax = 4)
+    {
+        var reply = new Response.LoadRoom
+        {
+            PilotId = pilotId,
+            IsNewCard = isNewCard,
+            Status = StatusOk,
+            AcidError = AcidError.AcidSuccess,
+        };
+        if (isNewCard) return reply;
+        foreach (var r in rooms)
+            reply.rooms.Add(RoomGroup(r, classIdMin, classIdMax));
+        return reply;
+    }
+
+    public static Response.LoadRoom.RoomGroup RoomGroup(CustomRoom r, uint classIdMin = 1, uint classIdMax = 4) => new()
+    {
+        TagId = r.RoomId,
+        RegistrationCode = r.Code,
+        TagType = r.TagType,
+        MatchingType = r.MatchingType,
+        StartDate = Unix(r.CreatedUtc),
+        EndDate = Unix(r.ExpiresUtc),
+        CurrentNum = (uint)r.Members.Count,
+        MemberLimit = r.MemberLimit,
+        ClassIdMin = classIdMin,
+        ClassIdMax = classIdMax,
+        RuleType = r.RuleType,
+    };
+
+    public static Response.RegisterRoom RegisterRoom(bool ok) => new() { Status = ok ? StatusOk : StatusError };
+
+    /// <summary>PreLoadCard.matching_tag for a room picked on the LM (shape of upstream PrivateRoomCommand + world_id).</summary>
+    public static Response.PreLoadCard.MatchingTag MatchingTag(CustomRoom r, uint soloWorldId, uint teamWorldId)
+    {
+        var tag = new Response.PreLoadCard.MatchingTag
+        {
+            Id = r.RoomId,
+            TagName = string.IsNullOrEmpty(r.Name) ? r.Code : r.Name,
+            TagType = r.TagType,
+            MatchingType = r.MatchingType,
+            EndDate = Unix(r.ExpiresUtc),
+            MatchingAttribute = 1,
+            RuleType = r.RuleType,
+            OncompeMatchingFlag = false,
+        };
+        tag.WorldId = WorldFor(r, soloWorldId, teamWorldId);
+        return tag;
+    }
+
+    public static uint WorldFor(CustomRoom r, uint soloWorldId, uint teamWorldId) =>
+        r.WorldId != 0 ? r.WorldId : r.MatchingType == 2 ? teamWorldId : soloWorldId;
+
+    private static ulong Unix(DateTime utc) =>
+        (ulong)Math.Max(0, new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)).ToUnixTimeSeconds());
+}
diff --git a/Server-Infinite/Matchmaking/CustomRoomStore.cs b/Server-Infinite/Matchmaking/CustomRoomStore.cs
new file mode 100644
index 0000000..ec2684d
--- /dev/null
+++ b/Server-Infinite/Matchmaking/CustomRoomStore.cs
@@ -0,0 +1,327 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] A Custom Match room (カスタムマッチ). Made from the launcher (stand-in for vsmobile),
+/// joined with its room code, listed on the LM by LoadRoom and picked there with RegisterRoom. Pilot ids are wire
+/// ids (<see cref="PilotId.Wire"/>), so one registry can serve several card servers. No card secrets are stored.
+/// </summary>
+public sealed class CustomRoom
+{
+    /// <summary>LoadRoom.RoomGroup.tag_id, RegisterRoom.room_id and PreLoadCard.matching_tag.id.</summary>
+    public uint RoomId { get; set; }
+    /// <summary>Room code (LoadRoom.RoomGroup.registration_code).</summary>
+    public string Code { get; set; } = "";
+    public string Name { get; set; } = "";
+    public uint OwnerPilotId { get; set; }
+    public string OwnerName { get; set; } = "";
+    /// <summary>1 = no MS restriction, 2 = MS restriction (upstream PrivateMatchRoom.TagType).</summary>
+    public uint TagType { get; set; } = 1;
+    /// <summary>1 = solo, 2 = team.</summary>
+    public uint MatchingType { get; set; } = 1;
+    public uint RuleType { get; set; } = 1;
+    /// <summary>World sent in PreLoadCard.matching_tag.world_id (0 = the configured default for the matching type).</summary>
+    public uint WorldId { get; set; }
+    public uint MemberLimit { get; set; } = 32;
+    public List<uint> Members { get; set; } = new();
+    public DateTime CreatedUtc { get; set; }
+    public DateTime ExpiresUtc { get; set; }
+}
+
+public sealed class CustomRoomOptions
+{
+    public string Name { get; set; } = "";
+    public uint TagType { get; set; } = 1;
+    public uint MatchingType { get; set; } = 1;
+    public uint RuleType { get; set; } = 1;
+    public uint WorldId { get; set; }
+    public uint MemberLimit { get; set; }
+}
+
+public enum CustomRoomStatus
+{
+    Ok = 0,
+    NotFound = 1,
+    Full = 2,
+    NotMember = 3,
+    TooManyRooms = 4,
+    Invalid = 5,
+    NotOwner = 6,
+}
+
+/// <summary>Outcome of create / join / leave / register. <see cref="Room"/> is a copy.</summary>
+public sealed record CustomRoomResult(CustomRoomStatus Status, CustomRoom? Room = null)
+{
+    [JsonIgnore] public bool Ok => Status == CustomRoomStatus.Ok;
+}
+
+/// <summary>
+/// In-memory + JSON-backed Custom Match room registry. Rooms expire at the end of the day (the configured reset hour
+/// in the configured zone); a pilot's LM pick (RegisterRoom) is kept until its room expires. Thread-safe.
+/// </summary>
+public sealed class CustomRoomStore
+{
+    public const int CodeLength = 6;
+    // Same alphabet as online-tag codes: no 0/O/1/I, so a code can be read aloud or off a screenshot.
+    private const string Alphabet = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ";
+    public const uint MaxMemberLimit = 64;
+
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        WriteIndented = true,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+    };
+
+    private readonly object _gate = new();
+    private readonly string? _path;
+    private readonly Dictionary<string, CustomRoom> _byCode = new(StringComparer.OrdinalIgnoreCase);
+    private readonly Dictionary<uint, uint> _selected = new(); // pilot -> room id (LM RegisterRoom)
+    private uint _nextRoomId = 1;
+
+    public Func<DateTime> UtcNow { get; set; } = () => DateTime.UtcNow;
+    public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;
+    public int DayResetHour { get; set; }
+    public uint DefaultMemberLimit { get; set; } = 32;
+    public int MaxRoomsPerOwner { get; set; } = 3;
+    public int MaxRoomsPerPilot { get; set; } = 10;
+    public Action<string>? Log { get; set; }
+
+    public CustomRoomStore(string? statePath = null)
+    {
+        _path = string.IsNullOrWhiteSpace(statePath) ? null : statePath;
+        if (_path == null || !File.Exists(_path)) return;
+        try
+        {
+            var snap = JsonSerializer.Deserialize<Snapshot>(File.ReadAllText(_path), JsonOpts);
+            if (snap == null) return;
+            foreach (var r in snap.Rooms ?? new())
+                if (!string.IsNullOrWhiteSpace(r.Code) && r.RoomId != 0) _byCode[Normalize(r.Code)] = r;
+            foreach (var kv in snap.Selected ?? new()) _selected[kv.Key] = kv.Value;
+            _nextRoomId = Math.Max(snap.NextRoomId, _byCode.Values.Select(r => r.RoomId).DefaultIfEmpty(0u).Max() + 1);
+        }
+        catch (Exception)
+        {
+            // corrupt state: start empty
+        }
+    }
+
+    public int Count { get { lock (_gate) { Prune(); return _byCode.Count; } } }
+
+    public static string Normalize(string? code) => (code ?? "").Trim().Replace("-", "").ToUpperInvariant();
+
+    /// <summary>Masked code for logs (AB****).</summary>
+    public static string MaskCode(string? code)
+    {
+        var c = Normalize(code);
+        return c.Length <= 2 ? new string('*', c.Length) : c[..2] + new string('*', c.Length - 2);
+    }
+
+    /// <summary>End of the room day for <paramref name="utc"/>: the next DayResetHour in <see cref="Zone"/>.</summary>
+    public DateTime EndOfDayUtc(DateTime utc)
+    {
+        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), Zone);
+        var reset = local.Date.AddHours(Math.Clamp(DayResetHour, 0, 23));
+        if (reset <= local) reset = reset.AddDays(1);
+        try
+        {
+            return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(reset, DateTimeKind.Unspecified), Zone);
+        }
+        catch (ArgumentException)
+        {
+            // reset hour falls in a DST gap: use one hour later
+            return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(reset.AddHours(1), DateTimeKind.Unspecified), Zone);
+        }
+    }
+
+    public CustomRoomResult Create(uint ownerPilotId, string ownerName, CustomRoomOptions? options = null)
+    {
+        if (ownerPilotId == 0) return new(CustomRoomStatus.Invalid);
+        var o = options ?? new CustomRoomOptions();
+        if (o.MatchingType is not (1 or 2) || o.TagType is not (1 or 2)) return new(CustomRoomStatus.Invalid);
+        lock (_gate)
+        {
+            Prune();
+            if (_byCode.Values.Count(r => r.OwnerPilotId == ownerPilotId) >= Math.Max(1, MaxRoomsPerOwner))
+                return new(CustomRoomStatus.TooManyRooms);
+            if (_byCode.Values.Count(r => r.Members.Contains(ownerPilotId)) >= Math.Max(1, MaxRoomsPerPilot))
+                return new(CustomRoomStatus.TooManyRooms);
+            string code;
+            do { code = NewCode(); } while (_byCode.ContainsKey(code));
+            var now = UtcNow();
+            var limit = o.MemberLimit == 0 ? DefaultMemberLimit : o.MemberLimit;
+            var room = new CustomRoom
+            {
+                RoomId = _nextRoomId++,
+                Code = code,
+                Name = TagInviteStore.CleanName(o.Name),
+                OwnerPilotId = ownerPilotId,
+                OwnerName = TagInviteStore.CleanName(ownerName),
+                TagType = o.TagType,
+                MatchingType = o.MatchingType,
+                RuleType = o.RuleType == 0 ? 1 : o.RuleType,
+                WorldId = o.WorldId,
+                MemberLimit = Math.Clamp(limit, 2u, MaxMemberLimit),
+                Members = new List<uint> { ownerPilotId },
+                CreatedUtc = now,
+                ExpiresUtc = EndOfDayUtc(now),
+            };
+            _byCode[code] = room;
+            Persist();
+            Log?.Invoke($"ROOM-CREATE id={room.RoomId} code={MaskCode(code)} owner={ownerPilotId} matching={room.MatchingType} tag={room.TagType}");
+            return new(CustomRoomStatus.Ok, Clone(room));
+        }
+    }
+
+    public CustomRoomResult Join(string code, uint pilotId)
+    {
+        if (pilotId == 0) return new(CustomRoomStatus.Invalid);
+        lock (_gate)
+        {
+            Prune();
+            if (!_byCode.TryGetValue(Normalize(code), out var room)) return new(CustomRoomStatus.NotFound);
+            if (room.Members.Contains(pilotId)) return new(CustomRoomStatus.Ok, Clone(room));
+            if (room.Members.Count >= room.MemberLimit) return new(CustomRoomStatus.Full, Clone(room));
+            if (_byCode.Values.Count(r => r.Members.Contains(pilotId)) >= Math.Max(1, MaxRoomsPerPilot))
+                return new(CustomRoomStatus.TooManyRooms);
+            room.Members.Add(pilotId);
+            Persist();
+            Log?.Invoke($"ROOM-JOIN id={room.RoomId} pilot={pilotId} members={room.Members.Count}");
+            return new(CustomRoomStatus.Ok, Clone(room));
+        }
+    }
+
+    /// <summary>Leave a room. The owner leaving closes it.</summary>
+    public CustomRoomResult Leave(string code, uint pilotId)
+    {
+        lock (_gate)
+        {
+            Prune();
+            if (!_byCode.TryGetValue(Normalize(code), out var room)) return new(CustomRoomStatus.NotFound);
+            if (!room.Members.Contains(pilotId)) return new(CustomRoomStatus.NotMember);
+            if (room.OwnerPilotId == pilotId)
+            {
+                RemoveRoom(room);
+                Log?.Invoke($"ROOM-CLOSE id={room.RoomId} by owner");
+            }
+            else
+            {
+                room.Members.Remove(pilotId);
+                if (_selected.TryGetValue(pilotId, out var sel) && sel == room.RoomId) _selected.Remove(pilotId);
+                Log?.Invoke($"ROOM-LEAVE id={room.RoomId} pilot={pilotId}");
+            }
+            Persist();
+            return new(CustomRoomStatus.Ok, Clone(room));
+        }
+    }
+
+    public CustomRoom? Get(string code)
+    {
+        lock (_gate)
+        {
+            Prune();
+            return _byCode.TryGetValue(Normalize(code), out var r) ? Clone(r) : null;
+        }
+    }
+
+    /// <summary>Rooms <paramref name="pilotId"/> can enter today (LoadRoom), oldest first.</summary>
+    public IReadOnlyList<CustomRoom> RoomsFor(uint pilotId)
+    {
+        lock (_gate)
+        {
+            Prune();
+            return _byCode.Values.Where(r => r.Members.Contains(pilotId)).OrderBy(r => r.RoomId).Select(Clone).ToList();
+        }
+    }
+
+    /// <summary>LM RegisterRoom: the pilot picks one of its rooms for today's credits.</summary>
+    public CustomRoomResult Register(uint pilotId, uint roomId)
+    {
+        lock (_gate)
+        {
+            Prune();
+            var room = _byCode.Values.FirstOrDefault(r => r.RoomId == roomId);
+            if (room == null) return new(CustomRoomStatus.NotFound);
+            if (!room.Members.Contains(pilotId)) return new(CustomRoomStatus.NotMember);
+            _selected[pilotId] = roomId;
+            Persist();
+            Log?.Invoke($"ROOM-REGISTER id={roomId} pilot={pilotId}");
+            return new(CustomRoomStatus.Ok, Clone(room));
+        }
+    }
+
+    /// <summary>The room picked on the LM today, if it is still open and the pilot is still a member.</summary>
+    public CustomRoom? SelectedFor(uint pilotId)
+    {
+        lock (_gate)
+        {
+            Prune();
+            if (!_selected.TryGetValue(pilotId, out var id)) return null;
+            var room = _byCode.Values.FirstOrDefault(r => r.RoomId == id && r.Members.Contains(pilotId));
+            return room == null ? null : Clone(room);
+        }
+    }
+
+    private void RemoveRoom(CustomRoom room)
+    {
+        _byCode.Remove(Normalize(room.Code));
+        foreach (var p in _selected.Where(kv => kv.Value == room.RoomId).Select(kv => kv.Key).ToList()) _selected.Remove(p);
+    }
+
+    private void Prune()
+    {
+        var now = UtcNow();
+        var dead = _byCode.Values.Where(r => r.ExpiresUtc <= now).ToList();
+        if (dead.Count == 0) return;
+        foreach (var r in dead) RemoveRoom(r);
+        Log?.Invoke($"ROOM-EXPIRE {dead.Count} room(s)");
+        Persist();
+    }
+
+    private static string NewCode()
+    {
+        Span<char> chars = stackalloc char[CodeLength];
+        for (var i = 0; i < CodeLength; i++)
+            chars[i] = Alphabet[System.Security.Cryptography.RandomNumberGenerator.GetInt32(Alphabet.Length)];
+        return new string(chars);
+    }
+
+    private static CustomRoom Clone(CustomRoom r) => new()
+    {
+        RoomId = r.RoomId, Code = r.Code, Name = r.Name, OwnerPilotId = r.OwnerPilotId, OwnerName = r.OwnerName,
+        TagType = r.TagType, MatchingType = r.MatchingType, RuleType = r.RuleType, WorldId = r.WorldId,
+        MemberLimit = r.MemberLimit, Members = r.Members.ToList(), CreatedUtc = r.CreatedUtc, ExpiresUtc = r.ExpiresUtc,
+    };
+
+    private void Persist()
+    {
+        if (_path == null) return;
+        try
+        {
+            var snap = new Snapshot
+            {
+                NextRoomId = _nextRoomId,
+                Rooms = _byCode.Values.ToList(),
+                Selected = _selected.ToDictionary(kv => kv.Key, kv => kv.Value),
+            };
+            var dir = Path.GetDirectoryName(_path);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+            var tmp = _path + ".tmp";
+            File.WriteAllText(tmp, JsonSerializer.Serialize(snap, JsonOpts));
+            File.Move(tmp, _path, overwrite: true);
+        }
+        catch (Exception e)
+        {
+            Log?.Invoke("ROOM-PERSIST failed: " + e.GetBaseException().Message);
+        }
+    }
+
+    private sealed class Snapshot
+    {
+        public uint NextRoomId { get; set; } = 1;
+        public List<CustomRoom>? Rooms { get; set; }
+        public Dictionary<uint, uint>? Selected { get; set; }
+    }
+}
