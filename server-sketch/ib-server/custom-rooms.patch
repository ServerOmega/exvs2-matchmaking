+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.CustomRooms;
+
+/// <summary>
+/// [exvs2-lobbies 2026-11-17] Card server → matchmaker /tag/rooms. Same base URL and X-Tag-Secret header as the
+/// online tag client, so no new port, allowlist entry or secret. Never sends card secrets (wire pilot ids only).
+/// </summary>
+public sealed class HttpCustomRoomClient : ICustomRoomClient
+{
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        Converters = { new JsonStringEnumConverter() },
+    };
+
+    private readonly HttpClient _http;
+    private readonly string _base;
+
+    /// <param name="tagBaseUrl">The /tag URL (for example http://host:28090/tag); /rooms is appended.</param>
+    public HttpCustomRoomClient(HttpClient http, string tagBaseUrl, string? sharedSecret = null)
+    {
+        _http = http;
+        _base = tagBaseUrl.TrimEnd('/') + "/rooms";
+        _http.Timeout = TimeSpan.FromSeconds(4);
+        if (!string.IsNullOrEmpty(sharedSecret))
+            _http.DefaultRequestHeaders.TryAddWithoutValidation(ServerInfinite.Lobbies.NetworkAccess.TagSecretHeader, sharedSecret);
+    }
+
+    public Task<CustomRoomResult> CreateAsync(uint ownerPilotId, string ownerName, CustomRoomOptions options, CancellationToken ct = default) =>
+        Post("", new { ownerPilotId, ownerName, options.Name, options.TagType, options.MatchingType, options.RuleType, options.WorldId, options.MemberLimit }, ct);
+
+    public Task<CustomRoomResult> JoinAsync(string code, uint pilotId, CancellationToken ct = default) =>
+        Post("/join", new { code, pilotId }, ct);
+
+    public Task<CustomRoomResult> LeaveAsync(string code, uint pilotId, CancellationToken ct = default) =>
+        Post("/leave", new { code, pilotId }, ct);
+
+    public Task<CustomRoomResult> RegisterAsync(uint pilotId, uint roomId, CancellationToken ct = default) =>
+        Post("/register", new { pilotId, roomId }, ct);
+
+    public async Task<IReadOnlyList<CustomRoom>> RoomsForAsync(uint pilotId, CancellationToken ct = default)
+    {
+        var r = await _http.GetAsync($"{_base}/pilot/{pilotId}", ct);
+        r.EnsureSuccessStatusCode();
+        return await r.Content.ReadFromJsonAsync<List<CustomRoom>>(Json, ct) ?? new List<CustomRoom>();
+    }
+
+    public async Task<CustomRoom?> SelectedForAsync(uint pilotId, CancellationToken ct = default)
+    {
+        var r = await _http.GetAsync($"{_base}/pilot/{pilotId}/selected", ct);
+        if (r.StatusCode is HttpStatusCode.NoContent or HttpStatusCode.NotFound) return null;
+        r.EnsureSuccessStatusCode();
+        return await r.Content.ReadFromJsonAsync<CustomRoom>(Json, ct);
+    }
+
+    private async Task<CustomRoomResult> Post(string path, object body, CancellationToken ct)
+    {
+        var r = await _http.PostAsJsonAsync(_base + path, body, Json, ct);
+        if ((int)r.StatusCode >= 500 || r.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
+            r.EnsureSuccessStatusCode();
+        return await r.Content.ReadFromJsonAsync<CustomRoomResult>(Json, ct)
+               ?? throw new InvalidOperationException("Empty /tag/rooms response.");
+    }
+}
