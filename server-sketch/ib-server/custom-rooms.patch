+    /// <summary>Web create / join also picks the room for the cab (same as the LM's RegisterRoom), so the next
+    /// PreLoadCard carries matching_tag without an LM visit. Uses the registry's existing /register call, so the
+    /// matchmaker needs no update. A later LM RegisterRoom (or "Use this room") overrides it.</summary>
+    private async Task<bool> AutoSelect(uint self, CustomRoom room, CancellationToken ct)
+    {
+        if (!_cfg.WebSelectsRoom) return false;
+        try
+        {
+            var reg = await _rooms.RegisterAsync(self, room.RoomId, ct);
+            if (reg.Ok) _log.LogInformation("Rooms: pilot {Pilot} selected room {Room} (web)", self, room.RoomId);
+            else _log.LogWarning("Rooms: pilot {Pilot} auto-select room {Room} failed: {Status}", self, room.RoomId, reg.Status);
+            return reg.Ok;
+        }
+        catch (Exception ex)
+        {
+            _log.LogWarning("Rooms: auto-select failed: {Error}", ex.Message);
+            return false;
+        }
+    }
+
+    /// <summary>"Use this room": pick one of the card's rooms for the cab (like RegisterRoom on the LM).</summary>
+    public async Task<RoomActionResponse> Select(RoomCodeRequest r, CancellationToken ct)
+    {
+        var card = Card(r);
+        if (card is null) return Fail("Invalid", "Card Profile is invalid");
+        var self = PilotId.Wire(card.Id);
+        var code = CustomRoomStore.Normalize(r.Code);
+        if (code.Length == 0) return Fail("NotFound", "Room code is required.");
+        try
+        {
+            var room = (await _rooms.RoomsForAsync(self, ct)).FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase));
+            if (room == null) return Fail("NotMember", "You are not in that room.");
+            var res = await _rooms.RegisterAsync(self, room.RoomId, ct);
+            _log.LogInformation("Rooms: pilot {Pilot} select room {Room}: {Status}", self, room.RoomId, res.Status);
+            var resp = From(res, self);
+            resp.Selected = res.Ok;
+            return resp;
+        }
+        catch (Exception ex)
+        {
+            _log.LogWarning("Rooms: select failed: {Error}", ex.Message);
+            return Fail("Error", "Room server is unreachable.");
+        }
+    }
+
     public async Task<RoomActionResponse> Leave(RoomCodeRequest r, CancellationToken ct) =>
         await Simple(r, "leave", (code, self) => _rooms.LeaveAsync(code, self, ct));
 
