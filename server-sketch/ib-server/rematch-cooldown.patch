diff --git a/Tests/Matchmaking.Tests/RematchCooldownTests.cs b/Tests/Matchmaking.Tests/RematchCooldownTests.cs
new file mode 100644
index 0000000..af28583
--- /dev/null
+++ b/Tests/Matchmaking.Tests/RematchCooldownTests.cs
@@ -0,0 +1,318 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// LA 2026-11-16 (cdd7bf8): room 19 (mix, 15:15:55Z) was an EXACT rematch of room 18 (nodes 1406/1400/1404/1402, same
+// teams) formed the second the 4th cab re-entered, 27 s after room 18's results; two cabs got 21-01 while loading.
+// Room 13 (class, 14:49:38Z) was the same for room 12 (nodes 1372-1378, entries 14:49:18/18/37/38), no result saved.
+// RematchCooldownSeconds keeps nodes of one room apart until N s after both re-entered. ROOM-END logs each node's end.
+public class RematchCooldownTests
+{
+    private const uint Mix = 23, ClassSolo = 13, ClassTeam = 14, Recruit = 21, Fes1on1 = 20;
+
+    private static Client Cl(uint node)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = $"PCB{node}", LocId = "JPN0JPN1", PrefCode = 1, GlobalIpaddress = "203.0.113.8",
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Entry(uint node, uint apply, uint world, uint? member = null)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = apply, Myclient = Cl(node), MatchingTimeout = 150, SeqNum = 1, CreateRoomFlag = 1,
+            Myplayer = new Player { BanapassportAmId = node },
+            World = new World { MuchaGameId = "GIB1", Version = 106547, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = world == Mix ? 0 : 1 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = 3 });
+        if (member != null)
+            e.Groups.Add(new Request.EntryMatching.Group { Client = Cl(member.Value), Player = new Player { BanapassportAmId = member.Value } });
+        return e;
+    }
+
+    /// <summary>The LA policy (cdd7bf8 server.json) plus the new settings.</summary>
+    private static Matchmaker New(double cooldown, List<string>? log = null, bool roomEnd = true) =>
+        new(fillAfter: 3, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, MaxFillWait = 3, InStoreFillAfter = 3, InStoreMaxFillWait = 3,
+            NoCpuPartner = true,
+            ContinuePairMode = Matchmaker.ContinuePairPolicy.VsCpu,
+            ContinuePairSeconds = 12,
+            ContinuePairScope = Matchmaker.ContinuePairScopeKind.AnyDuo,
+            ContinuePairAfterCpuSeconds = 2,
+            CpuPartnerCancelSeconds = 5,
+            PlaceCpuPartnerTeams = true,
+            RematchCooldownSeconds = cooldown,
+            RoomEndLog = roomEnd,
+            Log = log == null ? null : log.Add,
+        };
+
+    private static readonly uint[] Room18 = { 1406, 1400, 1402, 1404 };
+
+    /// <summary>15:12:41-47Z: the four cabs enter mix and get room 18 (t = 0 is the room).</summary>
+    private static Matchmaker.Room FirstRoom(Matchmaker mm, uint world = Mix, uint[]? nodes = null, double at = 0)
+    {
+        nodes ??= Room18;
+        foreach (var n in nodes) Assert.Equal(ErrorCode.Success, mm.Entry(Entry(n, 1, world), at));
+        var r = mm.Check(nodes[0], at + 0.5);
+        Assert.NotNull(r.Room);
+        Assert.Equal(4, r.Room!.Humans);
+        return r.Room;
+    }
+
+    private static Matchmaker.Room? Poll(Matchmaker mm, uint node, double t) => mm.Check(node, t).Room;
+
+    [Fact]
+    public void Defaults_matchmaker_off_config_30s_and_room_end_log_on()
+    {
+        var mm = new Matchmaker(3, true, 15, 1);
+        Assert.Equal(0, mm.RematchCooldownSeconds);
+        Assert.False(mm.RoomEndLog);
+        var cfg = new OnlineMatchingConfigurations();
+        Assert.Equal(30, cfg.RematchCooldownSeconds);
+        Assert.True(cfg.LogRoomEnd);
+        Assert.Equal(900, cfg.RoomEndTimeoutSeconds);
+    }
+
+    [Fact]
+    public void Off_keeps_old_behaviour_exact_rematch_at_once()
+    {
+        var mm = New(0);
+        var r18 = FirstRoom(mm);
+        foreach (var n in Room18) mm.Entry(Entry(n, 2, Mix), 188);
+        var r19 = Poll(mm, 1406, 188.2);
+        Assert.NotNull(r19);
+        Assert.NotEqual(r18.RoomId, r19!.RoomId);
+    }
+
+    [Fact]
+    public void Room19_replay_exact_rematch_waits_30s_after_the_first_reentry_then_forms()
+    {
+        var log = new List<string>();
+        var mm = New(30, log);
+        FirstRoom(mm);
+        foreach (var n in Room18) mm.Entry(Entry(n, 2, Mix), 188);   // all four within one second
+        foreach (var t in new[] { 188.5, 191.0, 194.0, 200.0, 210.0, 217.9 })
+            foreach (var n in Room18) Assert.Null(Poll(mm, n, t));
+        Assert.Single(log, l => l.StartsWith("REMATCH-COOLDOWN defer mix-match nodes=[1400,1402,1404,1406] room=1 "));
+        var r = Poll(mm, 1406, 218.1);
+        Assert.NotNull(r);
+        Assert.Equal(4, r!.Humans);
+        Assert.Contains(log, l => l.StartsWith($"REMATCH-COOLDOWN placed room={r.RoomId} ") && l.Contains("after 30"));
+        foreach (var n in Room18) Assert.Same(r, Poll(mm, n, 218.5));
+    }
+
+    [Fact]
+    public void Room13_replay_staggered_reentries_wait_30s_from_the_first_one()
+    {
+        var mm = New(30);
+        var nodes = new uint[] { 1374, 1376, 1372, 1378 };
+        FirstRoom(mm, ClassSolo, nodes);
+        mm.Entry(Entry(1378, 2, ClassSolo), 161);    // 14:49:18
+        mm.Entry(Entry(1374, 2, ClassSolo), 161);
+        mm.Entry(Entry(1372, 2, ClassSolo), 180);    // 14:49:37
+        mm.Entry(Entry(1376, 2, ClassSolo), 181);    // 14:49:38: room 13 formed here (20 s after the first)
+        Assert.Null(Poll(mm, 1376, 181.2));
+        Assert.Null(Poll(mm, 1378, 190.9));
+        Assert.NotNull(Poll(mm, 1376, 191.1));
+    }
+
+    [Fact]
+    public void Pure_solo_rematch_like_0859Z_that_played_is_not_delayed()
+    {
+        // 08:58:13 three back, 08:59:02 the 4th (49 s after the first): room 2 at once, played (+176 s)
+        var log = new List<string>();
+        var mm = New(30, log);
+        var nodes = new uint[] { 1296, 1298, 1300, 1302 };
+        FirstRoom(mm, Mix, nodes);
+        foreach (var n in nodes.Take(3)) mm.Entry(Entry(n, 2, Mix), 187);
+        mm.Entry(Entry(1302, 2, Mix), 236);
+        Assert.NotNull(Poll(mm, 1302, 236.2));
+        Assert.DoesNotContain(log, l => l.StartsWith("REMATCH-COOLDOWN"));
+    }
+
+    [Fact]
+    public void Fresh_cabs_match_at_once_while_the_rematch_group_waits()
+    {
+        var mm = New(30);
+        FirstRoom(mm);
+        foreach (var n in Room18) mm.Entry(Entry(n, 2, Mix), 188);
+        var fresh = new uint[] { 2000, 2002, 2004, 2006 };
+        foreach (var n in fresh) mm.Entry(Entry(n, 1, Mix), 189);
+        var rf = Poll(mm, 2000, 189.5);
+        Assert.NotNull(rf);                               // formed at once, never with two cabs of the old room
+        Assert.True(rf!.Clients.Count(c => Room18.Contains(c.Client.NodeId)) <= 1);
+        var held = Room18.Where(n => !rf.Clients.Any(c => c.Client.NodeId == n)).ToList();
+        Assert.True(held.Count >= 3);
+        Assert.Null(Poll(mm, held[0], 190));
+        Assert.NotNull(Poll(mm, held[0], 218.5));
+    }
+
+    [Fact]
+    public void Two_from_the_room_plus_two_fresh_is_still_held_but_unrelated_pairs_are_fine()
+    {
+        var mm = New(30);
+        FirstRoom(mm);
+        mm.Entry(Entry(1406, 2, Mix), 188);
+        mm.Entry(Entry(1400, 2, Mix), 188);
+        mm.Entry(Entry(3000, 1, Mix), 188);
+        mm.Entry(Entry(3002, 1, Mix), 188);
+        Assert.Null(Poll(mm, 3000, 190));                  // 1406 + 1400 were in room 1
+        Assert.NotNull(Poll(mm, 3000, 218.1));
+
+        // only ONE node of the old room among fresh players: no pair, no wait
+        var mm2 = New(30);
+        FirstRoom(mm2);
+        mm2.Entry(Entry(1406, 2, Mix), 188);
+        foreach (var n in new uint[] { 3000, 3002, 3004 }) mm2.Entry(Entry(n, 1, Mix), 188);
+        Assert.NotNull(Poll(mm2, 1406, 188.5));
+    }
+
+    [Fact]
+    public void Continue_pair_winners_still_get_their_cpu_room_and_losers_hold()
+    {
+        var log = new List<string>();
+        var mm = New(30, log);
+        var room = FirstRoom(mm, ClassSolo, Room18);
+        var side0 = room.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).ToList();
+        var side1 = room.Clients.Where(c => c.GroupId == 1).Select(c => c.Client.NodeId).ToList();
+        // winners continue as a duo in class-team, losers come back solo in class-solo (different buckets: unchanged)
+        mm.Entry(Entry(side0[0], 2, ClassTeam, side0[1]), 180);
+        mm.Entry(Entry(side1[0], 2, ClassSolo), 181);
+        mm.Entry(Entry(side1[1], 2, ClassSolo), 181);
+        Assert.Null(Poll(mm, side0[0], 183));
+        var cpu = Poll(mm, side0[0], 192.1);                // ContinuePairSeconds 12
+        Assert.NotNull(cpu);
+        Assert.Equal(2, cpu!.Humans);
+        Assert.Equal(2, cpu.Clients.Count(c => c.Client.Properties.Any(p => p.PropertyValue == "N")));
+
+        // same world (mix): the continued duo + the two losers regroup into a 4-human room at once (rooms with a team
+        // entry are not held: 09:01:59Z room 3 formed 1 s after all four re-entered and played)
+        var log2 = new List<string>();
+        var mm2 = New(30, log2);
+        var r2 = FirstRoom(mm2);
+        var a = r2.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).ToList();
+        var b = r2.Clients.Where(c => c.GroupId == 1).Select(c => c.Client.NodeId).ToList();
+        mm2.Entry(Entry(a[0], 2, Mix, a[1]), 180);
+        mm2.Entry(Entry(b[0], 2, Mix), 181);
+        mm2.Entry(Entry(b[1], 2, Mix), 181);
+        var four = Poll(mm2, a[0], 181.5);
+        Assert.NotNull(four);
+        Assert.Equal(4, four!.Humans);
+        Assert.DoesNotContain(log2, l => l.StartsWith("REMATCH-COOLDOWN"));
+    }
+
+    [Fact]
+    public void After_cpu_duo_reentry_is_not_held_by_its_own_cpu_room()
+    {
+        var mm = New(30);
+        mm.Entry(Entry(1312, 3, ClassTeam, 1320), 0);
+        var cpu = Poll(mm, 1312, 12.1);
+        Assert.NotNull(cpu);
+        mm.Entry(Entry(1312, 4, ClassTeam, 1320), 170);
+        var again = Poll(mm, 1312, 173);                    // ContinuePairAfterCpuSeconds 2: first poll
+        Assert.NotNull(again);
+        Assert.NotEqual(cpu!.RoomId, again!.RoomId);
+    }
+
+    [Fact]
+    public void Pair_world_partners_re_pair_at_once()
+    {
+        var mm = New(30);
+        mm.Entry(Entry(1500, 1, Recruit), 0);
+        mm.Entry(Entry(1502, 1, Recruit), 0);
+        var p1 = Poll(mm, 1500, 0.5);
+        Assert.NotNull(p1);
+        mm.Entry(Entry(1500, 2, Recruit), 60);
+        mm.Entry(Entry(1502, 2, Recruit), 60);
+        var p2 = Poll(mm, 1500, 60.5);
+        Assert.NotNull(p2);
+        Assert.NotEqual(p1!.RoomId, p2!.RoomId);
+    }
+
+    [Fact]
+    public void Teammates_of_a_humans_vs_cpu_room_back_as_solos_are_not_held()
+    {
+        // a continued duo's CPU room (no human opponents) is not a P2P rematch: the two may meet again at once
+        var log = new List<string>();
+        var mm = New(30, log);
+        mm.Entry(Entry(1312, 3, Mix, 1320), 0);
+        Assert.NotNull(Poll(mm, 1312, 12.1));               // ContinuePair CPU room
+        mm.Entry(Entry(1312, 4, Mix), 170);
+        mm.Entry(Entry(1320, 4, Mix), 170);
+        mm.Entry(Entry(4000, 1, Mix), 170);
+        mm.Entry(Entry(4002, 1, Mix), 170);
+        var r = Poll(mm, 1312, 170.2);
+        Assert.NotNull(r);
+        Assert.Equal(4, r!.Humans);
+        Assert.DoesNotContain(log, l => l.StartsWith("REMATCH-COOLDOWN"));
+    }
+
+    [Fact]
+    public void OneOnOne_exact_rematch_is_held_too()
+    {
+        var mm = New(30);
+        mm.Entry(Entry(1600, 1, Fes1on1), 0);
+        mm.Entry(Entry(1602, 1, Fes1on1), 0);
+        Assert.NotNull(Poll(mm, 1600, 0.5));
+        mm.Entry(Entry(1600, 2, Fes1on1), 120);
+        mm.Entry(Entry(1602, 2, Fes1on1), 121);
+        Assert.Null(Poll(mm, 1600, 149.9));
+        Assert.NotNull(Poll(mm, 1600, 150.1));
+    }
+
+    [Fact]
+    public void Room_end_lines_reentry_cancel_timeout_and_summary()
+    {
+        var log = new List<string>();
+        var mm = New(30, log);
+        var room = FirstRoom(mm);                         // 1406 fetched at +0.5
+        Poll(mm, 1400, 1.0);                              // 1400 fetched at +1, 1402/1404 never fetch
+        mm.Cancel(1402, 40, applyId: 1);                  // still in the room: cancel after match
+        mm.Entry(Entry(1406, 2, Mix), 101);               // first re-entry
+        mm.Entry(Entry(1400, 2, Mix), 101);
+        Assert.Contains(log, l => l.StartsWith($"ROOM-END room={room.RoomId} mix-match node=1402 serial=PCB1402 reason=cancel-after-match apply=1 +40s since match fetched=never order=1/4"));
+        Assert.Contains(log, l => l.StartsWith($"ROOM-END room={room.RoomId} mix-match node=1406 serial=PCB1406 reason=reentry mix-match apply=2 +101s since match fetched=+0.5s order=2/4"));
+        Assert.Contains(log, l => l.Contains("node=1400") && l.Contains("fetched=+1s") && l.Contains("order=3/4"));
+        Assert.DoesNotContain(log, l => l.StartsWith("ROOM-SUMMARY"));
+        Poll(mm, 1406, 902);                              // sweep after RoomEndTimeoutSeconds
+        Assert.Contains(log, l => l.Contains("node=1404") && l.Contains("reason=timeout") && l.Contains("order=4/4"));
+        var sum = Assert.Single(log, l => l.StartsWith("ROOM-SUMMARY"));
+        Assert.Equal($"ROOM-SUMMARY room={room.RoomId} mix-match humans=4 spread=862s ends: 1402:cancel-after-match@+40s(fetch never) " +
+                     "1400:reentry@+101s(fetch +1s) 1406:reentry@+101s(fetch +0.5s) 1404:timeout@+902s(fetch never)", sum);
+    }
+
+    [Fact]
+    public void Room_end_same_cabinet_on_a_new_node_id()
+    {
+        var log = new List<string>();
+        var mm = New(30, log);
+        var room = FirstRoom(mm);
+        var e = Entry(5000, 1, Mix);
+        e.Myclient.PcbSerial = "PCB1404";                 // cab 1404 restarted: IssueNodeId gave it 5000
+        mm.Entry(e, 120);
+        Assert.Contains(log, l => l.StartsWith($"ROOM-END room={room.RoomId} mix-match node=1404 serial=PCB1404 reason=reentry-new-node new=5000 "));
+    }
+
+    [Fact]
+    public void Room_end_log_off_logs_nothing()
+    {
+        var log = new List<string>();
+        var mm = New(30, log, roomEnd: false);
+        FirstRoom(mm);
+        foreach (var n in Room18) mm.Entry(Entry(n, 2, Mix), 188);
+        Poll(mm, 1406, 1000);
+        Assert.DoesNotContain(log, l => l.StartsWith("ROOM-"));
+        Assert.Contains(log, l => l.StartsWith("REMATCH-COOLDOWN defer"));
+    }
+}
