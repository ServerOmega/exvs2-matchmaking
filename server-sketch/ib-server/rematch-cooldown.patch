+    // ---- rematch cooldown + ROOM-END (lock held) ----
+
+    /// <summary>The room's first re-entry (any of its human nodes); "now" if none yet.</summary>
+    private double RoomReentryAt(uint room, double now) => _roomFirstReentry.TryGetValue(room, out var at) ? at : now;
+
+    /// <summary>True when two different units of <paramref name="units"/> hold nodes whose last room is the same room and
+    /// at least one of the two has re-entered less than <see cref="RematchCooldownSeconds"/> ago.</summary>
+    private bool CooldownBlocks(IReadOnlyList<Unit> units, double now, out string why)
+    {
+        why = "";
+        if (RematchCooldownSeconds <= 0) return false;
+        // solo rooms only: both LA failures (rooms 13 / 19) were 4 solo entries; a continued duo regrouping with its
+        // former opponents (09:01:59Z room 3 within 1 s, 10:17:28Z room 8 within 5 s, both played) keeps forming at once,
+        // so the continue-pair / after-CPU answers are unchanged
+        if (units.Any(u => u.IsTeam)) return false;
+        double worst = 0; uint room = 0;
+        var pairs = new List<string>();
+        for (var i = 0; i < units.Count; i++)
+            for (var j = i + 1; j < units.Count; j++)
+                foreach (var a in units[i].NodeIds)
+                    foreach (var b in units[j].NodeIds)
+                    {
+                        if (!_lastSideByNode.TryGetValue(a, out var la) || !_lastSideByNode.TryGetValue(b, out var lb) ||
+                            la.Room != lb.Room || !_pvpRoomIds.Contains(la.Room)) continue;
+                        var left = RematchCooldownSeconds - (now - RoomReentryAt(la.Room, now));
+                        if (left <= 0) continue;
+                        pairs.Add($"{a}+{b}");
+                        if (left > worst) { worst = left; room = la.Room; }
+                    }
+        if (pairs.Count == 0) return false;
+        why = $"room={room} pairs=[{string.Join(",", pairs)}] left={worst:0.#}s";
+        return true;
+    }
+
+    /// <summary>CooldownBlocks + remember the deferral for the REMATCH-COOLDOWN log.</summary>
+    private bool CooldownDefer(List<Unit> units, double now)
+    {
+        if (!CooldownBlocks(units, now, out var why)) return false;
+        _cooldownDefers.Add((units, why));
+        return true;
+    }
+
+    /// <summary>One REMATCH-COOLDOWN defer line per held group (only groups still waiting after this TryMatch).</summary>
+    private void FlushCooldownDefers(double now)
+    {
+        if (_cooldownDefers.Count == 0) return;
+        foreach (var (units, why) in _cooldownDefers)
+        {
+            if (units.Any(u => u.Room != null || !_queue.Contains(u))) continue;
+            foreach (var u in units) u.CooldownDeferredAt ??= now;
+            var nodes = units.SelectMany(u => u.NodeIds).OrderBy(n => n).ToList();
+            var key = $"{string.Join(",", nodes)}|{why.Split(' ')[0]}";
+            if (_cooldownLogged.Count > 4096) _cooldownLogged.Clear();
+            if (!_cooldownLogged.Add(key)) continue;
+            Log?.Invoke($"REMATCH-COOLDOWN defer {units[0].WorldName} nodes=[{string.Join(",", nodes)}] {why}: these cabinets " +
+                        $"were just in one room; not together again until {RematchCooldownSeconds:0.#}s after that room's first re-entry");
+        }
+        _cooldownDefers.Clear();
+    }
+
+    /// <summary>First EntryMatching of each node after its last room: cooldown anchor + ROOM-END reentry.</summary>
+    private void NoteReentry(Unit t, double now)
+    {
+        foreach (var c in t.Humans)
+        {
+            var n = c.NodeId;
+            if (!_lastSideByNode.TryGetValue(n, out var last) || now < last.At) continue;
+            if (_reentryByNode.TryGetValue(n, out var re) && re.Room == last.Room) continue;
+            _reentryByNode[n] = (last.Room, now);
+            _roomFirstReentry.TryAdd(last.Room, now);
+            RoomEnd(last.Room, n, now, $"reentry {t.WorldName} apply={t.ApplyId}{(t.IsTeam ? $" team=[{string.Join(",", t.NodeIds)}]" : "")}");
+        }
+        if (_reentryByNode.Count > LastRoomMax)
+            foreach (var k in _reentryByNode.OrderBy(kv => kv.Value.At).Take(_reentryByNode.Count - LastRoomMax).Select(kv => kv.Key).ToList())
+                _reentryByNode.Remove(k);
+        if (_roomFirstReentry.Count > LastRoomMax)
+            foreach (var k in _roomFirstReentry.OrderBy(kv => kv.Value).Take(_roomFirstReentry.Count - LastRoomMax).Select(kv => kv.Key).ToList())
+                _roomFirstReentry.Remove(k);
+        if (!RoomEndLog) return;
+        // the same cabinet back on a NEW node id (IssueNodeId after a restart / new credit)
+        foreach (var tr in _rooms.Values.ToList())
+            foreach (var h in tr.Humans)
+                if (!tr.Ended.ContainsKey(h.NodeId) && !t.NodeIds.Contains(h.NodeId) &&
+                    t.Humans.Any(c => NetDiag.SameCabinet(c, h)))
+                    RoomEnd(tr.Room.RoomId, h.NodeId, now,
+                        $"reentry-new-node new={string.Join(",", t.Humans.Where(c => NetDiag.SameCabinet(c, h)).Select(c => c.NodeId))} {t.WorldName}");
+    }
+
+    private void TrackRoom(Unit u, Room room)
+    {
+        // rematch cooldown counts only humans-vs-humans rooms (both failures were 4-human P2P rooms): not humans-vs-CPU,
+        // lone-team or pair rooms (all group 0), so CPU-room teammates regroup with the waiting solos as before
+        if (_pvpRoomIds.Count > LastRoomMax) _pvpRoomIds.Clear();
+        if (room.Clients.All(rc => Unit.IsHuman(rc.Client)) && room.Clients.Any(rc => rc.GroupId == 0) &&
+            room.Clients.Any(rc => rc.GroupId != 0))
+            _pvpRoomIds.Add(room.RoomId);
+        if (!RoomEndLog && RematchCooldownSeconds <= 0) return;
+        if (_rooms.ContainsKey(room.RoomId)) return;
+        // first unit of a new room: every unit of the room is still mapped in _byNode
+        var deferred = room.Clients.Where(rc => Unit.IsHuman(rc.Client))
+            .Select(rc => _byNode.TryGetValue(rc.Client.NodeId, out var x) ? x : null)
+            .Where(x => x?.CooldownDeferredAt != null).Distinct().ToList();
+        if (deferred.Count > 0)
+            Log?.Invoke($"REMATCH-COOLDOWN placed room={room.RoomId} nodes=[{string.Join(",", deferred.SelectMany(x => x!.NodeIds))}] " +
+                        $"after {room.At - deferred.Min(x => x!.CooldownDeferredAt!.Value):0.#}s held");
+        if (!RoomEndLog) return;
+        _rooms[room.RoomId] = new RoomTrack
+        {
+            Room = room, WorldName = u.WorldName,
+            Humans = room.Clients.Where(rc => Unit.IsHuman(rc.Client)).Select(rc => rc.Client).ToList(),
+        };
+        if (_rooms.Count > RoomTrackMax)
+            foreach (var k in _rooms.OrderBy(kv => kv.Value.Room.At).Take(_rooms.Count - RoomTrackMax).Select(kv => kv.Key).ToList())
+                _rooms.Remove(k);
+    }
+
+    private void NoteFetch(uint roomId, uint node, double now)
+    {
+        if (!RoomEndLog || !_rooms.TryGetValue(roomId, out var tr) || tr.Fetched.ContainsKey(node)) return;
+        if (tr.Humans.Any(h => h.NodeId == node)) tr.Fetched[node] = now;
+    }
+
+    private string FetchText(RoomTrack tr, uint node) =>
+        tr.Fetched.TryGetValue(node, out var f) ? $"+{f - tr.Room.At:0.#}s" : "never";
+
+    /// <summary>ROOM-END for one node; ROOM-SUMMARY once every human node of the room has ended.</summary>
+    private void RoomEnd(uint roomId, uint node, double now, string reason)
+    {
+        if (!RoomEndLog || !_rooms.TryGetValue(roomId, out var tr) || tr.Ended.ContainsKey(node)) return;
+        if (!tr.Humans.Any(h => h.NodeId == node)) return;
+        tr.Ended[node] = (now, reason);
+        var serial = tr.Humans.First(h => h.NodeId == node).PcbSerial;
+        Log?.Invoke($"ROOM-END room={roomId} {tr.WorldName} node={node} serial={serial} reason={reason} " +
+                    $"+{now - tr.Room.At:0.#}s since match fetched={FetchText(tr, node)} order={tr.Ended.Count}/{tr.Humans.Count}");
+        if (tr.Ended.Count < tr.Humans.Count) return;
+        var ends = tr.Humans.OrderBy(h => tr.Ended[h.NodeId].At).ThenBy(h => h.NodeId)
+            .Select(h => $"{h.NodeId}:{tr.Ended[h.NodeId].Reason.Split(' ')[0]}@+{tr.Ended[h.NodeId].At - tr.Room.At:0.#}s" +
+                         $"(fetch {FetchText(tr, h.NodeId)})");
+        var times = tr.Humans.Select(h => tr.Ended[h.NodeId].At).ToList();
+        Log?.Invoke($"ROOM-SUMMARY room={roomId} {tr.WorldName} humans={tr.Humans.Count} spread={times.Max() - times.Min():0.#}s " +
+                    $"ends: {string.Join(" ", ends)}");
+        _rooms.Remove(roomId);
+    }
+
+    private void SweepRooms(double now)
+    {
+        if (!RoomEndLog || RoomEndTimeoutSeconds <= 0) return;
+        foreach (var tr in _rooms.Values.Where(r => now - r.Room.At > RoomEndTimeoutSeconds).ToList())
+            foreach (var h in tr.Humans.ToList())
+                if (!tr.Ended.ContainsKey(h.NodeId))
+                    RoomEnd(tr.Room.RoomId, h.NodeId, now, $"timeout (no re-entry or cancel within {RoomEndTimeoutSeconds:0}s)");
     }
 
