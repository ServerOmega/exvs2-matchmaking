@@ -0,0 +1,72 @@
+using nue.protocol.mms;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// exvs2-lobbies post-match trace (2026-11-14): one short line per MMS request that comes from a cabinet that was
+/// matched recently, plus a warning for MMS methods this server does not handle. Logging only: the replies are
+/// unchanged. The lines carry node id, apply id, method, reply code, handling time and the HTTP source IP; never
+/// pcb_serial, am_id, card ids or access codes.
+/// </summary>
+public sealed class MmsTrace
+{
+    private readonly Dictionary<(uint, MethodType), double> _lastCheck = new();
+    private readonly object _gate = new();
+
+    /// <summary>OnlineMatching.LogPostMatchTraffic (default true).</summary>
+    public bool Enabled { get; set; } = true;
+
+    /// <summary>Repeated CheckMatching polls of one node are logged at most once per this many seconds.</summary>
+    public double CheckEvery { get; set; } = 15;
+
+    public static uint NodeOf(Request r) => r.Type switch
+    {
+        MethodType.EntryMatching => r.entry_matching?.Myclient?.NodeId ?? 0,
+        MethodType.CheckMatching => r.check_matching?.NodeId ?? 0,
+        MethodType.CancelMatching => r.cancel_matching?.NodeId ?? 0,
+        _ => 0
+    };
+
+    public static uint ApplyOf(Request r) => r.Type switch
+    {
+        MethodType.EntryMatching => r.entry_matching?.ApplyId ?? 0,
+        MethodType.CancelMatching => r.cancel_matching?.ApplyId ?? 0,
+        _ => 0
+    };
+
+    public static bool IsHandled(MethodType t) => t is MethodType.Ping or MethodType.IssueNodeId
+        or MethodType.MatchingSetting or MethodType.EntryMatching or MethodType.CheckMatching or MethodType.CancelMatching;
+
+    /// <summary>
+    /// The line to log for this request, or null. <paramref name="context"/> = Matchmaker.PostMatchContext (null when
+    /// the cabinet had no recent match). Unhandled methods are always reported.
+    /// </summary>
+    public string? Line(Request req, Response? resp, string? sourceIp, string? context, double ms, double now)
+    {
+        if (!Enabled) return null;
+        var node = NodeOf(req);
+        var type = Enum.IsDefined(typeof(MethodType), req.Type) ? req.Type.ToString() : $"type{(int)req.Type}";
+        if (!IsHandled(req.Type))
+            return $"MMS-UNHANDLED method={type} node={node} src={sourceIp ?? "-"} -> {resp?.Code.ToString() ?? "-"}" +
+                   (context != null ? $" post-match {context}" : "");
+        if (context == null) return null;
+        if (req.Type == MethodType.CheckMatching)
+        {
+            var matched = resp?.check_matching?.Clients?.Count > 0;
+            lock (_gate)
+            {
+                var key = (node, req.Type);
+                // always log a poll that returns a room or an error; rate-limit the plain "keep polling" ones
+                if (!matched && resp?.Code == ErrorCode.Success && _lastCheck.TryGetValue(key, out var last) &&
+                    now - last < CheckEvery)
+                    return null;
+                _lastCheck[key] = now;
+                if (_lastCheck.Count > 8192) _lastCheck.Clear();
+            }
+        }
+        var room = resp?.check_matching?.Clients?.Count > 0 ? $" room={resp.check_matching.RoomId}" : "";
+        var apply = ApplyOf(req);
+        return $"MMS-POST {type} node={node}{(apply != 0 ? $" apply={apply}" : "")} src={sourceIp ?? "-"} -> " +
+               $"{resp?.Code.ToString() ?? "-"}{room} ({ms:0}ms) {context}";
+    }
+}
