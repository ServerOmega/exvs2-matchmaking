+    [HttpPost("invites")]
+    public IActionResult Create([FromBody] CreateRequest body)
+    {
+        if (body.PilotId == 0) return BadRequest(new { error = "pilotId is required." });
+        try
+        {
+            var code = _store.Create(body.PilotId, body.Name ?? "");
+            _log.LogInformation("tag invite created for pilot {PilotId}", body.PilotId);
+            return Ok(new { code });
+        }
+        catch (Exception ex)
+        {
+            return BadRequest(new { error = ex.Message });
+        }
+    }
+
+    [HttpPost("invites/join")]
+    public IActionResult Join([FromBody] JoinRequest body)
+    {
+        if (body.PilotId == 0 || string.IsNullOrWhiteSpace(body.Code))
+            return BadRequest(new { error = "code and pilotId are required." });
+        try
+        {
+            var inv = _store.Join(body.Code, body.PilotId, body.Name ?? "");
+            _log.LogInformation("tag invite {Code} joined by pilot {PilotId}", inv.Code, body.PilotId);
+            return Ok(inv);
+        }
+        catch (Exception ex)
+        {
+            return BadRequest(new { error = ex.Message });
+        }
+    }
+
+    [HttpGet("invites/{code}")]
+    public IActionResult Get(string code)
+    {
+        var inv = _store.Get(code);
+        return inv is null ? NotFound() : Ok(inv);
+    }
+
+    [HttpGet("invites/for/{pilotId}")]
+    public IActionResult ForPilot(uint pilotId) => Ok(_store.ForPilot(pilotId));
+
+    [HttpPost("invites/{code}/settings")]
+    public IActionResult Settings(string code, [FromBody] SettingsRequest body)
+    {
+        if (body.PilotId == 0 || string.IsNullOrWhiteSpace(code))
+            return BadRequest(new { error = "code and pilotId are required." });
+        try
+        {
+            var inv = _store.UpdateSettings(code, body.PilotId, new TagTeamSettings
+            {
+                TeamName = body.TeamName ?? "",
+                BackgroundPartsId = body.BackgroundPartsId,
+                EffectId = body.EffectId,
+                EmblemId = body.EmblemId,
+                BgmId = body.BgmId,
+                NameColorId = body.NameColorId,
+            });
+            _log.LogInformation("tag invite {Code} settings updated by pilot {PilotId}", inv.Code, body.PilotId);
+            return Ok(inv);
+        }
+        catch (Exception ex)
+        {
+            return BadRequest(new { error = ex.Message });
+        }
+    }
+
+    [HttpPost("register")]
+    public IActionResult Register([FromBody] RegisterRequest body)
+    {
+        if (body.AmId == 0) return BadRequest(new { error = "amId is required." });
+        _mm.RegisterTagSearch(body.AmId, body.Codes ?? Array.Empty<string>());
+        return Ok(new { ok = true });
+    }
+}
