diff --git a/Server-Infinite/Matchmaking/PilotId.cs b/Server-Infinite/Matchmaking/PilotId.cs
new file mode 100644
index 0000000..e3f4a3c
--- /dev/null
+++ b/Server-Infinite/Matchmaking/PilotId.cs
@@ -0,0 +1,101 @@
+using System;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// Maps a local card-server card id to a globally unique wire pilot / am_id.
+/// Cabinets use this value as <c>am_id</c> and, for online tag (world 5), as
+/// Attr2 = min(own, partner) and for leader election (own &lt; partner). Local
+/// card ids collide across card servers (both start at 1), so each server
+/// prefixes its own ServerId: Wire = ServerId * Block + localCardId.
+/// ServerId is 1..4000 so the result fits in uint and leaves room for card ids.
+/// A ServerId of 0 (uninitialized) leaves ids unchanged for backward compatibility.
+/// </summary>
+public static class PilotId
+{
+    public const int Block = 1_000_000;
+    public const int MaxServerId = 4000;
+
+    public static int ServerId { get; private set; }
+
+    public static uint Wire(int localCardId)
+    {
+        if (ServerId <= 0 || localCardId <= 0) return localCardId <= 0 ? 0u : (uint)localCardId;
+        return (uint)((long)ServerId * Block + localCardId);
+    }
+
+    public static int Local(uint wire) =>
+        ServerId <= 0 ? (int)wire : (int)(wire % (uint)Block);
+
+    public static int ServerOf(uint wire) =>
+        ServerId <= 0 ? 0 : (int)(wire / (uint)Block);
+
+    public static bool IsRemote(uint wire) =>
+        ServerId > 0 && ServerOf(wire) != 0 && ServerOf(wire) != ServerId;
+
+    public static void SetServerId(int serverId)
+    {
+        if (serverId < 0 || serverId > MaxServerId)
+            throw new ArgumentOutOfRangeException(nameof(serverId), serverId, $"ServerId must be 0..{MaxServerId}");
+        ServerId = serverId;
+    }
+
+    /// <summary>
+    /// Use <paramref name="configuredServerId"/> if it is &gt; 0; otherwise load or create
+    /// a persisted random id in [1, MaxServerId] at <paramref name="statePath"/>.
+    /// </summary>
+    public static int Initialize(int configuredServerId, string statePath, Action<string>? log = null)
+    {
+        if (configuredServerId > 0)
+        {
+            if (configuredServerId > MaxServerId)
+                throw new ArgumentOutOfRangeException(nameof(configuredServerId), configuredServerId, $"ServerId must be 1..{MaxServerId}");
+            ServerId = configuredServerId;
+            log?.Invoke($"OnlineTag ServerId={ServerId} (from config)");
+            return ServerId;
+        }
+
+        if (!string.IsNullOrWhiteSpace(statePath) && File.Exists(statePath))
+        {
+            var text = File.ReadAllText(statePath).Trim();
+            if (int.TryParse(text, out var id) && id > 0 && id <= MaxServerId)
+            {
+                ServerId = id;
+                log?.Invoke($"OnlineTag ServerId={ServerId} (from {statePath})");
+                return ServerId;
+            }
+        }
+
+        ServerId = Random.Shared.Next(1, MaxServerId + 1);
+        if (!string.IsNullOrWhiteSpace(statePath))
+        {
+            var dir = Path.GetDirectoryName(statePath);
+            if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+            File.WriteAllText(statePath, ServerId.ToString());
+            log?.Invoke($"OnlineTag ServerId={ServerId} (generated, saved to {statePath})");
+        }
+        else
+        {
+            log?.Invoke($"OnlineTag ServerId={ServerId} (generated, not persisted)");
+        }
+        return ServerId;
+    }
+
+    /// <summary>
+    /// Map a wire (or legacy local) id back to this server's local card id.
+    /// Returns -1 if the id belongs to another server (do not treat the remainder as a local card).
+    /// </summary>
+    public static int ToLocalOrUnmatched(long incoming)
+    {
+        if (incoming <= 0) return -1;
+        if (ServerId <= 0) return incoming <= int.MaxValue ? (int)incoming : -1;
+        // Legacy clients / un-updated partners still send the raw card id (&lt; Block).
+        if (incoming < Block) return (int)incoming;
+        if (incoming > uint.MaxValue) return -1;
+        var w = (uint)incoming;
+        return ServerOf(w) == ServerId ? Local(w) : -1;
+    }
+
+    public static bool IsThisCard(int localCardId, long incoming) =>
+        localCardId > 0 && ToLocalOrUnmatched(incoming) == localCardId;
+}
