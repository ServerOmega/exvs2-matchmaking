@@ -0,0 +1,133 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// post-match trace (2026-11-14): logging only. Does anything reach the MMS / STUN after a match, and from whom?
+public class PostMatchTraceTests
+{
+    private static Client Cl(uint node, string ip)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = $"PCBSERIAL{node}", LocId = $"L{node}", PrefCode = 13,
+            GlobalIpaddress = ip, NatMappingType = NatMappingType.NmEndpointIndependent,
+            NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        return c;
+    }
+
+    private static Request.EntryMatching Solo(uint node, string ip, uint apply = 1) => new()
+    {
+        ApplyId = apply, Myclient = Cl(node, ip), MatchingTimeout = 150,
+        Myplayer = new Player { BanapassportAmId = 987654 + node },
+        World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = 23 }
+    };
+
+    private static Matchmaker New() => new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1)
+        { StaleAfter = 1e6, Realms = null };
+
+    private static Request Req(MethodType t, uint node, uint apply = 0) => t switch
+    {
+        MethodType.CheckMatching => new Request { Type = t, RequestId = "r", check_matching = new Request.CheckMatching { NodeId = node } },
+        MethodType.CancelMatching => new Request { Type = t, RequestId = "r", cancel_matching = new Request.CancelMatching { NodeId = node, ApplyId = apply } },
+        MethodType.EntryMatching => new Request { Type = t, RequestId = "r", entry_matching = Solo(node, "203.0.113.5", apply) },
+        _ => new Request { Type = t, RequestId = "r" }
+    };
+
+    [Fact]
+    public void ContextOnlyAfterAMatchAndWithinTheWindow()
+    {
+        var mm = New();
+        Assert.Null(mm.PostMatchContext(1100, null, 0));
+        mm.Entry(Solo(1100, "203.0.113.5"), 0, "192.168.1.69");
+        mm.Entry(Solo(1102, "198.51.100.7"), 0, "10.10.0.2");
+        Assert.Null(mm.PostMatchContext(1100, "192.168.1.69", 10));          // queued, not matched yet
+        var room = mm.Check(1100, 31).Room!;
+        Assert.Equal($"room={room.RoomId} +169s by=node", mm.PostMatchContext(1100, null, 200));
+        Assert.Equal($"room={room.RoomId} +169s by=node", mm.PostMatchContext(1102, null, 200));
+        // no node (Ping / IssueNodeId / STUN): HTTP source IP or STUN global IP of the matched cabinet
+        Assert.Equal($"room={room.RoomId} +69s by=ip", mm.PostMatchContext(0, "10.10.0.2", 100));
+        Assert.Equal($"room={room.RoomId} +69s by=ip", mm.PostMatchContext(0, "198.51.100.7", 100));
+        Assert.Null(mm.PostMatchContext(0, "192.0.2.99", 100));                // someone else
+        Assert.Null(mm.PostMatchContext(1100, null, 31 + 1801));               // window over
+    }
+
+    [Fact]
+    public void WindowZeroIsOff()
+    {
+        var mm = New(); mm.PostMatchWindow = 0;
+        mm.Entry(Solo(1100, "203.0.113.5"), 0); mm.Entry(Solo(1102, "198.51.100.7"), 0);
+        Assert.NotNull(mm.Check(1100, 31).Room);
+        Assert.Null(mm.PostMatchContext(1100, null, 40));
+    }
+
+    [Fact]
+    public void RequeueAfterTheBattleIsANewEntryAndIsTraced()
+    {
+        var mm = New();
+        mm.Entry(Solo(1100, "203.0.113.5"), 0); mm.Entry(Solo(1102, "198.51.100.7"), 0);
+        var first = mm.Check(1100, 31).Room!;
+        // winner re-queues ~3 min later with the next apply_id (same node ids): a fresh wait, not the old room
+        Assert.Equal(ErrorCode.Success, mm.Entry(Solo(1100, "203.0.113.5", apply: 2), 210));
+        var (code, room, _) = mm.Check(1100, 213);
+        Assert.Equal(ErrorCode.Success, code);
+        Assert.Null(room);
+        Assert.Equal($"room={first.RoomId} +182s by=node", mm.PostMatchContext(1100, null, 213));
+    }
+
+    [Fact]
+    public void LinesNameCallerMethodAndReplyButNoCardOrPlayerIds()
+    {
+        var t = new MmsTrace();
+        var entry = Req(MethodType.EntryMatching, 1100, apply: 2);
+        var line = t.Line(entry, new Response { Type = MethodType.EntryMatching, Code = ErrorCode.Success }, "192.168.1.69",
+            "room=1 +190s by=node", 3.2, 221)!;
+        Assert.Equal("MMS-POST EntryMatching node=1100 apply=2 src=192.168.1.69 -> Success (3ms) room=1 +190s by=node", line);
+        Assert.DoesNotContain("PCBSERIAL", line);
+        Assert.DoesNotContain("987654", line);
+        // no recent match -> nothing (normal pre-match traffic is already in the upstream request dump)
+        Assert.Null(t.Line(entry, new Response { Code = ErrorCode.Success }, "192.168.1.69", null, 1, 221));
+        var cancel = t.Line(Req(MethodType.CancelMatching, 1100, 2), new Response { Code = ErrorCode.Success }, "10.10.0.2",
+            "room=1 +100s by=node", 1, 131)!;
+        Assert.StartsWith("MMS-POST CancelMatching node=1100 apply=2 src=10.10.0.2", cancel);
+        var ping = t.Line(Req(MethodType.Ping, 0), new Response { Code = ErrorCode.Success }, "10.10.0.2", "room=1 +60s by=ip", 1, 91)!;
+        Assert.StartsWith("MMS-POST Ping node=0 src=10.10.0.2 -> Success", ping);
+    }
+
+    [Fact]
+    public void UnhandledMethodIsAlwaysReported()
+    {
+        var t = new MmsTrace();
+        var line = t.Line(new Request { Type = (MethodType)7, RequestId = "r" },
+            new Response { Code = ErrorCode.ErrRequest }, "10.10.0.2", null, 1, 5)!;
+        Assert.Equal("MMS-UNHANDLED method=type7 node=0 src=10.10.0.2 -> ErrRequest", line);
+    }
+
+    [Fact]
+    public void KeepPollingChecksAreRateLimitedButResultsAreNot()
+    {
+        var t = new MmsTrace();
+        var chk = Req(MethodType.CheckMatching, 1100);
+        var empty = new Response { Code = ErrorCode.Success, check_matching = new Response.CheckMatching() };
+        const string ctx = "room=1 +200s by=node";
+        Assert.NotNull(t.Line(chk, empty, "x", ctx, 1, 100));
+        Assert.Null(t.Line(chk, empty, "x", ctx, 1, 103));
+        Assert.Null(t.Line(chk, empty, "x", ctx, 1, 112));
+        Assert.NotNull(t.Line(chk, empty, "x", ctx, 1, 116));
+        Assert.NotNull(t.Line(chk, new Response { Code = ErrorCode.MatchCanceled }, "x", ctx, 1, 117));
+        var matched = new Response { Code = ErrorCode.Success, check_matching = new Response.CheckMatching { RoomId = 9 } };
+        matched.check_matching.Clients.Add(new Response.CheckMatching.MatchedClient { GroupId = 0, Client = Cl(1100, "x") });
+        Assert.Contains(" room=9 ", t.Line(chk, matched, "x", ctx, 1, 118));
+    }
+
+    [Fact]
+    public void DisabledLogsNothing()
+    {
+        var t = new MmsTrace { Enabled = false };
+        Assert.Null(t.Line(new Request { Type = (MethodType)7, RequestId = "r" }, null, "x", "room=1 +1s by=node", 1, 1));
+        Assert.True(new MmsTrace().Enabled);   // default on
+    }
+}
