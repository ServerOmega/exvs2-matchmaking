+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace ServerInfinite.Matchmaking;
+
+/// <summary>
+/// A shared cross-server online-tag invite. Partners on different card servers
+/// cannot look each other up in a local DB, so they exchange this short code.
+/// The matchmaker also uses the code as a world-5 pair key (in addition to Attr2).
+/// </summary>
+public sealed class TagInvite
+{
+    public string Code { get; set; } = "";
+    public uint CreatorPilotId { get; set; }
+    public string CreatorName { get; set; } = "";
+    public uint PartnerPilotId { get; set; }
+    public string PartnerName { get; set; } = "";
+    public DateTime CreatedUtc { get; set; }
+    public DateTime? JoinedUtc { get; set; }
+
+    [JsonIgnore]
+    public bool Joined => PartnerPilotId != 0;
+
+    /// <summary>Shared team cosmetics (name, BGM, effect, …). Null until a partner saves them.</summary>
+    public TagTeamSettings? Settings { get; set; }
+}
+
+/// <summary>
+/// Cross-server team name and presentation. The matchmaker stamps <see cref="UpdatedUtc"/>
+/// so the last write wins even if the two card servers' clocks disagree.
+/// </summary>
+public sealed class TagTeamSettings
+{
+    public string TeamName { get; set; } = "";
+    public uint BackgroundPartsId { get; set; }
+    public uint EffectId { get; set; }
+    public uint EmblemId { get; set; }
+    public uint BgmId { get; set; }
+    public uint NameColorId { get; set; }
+    public DateTime UpdatedUtc { get; set; }
+    public uint UpdatedByPilotId { get; set; }
+
+    /// <summary>True when this payload should replace the last one applied locally (last-write-wins).</summary>
+    public bool IsNewerThan(DateTime? localUpdatedUtc) =>
+        localUpdatedUtc is null || UpdatedUtc > localUpdatedUtc;
+}
+
+/// <summary>
+/// In-memory + JSON-backed store for cross-server tag invites and am_id → code
+/// registrations. Lives on the shared matchmaker (VPS). Thread-safe.
+/// Never stores or logs card access codes / chip ids / passwords.
+/// </summary>
+public sealed class TagInviteStore
+{
+    public const int CodeLength = 8;
+    // Avoid 0/O/1/I so a partner can read the code aloud or off a screenshot.
+    private const string Alphabet = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ";
+    private static readonly JsonSerializerOptions JsonOpts = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        WriteIndented = true,
+        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
+    };
+
+    private readonly object _gate = new();
+    private readonly string? _path;
+    private readonly Dictionary<string, TagInvite> _invites = new(StringComparer.OrdinalIgnoreCase);
+    private readonly Dictionary<uint, string[]> _codesByAm = new();
+
+    public TagInviteStore(string? statePath = null)
+    {
+        _path = string.IsNullOrWhiteSpace(statePath) ? null : statePath;
+        if (_path != null && File.Exists(_path))
+        {
+            try
+            {
+                var json = File.ReadAllText(_path);
+                var snap = JsonSerializer.Deserialize<Snapshot>(json, JsonOpts);
+                if (snap?.Invites != null)
+                {
+                    foreach (var inv in snap.Invites)
+                    {
+                        if (string.IsNullOrWhiteSpace(inv.Code)) continue;
+                        _invites[Normalize(inv.Code)] = inv;
+                    }
+                }
+                if (snap?.CodesByAm != null)
+                {
+                    foreach (var kv in snap.CodesByAm)
+                        _codesByAm[kv.Key] = kv.Value;
+                }
+            }
+            catch (Exception)
+            {
+                // corrupt state: start empty; new invites still work this run
+            }
+        }
+    }
+
+    public string Create(uint creatorPilotId, string creatorName)
+    {
+        if (creatorPilotId == 0) throw new ArgumentOutOfRangeException(nameof(creatorPilotId));
+        var name = creatorName?.Trim() ?? "";
+        lock (_gate)
+        {
+            // Reuse an open invite from the same creator so they can refresh the page
+            // and still see the same code.
+            foreach (var existing in _invites.Values)
+            {
+                if (existing.CreatorPilotId == creatorPilotId && !existing.Joined)
+                    return existing.Code;
+            }
+
+            string code;
+            do { code = NewCode(); } while (_invites.ContainsKey(code));
+            _invites[code] = new TagInvite
+            {
+                Code = code,
+                CreatorPilotId = creatorPilotId,
+                CreatorName = name,
+                CreatedUtc = DateTime.UtcNow,
+            };
+            Persist();
+            return code;
+        }
+    }
+
+    public TagInvite Join(string code, uint partnerPilotId, string partnerName)
+    {
+        if (partnerPilotId == 0) throw new ArgumentOutOfRangeException(nameof(partnerPilotId));
+        var key = Normalize(code);
+        if (key.Length != CodeLength) throw new InvalidOperationException("Invalid tag code.");
+        lock (_gate)
+        {
+            if (!_invites.TryGetValue(key, out var inv))
+                throw new InvalidOperationException("Tag code not found. Check that you typed it correctly and that the matchmaker is the same one your partner is using.");
+            if (inv.CreatorPilotId == partnerPilotId)
+                throw new InvalidOperationException("You cannot join your own tag code.");
+            if (inv.Joined && inv.PartnerPilotId != partnerPilotId)
+                throw new InvalidOperationException("That tag code is already in use by another player.");
+            // Idempotent re-join by the same partner (page refresh).
+            inv.PartnerPilotId = partnerPilotId;
+            inv.PartnerName = partnerName?.Trim() ?? inv.PartnerName;
+            inv.JoinedUtc ??= DateTime.UtcNow;
+            Persist();
+            return Clone(inv);
+        }
+    }
+
+    public TagInvite? Get(string code)
+    {
+        var key = Normalize(code);
+        lock (_gate)
+        {
+            return _invites.TryGetValue(key, out var inv) ? Clone(inv) : null;
+        }
+    }
+
+    /// <summary>Invites this pilot created or joined, newest first.</summary>
+    public IReadOnlyList<TagInvite> ForPilot(uint wirePilotId)
+    {
+        if (wirePilotId == 0) return Array.Empty<TagInvite>();
+        lock (_gate)
+        {
+            return _invites.Values
+                .Where(i => i.CreatorPilotId == wirePilotId || i.PartnerPilotId == wirePilotId)
+                .OrderByDescending(i => i.CreatedUtc)
+                .Select(Clone)
+                .ToList();
+        }
+    }
+
+    /// <summary>
+    /// Save shared team cosmetics for a joined invite. Only the creator or the partner may write.
+    /// The store stamps <see cref="TagTeamSettings.UpdatedUtc"/> with its own clock (last request wins).
+    /// </summary>
+    public TagInvite UpdateSettings(string code, uint byPilotId, TagTeamSettings settings)
+    {
+        if (byPilotId == 0) throw new ArgumentOutOfRangeException(nameof(byPilotId));
+        if (settings is null) throw new ArgumentNullException(nameof(settings));
+        var key = Normalize(code);
+        if (key.Length != CodeLength) throw new InvalidOperationException("Invalid tag code.");
+        lock (_gate)
+        {
+            if (!_invites.TryGetValue(key, out var inv))
+                throw new InvalidOperationException("Tag code not found.");
+            if (inv.CreatorPilotId != byPilotId && inv.PartnerPilotId != byPilotId)
+                throw new InvalidOperationException("Only the two partners can update this team's settings.");
+            var name = (settings.TeamName ?? "").Trim();
+            if (name.Length == 0) name = "EXTREME TEAM";
+            if (name.Length > 32) name = name[..32];
+            inv.Settings = new TagTeamSettings
+            {
+                TeamName = name,
+                BackgroundPartsId = settings.BackgroundPartsId,
+                EffectId = settings.EffectId,
+                EmblemId = settings.EmblemId,
+                BgmId = settings.BgmId,
+                NameColorId = settings.NameColorId,
+                UpdatedUtc = DateTime.UtcNow,
+                UpdatedByPilotId = byPilotId,
+            };
+            Persist();
+            return Clone(inv);
+        }
+    }
+
+    /// <summary>Bind the codes this am_id will search with on world 5.</summary>
+    public void RegisterSearch(uint amId, IEnumerable<string> codes)
+    {
+        if (amId == 0) return;
+        var list = (codes ?? Array.Empty<string>())
+            .Select(Normalize)
+            .Where(c => c.Length == CodeLength)
+            .Distinct(StringComparer.OrdinalIgnoreCase)
+            .ToArray();
+        lock (_gate)
+        {
+            if (list.Length == 0) _codesByAm.Remove(amId);
+            else _codesByAm[amId] = list;
+            Persist();
+        }
+    }
+
+    public IReadOnlyList<string> CodesForAm(uint amId)
+    {
+        lock (_gate)
+        {
+            return _codesByAm.TryGetValue(amId, out var list) ? list.ToArray() : Array.Empty<string>();
+        }
+    }
+
+    public static string Normalize(string? code) =>
+        (code ?? "").Trim().ToUpperInvariant();
+
+    private string NewCode()
+    {
+        Span<char> chars = stackalloc char[CodeLength];
+        for (var i = 0; i < CodeLength; i++)
+            chars[i] = Alphabet[Random.Shared.Next(Alphabet.Length)];
+        return new string(chars);
+    }
+
+    private void Persist()
+    {
+        if (_path == null) return;
+        var snap = new Snapshot
+        {
+            Invites = _invites.Values.ToList(),
+            CodesByAm = _codesByAm.ToDictionary(kv => kv.Key, kv => kv.Value),
+        };
+        var dir = Path.GetDirectoryName(_path);
+        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
+        var tmp = _path + ".tmp";
+        File.WriteAllText(tmp, JsonSerializer.Serialize(snap, JsonOpts));
+        File.Move(tmp, _path, overwrite: true);
+    }
+
+    private static TagInvite Clone(TagInvite i) => new()
+    {
+        Code = i.Code,
+        CreatorPilotId = i.CreatorPilotId,
+        CreatorName = i.CreatorName,
+        PartnerPilotId = i.PartnerPilotId,
+        PartnerName = i.PartnerName,
+        CreatedUtc = i.CreatedUtc,
+        JoinedUtc = i.JoinedUtc,
+        Settings = CloneSettings(i.Settings),
+    };
+
+    internal static TagTeamSettings? CloneSettings(TagTeamSettings? s) =>
+        s is null ? null : new TagTeamSettings
+        {
+            TeamName = s.TeamName,
+            BackgroundPartsId = s.BackgroundPartsId,
+            EffectId = s.EffectId,
+            EmblemId = s.EmblemId,
+            BgmId = s.BgmId,
+            NameColorId = s.NameColorId,
+            UpdatedUtc = s.UpdatedUtc,
+            UpdatedByPilotId = s.UpdatedByPilotId,
+        };
+
+    private sealed class Snapshot
+    {
+        public List<TagInvite> Invites { get; set; } = new();
+        public Dictionary<uint, string[]> CodesByAm { get; set; } = new();
+    }
+}
