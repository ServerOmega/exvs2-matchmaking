@@ -0,0 +1,109 @@
+using System.Net.Http.Json;
+using System.Text.Json;
+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.TagInvites;
+
+public sealed class HttpTagInviteClient : ITagInviteClient
+{
+    private static readonly JsonSerializerOptions Json = new() { PropertyNameCaseInsensitive = true };
+    private readonly HttpClient _http;
+    private readonly string _base;
+
+    public HttpTagInviteClient(HttpClient http, string inviteBaseUrl)
+    {
+        _http = http;
+        _base = inviteBaseUrl.TrimEnd('/');
+        _http.Timeout = TimeSpan.FromSeconds(8);
+    }
+
+    public async Task<string> CreateAsync(uint creatorPilotId, string creatorName, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/invites", new { pilotId = creatorPilotId, name = creatorName }, ct);
+        r.EnsureSuccessStatusCode();
+        var body = await r.Content.ReadFromJsonAsync<CreateBody>(Json, ct)
+                   ?? throw new InvalidOperationException("Empty create-invite response.");
+        if (string.IsNullOrWhiteSpace(body.Code))
+            throw new InvalidOperationException(body.Error ?? "The matchmaker did not return a partner code.");
+        return body.Code;
+    }
+
+    public async Task<TagInvite> JoinAsync(string code, uint partnerPilotId, string partnerName, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/invites/join",
+            new { code, pilotId = partnerPilotId, name = partnerName }, ct);
+        if (!r.IsSuccessStatusCode)
+        {
+            var err = await ReadError(r, ct);
+            throw new InvalidOperationException(err ?? $"Join failed ({(int)r.StatusCode}).");
+        }
+        var inv = await r.Content.ReadFromJsonAsync<TagInvite>(Json, ct)
+                  ?? throw new InvalidOperationException("Empty join-invite response.");
+        return inv;
+    }
+
+    public async Task<TagInvite?> GetAsync(string code, CancellationToken ct = default)
+    {
+        var r = await _http.GetAsync($"{_base}/invites/{Uri.EscapeDataString(TagInviteStore.Normalize(code))}", ct);
+        if (r.StatusCode == System.Net.HttpStatusCode.NotFound) return null;
+        r.EnsureSuccessStatusCode();
+        return await r.Content.ReadFromJsonAsync<TagInvite>(Json, ct);
+    }
+
+    public async Task<IReadOnlyList<TagInvite>> ForPilotAsync(uint wirePilotId, CancellationToken ct = default)
+    {
+        var r = await _http.GetAsync($"{_base}/invites/for/{wirePilotId}", ct);
+        r.EnsureSuccessStatusCode();
+        var list = await r.Content.ReadFromJsonAsync<List<TagInvite>>(Json, ct);
+        return list ?? (IReadOnlyList<TagInvite>)Array.Empty<TagInvite>();
+    }
+
+    public async Task RegisterSearchAsync(uint amId, IEnumerable<string> codes, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync($"{_base}/register", new { amId, codes = codes.ToArray() }, ct);
+        r.EnsureSuccessStatusCode();
+    }
+
+    public async Task<TagInvite> UpdateSettingsAsync(string code, uint byPilotId, TagTeamSettings settings, CancellationToken ct = default)
+    {
+        var r = await _http.PostAsJsonAsync(
+            $"{_base}/invites/{Uri.EscapeDataString(TagInviteStore.Normalize(code))}/settings",
+            new
+            {
+                pilotId = byPilotId,
+                teamName = settings.TeamName,
+                backgroundPartsId = settings.BackgroundPartsId,
+                effectId = settings.EffectId,
+                emblemId = settings.EmblemId,
+                bgmId = settings.BgmId,
+                nameColorId = settings.NameColorId,
+            }, ct);
+        if (!r.IsSuccessStatusCode)
+        {
+            var err = await ReadError(r, ct);
+            throw new InvalidOperationException(err ?? $"Update settings failed ({(int)r.StatusCode}).");
+        }
+        return await r.Content.ReadFromJsonAsync<TagInvite>(Json, ct)
+               ?? throw new InvalidOperationException("Empty settings response.");
+    }
+
+    private static async Task<string?> ReadError(HttpResponseMessage r, CancellationToken ct)
+    {
+        try
+        {
+            var body = await r.Content.ReadFromJsonAsync<CreateBody>(Json, ct);
+            return body?.Error ?? body?.Message;
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    private sealed class CreateBody
+    {
+        public string? Code { get; set; }
+        public string? Error { get; set; }
+        public string? Message { get; set; }
+    }
+}
