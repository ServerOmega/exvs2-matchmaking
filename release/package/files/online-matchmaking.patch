+using nue.protocol.exvs;
+using ServerInfinite.Lobbies;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// results-hang simulation drafts (analysis/results-hang-sim.md section 5): PostMatchWatchdog + LogMask. No server, no DB.
+public class HangSimTests
+{
+    private static Request Q(MethodType t) => new() { Type = t, RequestId = "r1", PcbSerial = "P", LocId = "L", Token = "" };
+
+    [Fact]
+    public void WatchdogOffByDefaultAndClamped()
+    {
+        Assert.False(PostMatchWatchdog.Applies(0, MethodType.MthdSaveVsmOnResult));
+        Assert.Equal(0, PostMatchWatchdog.Clamp(-5));
+        Assert.Equal(500, PostMatchWatchdog.Clamp(1));
+        Assert.Equal(9000, PostMatchWatchdog.Clamp(60000));   // always below the game's 10 s HTTP timeout
+        Assert.True(PostMatchWatchdog.Applies(8000, MethodType.MthdSaveVsmOnResult));
+        Assert.False(PostMatchWatchdog.Applies(8000, MethodType.MthdLoadCard));   // never on loads / card reads
+        Assert.False(PostMatchWatchdog.Applies(8000, MethodType.MthdPreLoadCard));
+    }
+
+    [Theory]
+    [InlineData(MethodType.MthdSaveVsmResult)]
+    [InlineData(MethodType.MthdSaveVsmOnResult)]
+    [InlineData(MethodType.MthdSaveVscResult)]
+    [InlineData(MethodType.MthdSaveVstResult)]
+    [InlineData(MethodType.MthdSaveStageResult)]
+    [InlineData(MethodType.MthdSaveBattleLog)]
+    [InlineData(MethodType.MthdSaveBattleLogOn)]
+    [InlineData(MethodType.MthdSaveUserPlayResearchData)]
+    [InlineData(MethodType.MthdSaveResultCapture)]
+    public void TimeoutReplyIsSuccessWithTypedBodyAndRoundTrips(MethodType t)
+    {
+        var r = PostMatchWatchdog.TimeoutReply(Q(t));
+        Assert.Equal(Error.Success, r.Error);
+        Assert.Equal(t, r.Type);
+        Assert.Equal("r1", r.RequestId);
+        using var ms = new MemoryStream();
+        ProtoBuf.Serializer.Serialize(ms, r);
+        ms.Position = 0;
+        var back = ProtoBuf.Serializer.Deserialize<Response>(ms);
+        Assert.Equal(Error.Success, back.Error);
+        if (t == MethodType.MthdSaveResultCapture) Assert.Empty(back.save_result_capture.Urls);   // no upload URL
+    }
+
+    [Fact]
+    public async Task FastHandlerIsReturnedAsIs()
+    {
+        var q = Q(MethodType.MthdSaveVsmOnResult);
+        var (r, late) = await PostMatchWatchdog.RunAsync(q, 2000,
+            () => Task.FromResult(new Response { Type = q.Type, RequestId = q.RequestId, Error = Error.ErrServer, ErrorMsg = "x" }));
+        Assert.False(late);
+        Assert.Equal("x", r.ErrorMsg);
+    }
+
+    [Fact]
+    public async Task SlowBlockingHandlerGetsEarlySuccessAndStillFinishes()
+    {
+        var q = Q(MethodType.MthdSaveVsmOnResult);
+        var finished = new TaskCompletionSource<bool>();
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        var (r, late) = await PostMatchWatchdog.RunAsync(q, 500, () =>
+        {
+            Thread.Sleep(1500);   // upstream handlers block synchronously (SQLite busy wait)
+            return Task.FromResult(new Response { Type = q.Type, Error = Error.Success });
+        }, t => finished.TrySetResult(t.IsCompletedSuccessfully));
+        Assert.True(late);
+        Assert.Equal(Error.Success, r.Error);
+        Assert.NotNull(r.save_vsm_on_result);
+        Assert.InRange(sw.ElapsedMilliseconds, 400, 1400);
+        Assert.True(await finished.Task.WaitAsync(TimeSpan.FromSeconds(5)));   // background save completed
+    }
+
+    [Fact]
+    public void LogMaskHidesCardValuesOnly()
+    {
+        const string dump = "Request is (Stringified)   : $id = 1\n  Type            : 100\n  PcbSerial       : TAGPCB0001\n" +
+                            "  Token           : \n  pre_load_card   : $id = 2\n    IsCard          : True\n" +
+                            "    AccessCode      : FAKE2586900000001\n    ChipId          : FAKECHIP58690001\n" +
+                            "    SessionId       : abcdef0123456789\n  load_card       : (null)\n";
+        var m = LogMask.Mask(dump);
+        Assert.DoesNotContain("FAKE2586900000001", m);
+        Assert.DoesNotContain("FAKECHIP58690001", m);
+        Assert.DoesNotContain("abcdef0123456789", m);
+        Assert.Contains("AccessCode      : <masked:17>", m);
+        Assert.Contains("PcbSerial       : TAGPCB0001", m);   // non-secret fields unchanged
+        Assert.Contains("load_card       : (null)", m);
+        Assert.Contains("Token           : \n", m);
+        Assert.Equal("Card not exist for ChipId = <masked:16>, Now creating...",
+            LogMask.Mask("Card not exist for ChipId = FAKECHIP58690001, Now creating..."));
+        Assert.Equal(m, LogMask.Mask(m));   // idempotent
+    }
+}
diff --git a/Tests/Matchmaking.Tests/HumansVsCpuSimTests.cs b/Tests/Matchmaking.Tests/HumansVsCpuSimTests.cs
new file mode 100644
index 0000000..9942148
--- /dev/null
+++ b/Tests/Matchmaking.Tests/HumansVsCpuSimTests.cs
@@ -0,0 +1,154 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace Matchmaking.Tests;
+
+// results-hang simulation (analysis/results-hang-sim.md section 4): many fake cabinets (solo / 2-human team /
+// cabinet with its own CPU partner, two modes, random arrival) polled once a second, HumansVsCpu off vs on, same seed.
+// Checks room invariants and that the flag only changes rooms that would otherwise be short-handed with two humans.
+public class HumansVsCpuSimTests
+{
+    private readonly ITestOutputHelper _out;
+    public HumansVsCpuSimTests(ITestOutputHelper output) => _out = output;
+
+    private static Client Cl(uint node, bool human = true)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = human ? $"P{node}" : Matchmaker.NpcSerial, LocId = $"L{node}", PrefCode = 13,
+            GlobalIpaddress = "203.0.113.1", NatMappingType = NatMappingType.NmEndpointIndependent,
+            NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = human ? "Y" : "N" });
+        return c;
+    }
+
+    private enum Kind { Solo, Team, CpuPartner }
+    private sealed record Cab(uint Node, Kind Kind, uint World, double Arrive, uint Partner);
+
+    private static Request.EntryMatching Entry(Cab c)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(c.Node), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = c.Node },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = c.World }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        if (c.Kind != Kind.Solo)
+            e.Groups.Add(new Request.EntryMatching.Group
+            {
+                Client = Cl(c.Partner, c.Kind == Kind.Team),
+                Player = new Player { BanapassportAmId = c.Kind == Kind.Team ? c.Partner : 0 }
+            });
+        return e;
+    }
+
+    private static List<Cab> Population(int seed, int n)
+    {
+        var rnd = new Random(seed);
+        var cabs = new List<Cab>();
+        for (int i = 0; i < n; i++)
+        {
+            uint node = 20000u + 8u * (uint)i;                  // ids: node, node+1 (2nd id), partner node+4, node+5
+            double p = rnd.NextDouble();
+            var kind = p < 0.55 ? Kind.Solo : p < 0.8 ? Kind.Team : Kind.CpuPartner;
+            uint partner = kind == Kind.Team ? node + 4 : kind == Kind.CpuPartner ? node + 1 : 0;
+            cabs.Add(new Cab(node, kind, rnd.NextDouble() < 0.7 ? 23u : 21u, Math.Round(rnd.NextDouble() * 240), partner));
+        }
+        return cabs;
+    }
+
+    private sealed record Outcome(List<Matchmaker.Room> Rooms, Dictionary<uint, Matchmaker.Room> ByNode, int Unmatched);
+
+    private static Outcome Run(List<Cab> cabs, bool flag)
+    {
+        var mm = new Matchmaker(fillAfter: 30, allowPartial: true, softWait: 15, seed: 7)
+        { StaleAfter = 1e6, HumansVsCpu = flag, Realms = null };
+        foreach (var c in cabs)
+        {
+            mm.RegisterIssued(new[] { c.Node, c.Node + 1 });
+            if (c.Kind == Kind.Team) mm.RegisterIssued(new[] { c.Partner, c.Partner + 1 });
+        }
+        var rooms = new List<Matchmaker.Room>();
+        var byNode = new Dictionary<uint, Matchmaker.Room>();
+        var waiting = new HashSet<Cab>();
+        for (double t = 0; t <= 450; t += 1)
+        {
+            foreach (var c in cabs.Where(c => c.Arrive == t)) { mm.Entry(Entry(c), t); waiting.Add(c); }
+            foreach (var c in waiting.ToList())
+            {
+                var (code, room, _) = mm.Check(c.Node, t);
+                if (room != null)
+                {
+                    if (!rooms.Contains(room)) rooms.Add(room);
+                    Assert.False(byNode.ContainsKey(c.Node) && !ReferenceEquals(byNode[c.Node], room), "cabinet in two rooms");
+                    byNode[c.Node] = room; waiting.Remove(c);
+                    if (c.Kind == Kind.Team) byNode[c.Partner] = room;
+                }
+                else if (code == ErrorCode.MatchCanceled) waiting.Remove(c);
+            }
+        }
+        return new Outcome(rooms, byNode, cabs.Count(c => !byNode.ContainsKey(c.Node)));
+    }
+
+    private static bool IsHumansVsCpu(Matchmaker.Room r) =>
+        r.Clients.Count == 4 && r.Clients.Count(c => c.GroupId == 0) == 2
+        && r.Clients.Where(c => c.GroupId == 0).All(c => Matchmaker.Unit.IsHuman(c.Client))
+        && r.Clients.Where(c => c.GroupId == 1).All(c => !Matchmaker.Unit.IsHuman(c.Client));
+
+    private static void Invariants(Outcome o, List<Cab> cabs, bool flag)
+    {
+        var seen = new HashSet<uint>();
+        foreach (var r in o.Rooms)
+        {
+            Assert.InRange(r.Clients.Count, 2, 4);
+            Assert.All(r.Clients, c => Assert.InRange(c.GroupId, 0u, 1u));
+            Assert.True(r.Clients.Count(c => c.GroupId == 0) <= 2 && r.Clients.Count(c => c.GroupId == 1) <= 2);
+            var ids = r.Clients.Select(c => c.Client.NodeId).ToList();
+            Assert.Equal(ids.Count, ids.Distinct().Count());                          // no id twice in a room
+            foreach (var h in r.Clients.Where(c => Matchmaker.Unit.IsHuman(c.Client)))
+                Assert.True(seen.Add(h.Client.NodeId), $"human {h.Client.NodeId} in two rooms");
+            var worlds = cabs.Where(c => ids.Contains(c.Node)).Select(c => c.World).Distinct().ToList();
+            Assert.Single(worlds);                                                    // never mixes modes
+            if (IsHumansVsCpu(r))
+            {
+                Assert.True(flag, "humans-vs-cpu room with the flag off");
+                var humans = r.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId).ToHashSet();
+                Assert.All(r.Clients.Where(c => c.GroupId == 1), c =>
+                {
+                    Assert.Equal(Matchmaker.NpcSerial, c.Client.PcbSerial);
+                    Assert.Contains(c.Client.NodeId - 1, humans);                     // stand-in on its human's 2nd id
+                });
+                // never built from a cabinet that brought its own CPU partner
+                Assert.DoesNotContain(cabs, c => c.Kind == Kind.CpuPartner && humans.Contains(c.Node));
+            }
+        }
+    }
+
+    [Theory]
+    [InlineData(1)] [InlineData(2)] [InlineData(3)] [InlineData(4)] [InlineData(5)]
+    [InlineData(6)] [InlineData(7)] [InlineData(8)] [InlineData(9)] [InlineData(10)]
+    public void ManyCabinetsOffVsOn(int seed)
+    {
+        foreach (int n in new[] { 6, 24, 120 })
+        {
+            var cabs = Population(seed * 1000 + n, n);
+            var off = Run(cabs, false);
+            var on = Run(cabs, true);
+            Invariants(off, cabs, false);
+            Invariants(on, cabs, true);
+            int hvc = on.Rooms.Count(IsHumansVsCpu);
+            int humansOff = off.Rooms.Sum(r => r.Humans), humansOn = on.Rooms.Sum(r => r.Humans);
+            _out.WriteLine($"seed {seed} n={n,3}: off rooms={off.Rooms.Count,3} humans matched={humansOff,3} unmatched cabs={off.Unmatched,3} | " +
+                           $"on rooms={on.Rooms.Count,3} humans matched={humansOn,3} unmatched cabs={on.Unmatched,3} humans-vs-cpu={hvc}");
+            // the flag can only add matches (lone 2-human teams) or turn short 1v1s into teammates; it never strands more
+            Assert.True(on.Unmatched <= off.Unmatched, $"flag on left more cabinets unmatched ({on.Unmatched} > {off.Unmatched})");
+            // full rooms of 4 humans are as frequent with the flag (+-1 from changed timing)
+            int full(Outcome o) => o.Rooms.Count(r => r.Clients.Count == 4 && r.Clients.All(c => Matchmaker.Unit.IsHuman(c.Client)));
+            Assert.InRange(full(on), full(off) - 1, full(off) + 1);
+        }
+    }
+}
