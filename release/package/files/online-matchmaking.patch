+using Serilog.Core;
+using Serilog.Events;
+
+namespace ServerInfinite.Lobbies.Serilog;
+
+/// <summary>
+/// exvs2-lobbies: with CardServerConfig.MaskCardSecretsInLog (default true), replaces the value of structured log
+/// properties that carry card data (e.g. upstream's "Card not exist for ChipId = {ChipId}") with "&lt;masked:N&gt;".
+/// Logging only; the request dump itself is masked by <see cref="LogMask"/>.
+/// </summary>
+public sealed class CardSecretMaskEnricher : ILogEventEnricher
+{
+    private static readonly string[] Names = { "ChipId", "AccessCode", "SessionId", "Token", "BootToken", "UploadToken" };
+
+    public void Enrich(LogEvent logEvent, ILogEventPropertyFactory propertyFactory)
+    {
+        foreach (var name in Names)
+            if (logEvent.Properties.TryGetValue(name, out var v) && v is ScalarValue { Value: string s } && s.Length > 0
+                && !s.StartsWith("<masked:"))
+                logEvent.AddOrUpdateProperty(new LogEventProperty(name, new ScalarValue($"<masked:{s.Length}>")));
+    }
+}
