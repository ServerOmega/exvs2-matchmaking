+
+/// <summary>
+/// Shared matchmaker API for cross-server online-tag invites. No card secrets are accepted or logged.
+/// Card servers (and the WebUI through them) call these endpoints; cabinets do not.
+/// </summary>
+[ApiController]
+[Route("tag")]
+public class TagInviteController : ControllerBase
+{
+    private readonly TagInviteStore _store;
+    private readonly Matchmaker _mm;
+    private readonly ILogger<TagInviteController> _log;
+
+    public TagInviteController(TagInviteStore store, Matchmaker mm, ILogger<TagInviteController> log)
+    {
+        _store = store;
+        _mm = mm;
+        _log = log;
+    }
+
+    public sealed class CreateRequest
+    {
+        public uint PilotId { get; set; }
+        public string Name { get; set; } = "";
+    }
+
+    public sealed class JoinRequest
+    {
+        public string Code { get; set; } = "";
+        public uint PilotId { get; set; }
+        public string Name { get; set; } = "";
+    }
+
+    public sealed class RegisterRequest
+    {
+        public uint AmId { get; set; }
+        public string[] Codes { get; set; } = Array.Empty<string>();
+    }
+
+    public sealed class SettingsRequest
+    {
+        public uint PilotId { get; set; }
