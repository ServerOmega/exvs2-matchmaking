+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.TagInvites;
+
+/// <summary>
+/// Card-server view of the shared matchmaker invite store. In-process on the VPS / all-in-one;
+/// HTTP to InviteUrl (or MatchUrl rewritten to /tag) on a split card server.
+/// Never sends card access codes, chip ids, or passwords.
+/// </summary>
+public interface ITagInviteClient
+{
+    Task<string> CreateAsync(uint creatorPilotId, string creatorName, CancellationToken ct = default);
+    Task<TagInvite> JoinAsync(string code, uint partnerPilotId, string partnerName, CancellationToken ct = default);
+    Task<TagInvite?> GetAsync(string code, CancellationToken ct = default);
+    Task<IReadOnlyList<TagInvite>> ForPilotAsync(uint wirePilotId, CancellationToken ct = default);
+    Task RegisterSearchAsync(uint amId, IEnumerable<string> codes, CancellationToken ct = default);
+    Task<TagInvite> UpdateSettingsAsync(string code, uint byPilotId, TagTeamSettings settings, CancellationToken ct = default);
+}
