--- /dev/null
+++ b/Tests/Matchmaking.Tests/PilotIdTests.cs
@@ -0,0 +1,85 @@
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+public class PilotIdTests : IDisposable
+{
+    public PilotIdTests() => PilotId.SetServerId(0);
+
+    public void Dispose() => PilotId.SetServerId(0);
+
+    [Fact]
+    public void UninitializedServerLeavesLocalIdsUnchanged()
+    {
+        PilotId.SetServerId(0);
+        Assert.Equal(1u, PilotId.Wire(1));
+        Assert.Equal(42, PilotId.Local(42));
+        Assert.False(PilotId.IsRemote(1));
+        Assert.Equal(1, PilotId.ToLocalOrUnmatched(1));
+    }
+
+    [Fact]
+    public void WireIsServerTimesBlockPlusLocalId()
+    {
+        PilotId.SetServerId(1);
+        Assert.Equal(1_000_001u, PilotId.Wire(1));
+        PilotId.SetServerId(2);
+        Assert.Equal(2_000_001u, PilotId.Wire(1));
+        Assert.Equal(1, PilotId.Local(2_000_001));
+        Assert.Equal(2, PilotId.ServerOf(2_000_001));
+        Assert.True(PilotId.IsRemote(1_000_001));
+        Assert.False(PilotId.IsRemote(2_000_001));
+    }
+
+    [Fact]
+    public void TwoServersWithTheSameLocalCardIdDoNotShareAWireId()
+    {
+        PilotId.SetServerId(1);
+        var a = PilotId.Wire(1);
+        PilotId.SetServerId(2);
+        var b = PilotId.Wire(1);
+        Assert.NotEqual(a, b);
+        Assert.Equal(a, Math.Min(a, b)); // 1_000_001 < 2_000_001, so both sides agree on the pair key
+        Assert.Equal(1_000_001u, Math.Min(a, b));
+    }
+
+    [Fact]
+    public void ToLocalOrUnmatchedRejectsAnotherServersId()
+    {
+        PilotId.SetServerId(1);
+        Assert.Equal(1, PilotId.ToLocalOrUnmatched(1_000_001));
+        Assert.Equal(1, PilotId.ToLocalOrUnmatched(1)); // legacy local
+        Assert.Equal(-1, PilotId.ToLocalOrUnmatched(2_000_001));
+        Assert.True(PilotId.IsThisCard(1, 1_000_001));
+        Assert.False(PilotId.IsThisCard(1, 2_000_001));
+    }
+
+    [Fact]
+    public void InitializePersistsAGeneratedId()
+    {
+        var path = Path.Combine(Path.GetTempPath(), "pilotid-test-" + Guid.NewGuid().ToString("n") + ".txt");
+        try
+        {
+            var first = PilotId.Initialize(0, path);
+            Assert.InRange(first, 1, PilotId.MaxServerId);
+            Assert.True(File.Exists(path));
+            PilotId.SetServerId(0);
+            var second = PilotId.Initialize(0, path);
+            Assert.Equal(first, second);
+            var forced = PilotId.Initialize(7, path);
+            Assert.Equal(7, forced);
+        }
+        finally
+        {
+            if (File.Exists(path)) File.Delete(path);
+            PilotId.SetServerId(0);
+        }
+    }
+
+    [Fact]
+    public void ServerIdAboveMaxIsRejected()
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() => PilotId.SetServerId(PilotId.MaxServerId + 1));
+    }
+}
