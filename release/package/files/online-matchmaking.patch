@@ -0,0 +1,41 @@
+using MediatR;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Common.TagInvites;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Response;
+using WebUIInfinite.Shared.Exception;
+
+namespace ServerInfinite.Handlers.UI.Team;
+
+public record CreateCrossServerInviteCommand(string AccessCode, string ChipId) : IRequest<CrossServerInviteResponse>;
+
+public class CreateCrossServerInviteCommandHandler : IRequestHandler<CreateCrossServerInviteCommand, CrossServerInviteResponse>
+{
+    private readonly ServerDbContext _context;
+    private readonly ITagInviteClient _invites;
+
+    public CreateCrossServerInviteCommandHandler(ServerDbContext context, ITagInviteClient invites)
+    {
+        _context = context;
+        _invites = invites;
+    }
+
+    public async Task<CrossServerInviteResponse> Handle(CreateCrossServerInviteCommand request, CancellationToken cancellationToken)
+    {
+        var card = _context.CardProfiles
+            .FirstOrDefault(x => x.AccessCode == request.AccessCode && x.ChipId == request.ChipId);
+        if (card is null) throw new InvalidCardDataException("Card Profile is invalid");
+        try
+        {
+            var code = await _invites.CreateAsync(PilotId.Wire(card.Id), card.UserName ?? "", cancellationToken);
+            return new CrossServerInviteResponse { Success = true, Code = code };
+        }
+        catch (Exception ex)
+        {
+            return new CrossServerInviteResponse { Success = false, Message = ex.Message };
+        }
+    }
+}
