@@ -0,0 +1,93 @@
+using nue.protocol.exvs;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// exvs2-lobbies results-hang trace (2026-11-14, logging only, replies unchanged). Times the results screen from the
+/// card server's side: when a cabinet sends its result save (SaveVsmOnResult etc.) the clock starts; the next request
+/// from the same cabinet (pcb serial) stops it and is logged as RESULT-GAP. While nothing arrives, any other request
+/// (the LMs poll LoadRanking every 10 s) sweeps the open clocks and logs RESULT-WAIT at 30/60/120/300/600 s, so a hang
+/// shows up in the log while it is happening. A repeated save is logged as a retry. Only the last 4 characters of the
+/// pcb serial are printed; no card data.
+/// </summary>
+public sealed class ResultGapTrace
+{
+    private static readonly HashSet<MethodType> Saves = new()
+    {
+        MethodType.MthdSaveVsmResult, MethodType.MthdSaveVsmOnResult, MethodType.MthdSaveVscResult,
+        MethodType.MthdSaveVstResult, MethodType.MthdSaveVsmToResult, MethodType.MthdSavePracticeResult,
+        MethodType.MthdSaveStageResult, MethodType.MthdSaveTournamentResult
+    };
+
+    private static readonly double[] Marks = { 30, 60, 120, 300, 600 };
+
+    private sealed class Open
+    {
+        public MethodType Save;
+        public double At;
+        public int Tries = 1;
+        public int MarksDone;
+    }
+
+    private readonly Dictionary<string, Open> _open = new();
+    private readonly object _gate = new();
+
+    public bool Enabled { get; set; } = true;
+
+    public static bool IsResultSave(MethodType t) => Saves.Contains(t);
+
+    public static string Short(string? pcb) =>
+        string.IsNullOrEmpty(pcb) ? "-" : pcb.Length <= 4 ? pcb : "…" + pcb[^4..];
+
+    /// <summary>Lines to log for this request (possibly none). <paramref name="now"/> in seconds.</summary>
+    public List<string> Observe(MethodType type, string? pcbSerial, double now)
+    {
+        var lines = new List<string>();
+        if (!Enabled) return lines;
+        lock (_gate)
+        {
+            var pcb = pcbSerial ?? "";
+            // sweep: report cabinets that have been silent since their result save
+            foreach (var (key, o) in _open)
+            {
+                if (key == pcb) continue;
+                while (o.MarksDone < Marks.Length && now - o.At >= Marks[o.MarksDone])
+                {
+                    lines.Add(FormattableString.Invariant($"RESULT-WAIT pcb={Short(key)} {Name(o.Save)} answered, no request from this cabinet for {Marks[o.MarksDone]:0}s"));
+                    o.MarksDone++;
+                }
+            }
+            if (pcb.Length == 0) return lines;
+
+            _open.TryGetValue(pcb, out var open);
+            if (IsResultSave(type))
+            {
+                if (open != null && open.Save == type)
+                {
+                    open.Tries++;
+                    lines.Add(FormattableString.Invariant($"RESULT-SAVE pcb={Short(pcb)} {Name(type)} retry #{open.Tries} +{now - open.At:0.0}s"));
+                    return lines;
+                }
+                if (open != null)
+                    lines.Add(Gap(pcb, open, type, now));
+                _open[pcb] = new Open { Save = type, At = now };
+                lines.Add($"RESULT-SAVE pcb={Short(pcb)} {Name(type)} (results screen clock started)");
+                if (_open.Count > 4096) _open.Clear();
+                return lines;
+            }
+            if (open != null)
+            {
+                lines.Add(Gap(pcb, open, type, now));
+                _open.Remove(pcb);
+            }
+        }
+        return lines;
+    }
+
+    private static string Gap(string pcb, Open o, MethodType next, double now) =>
+        FormattableString.Invariant($"RESULT-GAP pcb={Short(pcb)} {Name(o.Save)} -> next {Name(next)} after {now - o.At:0.0}s") +
+        (o.Tries > 1 ? $" (save sent {o.Tries}x)" : "");
+
+    private static string Name(MethodType t) =>
+        Enum.IsDefined(typeof(MethodType), t) ? t.ToString() : $"type{(int)t}";
+}
