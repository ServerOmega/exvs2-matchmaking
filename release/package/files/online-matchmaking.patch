@@ -0,0 +1,53 @@
+using MediatR;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Options;
+using ServerInfinite.Common.TagInvites;
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+using WebUIInfinite.Shared.Dto.Request;
+using WebUIInfinite.Shared.Dto.Response;
+using WebUIInfinite.Shared.Exception;
+
+namespace ServerInfinite.Handlers.UI.Team;
+
+public record JoinCrossServerInviteCommand(JoinCrossServerTeamRequest Request) : IRequest<CrossServerInviteResponse>;
+
+public class JoinCrossServerInviteCommandHandler : IRequestHandler<JoinCrossServerInviteCommand, CrossServerInviteResponse>
+{
+    private readonly ServerDbContext _context;
+    private readonly ITagInviteClient _invites;
+    private readonly ILogger<JoinCrossServerInviteCommandHandler> _log;
+    private readonly OnlineTagConfigurations _cfg;
+
+    public JoinCrossServerInviteCommandHandler(ServerDbContext context, ITagInviteClient invites,
+        ILogger<JoinCrossServerInviteCommandHandler> log, IOptions<CardServerConfig>? options = null)
+    {
+        _context = context;
+        _invites = invites;
+        _log = log;
+        _cfg = options?.Value.OnlineTag ?? new OnlineTagConfigurations();
+    }
+
+    public async Task<CrossServerInviteResponse> Handle(JoinCrossServerInviteCommand request, CancellationToken cancellationToken)
+    {
+        var req = request.Request;
+        var card = _context.CardProfiles
+            .Include(x => x.TagTeamDatas)
+            .FirstOrDefault(x => x.AccessCode == req.AccessCode && x.ChipId == req.ChipId);
+        if (card is null) throw new InvalidCardDataException("Card Profile is invalid");
+        try
+        {
+            var inv = await _invites.JoinAsync(req.Code, PilotId.Wire(card.Id), card.UserName ?? "", cancellationToken);
+            var team = CrossServerTeamSupport.Upsert(_context, card, inv, _cfg.MaxTeams);
+            _context.SaveChanges();
+            _log.LogInformation("Cross-server tag joined: wire={Wire} partner={Partner} team={TeamId}",
+                PilotId.Wire(card.Id), inv.CreatorPilotId, team?.Id);
+            return new CrossServerInviteResponse { Success = true, Code = inv.Code };
+        }
+        catch (Exception ex)
+        {
+            return new CrossServerInviteResponse { Success = false, Message = ex.Message };
+        }
+    }
+}
