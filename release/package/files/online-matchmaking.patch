@@ -0,0 +1,142 @@
+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// results-hang fix #1 (analysis/results-hang-fixes.md section 4.1): HumansVsCpu. Fake entries only.
+public class HangFixTests
+{
+    private static Client Cl(uint node, bool human = true)
+    {
+        var c = new Client
+        {
+            NodeId = node, PcbSerial = human ? $"P{node}" : Matchmaker.NpcSerial, LocId = $"L{node}", PrefCode = 13,
+            GlobalIpaddress = "203.0.113.1", NatMappingType = NatMappingType.NmEndpointIndependent,
+            NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = human ? "Y" : "N" });
+        return c;
+    }
+
+    private static Request.EntryMatching Solo(uint node, uint world = 23, uint? partner = null, bool cpuPartner = false)
+    {
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = Cl(node), MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = node },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        if (partner != null)
+            e.Groups.Add(new Request.EntryMatching.Group
+            {
+                Client = Cl(partner.Value, !cpuPartner), Player = new Player { BanapassportAmId = cpuPartner ? 0 : partner.Value }
+            });
+        return e;
+    }
+
+    private static Matchmaker New(bool on = true, List<string>? log = null) =>
+        new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1)
+        {
+            StaleAfter = 1e6, HumansVsCpu = on, Realms = null, Log = log == null ? null : log.Add
+        };
+
+    [Fact]
+    public void OffByDefault()
+    {
+        Assert.False(new Matchmaker().HumansVsCpu);
+        var mm = New(on: false);
+        mm.Entry(Solo(1100), 0); mm.Entry(Solo(1102), 0);
+        var room = mm.Check(1100, 31).Room!;
+        Assert.Equal(2, room.Clients.Count);
+        Assert.NotEqual(room.Clients[0].GroupId, room.Clients[1].GroupId);   // unchanged: 1v1
+    }
+
+    [Fact]
+    public void TwoSolosBecomeTeammatesAgainstTwoStandIns()
+    {
+        var log = new List<string>();
+        var mm = New(log: log);
+        mm.RegisterIssued(new uint[] { 1100, 1101 });
+        mm.RegisterIssued(new uint[] { 1102, 1103 });
+        mm.Entry(Solo(1100), 0); mm.Entry(Solo(1102), 0);
+        Assert.Null(mm.Check(1100, 10).Room);                     // waits FillAfter for a real 2v2 first
+        var room = mm.Check(1100, 31).Room!;
+        Assert.Equal(4, room.Clients.Count);
+        Assert.Equal(new uint[] { 1100, 1102 }, room.Clients.Where(c => c.GroupId == 0).Select(c => c.Client.NodeId));
+        var cpu = room.Clients.Where(c => c.GroupId == 1).ToList();
+        Assert.Equal(new uint[] { 1101, 1103 }, cpu.Select(c => c.Client.NodeId));
+        Assert.All(cpu, c =>
+        {
+            Assert.False(Matchmaker.Unit.IsHuman(c.Client));
+            Assert.Equal(Matchmaker.NpcSerial, c.Client.PcbSerial);
+            Assert.Equal("0.0.0.0", c.Client.GlobalIpaddress);
