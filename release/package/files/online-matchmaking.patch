+    private void RememberRoom(Unit u, Room room)
+    {
+        if (PostMatchWindow <= 0) return;
+        foreach (var n in u.NodeIds) _lastRoomByNode[n] = (room.RoomId, room.At);
+        foreach (var ip in u.SourceByNode.Values) _lastRoomByIp[ip] = (room.RoomId, room.At);
+        foreach (var c in u.Humans)
+            if (!string.IsNullOrEmpty(c.GlobalIpaddress) && c.GlobalIpaddress != "0.0.0.0")
+                _lastRoomByIp[NetDiag.Norm(c.GlobalIpaddress)] = (room.RoomId, room.At);
+        Trim(_lastRoomByNode); Trim(_lastRoomByIp);
+        static void Trim<TK>(Dictionary<TK, (uint Room, double At)> d) where TK : notnull
+        {
+            if (d.Count <= LastRoomMax) return;
+            foreach (var k in d.OrderBy(kv => kv.Value.At).Take(d.Count - LastRoomMax).Select(kv => kv.Key).ToList()) d.Remove(k);
+        }
