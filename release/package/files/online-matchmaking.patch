+using nue.protocol.mms;
+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+// In-store fill override (2026-11-14 23:00 PT). Offline in-store shuffle, one shop, four cabinets:
+// cab3 joined at t=0, cab2 at t=2, cab1 at t=42, cab4 at t=45. With the shared 30s rolling window a
+// 1v1 formed at t=32 and the late pair made a second 1v1 (both hung after results). In-store waits
+// longer (InStoreFillAfter=60, InStoreMaxFillWait=120) so all four shuffle into one 2v2.
+public class InStoreFillTests
+{
+    private uint _node = 5000;
+
+    private Request.EntryMatching Entry(uint world, string local, string global = "192.168.1.245")
+    {
+        var me = ++_node;
+        var c = new Client
+        {
+            NodeId = me, PcbSerial = $"P{me}", LocId = "JPN1", PrefCode = 13,
+            LocalIpaddress = local, GlobalIpaddress = local,
+            NatMappingType = NatMappingType.NmEndpointIndependent, NatFilteringType = NatFilteringType.NfEndpointIndependent
+        };
+        c.Properties.Add(new Client.Property { PropertyId = 0, PropertyValue = "Y" });
+        var e = new Request.EntryMatching
+        {
+            ApplyId = 1, Myclient = c, MatchingTimeout = 150,
+            Myplayer = new Player { BanapassportAmId = me },
+            World = new World { MuchaGameId = "GIB1", Version = 1, WorldId = world }
+        };
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 1, parameter = 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 2, parameter = world == 15 ? 0x100000 : 0 });
+        e.Myplayer.Parameters.Add(new Player.Parameter { AttributeId = 4, parameter = 0 });
+        return e;
+    }
+
+    private static Matchmaker New(double inStoreFill = 60, double inStoreCap = 120) =>
+        new(fillAfter: 30, allowPartial: true, softWait: 15, seed: 1,
+            fillTimerMode: FillTimerMode.Rolling, maxFillWait: 90)
+        {
+            StaleAfter = 1e6, Realms = NetDiag.DefaultRealms,
+            InStoreFillAfter = inStoreFill, InStoreMaxFillWait = inStoreCap
+        };
+
+    private (Request.EntryMatching a, Request.EntryMatching b, Request.EntryMatching c, Request.EntryMatching d) Four(uint world) =>
+        (Entry(world, "192.168.1.71"), Entry(world, "192.168.1.73"), Entry(world, "192.168.1.69"), Entry(world, "192.168.1.72"));
+
+    [Fact]
+    public void TonightInStoreTimeline_OneTwoVsTwo()
+    {
+        var mm = New();
+        var (a, b, c, d) = Four(15);
+        mm.Entry(a, 0); mm.Entry(b, 2);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 32).Room);   // the 30s window that split them tonight
+        mm.Entry(c, 42);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 43).Room);
+        mm.Entry(d, 45);
+        var room = mm.Check(a.Myclient.NodeId, 45).Room!;
+        Assert.Equal(4, room.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+        foreach (var e in new[] { a, b, c, d }) Assert.Same(room, mm.Check(e.Myclient.NodeId, 45).Room);
+    }
+
+    [Fact]
+    public void WithoutOverride_TonightInStoreTimelineSplitsIntoTwo1v1s()
+    {
+        var mm = New(inStoreFill: 0, inStoreCap: 0);
+        var (a, b, c, d) = Four(15);
+        mm.Entry(a, 0); mm.Entry(b, 2);
+        var first = mm.Check(a.Myclient.NodeId, 32).Room!;
+        Assert.Equal(2, first.Clients.Count(x => Matchmaker.Unit.IsHuman(x.Client)));
+        mm.Entry(c, 42); mm.Entry(d, 45);
+        Assert.Null(mm.Check(c.Myclient.NodeId, 46).Room);
+        var second = mm.Check(c.Myclient.NodeId, 76).Room!;
+        Assert.NotSame(first, second);
+    }
+
+    [Fact]
+    public void InStorePairStillPlaysAfterSixtySecondsAlone()
+    {
+        var mm = New();
+        var (a, b, _, _) = Four(15);
+        mm.Entry(a, 0); mm.Entry(b, 2);
+        Assert.Null(mm.Check(a.Myclient.NodeId, 61).Room);
+        Assert.NotNull(mm.Check(a.Myclient.NodeId, 62).Room);
+    }
+
+    [Fact]
+    public void InStoreCapLimitsRollingResets()
+    {
+        var mm = New();
+        var a = Entry(15, "192.168.1.71"); var b = Entry(15, "192.168.1.73"); var c = Entry(15, "192.168.1.69");
+        mm.Entry(a, 0); mm.Entry(b, 55); mm.Entry(c, 110);   // rolling would wait until 170
+        Assert.Null(mm.Check(a.Myclient.NodeId, 119).Room);
+        Assert.NotNull(mm.Check(a.Myclient.NodeId, 120).Room);
+    }
+
+    [Fact]
+    public void OnlineWorldsKeepTheSharedFillAfter()
+    {
+        var mm = New();
+        var a = Entry(23, "192.168.1.71"); var b = Entry(23, "192.168.1.73");
+        mm.Entry(a, 0); mm.Entry(b, 2);
+        Assert.NotNull(mm.Check(a.Myclient.NodeId, 32).Room);   // Mix still uses 30s
+    }
+}
