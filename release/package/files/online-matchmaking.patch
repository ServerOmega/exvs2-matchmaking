+using ServerInfinite.Matchmaking;
+using Xunit;
+
+namespace Matchmaking.Tests;
+
+public class TagInviteStoreTests
+{
+    [Fact]
+    public void CreateReturnsAnEightCharacterCodeAndJoinIsIdempotent()
+    {
+        var store = new TagInviteStore();
+        var code = store.Create(1_000_001, "Alice");
+        Assert.Equal(TagInviteStore.CodeLength, code.Length);
+        Assert.Equal(code, store.Create(1_000_001, "Alice")); // reuse open invite
+        var inv = store.Join(code.ToLowerInvariant(), 2_000_001, "Bob");
+        Assert.True(inv.Joined);
+        Assert.Equal(1_000_001u, inv.CreatorPilotId);
+        Assert.Equal(2_000_001u, inv.PartnerPilotId);
+        Assert.Equal("Bob", inv.PartnerName);
+        var again = store.Join(code, 2_000_001, "Bob");
+        Assert.Equal(2_000_001u, again.PartnerPilotId);
+    }
+
+    [Fact]
+    public void CannotJoinOwnCodeOrAMissingCodeOrATakenCode()
+    {
+        var store = new TagInviteStore();
+        var code = store.Create(1_000_001, "A");
+        Assert.Throws<InvalidOperationException>(() => store.Join(code, 1_000_001, "A"));
+        Assert.Throws<InvalidOperationException>(() => store.Join("ZZZZZZZZ", 2_000_001, "B"));
+        store.Join(code, 2_000_001, "B");
+        Assert.Throws<InvalidOperationException>(() => store.Join(code, 3_000_001, "C"));
+    }
+
+    [Fact]
+    public void ForPilotListsCreatedAndJoinedInvites()
+    {
+        var store = new TagInviteStore();
+        var code = store.Create(1_000_001, "A");
+        store.Join(code, 2_000_001, "B");
+        Assert.Single(store.ForPilot(1_000_001));
+        Assert.Single(store.ForPilot(2_000_001));
+        Assert.Empty(store.ForPilot(3_000_001));
+    }
+
+    [Fact]
+    public void RegisterSearchRoundTripsAndPersists()
+    {
+        var path = Path.Combine(Path.GetTempPath(), "tag-invites-test-" + Guid.NewGuid().ToString("n") + ".json");
+        try
+        {
+            var store = new TagInviteStore(path);
+            var code = store.Create(1_000_001, "A");
+            store.Join(code, 2_000_001, "B");
+            store.RegisterSearch(1_000_001, new[] { code });
+            Assert.Equal(new[] { code }, store.CodesForAm(1_000_001));
+            store.UpdateSettings(code, 1_000_001, new TagTeamSettings
+            {
+                TeamName = "PERSIST TEAM",
+                BgmId = 3,
+                EffectId = 7,
+            });
+            var reloaded = new TagInviteStore(path);
+            Assert.Equal(code, reloaded.Get(code)!.Code);
+            Assert.Equal(2_000_001u, reloaded.Get(code)!.PartnerPilotId);
+            Assert.Equal(new[] { code }, reloaded.CodesForAm(1_000_001));
+            Assert.Equal("PERSIST TEAM", reloaded.Get(code)!.Settings!.TeamName);
+            Assert.Equal(3u, reloaded.Get(code)!.Settings!.BgmId);
+            Assert.Equal(7u, reloaded.Get(code)!.Settings!.EffectId);
+        }
+        finally
+        {
+            if (File.Exists(path)) File.Delete(path);
+        }
+    }
+
+    [Fact]
+    public void ResolveInviteUrlRewritesMatchUrl()
+    {
+        Assert.Equal("http://host:28090/tag", TagInviteUrl.Resolve(null, "http://host:28090/match"));
+        Assert.Equal("http://host:9/tag", TagInviteUrl.Resolve("http://host:9/tag/", "http://other/match"));
+        Assert.Null(TagInviteUrl.Resolve("", ""));
+    }
+
+    [Fact]
+    public void UpdateSettingsLastWriteWinsAndRejectsStrangers()
+    {
+        var store = new TagInviteStore();
+        var code = store.Create(1_000_001, "A");
+        store.Join(code, 2_000_001, "B");
+        var first = store.UpdateSettings(code, 1_000_001, new TagTeamSettings
+        {
+            TeamName = "FIRST",
+            BgmId = 1,
+            EffectId = 2,
+            BackgroundPartsId = 3,
+            EmblemId = 4,
+            NameColorId = 5,
+        });
+        Assert.Equal("FIRST", first.Settings!.TeamName);
+        Assert.Equal(1u, first.Settings.BgmId);
+        Assert.Equal(2u, first.Settings.EffectId);
+        Assert.Equal(1_000_001u, first.Settings.UpdatedByPilotId);
+        Assert.True(first.Settings.UpdatedUtc <= DateTime.UtcNow.AddSeconds(1));
+        var firstTs = first.Settings.UpdatedUtc;
+
+        var second = store.UpdateSettings(code, 2_000_001, new TagTeamSettings
+        {
+            TeamName = "SECOND",
+            BgmId = 9,
+            EffectId = 8,
+        });
+        Assert.Equal("SECOND", second.Settings!.TeamName);
+        Assert.Equal(9u, second.Settings.BgmId);
+        Assert.Equal(8u, second.Settings.EffectId);
+        Assert.Equal(2_000_001u, second.Settings.UpdatedByPilotId);
+        Assert.True(second.Settings.UpdatedUtc >= firstTs);
+        Assert.Equal("SECOND", store.ForPilot(1_000_001).Single().Settings!.TeamName);
+
+        Assert.Throws<InvalidOperationException>(() =>
+            store.UpdateSettings(code, 3_000_001, new TagTeamSettings { TeamName = "NOPE" }));
+        Assert.Throws<InvalidOperationException>(() =>
+            store.UpdateSettings("ZZZZZZZZ", 1_000_001, new TagTeamSettings { TeamName = "NOPE" }));
+        // missing or blank name falls back to the default, still last-write-wins
+        var blank = store.UpdateSettings(code, 1_000_001, new TagTeamSettings { TeamName = "  " });
+        Assert.Equal("EXTREME TEAM", blank.Settings!.TeamName);
+    }
+
+    [Fact]
+    public void SettingsIsNewerThanUsesLastWriteWins()
+    {
+        var newer = new TagTeamSettings { UpdatedUtc = new DateTime(2026, 11, 15, 13, 30, 0, DateTimeKind.Utc) };
+        Assert.True(newer.IsNewerThan(null));
+        Assert.True(newer.IsNewerThan(newer.UpdatedUtc.AddSeconds(-1)));
+        Assert.False(newer.IsNewerThan(newer.UpdatedUtc));
+        Assert.False(newer.IsNewerThan(newer.UpdatedUtc.AddSeconds(1)));
+    }
+}
