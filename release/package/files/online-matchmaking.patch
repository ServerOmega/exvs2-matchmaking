@@ -0,0 +1,94 @@
+using MediatR;
+using Microsoft.Extensions.Options;
+using nue.protocol.exvs;
+using ServerInfinite.Models.Config;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Handlers.Game;
+
+/// <summary>
+/// exvs2-lobbies, results-hang fix #4 (analysis/results-hang-fixes.md section 4.4). EXPERIMENTAL, only used when
+/// CardServerConfig.PostMatchStubs is true. Minimal, store-nothing answers for methods upstream leaves unhandled
+/// (they otherwise get a fast ErrServer "Unhandled case"):
+///   205 SaveVsmToResult, 225 SaveFailedBattleLogOn, 306 RegisterOption: Success, empty body (all fields optional).
+///   211 SaveMedal: card found -> ACID_SUCCESS + its pilot id, 0 medals; not found -> ACID_NO_USE.
+///   406 LoadReplayCard: ACID_NO_USE (no replay service on this server).
+///   407 PreSaveReplay: status 2 (= reject, the value upstream uses for "slots full"), url "http://dummy", so the LM
+///       skips the replay upload. (Upstream's own PreSaveReplay handler stays disabled.)
+/// Nothing is written to the DB. Card secrets are never logged.
+/// </summary>
+public record PostMatchStubCommand(Request Request) : IRequest<Response>;
+
+public class PostMatchStubCommandHandler : IRequestHandler<PostMatchStubCommand, Response>
+{
+    public static readonly HashSet<MethodType> Methods = new()
+    {
+        MethodType.MthdSaveVsmToResult, MethodType.MthdSaveMedal, MethodType.MthdSaveFailedBattleLogOn,
+        MethodType.MthdRegisterOption, MethodType.MthdLoadReplayCard, MethodType.MthdPreSaveReplay,
+    };
+
+    private readonly ILogger<PostMatchStubCommandHandler> _logger;
+    private readonly ServerDbContext _context;
+
+    public PostMatchStubCommandHandler(ILogger<PostMatchStubCommandHandler> logger, ServerDbContext context)
+    {
+        _logger = logger;
+        _context = context;
+    }
+
+    public Task<Response> Handle(PostMatchStubCommand command, CancellationToken cancellationToken)
+    {
+        var q = command.Request;
+        var r = new Response { Type = q.Type, RequestId = q.RequestId, Error = Error.Success };
+        switch (q.Type)
+        {
+            case MethodType.MthdSaveVsmToResult:
+                r.save_vsm_to_result = new Response.SaveVsmToResult();
+                _logger.LogInformation("STUB SaveVsmToResult pilot={Pilot}", q.save_vsm_to_result?.PilotId);
+                break;
+            case MethodType.MthdSaveFailedBattleLogOn:
+            {
+                var f = q.save_failed_battle_log_on;
+                r.save_failed_battle_log_on = new Response.SaveFailedBattleLogOn();
+                _logger.LogWarning("STUB SaveFailedBattleLogOn pilot={Pilot} room={Room} my_fault={Fault} mode={Mode} pilots=[{Pilots}]",
+                    f?.PilotId, f?.RoomId, f?.MyFaultFlag, f?.OnlineMatchingMode,
+                    f == null ? "" : string.Join(",", f.Pilots.Select(p => $"{p.PilotId}:{(p.MyFaultFlag ? "fault" : "ok")}")));
+                break;
+            }
+            case MethodType.MthdRegisterOption:
+                r.register_option = new Response.RegisterOption();
+                _logger.LogInformation("STUB RegisterOption user={User} friend={Friend} ng={Ng} (not stored)",
+                    q.register_option?.MobileUserId, q.register_option?.FriendPilotId, q.register_option?.NgPilotId);
+                break;
+            case MethodType.MthdSaveMedal:
+            {
+                var m = q.save_medal;
+                var card = m == null || string.IsNullOrEmpty(m.ChipId) ? null : _context.CardProfiles
+                    .Where(x => x.ChipId == m.ChipId && x.AccessCode == (m.AccessCode ?? ""))
+                    .Select(x => new { x.Id }).FirstOrDefault();
+                r.save_medal = new Response.SaveMedal
+                {
+                    AcidError = card == null ? AcidError.AcidNoUse : AcidError.AcidSuccess,
+                    PilotId = card == null ? 0u : (uint)card.Id,
+                    SeasonMedal = 0, GrantMedal = 0, GrantLocMedal = 0,
+                };
+                _logger.LogInformation("STUB SaveMedal mode={Mode} medal={Medal} card={Found}", m?.MedalMode, m?.Medal,
+                    card == null ? "not found" : $"pilot {card.Id}");
+                break;
+            }
+            case MethodType.MthdLoadReplayCard:
+                r.load_replay_card = new Response.LoadReplayCard { AcidError = AcidError.AcidNoUse };
+                _logger.LogInformation("STUB LoadReplayCard -> ACID_NO_USE (no replay service)");
+                break;
+            case MethodType.MthdPreSaveReplay:
+                r.pre_save_replay = new Response.PreSaveReplay { Status = 2, Url = "http://dummy" };
+                _logger.LogInformation("STUB PreSaveReplay size={Size} -> status 2 (reject, upload skipped)", q.pre_save_replay?.ReplaySize);
+                break;
+            default:
+                r.Error = Error.ErrServer;
+                r.ErrorMsg = "Unhandled case";
+                break;
+        }
+        return Task.FromResult(r);
+    }
+}
