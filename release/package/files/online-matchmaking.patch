@@ -0,0 +1,75 @@
+using ServerInfinite.Matchmaking;
+using ServerInfinite.Models.Cards;
+using ServerInfinite.Models.Cards.Team;
+using ServerInfinite.Persistence;
+
+namespace ServerInfinite.Handlers.UI.Team;
+
+/// <summary>Creates or refreshes a local TagTeamData row for a joined cross-server invite.</summary>
+internal static class CrossServerTeamSupport
+{
+    public const string DefaultTeamName = "EXTREME TEAM";
+
+    public static uint PartnerWire(TagInvite inv, uint selfWire) =>
+        inv.CreatorPilotId == selfWire ? inv.PartnerPilotId : inv.CreatorPilotId;
+
+    public static string PartnerName(TagInvite inv, uint selfWire) =>
+        inv.CreatorPilotId == selfWire ? inv.PartnerName : inv.CreatorName;
+
+    public static TagTeamData? Upsert(ServerDbContext context, CardProfile card, TagInvite inv, int maxTeams)
+    {
+        if (!inv.Joined) return null;
+        var self = PilotId.Wire(card.Id);
+        var partner = PartnerWire(inv, self);
+        if (partner == 0 || partner == self) return null;
+        var code = TagInviteStore.Normalize(inv.Code);
+
+        var existing = context.TagTeamDataDbSet.FirstOrDefault(t =>
+            t.CardId == card.Id && t.SharedTagCode == code);
+        if (existing != null)
+        {
+            existing.RemotePartnerPilotId = partner;
+            var name = PartnerName(inv, self);
+            if (!string.IsNullOrEmpty(name)) existing.RemotePartnerName = name;
+            ApplySettingsIfNewer(existing, inv.Settings);
+            return existing;
+        }
+
+        var count = context.TagTeamDataDbSet.Count(t => t.CardId == card.Id || t.TeammateCardId == (uint)card.Id);
+        if (count >= Math.Max(0, maxTeams)) return null;
+
+        var team = new TagTeamData
+        {
+            CardId = card.Id,
+            TeamName = DefaultTeamName,
+            TeammateCardId = 0,
+            RemotePartnerPilotId = partner,
+            RemotePartnerName = PartnerName(inv, self) ?? "",
+            SharedTagCode = code,
+        };
+        ApplySettingsIfNewer(team, inv.Settings);
+        context.TagTeamDataDbSet.Add(team);
+        return team;
+    }
+
+    /// <summary>
+    /// Apply shared cosmetics from /tag when the store's timestamp is newer than the last
+    /// payload this card server applied (or when none has been applied yet).
+    /// </summary>
+    public static bool ApplySettingsIfNewer(TagTeamData team, TagTeamSettings? settings)
+    {
+        if (settings is null) return false;
+        if (!settings.IsNewerThan(team.SettingsUpdatedUtc)) return false;
+        var name = (settings.TeamName ?? "").Trim();
+        if (name.Length == 0) name = DefaultTeamName;
+        team.TeamName = name;
+        team.BackgroundPartsId = settings.BackgroundPartsId;
+        team.EffectId = settings.EffectId;
+        team.EmblemId = settings.EmblemId;
+        team.BgmId = settings.BgmId;
+        team.NameColorId = settings.NameColorId;
+        team.SettingsUpdatedUtc = settings.UpdatedUtc;
+        team.UpdateTime = DateTime.Now;
+        return true;
+    }
+}
