+
+    /// <summary>Shared tag codes this card should register with the matchmaker before a world-5 search.</summary>
+    public static string[] SharedCodes(ServerDbContext context, CardProfile cardProfile) =>
+        context.TagTeamDataDbSet
+            .Where(x => x.CardId == cardProfile.Id || x.TeammateCardId == (uint)cardProfile.Id)
