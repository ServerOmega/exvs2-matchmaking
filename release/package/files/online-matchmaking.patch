+using ServerInfinite.Matchmaking;
+
+namespace ServerInfinite.Common.TagInvites;
+
+public sealed class InProcessTagInviteClient : ITagInviteClient
+{
+    private readonly TagInviteStore _store;
+    private readonly Matchmaker? _mm;
+
+    public InProcessTagInviteClient(TagInviteStore store, Matchmaker? mm = null)
+    {
+        _store = store;
+        _mm = mm;
+    }
+
+    public Task<string> CreateAsync(uint creatorPilotId, string creatorName, CancellationToken ct = default) =>
+        Task.FromResult(_store.Create(creatorPilotId, creatorName));
+
+    public Task<TagInvite> JoinAsync(string code, uint partnerPilotId, string partnerName, CancellationToken ct = default) =>
+        Task.FromResult(_store.Join(code, partnerPilotId, partnerName));
+
+    public Task<TagInvite?> GetAsync(string code, CancellationToken ct = default) =>
+        Task.FromResult(_store.Get(code));
+
+    public Task<IReadOnlyList<TagInvite>> ForPilotAsync(uint wirePilotId, CancellationToken ct = default) =>
+        Task.FromResult(_store.ForPilot(wirePilotId));
+
+    public Task RegisterSearchAsync(uint amId, IEnumerable<string> codes, CancellationToken ct = default)
+    {
+        var list = codes as string[] ?? codes.ToArray();
+        if (_mm != null) _mm.RegisterTagSearch(amId, list);
+        else _store.RegisterSearch(amId, list);
+        return Task.CompletedTask;
+    }
+
+    public Task<TagInvite> UpdateSettingsAsync(string code, uint byPilotId, TagTeamSettings settings, CancellationToken ct = default) =>
+        Task.FromResult(_store.UpdateSettings(code, byPilotId, settings));
+}
