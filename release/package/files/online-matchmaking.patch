diff --git a/Server-Infinite/Lobbies/LogMask.cs b/Server-Infinite/Lobbies/LogMask.cs
new file mode 100644
index 0000000..b830ffd
--- /dev/null
+++ b/Server-Infinite/Lobbies/LogMask.cs
@@ -0,0 +1,27 @@
+using System.Text.RegularExpressions;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// exvs2-lobbies: masks card secrets in upstream's full request dump ("Request is (Stringified) ..."), which otherwise
+/// logs AccessCode / ChipId / SessionId / Token values in clear text. CardServerConfig.MaskCardSecretsInLog (default
+/// true, logging only). Values become "&lt;masked:N&gt;" (N = length), so a log can be shared without card data.
+/// </summary>
+public static class LogMask
+{
+    private static readonly Regex Field = new(
+        @"(?m)^(\s*(?:AccessCode|ChipId|SessionId|Token|BootToken|UploadToken|access_code|chip_id|session_id|boot_token)\s*:[ \t]*)(\S[^\r\n]*)$",
+        RegexOptions.Compiled);
+
+    private static readonly Regex Inline = new(
+        @"(?i)\b(access_?code|chip_?id|session_?id|boot_?token)(\s*[=:]\s*)([0-9A-Za-z_\-]{4,})", RegexOptions.Compiled);
+
+    public static string Mask(string? text)
+    {
+        if (string.IsNullOrEmpty(text)) return text ?? "";
+        var s = Field.Replace(text, m => m.Groups[1].Value + Masked(m.Groups[2].Value.TrimEnd()));
+        return Inline.Replace(s, m => m.Groups[1].Value + m.Groups[2].Value + Masked(m.Groups[3].Value));
+    }
+
+    private static string Masked(string v) => v.StartsWith("<masked:") || v == "(null)" ? v : $"<masked:{v.Length}>";
+}
diff --git a/Server-Infinite/Lobbies/PostMatchWatchdog.cs b/Server-Infinite/Lobbies/PostMatchWatchdog.cs
new file mode 100644
index 0000000..60383d5
--- /dev/null
+++ b/Server-Infinite/Lobbies/PostMatchWatchdog.cs
@@ -0,0 +1,63 @@
+using nue.protocol.exvs;
+
+namespace ServerInfinite.Lobbies;
+
+/// <summary>
+/// exvs2-lobbies, results-hang simulation draft (analysis/results-hang-sim.md section 5, EXPERIMENTAL, off by default:
+/// CardServerConfig.PostMatchWatchdogMs = 0). The game's post-match save task (S) waits up to 10 s per HTTP call
+/// (libcurl timeout) and repeats a failed call up to 5 times. If a save handler is slow (e.g. the SQLite file is locked
+/// by another process: Microsoft.Data.Sqlite waits up to 30 s on a busy database), every try times out and S can stay
+/// busy for about 5 x 10 s per call. With the watchdog on, a post-match save that is not finished after the deadline
+/// gets an immediate Success with an empty body (the same reply upstream sends for an unknown card), so the game moves on.
+/// The handler keeps running in its own DI scope and still writes its result when the database is free again.
+/// </summary>
+public static class PostMatchWatchdog
+{
+    /// <summary>Post-match saves whose response bodies are empty / all-optional in the game's proto.</summary>
+    public static readonly HashSet<MethodType> Methods = new()
+    {
+        MethodType.MthdSaveVsmResult, MethodType.MthdSaveVsmOnResult, MethodType.MthdSaveVscResult,
+        MethodType.MthdSaveVstResult, MethodType.MthdSaveStageResult, MethodType.MthdSaveBattleLog,
+        MethodType.MthdSaveBattleLogOn, MethodType.MthdSaveUserPlayResearchData, MethodType.MthdSaveResultCapture,
+    };
+
+    /// <summary>Allowed range for the deadline (it must stay below the game's 10 s HTTP timeout).</summary>
+    public static int Clamp(int ms) => ms <= 0 ? 0 : Math.Clamp(ms, 500, 9000);
+
+    public static bool Applies(int ms, MethodType type) => Clamp(ms) > 0 && Methods.Contains(type);
+
+    /// <summary>Success + the empty typed body for a method in <see cref="Methods"/> (SaveResultCapture: no upload URL).</summary>
+    public static Response TimeoutReply(Request q)
+    {
+        var r = new Response { Type = q.Type, RequestId = q.RequestId, Error = Error.Success };
+        switch (q.Type)
+        {
+            case MethodType.MthdSaveVsmResult: r.save_vsm_result = new Response.SaveVsmResult(); break;
+            case MethodType.MthdSaveVsmOnResult: r.save_vsm_on_result = new Response.SaveVsmOnResult(); break;
+            case MethodType.MthdSaveVscResult: r.save_vsc_result = new Response.SaveVscResult(); break;
+            case MethodType.MthdSaveVstResult: r.save_vst_result = new Response.SaveVstResult(); break;
+            case MethodType.MthdSaveStageResult: r.save_stage_result = new Response.SaveStageResult(); break;
+            case MethodType.MthdSaveBattleLog: r.save_battle_log = new Response.SaveBattleLog(); break;
+            case MethodType.MthdSaveBattleLogOn: r.save_battle_log_on = new Response.SaveBattleLogOn(); break;
+            case MethodType.MthdSaveUserPlayResearchData: r.save_user_play_research_data = new Response.SaveUserPlayResearchData(); break;
+            case MethodType.MthdSaveResultCapture: r.save_result_capture = new Response.SaveResultCapture(); break;
+            default: r.Error = Error.ErrServer; r.ErrorMsg = "Unhandled case"; break;
+        }
+        return r;
+    }
+
+    /// <summary>
+    /// Runs <paramref name="work"/> on the thread pool (upstream handlers block synchronously on the database) and waits
+    /// at most <paramref name="ms"/>. Returns (response, false) when it finished in time, otherwise
+    /// (TimeoutReply, true) and lets the work finish in the background; <paramref name="onLate"/> sees its outcome.
+    /// </summary>
+    public static async Task<(Response Response, bool TimedOut)> RunAsync(Request q, int ms, Func<Task<Response>> work,
+        Action<Task<Response>>? onLate = null)
+    {
+        var task = Task.Run(work);
+        var done = await Task.WhenAny(task, Task.Delay(Clamp(ms))).ConfigureAwait(false);
+        if (done == task) return (await task.ConfigureAwait(false), false);
+        if (onLate != null) _ = task.ContinueWith(onLate, TaskScheduler.Default);
+        return (TimeoutReply(q), true);
+    }
+}
