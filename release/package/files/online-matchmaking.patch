+namespace ServerInfinite.Matchmaking;
+
+/// <summary>Resolves the shared /tag API URL from OnlineTag.InviteUrl or OnlineMatching.MatchUrl.</summary>
+public static class TagInviteUrl
+{
+    public static string? Resolve(string? inviteUrl, string? matchUrl)
+    {
+        if (!string.IsNullOrWhiteSpace(inviteUrl))
+            return inviteUrl.Trim().TrimEnd('/');
+        if (string.IsNullOrWhiteSpace(matchUrl))
+            return null;
+        var m = matchUrl.Trim().TrimEnd('/');
+        if (m.EndsWith("/match", StringComparison.OrdinalIgnoreCase))
+            return m[..^"/match".Length] + "/tag";
+        return m + "/tag";
+    }
+}
