Date: Fri, 13 Nov 2026 18:53:25 -0800
Subject: [PATCH 04/26] Built-in STUN: bind to StunHost when it is a local
 address

On a multi-homed Windows PC (Ethernet + N2N/VPN adapter) a socket bound to
0.0.0.0 answered from the other interface's IP (10.10.0.2), and the game drops
STUN replies whose source is not the server it asked. Bind the primary socket
to StunHost when that IP belongs to this machine; otherwise keep 0.0.0.0.
Found in the real game, 2026-11-13.
---
 .../Matchmaking/BuiltinStunServer.cs          | 22 ++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/Server-Infinite/Matchmaking/BuiltinStunServer.cs b/Server-Infinite/Matchmaking/BuiltinStunServer.cs
index 872d2b3..4ef4c22 100644
--- a/Server-Infinite/Matchmaking/BuiltinStunServer.cs
+++ b/Server-Infinite/Matchmaking/BuiltinStunServer.cs
@@ -38,11 +38,11 @@ public sealed class BuiltinStunServer : BackgroundService
         _port1 = (int)(_mm.BuiltinStunAltPort == 0 ? (uint)_port0 + 1 : _mm.BuiltinStunAltPort);
         IPAddress.TryParse(_mm.StunHost?.Trim(), out var stunIp);
         _hasAltIp = IPAddress.TryParse(_mm.BuiltinStunAltIp?.Trim(), out var altIp);
-        if (_hasAltIp)
-        {
-            // two local addresses: bind each explicitly so replies leave from the right one
-            _ip0 = stunIp ?? IPAddress.Any; _ip1 = altIp!;
-        }
+        // Bind to StunHost when it is one of this machine's addresses, so replies always leave from it.
+        // On a multi-homed Windows box a 0.0.0.0 socket can answer from another interface's IP, and the
+        // game drops replies whose source is not the STUN server it asked.
+        _ip0 = stunIp != null && IsLocal(stunIp) ? stunIp : IPAddress.Any;
+        if (_hasAltIp) _ip1 = altIp!;
         _advertised0 = stunIp ?? IPAddress.Loopback;
         _advertised1 = _hasAltIp ? altIp! : _advertised0;
 
@@ -75,6 +75,18 @@ public sealed class BuiltinStunServer : BackgroundService
         finally { foreach (var s in _socks) s?.Dispose(); }
     }
 
+    static bool IsLocal(IPAddress ip)
+    {
+        try
+        {
+            foreach (var ni in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces())
+            foreach (var ua in ni.GetIPProperties().UnicastAddresses)
+                if (ua.Address.Equals(ip)) return true;
+        }
+        catch { }
+        return false;
+    }
