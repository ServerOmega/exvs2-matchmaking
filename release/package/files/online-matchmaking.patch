+        lock (_gate)
+        {
+            string? by = null; (uint Room, double At) r = default;
+            if (nodeId != 0 && _lastRoomByNode.TryGetValue(nodeId, out r)) by = "node";
+            else if (!string.IsNullOrEmpty(sourceIp) && _lastRoomByIp.TryGetValue(NetDiag.Norm(sourceIp), out r)) by = "ip";
+            if (by == null || now - r.At > PostMatchWindow || now < r.At) return null;
+            return $"room={r.Room} +{now - r.At:0}s by={by}";
+        }
+    }
+
     /// <summary>Remove a unit. With <paramref name="now"/>, its other human nodes (e.g. the partner of a
     /// fixed pair) get MATCH_CANCELED on their next poll instead of ERR_MATCH_NOENTRY.</summary>
     private void Drop(Unit t, double? now = null, uint? except = null, string? reason = null)
